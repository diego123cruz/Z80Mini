              	#include "../Z80MiniAPI.asm"
              	;   API Z80Mini:
0100:         	delay500ms          equ     0x0100  ;   Delay 500ms
0103:         	delay               equ     0x0103  ;   On entry: DE = Delay time in milliseconds
0106:         	I2C_Open            equ     0x0106  ;   On entry: A = Device address (bit zero is read flag)
0109:         	I2C_Close           equ     0x0109  ;   Close
010C:         	I2C_Read            equ     0x010C  ;   On exit: If successful A = data byte and Z flagged
010F:         	I2C_Write           equ     0x010F  ;   On entry: A = Data byte, or Address byte (bit zero is read flag)
0112:         	keyboardIsEsc       equ     0x0112  ;   Verifica se ESC foi precionada. On exit: If press A = CTRLC and NZ flagged
0115:         	keyboardWaitA       equ     0x0115  ;   Aguarda tecla, letra em A. (BC DE HL preserved)
0118:         	keyboardA           equ     0x0118  ;   Lê teclado, Se tecla Carry=1. Letra em A. (BC DE HL preserved)
011B:         	setDefaultSerialA   equ     0x011B  ;   Seta terminal padrao porta A, Quando reinicia volta para A.
011E:         	setDefaultSerialB   equ     0x011E  ;   Seta terminal padrao porta B (P2), Quando reinicia volta para A.
0121:         	serialPrintA        equ     0x0121  ;   Imprime char in A no terminal setado.
0124:         	serialInputA        equ     0x0124  ;   Aguarda receber char no terminal setado. Retorno em A.
0127:         	serialPrintStr      equ     0x0127  ;   Imprime string (HL) terminado em 0 no terminal setado. MAX 128 chars. MODIFIES : A,B,C
012A:         	serialCRLF          equ     0x012A  ;   Imprime CR e LF no terminal setado.
012D:         	serialHexA          equ     0x012D  ;   Imprime byte em A no formato HEX, no terminal setado. Ex: 'D' = 44
0130:         	serialHexHL         equ     0x0130  ;   Imprime HL como 4 digitos hexadecimais, no terminal setado. Ex: HL=$80FF -> imprime "80FF"
0133:         	serialInHexA        equ     0x0133  ;   Pegar 2 caracteres ASCII (0-9 A-F), do terminal setado e converte em um byte em A. SEM ECHO
0136:         	serialInHexHL       equ     0x0136  ;   Pegar 4 caracteres ASCII (0-9 A-F), do terminal setado e converte em HL. SEM ECHO
              	
0139:         	initLCD             equ     0x0139  ;   Inicializa GLCD
013C:         	clearGBUF           equ     0x013C  ;   Limpa buffer da memoria de grafico. Precisa do plotToLCD para refletir no lcd.
013F:         	clearGrLCD          equ     0x013F  ;   Limpa memoria grafico do GLCD. Sem o plotToLCD.
0142:         	clearTxtLCD         equ     0x0142  ;   Limpar caracteres do LCD
0145:         	setGrMode           equ     0x0145  ;   Seta modo Grafico. 128x64
0148:         	setTxtMode          equ     0x0148  ;   Seta mode Text. 16x4 equivalente
014B:         	drawBox             equ     0x014B  ;   Desenha caixa. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
014E:         	drawLine            equ     0x014E  ;   Desenha linha.  Entradas: BC = X0,Y0 - DE = X1,Y1
0151:         	drawCircle          equ     0x0151  ;   Desenha circulo. Entradas BC = xm,ym (Ponro do Meio) - E = radius
0154:         	drawPixel           equ     0x0154  ;   Desenha um pixel em X Y.  Entrada B = column/X (0-127), C = row/Y (0-63)   Destroys: HL
0157:         	fillBox             equ     0x0157  ;   Desenha caixa preenchida. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
015A:         	fillCircle          equ     0x015A  ;   Desenha circulo preenchido. Entradas BC = xm,ym (Ponro do Meio) - E = radius
015D:         	plotToLCD           equ     0x015D  ;   Rotina principal de desenho. Move GBUF para o LCD e limpa o buffer ou não (setBufClear, setBufNoClear).  Destroys: ALL
0160:         	printString         equ     0x0160  ;   Imprimir texto ASCII em uma determinada linha. Entradas: A = 0 a 3 Número da linha. .db "String" na próxima linha, terminar com 0
0163:         	printChars          equ     0x0163  ;   (Ver detalhes) Imprimir caracteres na posição X,Y. Entrada B = coluna/X (0-7), C = linha/Y (0-3). HL = Endereço inicial do texto a ser exibido, termina com 0
0166:         	setInt38            equ     0x0166  ;   Seta vetor de interrupcao int38. Entradas HL = RST38_ADDR
0169:         	setint66            equ     0x0169  ;   Seta vetor de interrupcao int66. Entradas HL = RST66_ADDR
016C:         	setBufClear         equ     0x016C  ;   Configura limpeza do buffer após a saída para o LCD e vai para clearGBUF.
016F:         	setBufNoClear       equ     0x016F  ;   Configura para não limpar o buffer após a saída para o LCD.
0172:         	clearPixel          equ     0x0172  ;   Limpa um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0175:         	flipPixel           equ     0x0175  ;   Inverte um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0178:         	drawGraphic         equ     0x0178  ;   Desenha no buffer. Entrada: A = número ASCII ou se A=0 Então  HL = Endereço dos dados gráficos. B = (MULTIPLO DE 8) largura do gráfico em pixels (1-128). C = altura do gráfico em pixels (1-64). Destroy: ALL
017B:         	invGraphic          equ     0x017B  ;   Altera a flag de desenho inverso. (não inverte grafico atual) Destroy A
017E:         	initTerminal        equ     0x017E  ;   Inicializa o Terminal GLCD. Cursor 0,0 e limpa buffer.
0181:         	sendCharToLCD       equ     0x0181  ;   Envia ou manipula caracteres ASCII para a tela GLCD (Terminal). Entrada: A = caractere ASCII a ser enviado para a tela GLCD. A = somente cursor desenhado.
0184:         	sendStringToLCD     equ     0x0184  ;   Imprime string no terminal GLCD. DE = inicio da string. A = caractere para parar a impressão. A impressão para e retorna quando um CR é impresso. Destroy ALL
0187:         	sendRegToLCD        equ     0x0187  ;   Imprime byte em A no formato HEX, no GLCD. Ex: 'D' = 44
018A:         	sendHLToLCD         equ     0x018A  ;   Imprime HL como 4 digitos hexadecimais, no GLCD. Ex: HL=$80FF -> imprime "80FF"
018D:         	setCursor           equ     0x018D  ;   Define a posição do cursor gráfico. Entradas: BC = X,Y onde X = 0..127, Y = 0..63   Destroy A
0190:         	getCursor           equ     0x0190  ;   Obter a posição do cursor. Saídas: BC = X,Y onde X = 0..127, Y = 0..63
0193:         	displayCursor       equ     0x0193  ;   Exibir Cursor. Entrada: A = 0, Ativar cursor, A = diferente de zero, Desativar cursor.
0196:         	autoLF              equ     0x0196  ;   Avanço de linha automático quando o cursor atinge o final da linha (Terminal). Entrada: A = 0, Avanço de linha automático; A = diferente de zero, Sem avanço de linha automático. Padrao LIGADO.
0199:         	underline           equ     0x0199  ;   Exibir sublinhado no caractere (Terminal). O estado inicial é sem sublinhado. Chamar esta rotina irá ALTERAR/DESLIGAR o sinalizador de sublinhado.
019C:         	plotAlways          equ     0x019C  ;   Quando sendCharToLCD é chamado, Atualiza GLCD ou não. Se Desativado plotToLCD deve ser chamado atualizar o GLCD. Entrada: A=0, Plotar sempre; A>0, Não plotar. O padrão é Plotar sempre.
019F:         	resetCollisionPixel equ     0x019F  ;   Limpa flag de colisao
01A2:         	checkCollisionPixel equ     0x01A2  ;   Check se um pixel ja estava ligado quando tenta ligar. JP Z, SEM_COLISAO. JP NZ, COLISAO.
01A5:         	I2C_OpenRead        equ     0x01A5  ;   I2C Open Read  (On entry: A = Device address)
01A8:         	I2C_OpenWrite       equ     0x01A8  ;   I2C Open Write (On entry: A = Device address)
              	
              	
              	
              	; -----------------------------------------------------------------------------
              	; PORTS
              	; -----------------------------------------------------------------------------
0070:         	GLCD_INST           .EQU    $70
0071:         	GLCD_DATA           .EQU    $71
              	
0040:         	KEYBOARD		    .EQU	$40
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capsloock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	
              	; -------- Constantes gerais --------
000D:         	CR:       EQU   0DH
000A:         	LF:       EQU   0AH
0008:         	BKS:      EQU   08H
007F:         	DEL:      EQU   7FH
001B:         	ESC:      EQU   1BH
0020:         	SPACE:    EQU   20H
0000:         	NUL:      EQU   00H
000C:         	FF:       EQU   0CH                 ; Form Feed -> Limpa lcd
              	
              	; -----------------------------------------------------------------------------
              	; SIO/2 - SERIAL
              	; -----------------------------------------------------------------------------
0000:         	SIOA_D:   EQU   $00
0002:         	SIOA_C:   EQU   $02
0001:         	SIOB_D:   EQU   $01   ; Conector P2
0003:         	SIOB_C:   EQU   $03   ; Conector P2
              	
              	
              	
              	; ==========================================================================
              	; Driver SH1106 / SSD1306 (OLED 128x64) via I2C - Z80Mini
              	;
              	; Baseado no mesmo padrao I2C_Open/I2C_Write/I2C_Close usado no driver
              	; SSD1306 do repositorio (BIOS/Programas/Display oled ssd1306_128x32).
              	;
              	; Compativel com os dois chips atraves do switch CHIP_SH1106 abaixo.
              	; Os dois usam "page addressing mode" aqui (comum aos dois controladores),
              	; entao o unico codigo que realmente muda entre eles e:
              	;   - o comando de charge pump (SH1106: $AD,$8B / SSD1306: $8D,$14)
              	;   - o COL_OFFSET (SH1106 tem RAM de 132 colunas mas painel de 128 ->
              	;     desloca 2; SSD1306 e nativamente 128 colunas -> offset 0)
              	; Tudo o mais (comandos de pagina/coluna, remap, scan direction, etc.)
              	; e identico nos dois chips.
              	; ==========================================================================
              	
0000:         	CHIP_SH1106 .equ    0           ; 1 = compila para SH1106, 0 = compila para SSD1306
0001:         	CHIP_FLIP	.equ	1			; 0 = Display normal, 1 = Display flip 
              	
0078:         	oled        .equ    $78         ; endereco I2C (0x3C << 1), ja com bit R/W
0080:         	SCR_WIDTH   .equ    128
0008:         	SCR_PAGES   .equ    8           ; 128x64 -> 8 paginas de 8 pixels
              	
              	#if CHIP_SH1106
              	COL_OFFSET  .equ    2           ; SH1106: RAM de 132 col, painel usa so 128 (offset 2)
              	#else
0000:         	COL_OFFSET  .equ    0           ; SSD1306: 128 colunas nativas, sem offset
              	#endif
              	
8000:         	    .org $8000
              	
              	
              	; --------------------------------------------------------------------------
              	; Ponto de entrada de teste
              	; --------------------------------------------------------------------------
8000:         	inicio:
8000: CD3881  	    CALL SH1106_Init
8003: CDD581  	    CALL SH1106_ClearAll
              	
8006: 3E00    	    LD A,0
8008: CDAF81  	    CALL SH1106_SetPage
800B: 216580  	    LD HL, MSG1
800E: CD1581  	    CALL printStringHL
              	
8011: 3E01    	    LD A,1
8013: CDAF81  	    CALL SH1106_SetPage
8016: 217B80  	    LD HL, MSG2
8019: CD1581  	    CALL printStringHL
              	
801C: 3E02    	    LD A,2
801E: CDAF81  	    CALL SH1106_SetPage
8021: 219180  	    LD HL, MSG3
8024: CD1581  	    CALL printStringHL
              	
8027: 3E03    	    LD A,3
8029: CDAF81  	    CALL SH1106_SetPage
802C: 21A780  	    LD HL, MSG4
802F: CD1581  	    CALL printStringHL
              	
8032: 3E04    	    LD A,4
8034: CDAF81  	    CALL SH1106_SetPage
8037: 21BD80  	    LD HL, MSG5
803A: CD1581  	    CALL printStringHL
              	
803D: 3E05    	    LD A,5
803F: CDAF81  	    CALL SH1106_SetPage
8042: 21D380  	    LD HL, MSG6
8045: CD1581  	    CALL printStringHL
              	
8048: 3E06    	    LD A,6
804A: CDAF81  	    CALL SH1106_SetPage
804D: 21E980  	    LD HL, MSG7
8050: CD1581  	    CALL printStringHL
              	
8053: 3E07    	    LD A,7
8055: CDAF81  	    CALL SH1106_SetPage
8058: 21FF80  	    LD HL, MSG8
805B: CD1581  	    CALL printStringHL
              	
805E: C9      	    RET
805F:         	loop:
805F: CD1501  	    CALL keyboardWaitA
8062: C35F80  	    JP   loop
              	
              	
8065: 7C3D3D3D	MSG1:	.db "|===================|", 0
8069: 3D3D3D3D	
806D: 3D3D3D3D	
8071: 3D3D3D3D	
8075: 3D3D3D3D	
8079: 7C00    	
807B: 7C202E2E	MSG2:	.db "| ..:: Z80Mini ::.. |", 0
807F: 3A3A205A	
8083: 38304D69	
8087: 6E69203A	
808B: 3A2E2E20	
808F: 7C00    	
8091: 7C202D2D	MSG3:	.db "| ----------------- |", 0
8095: 2D2D2D2D	
8099: 2D2D2D2D	
809D: 2D2D2D2D	
80A1: 2D2D2D20	
80A5: 7C00    	
80A7: 7C203332	MSG4:	.db "| 32Kb ROM 0000-7FFF|", 0
80AB: 4B622052	
80AF: 4F4D2030	
80B3: 3030302D	
80B7: 37464646	
80BB: 7C00    	
80BD: 7C203332	MSG5:	.db "| 32Kb RAM 8000-FFFF|", 0
80C1: 4B622052	
80C5: 414D2038	
80C9: 3030302D	
80CD: 46464646	
80D1: 7C00    	
80D3: 7C205365	MSG6:	.db "| Serial 115200     |", 0
80D7: 7269616C	
80DB: 20313135	
80DF: 32303020	
80E3: 20202020	
80E7: 7C00    	
80E9: 7C204B65	MSG7:	.db "| Keyboard and GLCD |", 0
80ED: 79626F61	
80F1: 72642061	
80F5: 6E642047	
80F9: 4C434420	
80FD: 7C00    	
80FF: 7C3D3D3D	MSG8:	.db "|===================|", 0
8103: 3D3D3D3D	
8107: 3D3D3D3D	
810B: 3D3D3D3D	
810F: 3D3D3D3D	
8113: 7C00    	
              	
8115:         	printStringHL:
8115: 7E      		LD A, (HL)
8116: FE00    		CP 0
8118: C8      		RET Z
8119: E5      		PUSH HL
811A: CD2381  		CALL printCharA
811D: E1      		POP HL
811E: 23      		INC HL
811F: C31581  		JP printStringHL
              	
8122: C9      		RET
              	
8123:         	printCharA:
8123: 21C782  		LD HL, FONT
8126: 110000  		LD DE, $0000
8129: 5F      		LD E, A
812A: 19      		ADD HL, DE
812B: 19      		ADD HL, DE
812C: 19      		ADD HL, DE
812D: 19      		ADD HL, DE
812E: 19      		ADD HL, DE
812F: 19      		ADD HL, DE
8130: 3E40    	    LD   A, $40    ; control byte: fluxo de dados
8132: 0606    	    LD   B, 6      ; largura da fonte
8134: CDEC81  	    CALL send_i2c_block
8137: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; SH1106_Init - inicializa o display
              	;   Entrada: nenhuma
              	;   Saida:   BC DE HL preservados
              	; --------------------------------------------------------------------------
8138:         	SH1106_Init:
8138: 3EAE    	    LD   A, $AE         ; display off
813A: CD1782  	    CALL send_cmd
              	
813D: 3ED5    	    LD   A, $D5         ; clock divide ratio / oscillator freq
813F: CD1782  	    CALL send_cmd
8142: 3E80    	    LD   A, $80
8144: CD1782  	    CALL send_cmd
              	
8147: 3EA8    	    LD   A, $A8         ; multiplex ratio
8149: CD1782  	    CALL send_cmd
814C: 3E3F    	    LD   A, $3F         ; 64 linhas (MUX = 63)
814E: CD1782  	    CALL send_cmd
              	
8151: 3ED3    	    LD   A, $D3         ; display offset
8153: CD1782  	    CALL send_cmd
8156: 3E00    	    LD   A, $00
8158: CD1782  	    CALL send_cmd
              	
815B: 3E40    	    LD   A, $40         ; start line = 0
815D: CD1782  	    CALL send_cmd
              	
              	#if CHIP_SH1106
              	    LD   A, $AD         ; DC-DC control (charge pump do SH1106)
              	    CALL send_cmd
              	    LD   A, $8B         ; DC-DC on
              	    CALL send_cmd
              	#else
8160: 3E8D    	    LD   A, $8D         ; charge pump setting (SSD1306)
8162: CD1782  	    CALL send_cmd
8165: 3E14    	    LD   A, $14         ; charge pump on (usa VDD interno)
8167: CD1782  	    CALL send_cmd
              	#endif
              	
              	#if CHIP_FLIP
816A: 3EA0    	    LD   A, $A0         ; segment remap normal
816C: CD1782  	    CALL send_cmd
              	
816F: 3EC0    	    LD   A, $C0         ; COM scan normal 
8171: CD1782  	    CALL send_cmd
              	#else
              	    LD   A, $A1         ; segment remap (espelha horizontal)
              	    CALL send_cmd
              	
              	    LD   A, $C8         ; COM output scan direction (espelha vertical)
              	    CALL send_cmd
              	#endif
              	
8174: 3EDA    	    LD   A, $DA         ; COM pins hardware config
8176: CD1782  	    CALL send_cmd
8179: 3E12    	    LD   A, $12
817B: CD1782  	    CALL send_cmd
              	
817E: 3E81    	    LD   A, $81         ; contrast
8180: CD1782  	    CALL send_cmd
8183: 3E80    	    LD   A, $80
8185: CD1782  	    CALL send_cmd
              	
8188: 3ED9    	    LD   A, $D9         ; pre-charge period
818A: CD1782  	    CALL send_cmd
818D: 3E1F    	    LD   A, $1F
818F: CD1782  	    CALL send_cmd
              	
8192: 3EDB    	    LD   A, $DB         ; VCOM deselect level
8194: CD1782  	    CALL send_cmd
8197: 3E40    	    LD   A, $40
8199: CD1782  	    CALL send_cmd
              	
819C: 3EA4    	    LD   A, $A4         ; entire display resume (mostra conteudo da RAM)
819E: CD1782  	    CALL send_cmd
              	
81A1: 3EA6    	    LD   A, $A6         ; display normal (nao invertido)
81A3: CD1782  	    CALL send_cmd
              	
81A6: CD3D82  	    CALL delay_50ms
              	
81A9: 3EAF    	    LD   A, $AF         ; display on
81AB: CD1782  	    CALL send_cmd
              	
81AE: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; SH1106_SetPage - seleciona pagina (0-7) e volta o cursor de coluna
              	; para o inicio (respeitando COL_OFFSET)
              	;   Entrada: A = numero da pagina (0-7)
              	;   Saida:   HL preservado
              	; Os 3 bytes de comando (pagina, coluna baixa, coluna alta) sao montados
              	; em PAGE_CMD e enviados numa unica transacao I2C.
              	; --------------------------------------------------------------------------
81AF:         	SH1106_SetPage:
81AF: E5      	    PUSH HL
81B0: F6B0    	    OR   $B0             ; comando "set page address" = $B0 | page
81B2: 324482  	    LD   (PAGE_CMD), A
              	
81B5: 3E00    	    LD   A, COL_OFFSET
81B7: E60F    	    AND  $0F
81B9: 324582  	    LD   (PAGE_CMD+1), A ; coluna baixa (nibble baixo, comando $00-$0F)
              	
81BC: 3E00    	    LD   A, COL_OFFSET
81BE: 0F      	    RRCA
81BF: 0F      	    RRCA
81C0: 0F      	    RRCA
81C1: 0F      	    RRCA
81C2: E60F    	    AND  $0F
81C4: F610    	    OR   $10
81C6: 324682  	    LD   (PAGE_CMD+2), A ; coluna alta (nibble alto, comando $10-$1F)
              	
81C9: 214482  	    LD   HL, PAGE_CMD
81CC: 3E00    	    LD   A, $00           ; control byte: fluxo de comandos
81CE: 0603    	    LD   B, 3
81D0: CDEC81  	    CALL send_i2c_block
              	
81D3: E1      	    POP  HL
81D4: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; SH1106_ClearAll - apaga a tela inteira (todas as 8 paginas, 128 colunas)
              	; Cada pagina e enviada como um unico bloco de 128 bytes zerados
              	; (1 Open/Close por pagina, em vez de 1 por byte).
              	; --------------------------------------------------------------------------
81D5:         	SH1106_ClearAll:
81D5: 0E00    	    LD   C, 0             ; contador de paginas
81D7:         	SH1106_ClearPage:
81D7: 79      	    LD   A, C
81D8: CDAF81  	    CALL SH1106_SetPage
              	
81DB: 214782  	    LD   HL, ZERO_ROW
81DE: 3E40    	    LD   A, $40            ; control byte: fluxo de dados
81E0: 0680    	    LD   B, SCR_WIDTH
81E2: CDEC81  	    CALL send_i2c_block
              	
81E5: 0C      	    INC  C
81E6: 79      	    LD   A, C
81E7: FE08    	    CP   SCR_PAGES
81E9: 20EC    	    JR   NZ, SH1106_ClearPage
              	
81EB: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; send_i2c_block - envia um control byte seguido de varios bytes numa
              	; UNICA transacao I2C (1 Open/Close para o bloco inteiro).
              	;
              	;   Entrada: A  = control byte ($00 = comandos, $40 = dados)
              	;            HL = ponteiro para os bytes a enviar
              	;            B  = quantidade de bytes
              	;   Saida:   HL += B (avancado ate o fim do bloco enviado)
              	;            C preservado (B e reaproveitado como contador)
              	; --------------------------------------------------------------------------
81EC:         	send_i2c_block:
81EC: C5      	    PUSH BC              ; preserva B(quantidade) e C do chamador
81ED: 4F      	    LD   C, A            ; C = control byte
              	
81EE: 3E78    	    LD   A, oled
81F0: CD0601  	    CALL I2C_Open
81F3: 79      	    LD   A, C
81F4: CD0F01  	    CALL I2C_Write        ; control byte enviado uma unica vez
81F7:         	send_i2c_block_loop:
81F7: 7E      	    LD   A, (HL)
81F8: CD0F01  	    CALL I2C_Write
81FB: 23      	    INC  HL
81FC: 10F9    	    DJNZ send_i2c_block_loop
81FE: CD0901  	    CALL I2C_Close
              	
8201: C1      	    POP  BC
8202: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; SH1106_FlushBuffer - envia um buffer de RAM (128x64 = 1024 bytes,
              	; organizado como 8 paginas sequenciais de 128 bytes) para o display
              	;   Entrada: HL = endereco do buffer
              	;   Saida:   HL avancado ate o fim do buffer
              	; Cada pagina e enviada como um unico bloco de 128 bytes.
              	; --------------------------------------------------------------------------
8203:         	SH1106_FlushBuffer:
8203: 0E00    	    LD   C, 0             ; contador de paginas
8205:         	SH1106_FlushPage:
8205: 79      	    LD   A, C
8206: CDAF81  	    CALL SH1106_SetPage    ; HL preservado
              	
8209: 3E40    	    LD   A, $40            ; control byte: fluxo de dados
820B: 0680    	    LD   B, SCR_WIDTH
820D: CDEC81  	    CALL send_i2c_block    ; envia 128 bytes a partir de HL; HL += 128
              	
8210: 0C      	    INC  C
8211: 79      	    LD   A, C
8212: FE08    	    CP   SCR_PAGES
8214: 20EF    	    JR   NZ, SH1106_FlushPage
              	
8216: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; Rotinas de baixo nivel I2C (byte unico - usadas so na inicializacao)
              	; --------------------------------------------------------------------------
8217:         	send_cmd:
8217: F5      	    PUSH AF
8218: 3E78    	    LD   A, oled
821A: CD0601  	    CALL I2C_Open
821D: 3E00    	    LD   A, $00          ; control byte: fluxo de comandos
821F: CD0F01  	    CALL I2C_Write
8222: F1      	    POP  AF
8223: CD0F01  	    CALL I2C_Write
8226: CD0901  	    CALL I2C_Close
8229: C9      	    RET
              	
822A:         	send_data:
822A: F5      	    PUSH AF
822B: 3E78    	    LD   A, oled
822D: CD0601  	    CALL I2C_Open
8230: 3E40    	    LD   A, $40          ; control byte: fluxo de dados
8232: CD0F01  	    CALL I2C_Write
8235: F1      	    POP  AF
8236: CD0F01  	    CALL I2C_Write
8239: CD0901  	    CALL I2C_Close
823C: C9      	    RET
              	
823D:         	delay_50ms:
823D: 113200  	    LD   DE, $0032
8240: CD0301  	    CALL delay
8243: C9      	    RET
              	
              	
              	; --------------------------------------------------------------------------
              	; Areas auxiliares usadas por send_i2c_block:
              	; PAGE_CMD - scratch de 3 bytes montado por SH1106_SetPage a cada chamada
              	; ZERO_ROW - 128 bytes fixos em zero, fonte de dados para SH1106_ClearAll
              	; --------------------------------------------------------------------------
8244:         	PAGE_CMD:
8244: 000000  	    defs 3, $00
              	
8247:         	ZERO_ROW:
8247: 00000000	    defs SCR_WIDTH, $00
824B: 00...   	
              	
              	
              	; --------------------------------------------------------------------------
              	; Fonte 5x7 completa (ASCII 0x00-0x7E), indexada diretamente pelo codigo
              	; do caractere (6 bytes por entrada: 5 colunas + 1 de espacamento).
              	; --------------------------------------------------------------------------
82C7:         	FONT:
