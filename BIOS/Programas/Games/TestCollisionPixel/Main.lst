80E7: FE73    		cp 's'
80E9: CA0281  		jp z, Kdown
              		
80EC: FE61    		cp 'a'
80EE: CA0D81  		jp z, Kleft
              		
80F1: FE64    		cp 'd'
80F3: CA1881  		jp z, Kright
80F6: C9      		ret
              		
80F7:         	Kup:
80F7: ED4B2381		LD BC, (pXY)
80FB: 0D      		dec c
80FC: 0D      		dec c
80FD: ED432381		LD (pXY), BC
8101: C9      		ret
              		
8102:         	Kdown:
