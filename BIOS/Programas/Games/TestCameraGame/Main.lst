              	; FlushFB - TODO: chamar aqui sua rotina real que envia o
              	; framebuf (128x64, 1bpp, 16 bytes/linha) pro ST7920.
              	; ============================================================
82D2:         	FlushFB:
82D2: CD5D01  		call plotToLCD
82D5: C9      	    ret
              	    
              	    
              	    
