              	; --------------------------------------
              	; zasm: assemble "Main.asm"
              	; date: 2026-08-24 01:05:24
              	; --------------------------------------


              	#include "../Z80MiniAPI.asm"
              	;   API Z80Mini:
0100:         	delay500ms          equ     0x0100  ;   Delay 500ms
0103:         	delay               equ     0x0103  ;   On entry: DE = Delay time in milliseconds
0106:         	I2C_Open            equ     0x0106  ;   On entry: A = Device address (bit zero is read flag)
0109:         	I2C_Close           equ     0x0109  ;   Close
010C:         	I2C_Read            equ     0x010C  ;   On exit: If successful A = data byte and Z flagged
010F:         	I2C_Write           equ     0x010F  ;   On entry: A = Data byte, or Address byte (bit zero is read flag)
0112:         	keyboardIsEsc       equ     0x0112  ;   Verifica se ESC foi precionada. On exit: If press A = CTRLC and NZ flagged
0115:         	keyboardWaitA       equ     0x0115  ;   Aguarda tecla, letra em A. (BC DE HL preserved)
0118:         	keyboardA           equ     0x0118  ;   Lê teclado, Se tecla Carry=1. Letra em A. (BC DE HL preserved)
011B:         	setDefaultSerialA   equ     0x011B  ;   Seta terminal padrao porta A, Quando reinicia volta para A.
011E:         	setDefaultSerialB   equ     0x011E  ;   Seta terminal padrao porta B (P2), Quando reinicia volta para A.
0121:         	serialPrintA        equ     0x0121  ;   Imprime char in A no terminal setado.
0124:         	serialInputA        equ     0x0124  ;   Aguarda receber char no terminal setado. Retorno em A.
0127:         	serialPrintStr      equ     0x0127  ;   Imprime string (HL) terminado em 0 no terminal setado. MAX 128 chars. MODIFIES : A,B,C
012A:         	serialCRLF          equ     0x012A  ;   Imprime CR e LF no terminal setado.
012D:         	serialHexA          equ     0x012D  ;   Imprime byte em A no formato HEX, no terminal setado. Ex: 'D' = 44
0130:         	serialHexHL         equ     0x0130  ;   Imprime HL como 4 digitos hexadecimais, no terminal setado. Ex: HL=$80FF -> imprime "80FF"
0133:         	serialInHexA        equ     0x0133  ;   Pegar 2 caracteres ASCII (0-9 A-F), do terminal setado e converte em um byte em A. SEM ECHO
0136:         	serialInHexHL       equ     0x0136  ;   Pegar 4 caracteres ASCII (0-9 A-F), do terminal setado e converte em HL. SEM ECHO
              	
0139:         	initLCD             equ     0x0139  ;   Inicializa GLCD
013C:         	clearGBUF           equ     0x013C  ;   Limpa buffer da memoria de grafico. Precisa do plotToLCD para refletir no lcd.
013F:         	clearGrLCD          equ     0x013F  ;   Limpa memoria grafico do GLCD. Sem o plotToLCD.
0142:         	clearTxtLCD         equ     0x0142  ;   Limpar caracteres do LCD
0145:         	setGrMode           equ     0x0145  ;   Seta modo Grafico. 128x64
0148:         	setTxtMode          equ     0x0148  ;   Seta mode Text. 16x4 equivalente
014B:         	drawBox             equ     0x014B  ;   Desenha caixa. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
014E:         	drawLine            equ     0x014E  ;   Desenha linha.  Entradas: BC = X0,Y0 - DE = X1,Y1
0151:         	drawCircle          equ     0x0151  ;   Desenha circulo. Entradas BC = xm,ym (Ponro do Meio) - E = radius
0154:         	drawPixel           equ     0x0154  ;   Desenha um pixel em X Y.  Entrada B = column/X (0-127), C = row/Y (0-63)   Destroys: HL
0157:         	fillBox             equ     0x0157  ;   Desenha caixa preenchida. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
015A:         	fillCircle          equ     0x015A  ;   Desenha circulo preenchido. Entradas BC = xm,ym (Ponro do Meio) - E = radius
015D:         	plotToLCD           equ     0x015D  ;   Rotina principal de desenho. Move GBUF para o LCD e limpa o buffer ou não (setBufClear, setBufNoClear).  Destroys: ALL
0160:         	printString         equ     0x0160  ;   Imprimir texto ASCII em uma determinada linha. Entradas: A = 0 a 3 Número da linha. .db "String" na próxima linha, terminar com 0
0163:         	printChars          equ     0x0163  ;   (Ver detalhes) Imprimir caracteres na posição X,Y. Entrada B = coluna/X (0-7), C = linha/Y (0-3). HL = Endereço inicial do texto a ser exibido, termina com 0
0166:         	setInt38            equ     0x0166  ;   Seta vetor de interrupcao int38. Entradas HL = RST38_ADDR
0169:         	setint66            equ     0x0169  ;   Seta vetor de interrupcao int66. Entradas HL = RST66_ADDR
016C:         	setBufClear         equ     0x016C  ;   Configura limpeza do buffer após a saída para o LCD e vai para clearGBUF.
016F:         	setBufNoClear       equ     0x016F  ;   Configura para não limpar o buffer após a saída para o LCD.
0172:         	clearPixel          equ     0x0172  ;   Limpa um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0175:         	flipPixel           equ     0x0175  ;   Inverte um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0178:         	drawGraphic         equ     0x0178  ;   Desenha no buffer. Entrada: A = número ASCII ou se A=0 Então  HL = Endereço dos dados gráficos. B = (MULTIPLO DE 8) largura do gráfico em pixels (1-128). C = altura do gráfico em pixels (1-64). Destroy: ALL
017B:         	invGraphic          equ     0x017B  ;   Altera a flag de desenho inverso. (não inverte grafico atual) Destroy A
017E:         	initTerminal        equ     0x017E  ;   Inicializa o Terminal GLCD. Cursor 0,0 e limpa buffer.
0181:         	sendCharToLCD       equ     0x0181  ;   Envia ou manipula caracteres ASCII para a tela GLCD (Terminal). Entrada: A = caractere ASCII a ser enviado para a tela GLCD. A = somente cursor desenhado.
0184:         	sendStringToLCD     equ     0x0184  ;   Imprime string no terminal GLCD. DE = inicio da string. A = caractere para parar a impressão. A impressão para e retorna quando um CR é impresso. Destroy ALL
0187:         	sendRegToLCD        equ     0x0187  ;   Imprime byte em A no formato HEX, no GLCD. Ex: 'D' = 44
018A:         	sendHLToLCD         equ     0x018A  ;   Imprime HL como 4 digitos hexadecimais, no GLCD. Ex: HL=$80FF -> imprime "80FF"
018D:         	setCursor           equ     0x018D  ;   Define a posição do cursor gráfico. Entradas: BC = X,Y onde X = 0..127, Y = 0..63   Destroy A
0190:         	getCursor           equ     0x0190  ;   Obter a posição do cursor. Saídas: BC = X,Y onde X = 0..127, Y = 0..63
0193:         	displayCursor       equ     0x0193  ;   Exibir Cursor. Entrada: A = 0, Ativar cursor, A = diferente de zero, Desativar cursor.
0196:         	autoLF              equ     0x0196  ;   Avanço de linha automático quando o cursor atinge o final da linha (Terminal). Entrada: A = 0, Avanço de linha automático; A = diferente de zero, Sem avanço de linha automático. Padrao LIGADO.
0199:         	underline           equ     0x0199  ;   Exibir sublinhado no caractere (Terminal). O estado inicial é sem sublinhado. Chamar esta rotina irá ALTERAR/DESLIGAR o sinalizador de sublinhado.
019C:         	plotAlways          equ     0x019C  ;   Quando sendCharToLCD é chamado, Atualiza GLCD ou não. Se Desativado plotToLCD deve ser chamado atualizar o GLCD. Entrada: A=0, Plotar sempre; A>0, Não plotar. O padrão é Plotar sempre.
019F:         	resetCollisionPixel equ     0x019F  ;   Limpa flag de colisao
01A2:         	checkCollisionPixel equ     0x01A2  ;   Check se um pixel ja estava ligado quando tenta ligar. JP Z, SEM_COLISAO. JP NZ, COLISAO.
01A5:         	I2C_OpenRead        equ     0x01A5  ;   I2C Open Read  (On entry: A = Device address)
01A8:         	I2C_OpenWrite       equ     0x01A8  ;   I2C Open Write (On entry: A = Device address)
              	
              	
              	
              	; -----------------------------------------------------------------------------
              	; PORTS
              	; -----------------------------------------------------------------------------
0070:         	GLCD_INST           .EQU    $70
0071:         	GLCD_DATA           .EQU    $71
              	
0040:         	KEYBOARD		    .EQU	$40
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capsloock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	
              	; -------- Constantes gerais --------
000D:         	CR:       EQU   0DH
000A:         	LF:       EQU   0AH
0008:         	BKS:      EQU   08H
007F:         	DEL:      EQU   7FH
001B:         	ESC:      EQU   1BH
0020:         	SPACE:    EQU   20H
0000:         	NUL:      EQU   00H
000C:         	FF:       EQU   0CH                 ; Form Feed -> Limpa lcd
              	
              	; -----------------------------------------------------------------------------
              	; SIO/2 - SERIAL
              	; -----------------------------------------------------------------------------
0000:         	SIOA_D:   EQU   $00
0002:         	SIOA_C:   EQU   $02
0001:         	SIOB_D:   EQU   $01   ; Conector P2
0003:         	SIOB_C:   EQU   $03   ; Conector P2
              	
              	
              	
              	
              	; =========================================================
              	; TESTE_SDCARD.ASM
              	; Teste de inicializacao SPI do modulo SD Card no Z80Mini
              	; Porta $C0 (bit-bang SPI, somente escrita) + entrada $C0 (MISO)
              	; Roda na RAM a partir de $8000
              	;
              	; Mapeamento assumido (mesmo do driver ST7735/MAX7219):
              	;   OUT $C0:  bit0=SCK  bit1=MOSI  bit2=CS
              	;   IN  $C0:  bit0=MISO (com pull-up externo confirmado no hardware)
              	;
              	; Status confirmado:
              	;   CMD0 -> R1=$01 (cartao entrou em modo SPI, idle)   OK
              	;   CMD8 -> timeout ($FF)  -> cartao nao suporta CMD8,
              	;           tratado como SDv1 (comportamento esperado)
              	;
              	; Esta versao adiciona:
              	;   - loop de ACMD41 (CMD55+CMD41, sem HCS ja que e' SDv1)
              	;     ate o cartao sair do estado idle (R1 = $00)
              	;   - CMD58 (READ_OCR) apos inicializar, so' para conferir
              	;
              	; Compilar:  zasm --z80 -w -u --bin TESTE_SDCARD.ASM
              	; Rodar a partir de $8000 no monitor do Z80Mini (G8000)
              	; =========================================================
              	
              	
              	
00C0:         	PORTC0  EQU   $C0
9000:         	BUFFER  EQU   $9000            ; buffer de 512 bytes p/ o setor lido (fora da area de codigo)
              	
              	; ---- mascaras da SAIDA $C0 (ajustar se necessario) ----
0001:         	M_SCK   EQU   $01
0002:         	M_MOSI  EQU   $02
0004:         	M_CS    EQU   $04
              	
              	; ---- mascara da ENTRADA $C0 (ajustar se necessario) ----
0001:         	M_MISO  EQU   $01
              	
8000:         	        ORG   $8000
              	
8000:         	START:
8000: 215282  	        LD    HL,MSGTITLE
8003: CDA981  	        CALL  PRINT
              	
              	        ; ---- estado inicial: CS=1 (inativo), MOSI=1, SCK=0 ----
8006: 3E06    	        LD    A,M_CS|M_MOSI
8008: 322D82  	        LD    (OUTSTATE),A
800B: D3C0    	        OUT   (PORTC0),A
              	
              	        ; ---- 0) delay p/ VDD do cartao estabilizar ----
800D: 116400  	        LD    DE,100          ; 100ms
8010: CD0301  	        CALL  delay
              	
              	        ; ---- 1) power-up: >=74 clocks com CS=1 MOSI=1 ----
8013: 0650    	        LD    B,80
8015:         	PULOOP:
8015: CD1C82  	        CALL  SCKPULSE
8018: 10FB    	        DJNZ  PULOOP
              	
              	        ; ---- 2) CMD0: GO_IDLE_STATE ----
801A: 216C82  	        LD    HL,MSGCMD0
801D: CDA981  	        CALL  PRINT
              	
8020: CD8081  	        CALL  CSLOW
8023: 212E82  	        LD    HL,CMD0
8026: CDB981  	        CALL  SENDCMD
8029: CDC381  	        CALL  READR1
              	
802C: 210483  	        LD    HL,MSGR1
802F: CDA981  	        CALL  PRINT
8032: CD9981  	        CALL  HEXOUT
8035: CDA381  	        CALL  TXCRLF
              	
8038: CD8B81  	        CALL  CSHIGH
              	
              	        ; ---- 3) ACMD41: inicializacao (CMD55 + CMD41, sem HCS = SDv1) ----
803B: 218E82  	        LD    HL,MSGACMD41
803E: CDA981  	        CALL  PRINT
              	
8041: DD210000	        LD    IX,0             ; contador de tentativas (16 bits, nao usa B)
8045:         	ACMD41LOOP:
8045: CD8081  	        CALL  CSLOW
              	
8048: 213A82  	        LD    HL,CMD55
804B: CDB981  	        CALL  SENDCMD
804E: CDC381  	        CALL  READR1           ; A = R1 do CMD55
              	
8051: 4F      	        LD    C,A               ; guarda R1 do CMD55 em C
8052: DD7C    	        LD    A,IXH
8054: B7      	        OR    A
8055: 2013    	        JR    NZ,SKIPPRINT55    ; so' imprime detalhado na 1a "volta" de IX
8057: DD7D    	        LD    A,IXL
8059: FE0F    	        CP    15
805B: 300D    	        JR    NC,SKIPPRINT55
              	
805D: 210B83  	        LD    HL,MSGCMD55R1
8060: CDA981  	        CALL  PRINT
8063: 79      	        LD    A,C
8064: CD9981  	        CALL  HEXOUT
8067: 3E20    	        LD    A,' '
8069: CF      	        RST   $08
806A:         	SKIPPRINT55:
              	
806A: 214082  	        LD    HL,CMD41
806D: CDB981  	        CALL  SENDCMD
8070: CDC381  	        CALL  READR1           ; A = R1 do ACMD41
              	
8073: 4F      	        LD    C,A               ; guarda R1 do ACMD41
8074: DD7C    	        LD    A,IXH
8076: B7      	        OR    A
8077: 2013    	        JR    NZ,SKIPPRINT41
8079: DD7D    	        LD    A,IXL
807B: FE0F    	        CP    15
807D: 300D    	        JR    NC,SKIPPRINT41
              	
807F: 211883  	        LD    HL,MSGCMD41R1
8082: CDA981  	        CALL  PRINT
8085: 79      	        LD    A,C
8086: CD9981  	        CALL  HEXOUT
8089: CDA381  	        CALL  TXCRLF
808C:         	SKIPPRINT41:
              	
808C: CD8B81  	        CALL  CSHIGH
              	
808F: 79      	        LD    A,C               ; R1 do ACMD41 de volta em A
8090: B7      	        OR    A
8091: 2817    	        JR    Z,ACMD41OK       ; R1=0 -> cartao pronto
              	
8093: 110500  	        LD    DE,5              ; pequeno delay entre tentativas (5ms)
8096: CD0301  	        CALL  delay
              	
8099: DD23    	        INC   IX
809B: DD7C    	        LD    A,IXH
809D: FE04    	        CP    4                 ; ~ate 1024 tentativas (IX 16 bits)
809F: 38A4    	        JR    C,ACMD41LOOP
              	
80A1: 21D082  	        LD    HL,MSGACMD41TO
80A4: CDA981  	        CALL  PRINT
80A7: C37981  	        JP    ENDTEST
              	
80AA:         	ACMD41OK:
80AA: 21B382  	        LD    HL,MSGACMD41OK
80AD: CDA981  	        CALL  PRINT
              	
              	        ; ---- 4) CMD58: READ_OCR (so' para conferir) ----
80B0: CD8081  	        CALL  CSLOW
80B3: 214682  	        LD    HL,CMD58
80B6: CDB981  	        CALL  SENDCMD
80B9: CDC381  	        CALL  READR1
              	
80BC: 210483  	        LD    HL,MSGR1
80BF: CDA981  	        CALL  PRINT
80C2: CD9981  	        CALL  HEXOUT
80C5: CDA381  	        CALL  TXCRLF
              	
80C8: 21FD82  	        LD    HL,MSGOCR
80CB: CDA981  	        CALL  PRINT
80CE: 0604    	        LD    B,4
80D0:         	OCRLOOP:
80D0: C5      	        PUSH  BC
80D1: CDF681  	        CALL  SPIRECV
80D4: CD9981  	        CALL  HEXOUT
80D7: 3E20    	        LD    A,' '
80D9: CF      	        RST   $08
80DA: C1      	        POP   BC
80DB: 10F3    	        DJNZ  OCRLOOP
80DD: CDA381  	        CALL  TXCRLF
80E0: CD8B81  	        CALL  CSHIGH
              	
              	        ; ---- 5) CMD17: READ_SINGLE_BLOCK (le o bloco 0) ----
              	        ; cartao e' SDSC (CCS=0 no OCR) -> endereco em BYTES, nao em blocos
              	        ; bloco 0 -> endereco = 0
80E3: 213383  	        LD    HL,MSGCMD17
80E6: CDA981  	        CALL  PRINT
              	
80E9: CD8081  	        CALL  CSLOW
80EC: 214C82  	        LD    HL,CMD17
80EF: CDB981  	        CALL  SENDCMD
80F2: CDC381  	        CALL  READR1
              	
80F5: 210483  	        LD    HL,MSGR1
80F8: CDA981  	        CALL  PRINT
80FB: CD9981  	        CALL  HEXOUT
80FE: CDA381  	        CALL  TXCRLF
              	
8101: B7      	        OR    A
8102: 206C    	        JR    NZ,CMD17ERR      ; R1 != 0 -> comando rejeitado
              	
              	        ; ---- espera o token de inicio de dados ($FE) ----
8104: DD210000	        LD    IX,0
8108:         	WAITTOKEN:
8108: CDF681  	        CALL  SPIRECV
810B: FEFE    	        CP    $FE
810D: 2810    	        JR    Z,GOTTOKEN
810F: DD23    	        INC   IX
8111: DD7C    	        LD    A,IXH
8113: FE20    	        CP    $20              ; timeout generoso (~8000 tentativas)
8115: 38F1    	        JR    C,WAITTOKEN
              	
8117: 216883  	        LD    HL,MSGTOKENTO
811A: CDA981  	        CALL  PRINT
811D: 184C    	        JR    CMD17DONE
              	
811F:         	GOTTOKEN:
              	        ; ---- le os 512 bytes de dados para o buffer ----
811F: 210090  	        LD    HL,BUFFER
8122: 010002  	        LD    BC,512
8125:         	READLOOP:
8125: CDF681  	        CALL  SPIRECV
8128: 77      	        LD    (HL),A
8129: 23      	        INC   HL
812A: 0B      	        DEC   BC
812B: 78      	        LD    A,B
812C: B1      	        OR    C
812D: 20F6    	        JR    NZ,READLOOP
              	
              	        ; ---- le e descarta o CRC16 (2 bytes) ----
812F: CDF681  	        CALL  SPIRECV
8132: CDF681  	        CALL  SPIRECV
              	
8135: 219083  	        LD    HL,MSGDATAOK
8138: CDA981  	        CALL  PRINT
              	
              	        ; ---- mostra os primeiros 16 bytes em hex ----
813B: 210090  	        LD    HL,BUFFER
813E: 0610    	        LD    B,16
8140:         	DUMPLOOP:
8140: C5      	        PUSH  BC
8141: 7E      	        LD    A,(HL)
8142: CD9981  	        CALL  HEXOUT
8145: 3E20    	        LD    A,' '
8147: CF      	        RST   $08
8148: 23      	        INC   HL
8149: C1      	        POP   BC
814A: 10F4    	        DJNZ  DUMPLOOP
814C: CDA381  	        CALL  TXCRLF
              	
              	        ; ---- confere assinatura de boot 0x55 0xAA (offset 510-511) ----
814F: 21FE91  	        LD    HL,BUFFER+510
8152: 7E      	        LD    A,(HL)
8153: FE55    	        CP    $55
8155: 200E    	        JR    NZ,NOSIG
8157: 23      	        INC   HL
8158: 7E      	        LD    A,(HL)
8159: FEAA    	        CP    $AA
815B: 2008    	        JR    NZ,NOSIG
              	
815D: 21B683  	        LD    HL,MSGBOOTSIG
8160: CDA981  	        CALL  PRINT
8163: 1806    	        JR    CMD17DONE
              	
8165:         	NOSIG:
8165: 21DC83  	        LD    HL,MSGNOBOOTSIG
8168: CDA981  	        CALL  PRINT
              	
816B:         	CMD17DONE:
816B: CD8B81  	        CALL  CSHIGH
816E: 1809    	        JR    ENDTEST
              	
8170:         	CMD17ERR:
8170: 214D83  	        LD    HL,MSGCMD17ERR
8173: CDA981  	        CALL  PRINT
8176: CD8B81  	        CALL  CSHIGH
              	
8179:         	ENDTEST:
8179: 212483  	        LD    HL,MSGBYE
817C: CDA981  	        CALL  PRINT
817F: C9      	        RET
              	
              	; ---------------------------------------------------------
              	; CSLOW / CSHIGH - controla CS mantendo os demais bits de OUTSTATE
              	; ---------------------------------------------------------
8180:         	CSLOW:
8180: 3A2D82  	        LD    A,(OUTSTATE)
8183: E6FB    	        AND   ~M_CS & $FF
8185: 322D82  	        LD    (OUTSTATE),A
8188: D3C0    	        OUT   (PORTC0),A
818A: C9      	        RET
              	
818B:         	CSHIGH:
818B: 3A2D82  	        LD    A,(OUTSTATE)
818E: F604    	        OR    M_CS
8190: 322D82  	        LD    (OUTSTATE),A
8193: D3C0    	        OUT   (PORTC0),A
8195: CD1C82  	        CALL  SCKPULSE
8198: C9      	        RET
              	
8199:         	HEXOUT:
8199: C5      		push bc
819A: D5      		push de
819B: E5      		push hl
819C: CD8701  		call sendRegToLCD
819F: E1      		pop hl
81A0: D1      		pop de
81A1: C1      		pop bc
81A2: C9      		ret
              	
81A3:         	TXCRLF:
81A3: F5      		push af
81A4: 3E0D    		ld a, 13
81A6: CF      		rst $08
81A7: F1      		pop af
81A8: C9      		ret
              	
              	
              	
81A9:         	PRINT:
81A9: F5      		push af
81AA: C5      		push bc 
81AB: D5      		push de
81AC: E5      		push hl
81AD: E5      		push hl
81AE: D1      		pop de
81AF: 3E00    		LD A, 0
81B1: CD8401  		call sendStringToLCD
81B4: E1      		pop hl
81B5: D1      		pop de
81B6: C1      		pop bc
81B7: F1      		pop af
81B8: C9      		ret
              	
              	
              	
              	
              	
              	
              	; ---------------------------------------------------------
              	; SENDCMD - envia comando SD de 6 bytes apontado por HL
              	; ---------------------------------------------------------
81B9:         	SENDCMD:
81B9: 0606    	        LD    B,6
81BB:         	SCLOOP:
81BB: 7E      	        LD    A,(HL)
81BC: CDCE81  	        CALL  SPISEND
81BF: 23      	        INC   HL
81C0: 10F9    	        DJNZ  SCLOOP
81C2: C9      	        RET
              	
              	; ---------------------------------------------------------
              	; READR1 - espera resposta R1 (bit7=0), timeout em B
              	; retorna valor em A
              	; ---------------------------------------------------------
81C3:         	READR1:
81C3: 06FF    	        LD    B,$FF
81C5:         	RR1LOOP:
81C5: CDF681  	        CALL  SPIRECV
81C8: CB7F    	        BIT   7,A
81CA: C8      	        RET   Z
81CB: 10F8    	        DJNZ  RR1LOOP
81CD: C9      	        RET                    ; timeout: retorna ultimo valor lido ($FF = sem resposta)
              	
              	; ---------------------------------------------------------
              	; SPISEND - envia byte A via bit-bang (MSB first)
              	; NOPs adicionados para desacelerar o clock (fase de init)
              	; ---------------------------------------------------------
81CE:         	SPISEND:
81CE: C5      	        PUSH  BC
81CF: 4F      	        LD    C,A
81D0: 0608    	        LD    B,8
81D2:         	SSLOOP:
81D2: 3A2D82  	        LD    A,(OUTSTATE)
81D5: E6FD    	        AND   ~M_MOSI & $FF
81D7: CB01    	        RLC   C
81D9: 3002    	        JR    NC,SSNOBIT
81DB: F602    	        OR    M_MOSI
81DD:         	SSNOBIT:
81DD: D3C0    	        OUT   (PORTC0),A       ; MOSI valido, SCK=0
81DF: 00      	        NOP
81E0: 00      	        NOP
81E1: F601    	        OR    M_SCK
81E3: D3C0    	        OUT   (PORTC0),A       ; sobe SCK (dado e' amostrado)
81E5: 00      	        NOP
81E6: 00      	        NOP
81E7: E6FE    	        AND   ~M_SCK & $FF
81E9: D3C0    	        OUT   (PORTC0),A       ; desce SCK
81EB: 00      	        NOP
81EC: 00      	        NOP
81ED: 10E3    	        DJNZ  SSLOOP
81EF: 3A2D82  	        LD    A,(OUTSTATE)
81F2: D3C0    	        OUT   (PORTC0),A       ; restaura estado (MOSI=1, CS mantido)
81F4: C1      	        POP   BC
81F5: C9      	        RET
              	
              	; ---------------------------------------------------------
              	; SPIRECV - le um byte via bit-bang (MSB first), MOSI=1 (0xFF)
              	; NOPs adicionados para desacelerar o clock (fase de init)
              	; retorna byte em A
              	; ---------------------------------------------------------
81F6:         	SPIRECV:
81F6: C5      	        PUSH  BC
81F7: 1600    	        LD    D,0
81F9: 0608    	        LD    B,8
81FB:         	SRLOOP:
81FB: 3A2D82  	        LD    A,(OUTSTATE)
81FE: F601    	        OR    M_SCK
8200: D3C0    	        OUT   (PORTC0),A       ; sobe SCK
8202: 00      	        NOP
8203: 00      	        NOP
8204: DBC0    	        IN    A,(PORTC0)
8206: E601    	        AND   M_MISO
8208: 2803    	        JR    Z,SRZERO
820A: 37      	        SCF
820B: 1801    	        JR    SRSHIFT
820D:         	SRZERO:
820D: B7      	        OR    A
820E:         	SRSHIFT:
820E: CB12    	        RL    D
8210: 3A2D82  	        LD    A,(OUTSTATE)
8213: D3C0    	        OUT   (PORTC0),A       ; desce SCK
8215: 00      	        NOP
8216: 00      	        NOP
8217: 10E2    	        DJNZ  SRLOOP
8219: 7A      	        LD    A,D
821A: C1      	        POP   BC
821B: C9      	        RET
              	
              	; ---------------------------------------------------------
              	; SCKPULSE - um pulso de clock com o estado atual de saida
              	; NOPs adicionados para desacelerar o clock (fase de init)
              	; ---------------------------------------------------------
821C:         	SCKPULSE:
821C: 3A2D82  	        LD    A,(OUTSTATE)
821F: F601    	        OR    M_SCK
8221: D3C0    	        OUT   (PORTC0),A
8223: 00      	        NOP
8224: 00      	        NOP
8225: 3A2D82  	        LD    A,(OUTSTATE)
8228: D3C0    	        OUT   (PORTC0),A
822A: 00      	        NOP
822B: 00      	        NOP
822C: C9      	        RET
              	
