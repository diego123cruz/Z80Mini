              	;#include "../../Z80MiniAPI.asm"
              	
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	; ============================================================
              	; MINI-ASSEMBLER DE LINHA - Z80Mini
              	; ------------------------------------------------------------
              	; Digite mnemonicos Z80 linha a linha (estilo Apple 1 / KIM-1).
              	; Nao usa labels/forward refs: JR e DJNZ recebem o ENDERECO
              	; ALVO ($nnnn) e o proprio codigo calcula o deslocamento.
              	;
              	; Cobertura desta v1:
              	;   LD (todas as formas de 8/16 bits abaixo), ALU (ADD/ADC/SUB/
              	;   SBC/AND/XOR/OR/CP reg8 e imediato), INC/DEC r/rp, ADD HL,rp,
              	;   JP/JP cc/JP (HL), JR/JR cc, DJNZ, CALL/CALL cc, RET/RET cc,
              	;   PUSH/POP, IN A,(n) / OUT (n),A, EX DE,HL / EX AF,AF' / EXX,
              	;   HALT/NOP/DI/EI/DAA/CPL/SCF/CCF/RLCA/RRCA/RLA/RRA
              	;
              	; NAO implementado nesta v1 (fica facil de estender depois):
              	;   instrucoes prefixadas CB (bit/set/res/rot em geral),
              	;   ED (LD (nn),rp / LDIR / etc), e modos indexados IX/IY.
              	;
              	; IMPORTANTE: ajuste o bloco "I/O DO MONITOR" abaixo para
              	; apontar para as rotinas reais da sua jump table em $0100.
              	; Este arquivo NAO foi montado/testado num assembler real
              	; (ambiente sem zasm) - revise a montagem antes de gravar na EEPROM.
              	; ============================================================
              	
8000:         	        ORG     8000h
              	
              	; ---- I/O DO MONITOR (AJUSTE AQUI) ----
0319:         	CONIN	EQU		$0319
0447:         	CRLF	EQU		$0447
              	
              	; PUTCHAR: imprime o caractere em A
042B:         	PUTCHAR EQU     $042B
              	; PUTSTR: imprime string terminada em 0 apontada por HL
0437:         	PUTSTR  EQU     $0437
              	
0028:         	LINEMAX EQU     40              ; tamanho maximo de uma linha digitada
              	
              	; ============================================================
              	; PONTO DE ENTRADA
              	; HL = endereco inicial de montagem (default $8000 se chamado direto)
              	; ============================================================
8000:         	ASMSTART:
8000: 210090  	        LD      HL,9000h        ; endereco default; troque se quiser
              	                                 ; pedir o endereco ao usuario aqui
8003: 229588  	        LD      (CURADDR),HL
8006:         	ASMLOOP:
8006: CDB180  	        CALL    PRINTADDR       ; imprime "AAAA: " usando (CURADDR)
              	
8009: 11A088  	        LD      DE,LINEBUF
800C: 0628    	        LD      B,LINEMAX
800E: CD4F80  	        CALL    GETLINE         ; A = tamanho lido, LINEBUF = texto
8011: B7      	        OR      A
8012: 283A    	        JR      Z,ASMDONE       ; linha vazia -> sai do assembler
              	
8014: 4F      	        LD      C,A             ; C = tamanho da linha
8015: CDE280  	        CALL    UPCASE_LINE     ; converte para maiusculas
              	
8018: 21A088  	        LD      HL,LINEBUF
801B: CDF980  	        CALL    SKIPSPACES
801E: CD0081  	        CALL    READMNEMONIC    ; DE=MNEBUF, A=tamanho do mnemonico
8021: B7      	        OR      A
8022: 28E2    	        JR      Z,ASMLOOP       ; linha so com espacos -> ignora (nao mexe em CURADDR)
              	
8024: 229788  	        LD      (LINEPTR),HL    ; salva o resto da linha ANTES de FINDMNEMONIC
              	                                 ; reaproveitar HL para varrer a MNETAB
8027: CD5A81  	        CALL    FINDMNEMONIC    ; procura em MNETAB
802A: 381A    	        JR      C,ASMBADOP      ; nao achou -> erro
              	
              	        ; HL aponta para a entrada da tabela; IX = ponteiro pro handler
802C: CD8281  	        CALL    CALLHANDLER     ; handler consome o resto da linha,
              	                                 ; emite bytes em EMITBUF, retorna
              	                                 ; B = quantidade de bytes emitidos
              	                                 ; carry set = erro de sintaxe/operando
802F: 3815    	        JR      C,ASMBADOP
              	
              	        ; grava os bytes emitidos a partir de CURADDR
8031: 2A9588  	        LD      HL,(CURADDR)
8034: 11D388  	        LD      DE,EMITBUF
8037: 78      	        LD      A,B
8038: B7      	        OR      A
8039: 28CB    	        JR      Z,ASMLOOP       ; 0 bytes emitidos (nao deveria ocorrer)
803B:         	EMITCOPY:
803B: 1A      	        LD      A,(DE)
803C: 77      	        LD      (HL),A
803D: 23      	        INC     HL
803E: 13      	        INC     DE
803F: 10FA    	        DJNZ    EMITCOPY
8041: 229588  	        LD      (CURADDR),HL    ; atualiza o endereco corrente (unico lugar que avanca)
8044: 18C0    	        JR      ASMLOOP
              	
8046:         	ASMBADOP:
8046: 21D788  	        LD      HL,MSGERR
8049: CD3704  	        CALL    PUTSTR
804C: 18B8    	        JR      ASMLOOP         ; nao mexe em CURADDR
              	
804E:         	ASMDONE:
804E: C9      	        RET
              	        
              	        
              	        
              	        
              	        
              	        
              	
              	
              	; GETLINE: le uma linha ate CR em (DE), tamanho max B, retorna
              	;          tamanho lido em A. Deve ecoar os caracteres digitados
              	;          e tratar backspace. Troque pelo endereco real da sua
              	;          rotina de leitura de linha na jump table.
              	
              	; --- GETLINE: Lê linha para LINEBUF; eco local ---
              	;     Termina em CR. Suporta BS/DEL para apagar.
804F:         	GETLINE:
804F: 626B    	            LD   HL, DE
8051: 1600    	            LD 	 D, 0
8053:         	GETLINE_LOOP:
8053: CD1903  	            CALL CONIN
8056: FE0D    	            CP   CR
8058: 2850    	            JR   Z, GETLINE_DONE
805A: FEF8    	            CP   $F8    ; ignora scroll up - GLCD
805C: 28F5    	            JR   Z, GETLINE_LOOP
805E: FEF7    	            CP   $F7    ; ignora scroll down - GLCD
8060: 28F1    	            JR   Z, GETLINE_LOOP
8062: FE0A    	            CP   LF
8064: 28ED    	            JR   Z, GETLINE_LOOP    ; Ignora LF
8066: FE1B    	            CP   ESC
8068: 28E9    	            JR   Z, GETLINE_LOOP    ; Ignora
806A: FEFF    	            CP   $FF ;capslock Ignora
806C: CA5380  	            JP   Z, GETLINE_LOOP
806F: FE08    	            CP   BkS
8071: 281E    	            JR   Z, GETLINE_BS
8073: FE7F    	            CP   DEL
8075: 281A    	            JR   Z, GETLINE_BS
8077: FEFA    	            CP   $FA ; AltGr
8079: CA5380  	            JP   Z, GETLINE_LOOP
807C: FEF9    	            CP   $F9 ; LUZ
807E: CA5380  	            JP   Z, GETLINE_LOOP
8081: 4F      	            LD   C, A
8082: 78      	            LD   A, B
8083: FE00    	            CP   0
8085: 28CC    	            JR   Z, GETLINE_LOOP    ; Buffer cheio
8087: 79      	            LD   A, C
8088: 77      	            LD   (HL), A
8089: 23      	            INC  HL
808A: 05      	            DEC  B
808B: 14      	            INC  D
808C: CD2B04  	            CALL PUTCHAR             ; Eco
808F: 18C2    	            JR   GETLINE_LOOP
8091:         	GETLINE_BS:
8091: 78      	            LD   A, B
8092: FE4F    	            CP   79
8094: 28BD    	            JR   Z, GETLINE_LOOP    ; Início: ignora BS
8096: 2B      	            DEC  HL
8097: 04      	            INC  B
8098: 15      	            DEC  D
8099: 3E08    	            LD   A, BkS
809B: CD2B04  	            CALL PUTCHAR
809E: 3E20    	            LD   A, SPACE
80A0: CD2B04  	            CALL PUTCHAR
80A3: 3E08    	            LD   A, BkS
80A5: CD2B04  	            CALL PUTCHAR
80A8: 18A9    	            JR   GETLINE_LOOP
80AA:         	GETLINE_DONE:
80AA: 3600    	            LD   (HL), NUL           ; Termina string
80AC: CD4704  	            CALL CRLF
80AF: 7A      	            LD A, D
80B0: C9      	            RET   
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	
              	; ------------------------------------------------------------
80B1:         	PRINTADDR:
80B1: 2A9588  	        LD      HL,(CURADDR)
80B4: CDC280  	        CALL    PRINTHEX16
80B7: 3E3A    	        LD      A,':'
80B9: CD2B04  	        CALL    PUTCHAR
80BC: 3E20    	        LD      A,' '
80BE: CD2B04  	        CALL    PUTCHAR
80C1: C9      	        RET
              	
              	; Imprime HL em hex, 4 digitos maiusculos
80C2:         	PRINTHEX16:
80C2: 7C      	        LD      A,H
80C3: CDCB80  	        CALL    PRINTHEX8
80C6: 7D      	        LD      A,L
80C7: CDCB80  	        CALL    PRINTHEX8
80CA: C9      	        RET
80CB:         	PRINTHEX8:
80CB: F5      	        PUSH    AF
80CC: 1F      	        RRA
80CD: 1F      	        RRA
80CE: 1F      	        RRA
80CF: 1F      	        RRA
80D0: CDD480  	        CALL    PRINTNIBBLE
80D3: F1      	        POP     AF
80D4:         	PRINTNIBBLE:
80D4: E60F    	        AND     0Fh
80D6: FE0A    	        CP      0Ah
80D8: 3802    	        JR      C,PN_DIGIT
80DA: C607    	        ADD     A,'A'-'9'-1
80DC:         	PN_DIGIT:
80DC: C630    	        ADD     A,'0'
80DE: CD2B04  	        CALL    PUTCHAR
80E1: C9      	        RET
              	
              	; ------------------------------------------------------------
              	; Converte LINEBUF (C bytes) para maiusculas
80E2:         	UPCASE_LINE:
80E2: 21A088  	        LD      HL,LINEBUF
80E5: 41      	        LD      B,C
80E6: 78      	        LD      A,B
80E7: B7      	        OR      A
80E8: C8      	        RET     Z
80E9:         	UPC1:
80E9: 7E      	        LD      A,(HL)
80EA: FE61    	        CP      'a'
80EC: 3807    	        JR      C,UPC2
80EE: FE7B    	        CP      'z'+1
80F0: 3003    	        JR      NC,UPC2
80F2: D620    	        SUB     20h
80F4: 77      	        LD      (HL),A
80F5:         	UPC2:
80F5: 23      	        INC     HL
80F6: 10F1    	        DJNZ    UPC1
80F8: C9      	        RET
              	
              	; Pula espacos a partir de (HL)
80F9:         	SKIPSPACES:
80F9: 7E      	        LD      A,(HL)
80FA: FE20    	        CP      ' '
80FC: C0      	        RET     NZ
80FD: 23      	        INC     HL
80FE: 18F9    	        JR      SKIPSPACES
              	
              	; Le o MNEMONICO a partir de (HL): igual READTOKEN mas tambem para
              	; em '(' (sem consumir), para aceitar "OUT(10),A" sem espaco antes
              	; do parenteses. Operandos continuam usando READTOKEN normal.
              	; Nao usa B/C (varios chamadores guardam estado em B entre uma
              	; chamada e outra - ex.: porta em OUT, condicao em JP/JR/CALL cc).
8100:         	READMNEMONIC:
8100: 11CA88  	        LD      DE,MNEBUF
8103: AF      	        XOR     A
8104: 329D88  	        LD      (TOKLEN),A      ; contador em memoria, nao em B
8107:         	RM1:
8107: 7E      	        LD      A,(HL)
8108: B7      	        OR      A
8109: 281E    	        JR      Z,RM_END
810B: FE0D    	        CP      13
810D: 281A    	        JR      Z,RM_END
810F: FE20    	        CP      ' '
8111: 2816    	        JR      Z,RM_END
8113: FE2C    	        CP      ','
8115: 2812    	        JR      Z,RM_END
8117: FE28    	        CP      '('
8119: 280E    	        JR      Z,RM_END
811B: 12      	        LD      (DE),A
811C: 13      	        INC     DE
811D: 23      	        INC     HL
811E: 3A9D88  	        LD      A,(TOKLEN)
8121: 3C      	        INC     A
8122: 329D88  	        LD      (TOKLEN),A
8125: FE08    	        CP      8
8127: 38DE    	        JR      C,RM1
8129:         	RM_END:
8129: AF      	        XOR     A
812A: 12      	        LD      (DE),A
812B: 3A9D88  	        LD      A,(TOKLEN)
812E: C9      	        RET
              	
              	; Le um token (letras/digitos/$/(/)/+/-) a partir de (HL) ate achar
              	; espaco, virgula ou CR/0. Copia para MNEBUF (max 8 chars), poe 0
              	; no final. Retorna A = tamanho, HL aponta pro delimitador.
              	; Nao usa B/C (mesmo motivo do READMNEMONIC acima).
812F:         	READTOKEN:
812F: 11CA88  	        LD      DE,MNEBUF
8132: AF      	        XOR     A
8133: 329D88  	        LD      (TOKLEN),A      ; contador em memoria, nao em B
8136:         	RT1:
8136: 7E      	        LD      A,(HL)
8137: B7      	        OR      A
8138: 281A    	        JR      Z,RT_END
813A: FE0D    	        CP      13
813C: 2816    	        JR      Z,RT_END
813E: FE20    	        CP      ' '
8140: 2812    	        JR      Z,RT_END
8142: FE2C    	        CP      ','
8144: 280E    	        JR      Z,RT_END
8146: 12      	        LD      (DE),A
8147: 13      	        INC     DE
8148: 23      	        INC     HL
8149: 3A9D88  	        LD      A,(TOKLEN)
814C: 3C      	        INC     A
814D: 329D88  	        LD      (TOKLEN),A
8150: FE08    	        CP      8
8152: 38E2    	        JR      C,RT1
8154:         	RT_END:
8154: AF      	        XOR     A
8155: 12      	        LD      (DE),A
8156: 3A9D88  	        LD      A,(TOKLEN)
8159: C9      	        RET
              	
              	; ------------------------------------------------------------
              	; Procura MNEBUF em MNETAB. Cada entrada: 4 bytes de nome
              	; (preenchido com 0), 2 bytes ponteiro pro handler, 1 byte
              	; parametro (ex: numero da operacao ALU / opcode fixo).
              	; Retorna: HL = ponteiro pra entrada (nome), carry=1 se nao achou.
815A:         	FINDMNEMONIC:
815A: 21A087  	        LD      HL,MNETAB
815D:         	FM1:
815D: 7E      	        LD      A,(HL)
815E: B7      	        OR      A
815F: 281F    	        JR      Z,FM_NOTFOUND   ; entrada com nome vazio = fim da tabela
8161: E5      	        PUSH    HL
8162: 11CA88  	        LD      DE,MNEBUF
8165: 0604    	        LD      B,4
8167:         	FM2:
8167: 1A      	        LD      A,(DE)
8168: BE      	        CP      (HL)
8169: 200B    	        JR      NZ,FM_NEXT
816B: B7      	        OR      A
816C: 2806    	        JR      Z,FM_MATCHCHK   ; bateu 0 nos dois -> confere resto
816E: 23      	        INC     HL
816F: 13      	        INC     DE
8170: 10F5    	        DJNZ    FM2
8172: 1809    	        JR      FM_MATCH        ; 4 chars bateram e nao houve 0 -> ok
8174:         	FM_MATCHCHK:
8174: 1807    	        JR      FM_MATCH
8176:         	FM_NEXT:
8176: E1      	        POP     HL
8177: 110700  	        LD      DE,7            ; 4 (nome) + 2 (ptr) + 1 (param)
817A: 19      	        ADD     HL,DE
817B: 18E0    	        JR      FM1
817D:         	FM_MATCH:
817D: E1      	        POP     HL
817E: B7      	        OR      A               ; carry = 0
817F: C9      	        RET
8180:         	FM_NOTFOUND:
8180: 37      	        SCF
8181: C9      	        RET
              	
              	; Chama o handler da entrada apontada por HL (nome de 4 bytes,
              	; +4 = ponteiro do handler, +6 = byte de parametro).
              	; O resto da linha (apos o mnemonico) e recuperado de LINEPTR,
              	; que o ASMLOOP grava logo depois do READTOKEN do mnemonico
              	; (antes de HL ser reaproveitado por FINDMNEMONIC).
8182:         	CALLHANDLER:
8182: E5      	        PUSH    HL
8183: 110400  	        LD      DE,4
8186: 19      	        ADD     HL,DE
8187: 5E      	        LD      E,(HL)
8188: 23      	        INC     HL
8189: 56      	        LD      D,(HL)          ; DE = endereco do handler
818A: 23      	        INC     HL
818B: 4E      	        LD      C,(HL)          ; C = byte de parametro (ex: op ALU)
818C: E1      	        POP     HL              ; (descarta o ponteiro da tabela)
818D: 2A9788  	        LD      HL,(LINEPTR)    ; HL = resto da linha, apos o mnemonico
8190: D5      	        PUSH    DE              ; empilha o ENDERECO DO HANDLER
8191: C9      	        RET                     ; "salta" pro handler; o RET dele volta
              	                                 ; pro chamador original de CALLHANDLER,
              	                                 ; pois o proprio endereco de retorno da
              	                                 ; CALL CALLHANDLER continua embaixo na pilha
              	
              	; ============================================================
              	; HANDLERS
              	; Convencao: entrada HL = ponto da linha logo apos o mnemonico
              	; (ainda pode ter espacos antes do operando). C = parametro da
              	; tabela. Saida: B = bytes emitidos em EMITBUF, carry=1 se erro.
              	; Todos preservam a pilha (fazem RET normal).
              	; ============================================================
              	
              	; ---- instrucoes sem operando, opcode fixo em C ----
8192:         	H_SIMPLE:
8192: 79      	        LD      A,C
8193: 32D388  	        LD      (EMITBUF),A
8196: 0601    	        LD      B,1
8198: B7      	        OR      A
8199: C9      	        RET
              	
              	; ---- HALT precisa ser tratado como H_SIMPLE tambem (opcode 76h) ----
              	
              	; ---- ALU: <MNE> A,r | <MNE> A,n | <MNE> r | <MNE> n ----
              	; C = numero da operacao ALU (0=ADD 1=ADC 2=SUB 3=SBC 4=AND 5=XOR 6=OR 7=CP)
819A:         	H_ALU:
819A: CDF980  	        CALL    SKIPSPACES
819D: CD2F81  	        CALL    READTOKEN       ; DE/MNEBUF = primeiro operando
81A0: 3ACA88  	        LD      A,(MNEBUF)
81A3: FE41    	        CP      'A'
81A5: 200C    	        JR      NZ,ALU_NOTA     ; nao comecou com "A," -> e o unico operando
81A7: 3ACB88  	        LD      A,(MNEBUF+1)
81AA: B7      	        OR      A
81AB: 2006    	        JR      NZ,ALU_NOTA     ; token era "A" mesmo (nao "AB" etc)
              	        ; consumiu "A,"; le o operando real
81AD: CDF980  	        CALL    SKIPSPACES
81B0: CD2F81  	        CALL    READTOKEN
81B3:         	ALU_NOTA:
81B3: CD5985  	        CALL    CLASSIFY_R_OR_N
81B6: 3823    	        JR      C,ALU_ERR
81B8: 2812    	        JR      Z,ALU_ISREG
              	        ; imediato: opcode = C6 + (op<<3), byte = A
81BA: 47      	        LD      B,A             ; guarda imediato
81BB: 79      	        LD      A,C
81BC: 07      	        RLCA
81BD: 07      	        RLCA
81BE: 07      	        RLCA
81BF: C6C6    	        ADD     A,0C6h
81C1: 32D388  	        LD      (EMITBUF),A
81C4: 78      	        LD      A,B
81C5: 32D488  	        LD      (EMITBUF+1),A
81C8: 0602    	        LD      B,2
81CA: B7      	        OR      A
81CB: C9      	        RET
81CC:         	ALU_ISREG:
              	        ; registrador em A (codigo 0-7)
81CC: 47      	        LD      B,A
81CD: 79      	        LD      A,C
81CE: 07      	        RLCA
81CF: 07      	        RLCA
81D0: 07      	        RLCA
81D1: C680    	        ADD     A,80h
81D3: 80      	        ADD     A,B
81D4: 32D388  	        LD      (EMITBUF),A
81D7: 0601    	        LD      B,1
81D9: B7      	        OR      A
81DA: C9      	        RET
81DB:         	ALU_ERR:
81DB: 37      	        SCF
81DC: C9      	        RET
              	
              	; ---- LD (a mais complexa) ----
              	; Trata: LD r,r | LD r,n | LD rp,nn | LD (HL),n | LD A,(BC/DE/nn)
              	;        LD (BC/DE/nn),A | LD HL,(nn) | LD (nn),HL | LD SP,HL
81DD:         	H_LD:
81DD: CDF980  	        CALL    SKIPSPACES
81E0: CD2F81  	        CALL    READTOKEN       ; primeiro operando -> MNEBUF; HL fica no delimitador
81E3: CDBF86  	        CALL    CLASSIFY_DEST   ; classifica destino: retorna tipo em A (preserva HL)
              	                                 ; 0=reg8 1=reg16 2=(HL)ja incluso em reg8
              	                                 ; 3=(BC) 4=(DE) 5=(nn)
              	        ; guarda tipo/valor do destino
81E6: 329988  	        LD      (LD_DSTTYPE),A
81E9: ED439A88	        LD      (LD_DSTVAL),BC  ; BC = valor (reg code) ou endereco, conforme tipo
              	
              	        ; pula a virgula
81ED: CD1787  	        CALL    SKIPTOCOMMA
81F0: DAFC82  	        JP      C,LD_ERR
81F3: CDF980  	        CALL    SKIPSPACES
81F6: CD2F81  	        CALL    READTOKEN       ; segundo operando
              	
81F9: 3A9988  	        LD      A,(LD_DSTTYPE)
81FC: FE00    	        CP      0
81FE: CA1882  	        JP      Z,LD_DST_REG8
8201: FE01    	        CP      1
8203: CA5282  	        JP      Z,LD_DST_REG16
8206: FE03    	        CP      3
8208: CA9182  	        JP      Z,LD_DST_INDBC
820B: FE04    	        CP      4
820D: CAA782  	        JP      Z,LD_DST_INDDE
8210: FE05    	        CP      5
8212: CABD82  	        JP      Z,LD_DST_INDNN
8215: C3FC82  	        JP      LD_ERR
              	
8218:         	LD_DST_REG8:
              	        ; segundo operando: reg8, (HL) ja coberto por CLASSIFY_R_OR_N, ou imediato
              	        ; NAO guardamos o destino em D antes desta chamada: CLASSIFY_R_OR_N
              	        ; pode cair em PARSEDEC16FROM/PARSEHEX16FROM, que usam DE inteiro
              	        ; como acumulador e destruiriam D. Relemos LD_DSTVAL da memoria
              	        ; sempre que precisamos do destino, depois da chamada.
8218: CD5985  	        CALL    CLASSIFY_R_OR_N
821B: DAFC82  	        JP      C,LD_ERR
821E: CA3582  	        JP      Z,LD_REG8_REG
