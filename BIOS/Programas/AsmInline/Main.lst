              	; --------------------------------------
              	; zasm: assemble "Main.asm"
              	; date: 2026-08-20 21:56:35
              	; --------------------------------------


              	#include "../Z80MiniAPI.asm"
              	;   API Z80Mini:
0100:         	delay500ms          equ     0x0100  ;   Delay 500ms
0103:         	delay               equ     0x0103  ;   On entry: DE = Delay time in milliseconds
0106:         	I2C_Open            equ     0x0106  ;   On entry: A = Device address (bit zero is read flag)
0109:         	I2C_Close           equ     0x0109  ;   Close
010C:         	I2C_Read            equ     0x010C  ;   On exit: If successful A = data byte and Z flagged
010F:         	I2C_Write           equ     0x010F  ;   On entry: A = Data byte, or Address byte (bit zero is read flag)
0112:         	keyboardIsEsc       equ     0x0112  ;   Verifica se ESC foi precionada. On exit: If press A = CTRLC and NZ flagged
0115:         	keyboardWaitA       equ     0x0115  ;   Aguarda tecla, letra em A. (BC DE HL preserved)
0118:         	keyboardA           equ     0x0118  ;   Lê teclado, Se tecla Carry=1. Letra em A. (BC DE HL preserved)
011B:         	setDefaultSerialA   equ     0x011B  ;   Seta terminal padrao porta A, Quando reinicia volta para A.
011E:         	setDefaultSerialB   equ     0x011E  ;   Seta terminal padrao porta B (P2), Quando reinicia volta para A.
0121:         	serialPrintA        equ     0x0121  ;   Imprime char in A no terminal setado.
0124:         	serialInputA        equ     0x0124  ;   Aguarda receber char no terminal setado. Retorno em A.
0127:         	serialPrintStr      equ     0x0127  ;   Imprime string (HL) terminado em 0 no terminal setado. MAX 128 chars. MODIFIES : A,B,C
012A:         	serialCRLF          equ     0x012A  ;   Imprime CR e LF no terminal setado.
012D:         	serialHexA          equ     0x012D  ;   Imprime byte em A no formato HEX, no terminal setado. Ex: 'D' = 44
0130:         	serialHexHL         equ     0x0130  ;   Imprime HL como 4 digitos hexadecimais, no terminal setado. Ex: HL=$80FF -> imprime "80FF"
0133:         	serialInHexA        equ     0x0133  ;   Pegar 2 caracteres ASCII (0-9 A-F), do terminal setado e converte em um byte em A. SEM ECHO
0136:         	serialInHexHL       equ     0x0136  ;   Pegar 4 caracteres ASCII (0-9 A-F), do terminal setado e converte em HL. SEM ECHO
              	
0139:         	initLCD             equ     0x0139  ;   Inicializa GLCD
013C:         	clearGBUF           equ     0x013C  ;   Limpa buffer da memoria de grafico. Precisa do plotToLCD para refletir no lcd.
013F:         	clearGrLCD          equ     0x013F  ;   Limpa memoria grafico do GLCD. Sem o plotToLCD.
0142:         	clearTxtLCD         equ     0x0142  ;   Limpar caracteres do LCD
0145:         	setGrMode           equ     0x0145  ;   Seta modo Grafico. 128x64
0148:         	setTxtMode          equ     0x0148  ;   Seta mode Text. 16x4 equivalente
014B:         	drawBox             equ     0x014B  ;   Desenha caixa. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
014E:         	drawLine            equ     0x014E  ;   Desenha linha.  Entradas: BC = X0,Y0 - DE = X1,Y1
0151:         	drawCircle          equ     0x0151  ;   Desenha circulo. Entradas BC = xm,ym (Ponro do Meio) - E = radius
0154:         	drawPixel           equ     0x0154  ;   Desenha um pixel em X Y.  Entrada B = column/X (0-127), C = row/Y (0-63)   Destroys: HL
0157:         	fillBox             equ     0x0157  ;   Desenha caixa preenchida. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
015A:         	fillCircle          equ     0x015A  ;   Desenha circulo preenchido. Entradas BC = xm,ym (Ponro do Meio) - E = radius
015D:         	plotToLCD           equ     0x015D  ;   Rotina principal de desenho. Move GBUF para o LCD e limpa o buffer ou não (setBufClear, setBufNoClear).  Destroys: ALL
0160:         	printString         equ     0x0160  ;   Imprimir texto ASCII em uma determinada linha. Entradas: A = 0 a 3 Número da linha. .db "String" na próxima linha, terminar com 0
0163:         	printChars          equ     0x0163  ;   (Ver detalhes) Imprimir caracteres na posição X,Y. Entrada B = coluna/X (0-7), C = linha/Y (0-3). HL = Endereço inicial do texto a ser exibido, termina com 0
0166:         	setInt38            equ     0x0166  ;   Seta vetor de interrupcao int38. Entradas HL = RST38_ADDR
0169:         	setint66            equ     0x0169  ;   Seta vetor de interrupcao int66. Entradas HL = RST66_ADDR
016C:         	setBufClear         equ     0x016C  ;   Configura limpeza do buffer após a saída para o LCD e vai para clearGBUF.
016F:         	setBufNoClear       equ     0x016F  ;   Configura para não limpar o buffer após a saída para o LCD.
0172:         	clearPixel          equ     0x0172  ;   Limpa um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0175:         	flipPixel           equ     0x0175  ;   Inverte um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0178:         	drawGraphic         equ     0x0178  ;   Desenha no buffer. Entrada: A = número ASCII ou se A=0 Então  HL = Endereço dos dados gráficos. B = (MULTIPLO DE 8) largura do gráfico em pixels (1-128). C = altura do gráfico em pixels (1-64). Destroy: ALL
017B:         	invGraphic          equ     0x017B  ;   Altera a flag de desenho inverso. (não inverte grafico atual) Destroy A
017E:         	initTerminal        equ     0x017E  ;   Inicializa o Terminal GLCD. Cursor 0,0 e limpa buffer.
0181:         	sendCharToLCD       equ     0x0181  ;   Envia ou manipula caracteres ASCII para a tela GLCD (Terminal). Entrada: A = caractere ASCII a ser enviado para a tela GLCD. A = somente cursor desenhado.
0184:         	sendStringToLCD     equ     0x0184  ;   Imprime string no terminal GLCD. DE = inicio da string. A = caractere para parar a impressão. A impressão para e retorna quando um CR é impresso. Destroy ALL
0187:         	sendRegToLCD        equ     0x0187  ;   Imprime byte em A no formato HEX, no GLCD. Ex: 'D' = 44
018A:         	sendHLToLCD         equ     0x018A  ;   Imprime HL como 4 digitos hexadecimais, no GLCD. Ex: HL=$80FF -> imprime "80FF"
018D:         	setCursor           equ     0x018D  ;   Define a posição do cursor gráfico. Entradas: BC = X,Y onde X = 0..127, Y = 0..63   Destroy A
0190:         	getCursor           equ     0x0190  ;   Obter a posição do cursor. Saídas: BC = X,Y onde X = 0..127, Y = 0..63
0193:         	displayCursor       equ     0x0193  ;   Exibir Cursor. Entrada: A = 0, Ativar cursor, A = diferente de zero, Desativar cursor.
0196:         	autoLF              equ     0x0196  ;   Avanço de linha automático quando o cursor atinge o final da linha (Terminal). Entrada: A = 0, Avanço de linha automático; A = diferente de zero, Sem avanço de linha automático. Padrao LIGADO.
0199:         	underline           equ     0x0199  ;   Exibir sublinhado no caractere (Terminal). O estado inicial é sem sublinhado. Chamar esta rotina irá ALTERAR/DESLIGAR o sinalizador de sublinhado.
019C:         	plotAlways          equ     0x019C  ;   Quando sendCharToLCD é chamado, Atualiza GLCD ou não. Se Desativado plotToLCD deve ser chamado atualizar o GLCD. Entrada: A=0, Plotar sempre; A>0, Não plotar. O padrão é Plotar sempre.
019F:         	resetCollisionPixel equ     0x019F  ;   Limpa flag de colisao
01A2:         	checkCollisionPixel equ     0x01A2  ;   Check se um pixel ja estava ligado quando tenta ligar. JP Z, SEM_COLISAO. JP NZ, COLISAO.
1929:         	I2C_OpenRead        equ     0x1929  ;   I2C Open Read  (On entry: A = Device address)
192E:         	I2C_OpenWrite       equ     0x192E  ;   I2C Open Write (On entry: A = Device address)
              	
              	
              	
              	; -----------------------------------------------------------------------------
              	; PORTS
              	; -----------------------------------------------------------------------------
0070:         	GLCD_INST           .EQU    $70
0071:         	GLCD_DATA           .EQU    $71
              	
0040:         	KEYBOARD		    .EQU	$40
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capsloock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	
              	; -------- Constantes gerais --------
000D:         	CR:       EQU   0DH
000A:         	LF:       EQU   0AH
0008:         	BKS:      EQU   08H
007F:         	DEL:      EQU   7FH
001B:         	ESC:      EQU   1BH
0020:         	SPACE:    EQU   20H
0000:         	NUL:      EQU   00H
000C:         	FF:       EQU   0CH                 ; Form Feed -> Limpa lcd
              	
              	; -----------------------------------------------------------------------------
              	; SIO/2 - SERIAL
              	; -----------------------------------------------------------------------------
0000:         	SIOA_D:   EQU   $00
0002:         	SIOA_C:   EQU   $02
0001:         	SIOB_D:   EQU   $01   ; Conector P2
0003:         	SIOB_C:   EQU   $03   ; Conector P2
              	
              	
              	
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS         EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	; ============================================================
              	; MINI-ASSEMBLER DE LINHA - Z80Mini
              	; ------------------------------------------------------------
              	; Digite mnemonicos Z80 linha a linha (estilo Apple 1 / KIM-1).
              	; Nao usa labels/forward refs: JR e DJNZ recebem o ENDERECO
              	; ALVO ($nnnn) e o proprio codigo calcula o deslocamento.
              	;
              	; Cobertura desta v1:
              	;   LD (todas as formas de 8/16 bits abaixo), ALU (ADD/ADC/SUB/
              	;   SBC/AND/XOR/OR/CP reg8 e imediato), INC/DEC r/rp, ADD HL,rp,
              	;   JP/JP cc/JP (HL), JR/JR cc, DJNZ, CALL/CALL cc, RET/RET cc,
              	;   PUSH/POP, IN A,(n) / OUT (n),A, EX DE,HL / EX AF,AF' / EXX,
              	;   HALT/NOP/DI/EI/DAA/CPL/SCF/CCF/RLCA/RRCA/RLA/RRA
              	;
              	; NAO implementado nesta v1 (fica facil de estender depois):
              	;   instrucoes prefixadas CB (bit/set/res/rot em geral),
              	;   ED (LD (nn),rp / LDIR / etc), e modos indexados IX/IY.
              	;
              	; IMPORTANTE: ajuste o bloco "I/O DO MONITOR" abaixo para
              	; apontar para as rotinas reais da sua jump table em $0100.
              	; Este arquivo NAO foi montado/testado num assembler real
              	; (ambiente sem zasm) - revise a montagem antes de gravar na EEPROM.
              	; ============================================================
              	
8000:         		ORG     8000h
              	
0028:         	LINEMAX EQU     40              ; tamanho maximo de uma linha digitada
              	
              	; ============================================================
              	; PONTO DE ENTRADA
              	; HL = endereco inicial de montagem (default $8000 se chamado direto)
              	; ============================================================
8000:         	ASMSTART:
8000: 210090  	        LD      HL,9000h        ; endereco default; troque se quiser
              	                                 ; pedir o endereco ao usuario aqui
8003: 22C188  	        LD      (CURADDR),HL
8006:         	ASMLOOP:
8006: CDDD80  	        CALL    PRINTADDR       ; imprime "AAAA: " usando (CURADDR)
              	
8009: 11CC88  	        LD      DE,LINEBUF
800C: 0628    	        LD      B,LINEMAX
800E: CD7B80  	        CALL    GETLINE         ; A = tamanho lido, LINEBUF = texto
8011: B7      	        OR      A
8012: 283A    	        JR      Z,ASMDONE       ; linha vazia -> sai do assembler
              	
8014: 4F      	        LD      C,A             ; C = tamanho da linha
8015: CD0E81  	        CALL    UPCASE_LINE     ; converte para maiusculas
              	
8018: 21CC88  	        LD      HL,LINEBUF
801B: CD2581  	        CALL    SKIPSPACES
801E: CD2C81  	        CALL    READMNEMONIC    ; DE=MNEBUF, A=tamanho do mnemonico
8021: B7      	        OR      A
8022: 28E2    	        JR      Z,ASMLOOP       ; linha so com espacos -> ignora (nao mexe em CURADDR)
              	
8024: 22C388  	        LD      (LINEPTR),HL    ; salva o resto da linha ANTES de FINDMNEMONIC
              	                                 ; reaproveitar HL para varrer a MNETAB
8027: CD8681  	        CALL    FINDMNEMONIC    ; procura em MNETAB
802A: 381A    	        JR      C,ASMBADOP      ; nao achou -> erro
              	
              	        ; HL aponta para a entrada da tabela; IX = ponteiro pro handler
802C: CDAE81  	        CALL    CALLHANDLER     ; handler consome o resto da linha,
              	                                 ; emite bytes em EMITBUF, retorna
              	                                 ; B = quantidade de bytes emitidos
              	                                 ; carry set = erro de sintaxe/operando
802F: 3815    	        JR      C,ASMBADOP
              	
              	        ; grava os bytes emitidos a partir de CURADDR
8031: 2AC188  	        LD      HL,(CURADDR)
8034: 11FF88  	        LD      DE,EMITBUF
8037: 78      	        LD      A,B
8038: B7      	        OR      A
8039: 28CB    	        JR      Z,ASMLOOP       ; 0 bytes emitidos (nao deveria ocorrer)
803B:         	EMITCOPY:
803B: 1A      	        LD      A,(DE)
803C: 77      	        LD      (HL),A
803D: 23      	        INC     HL
803E: 13      	        INC     DE
803F: 10FA    	        DJNZ    EMITCOPY
8041: 22C188  	        LD      (CURADDR),HL    ; atualiza o endereco corrente (unico lugar que avanca)
8044: 18C0    	        JR      ASMLOOP
              	
8046:         	ASMBADOP:
8046: 210389  	        LD      HL,MSGERR
8049: CD6B80  	        CALL    PUTSTR
804C: 18B8    	        JR      ASMLOOP         ; nao mexe em CURADDR
              	
804E:         	ASMDONE:
804E: C9      	        RET
              	        
              	        
804F:         	CRLF:
804F: 3E0D    		LD   A, CR
8051: CD5F80  		CALL PUTCHAR
8054: C9      		RET   
              	        
8055:         	CONIN:
8055: C5      		PUSH BC
8056: D5      		PUSH DE
8057: E5      		PUSH HL
8058: CD1501  		CALL keyboardWaitA
805B: E1      		POP HL
805C: D1      		POP DE
805D: C1      		POP BC
805E: C9      		RET
              	
              	
805F:         	PUTCHAR:
805F:         	CONOUT:
805F: F5      		PUSH AF
8060: C5      		PUSH BC
8061: D5      		PUSH DE
8062: E5      		PUSH HL
8063: CD8101  		CALL sendCharToLCD
8066: E1      		POP HL
8067: D1      		POP DE
8068: C1      		POP BC
8069: F1      		POP AF
806A: C9      		RET
              	
              	
806B:         	PUTSTR:
806B: F5      		PUSH AF
806C: C5      		PUSH BC
806D: D5      		PUSH DE
806E: E5      		PUSH HL
806F: 545D    		LD DE, HL
8071: 3E00    		LD A, NUL
8073: CD8401  		CALL sendStringToLCD
8076: E1      		POP HL
8077: D1      		POP DE
8078: C1      		POP BC
8079: F1      		POP AF
807A: C9      		RET
              	
              	
              	; GETLINE: le uma linha ate CR em (DE), tamanho max B, retorna
              	;          tamanho lido em A. Deve ecoar os caracteres digitados
              	;          e tratar backspace. Troque pelo endereco real da sua
              	;          rotina de leitura de linha na jump table.
              	
              	; --- GETLINE: Lê linha para LINEBUF; eco local ---
              	;     Termina em CR. Suporta BS/DEL para apagar.
807B:         	GETLINE:
807B: 626B    	            LD   HL, DE
807D: 1600    	            LD 	 D, 0
807F:         	GETLINE_LOOP:
807F: CD5580  	            CALL CONIN
8082: FE0D    	            CP   CR
8084: 2850    	            JR   Z, GETLINE_DONE
8086: FEF8    	            CP   $F8    ; ignora scroll up - GLCD
8088: 28F5    	            JR   Z, GETLINE_LOOP
808A: FEF7    	            CP   $F7    ; ignora scroll down - GLCD
808C: 28F1    	            JR   Z, GETLINE_LOOP
808E: FE0A    	            CP   LF
8090: 28ED    	            JR   Z, GETLINE_LOOP    ; Ignora LF
8092: FE1B    	            CP   ESC
8094: 28E9    	            JR   Z, GETLINE_LOOP    ; Ignora
8096: FEFF    	            CP   $FF ;capslock Ignora
8098: CA7F80  	            JP   Z, GETLINE_LOOP
809B: FE08    	            CP   BkS
809D: 281E    	            JR   Z, GETLINE_BS
809F: FE7F    	            CP   DEL
80A1: 281A    	            JR   Z, GETLINE_BS
80A3: FEFA    	            CP   $FA ; AltGr
80A5: CA7F80  	            JP   Z, GETLINE_LOOP
80A8: FEF9    	            CP   $F9 ; LUZ
80AA: CA7F80  	            JP   Z, GETLINE_LOOP
80AD: 4F      	            LD   C, A
80AE: 78      	            LD   A, B
80AF: FE00    	            CP   0
80B1: 28CC    	            JR   Z, GETLINE_LOOP    ; Buffer cheio
80B3: 79      	            LD   A, C
80B4: 77      	            LD   (HL), A
80B5: 23      	            INC  HL
80B6: 05      	            DEC  B
80B7: 14      	            INC  D
80B8: CD5F80  	            CALL PUTCHAR             ; Eco
80BB: 18C2    	            JR   GETLINE_LOOP
80BD:         	GETLINE_BS:
80BD: 78      	            LD   A, B
80BE: FE4F    	            CP   79
80C0: 28BD    	            JR   Z, GETLINE_LOOP    ; Início: ignora BS
80C2: 2B      	            DEC  HL
80C3: 04      	            INC  B
80C4: 15      	            DEC  D
80C5: 3E08    	            LD   A, BkS
80C7: CD5F80  	            CALL PUTCHAR
80CA: 3E20    	            LD   A, SPACE
80CC: CD5F80  	            CALL PUTCHAR
80CF: 3E08    	            LD   A, BkS
80D1: CD5F80  	            CALL PUTCHAR
80D4: 18A9    	            JR   GETLINE_LOOP
80D6:         	GETLINE_DONE:
80D6: 3600    	            LD   (HL), NUL           ; Termina string
80D8: CD4F80  	            CALL CRLF
80DB: 7A      	            LD A, D
80DC: C9      	            RET   
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	        
              	
              	; ------------------------------------------------------------
80DD:         	PRINTADDR:
80DD: 2AC188  	        LD      HL,(CURADDR)
80E0: CDEE80  	        CALL    PRINTHEX16
80E3: 3E3A    	        LD      A,':'
80E5: CD5F80  	        CALL    PUTCHAR
80E8: 3E20    	        LD      A,' '
80EA: CD5F80  	        CALL    PUTCHAR
80ED: C9      	        RET
              	
              	; Imprime HL em hex, 4 digitos maiusculos
80EE:         	PRINTHEX16:
80EE: 7C      	        LD      A,H
80EF: CDF780  	        CALL    PRINTHEX8
80F2: 7D      	        LD      A,L
80F3: CDF780  	        CALL    PRINTHEX8
80F6: C9      	        RET
80F7:         	PRINTHEX8:
80F7: F5      	        PUSH    AF
80F8: 1F      	        RRA
80F9: 1F      	        RRA
80FA: 1F      	        RRA
80FB: 1F      	        RRA
80FC: CD0081  	        CALL    PRINTNIBBLE
80FF: F1      	        POP     AF
8100:         	PRINTNIBBLE:
8100: E60F    	        AND     0Fh
8102: FE0A    	        CP      0Ah
8104: 3802    	        JR      C,PN_DIGIT
8106: C607    	        ADD     A,'A'-'9'-1
8108:         	PN_DIGIT:
8108: C630    	        ADD     A,'0'
810A: CD5F80  	        CALL    PUTCHAR
810D: C9      	        RET
              	
              	; ------------------------------------------------------------
              	; Converte LINEBUF (C bytes) para maiusculas
810E:         	UPCASE_LINE:
810E: 21CC88  	        LD      HL,LINEBUF
8111: 41      	        LD      B,C
8112: 78      	        LD      A,B
8113: B7      	        OR      A
8114: C8      	        RET     Z
8115:         	UPC1:
8115: 7E      	        LD      A,(HL)
8116: FE61    	        CP      'a'
8118: 3807    	        JR      C,UPC2
811A: FE7B    	        CP      'z'+1
811C: 3003    	        JR      NC,UPC2
811E: D620    	        SUB     20h
8120: 77      	        LD      (HL),A
8121:         	UPC2:
8121: 23      	        INC     HL
8122: 10F1    	        DJNZ    UPC1
8124: C9      	        RET
              	
              	; Pula espacos a partir de (HL)
8125:         	SKIPSPACES:
8125: 7E      	        LD      A,(HL)
8126: FE20    	        CP      ' '
8128: C0      	        RET     NZ
8129: 23      	        INC     HL
812A: 18F9    	        JR      SKIPSPACES
              	
              	; Le o MNEMONICO a partir de (HL): igual READTOKEN mas tambem para
              	; em '(' (sem consumir), para aceitar "OUT(10),A" sem espaco antes
              	; do parenteses. Operandos continuam usando READTOKEN normal.
              	; Nao usa B/C (varios chamadores guardam estado em B entre uma
              	; chamada e outra - ex.: porta em OUT, condicao em JP/JR/CALL cc).
812C:         	READMNEMONIC:
812C: 11F688  	        LD      DE,MNEBUF
812F: AF      	        XOR     A
8130: 32C988  	        LD      (TOKLEN),A      ; contador em memoria, nao em B
8133:         	RM1:
8133: 7E      	        LD      A,(HL)
8134: B7      	        OR      A
8135: 281E    	        JR      Z,RM_END
8137: FE0D    	        CP      13
8139: 281A    	        JR      Z,RM_END
813B: FE20    	        CP      ' '
813D: 2816    	        JR      Z,RM_END
813F: FE2C    	        CP      ','
8141: 2812    	        JR      Z,RM_END
8143: FE28    	        CP      '('
8145: 280E    	        JR      Z,RM_END
8147: 12      	        LD      (DE),A
8148: 13      	        INC     DE
8149: 23      	        INC     HL
814A: 3AC988  	        LD      A,(TOKLEN)
814D: 3C      	        INC     A
814E: 32C988  	        LD      (TOKLEN),A
8151: FE08    	        CP      8
8153: 38DE    	        JR      C,RM1
8155:         	RM_END:
8155: AF      	        XOR     A
8156: 12      	        LD      (DE),A
8157: 3AC988  	        LD      A,(TOKLEN)
815A: C9      	        RET
              	
              	; Le um token (letras/digitos/$/(/)/+/-) a partir de (HL) ate achar
              	; espaco, virgula ou CR/0. Copia para MNEBUF (max 8 chars), poe 0
