8777: E1      	        POP     HL              ; restaura o ponteiro
8778: 23      	        INC     HL
8779: 18E1    	        JR      PH16_1
877B:         	PH16_DONE:
877B: EB      	        EX      DE,HL           ; HL = valor final
877C: B7      	        OR      A               ; forca carry=0 (sucesso); nao mexe em HL
877D: C9      	        RET
              	
