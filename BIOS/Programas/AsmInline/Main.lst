8768: E5      	        PUSH    HL              ; guarda o ponteiro de leitura
8769: EB      	        EX      DE,HL           ; HL = acumulador atual
876A: 29      	        ADD     HL,HL
876B: 29      	        ADD     HL,HL
876C: 29      	        ADD     HL,HL
876D: 29      	        ADD     HL,HL           ; HL = acumulador*16
