              	; --------------------------------------
              	; zasm: assemble "Main.asm"
              	; date: 2026-08-22 23:56:02
              	; --------------------------------------


              	#include "../Z80MiniAPI.asm"
              	;   API Z80Mini:
0100:         	delay500ms          equ     0x0100  ;   Delay 500ms
0103:         	delay               equ     0x0103  ;   On entry: DE = Delay time in milliseconds
0106:         	I2C_Open            equ     0x0106  ;   On entry: A = Device address (bit zero is read flag)
0109:         	I2C_Close           equ     0x0109  ;   Close
010C:         	I2C_Read            equ     0x010C  ;   On exit: If successful A = data byte and Z flagged
010F:         	I2C_Write           equ     0x010F  ;   On entry: A = Data byte, or Address byte (bit zero is read flag)
0112:         	keyboardIsEsc       equ     0x0112  ;   Verifica se ESC foi precionada. On exit: If press A = CTRLC and NZ flagged
0115:         	keyboardWaitA       equ     0x0115  ;   Aguarda tecla, letra em A. (BC DE HL preserved)
0118:         	keyboardA           equ     0x0118  ;   Lê teclado, Se tecla Carry=1. Letra em A. (BC DE HL preserved)
011B:         	setDefaultSerialA   equ     0x011B  ;   Seta terminal padrao porta A, Quando reinicia volta para A.
011E:         	setDefaultSerialB   equ     0x011E  ;   Seta terminal padrao porta B (P2), Quando reinicia volta para A.
0121:         	serialPrintA        equ     0x0121  ;   Imprime char in A no terminal setado.
0124:         	serialInputA        equ     0x0124  ;   Aguarda receber char no terminal setado. Retorno em A.
0127:         	serialPrintStr      equ     0x0127  ;   Imprime string (HL) terminado em 0 no terminal setado. MAX 128 chars. MODIFIES : A,B,C
012A:         	serialCRLF          equ     0x012A  ;   Imprime CR e LF no terminal setado.
012D:         	serialHexA          equ     0x012D  ;   Imprime byte em A no formato HEX, no terminal setado. Ex: 'D' = 44
0130:         	serialHexHL         equ     0x0130  ;   Imprime HL como 4 digitos hexadecimais, no terminal setado. Ex: HL=$80FF -> imprime "80FF"
0133:         	serialInHexA        equ     0x0133  ;   Pegar 2 caracteres ASCII (0-9 A-F), do terminal setado e converte em um byte em A. SEM ECHO
0136:         	serialInHexHL       equ     0x0136  ;   Pegar 4 caracteres ASCII (0-9 A-F), do terminal setado e converte em HL. SEM ECHO
              	
0139:         	initLCD             equ     0x0139  ;   Inicializa GLCD
013C:         	clearGBUF           equ     0x013C  ;   Limpa buffer da memoria de grafico. Precisa do plotToLCD para refletir no lcd.
013F:         	clearGrLCD          equ     0x013F  ;   Limpa memoria grafico do GLCD. Sem o plotToLCD.
0142:         	clearTxtLCD         equ     0x0142  ;   Limpar caracteres do LCD
0145:         	setGrMode           equ     0x0145  ;   Seta modo Grafico. 128x64
0148:         	setTxtMode          equ     0x0148  ;   Seta mode Text. 16x4 equivalente
014B:         	drawBox             equ     0x014B  ;   Desenha caixa. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
014E:         	drawLine            equ     0x014E  ;   Desenha linha.  Entradas: BC = X0,Y0 - DE = X1,Y1
0151:         	drawCircle          equ     0x0151  ;   Desenha circulo. Entradas BC = xm,ym (Ponro do Meio) - E = radius
0154:         	drawPixel           equ     0x0154  ;   Desenha um pixel em X Y.  Entrada B = column/X (0-127), C = row/Y (0-63)   Destroys: HL
0157:         	fillBox             equ     0x0157  ;   Desenha caixa preenchida. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
015A:         	fillCircle          equ     0x015A  ;   Desenha circulo preenchido. Entradas BC = xm,ym (Ponro do Meio) - E = radius
015D:         	plotToLCD           equ     0x015D  ;   Rotina principal de desenho. Move GBUF para o LCD e limpa o buffer ou não (setBufClear, setBufNoClear).  Destroys: ALL
0160:         	printString         equ     0x0160  ;   Imprimir texto ASCII em uma determinada linha. Entradas: A = 0 a 3 Número da linha. .db "String" na próxima linha, terminar com 0
0163:         	printChars          equ     0x0163  ;   (Ver detalhes) Imprimir caracteres na posição X,Y. Entrada B = coluna/X (0-7), C = linha/Y (0-3). HL = Endereço inicial do texto a ser exibido, termina com 0
0166:         	setInt38            equ     0x0166  ;   Seta vetor de interrupcao int38. Entradas HL = RST38_ADDR
0169:         	setint66            equ     0x0169  ;   Seta vetor de interrupcao int66. Entradas HL = RST66_ADDR
016C:         	setBufClear         equ     0x016C  ;   Configura limpeza do buffer após a saída para o LCD e vai para clearGBUF.
016F:         	setBufNoClear       equ     0x016F  ;   Configura para não limpar o buffer após a saída para o LCD.
0172:         	clearPixel          equ     0x0172  ;   Limpa um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0175:         	flipPixel           equ     0x0175  ;   Inverte um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0178:         	drawGraphic         equ     0x0178  ;   Desenha no buffer. Entrada: A = número ASCII ou se A=0 Então  HL = Endereço dos dados gráficos. B = (MULTIPLO DE 8) largura do gráfico em pixels (1-128). C = altura do gráfico em pixels (1-64). Destroy: ALL
017B:         	invGraphic          equ     0x017B  ;   Altera a flag de desenho inverso. (não inverte grafico atual) Destroy A
017E:         	initTerminal        equ     0x017E  ;   Inicializa o Terminal GLCD. Cursor 0,0 e limpa buffer.
0181:         	sendCharToLCD       equ     0x0181  ;   Envia ou manipula caracteres ASCII para a tela GLCD (Terminal). Entrada: A = caractere ASCII a ser enviado para a tela GLCD. A = somente cursor desenhado.
0184:         	sendStringToLCD     equ     0x0184  ;   Imprime string no terminal GLCD. DE = inicio da string. A = caractere para parar a impressão. A impressão para e retorna quando um CR é impresso. Destroy ALL
0187:         	sendRegToLCD        equ     0x0187  ;   Imprime byte em A no formato HEX, no GLCD. Ex: 'D' = 44
018A:         	sendHLToLCD         equ     0x018A  ;   Imprime HL como 4 digitos hexadecimais, no GLCD. Ex: HL=$80FF -> imprime "80FF"
018D:         	setCursor           equ     0x018D  ;   Define a posição do cursor gráfico. Entradas: BC = X,Y onde X = 0..127, Y = 0..63   Destroy A
0190:         	getCursor           equ     0x0190  ;   Obter a posição do cursor. Saídas: BC = X,Y onde X = 0..127, Y = 0..63
0193:         	displayCursor       equ     0x0193  ;   Exibir Cursor. Entrada: A = 0, Ativar cursor, A = diferente de zero, Desativar cursor.
0196:         	autoLF              equ     0x0196  ;   Avanço de linha automático quando o cursor atinge o final da linha (Terminal). Entrada: A = 0, Avanço de linha automático; A = diferente de zero, Sem avanço de linha automático. Padrao LIGADO.
0199:         	underline           equ     0x0199  ;   Exibir sublinhado no caractere (Terminal). O estado inicial é sem sublinhado. Chamar esta rotina irá ALTERAR/DESLIGAR o sinalizador de sublinhado.
019C:         	plotAlways          equ     0x019C  ;   Quando sendCharToLCD é chamado, Atualiza GLCD ou não. Se Desativado plotToLCD deve ser chamado atualizar o GLCD. Entrada: A=0, Plotar sempre; A>0, Não plotar. O padrão é Plotar sempre.
019F:         	resetCollisionPixel equ     0x019F  ;   Limpa flag de colisao
01A2:         	checkCollisionPixel equ     0x01A2  ;   Check se um pixel ja estava ligado quando tenta ligar. JP Z, SEM_COLISAO. JP NZ, COLISAO.
01A5:         	I2C_OpenRead        equ     0x01A5  ;   I2C Open Read  (On entry: A = Device address)
01A8:         	I2C_OpenWrite       equ     0x01A8  ;   I2C Open Write (On entry: A = Device address)
              	
              	
              	
              	; -----------------------------------------------------------------------------
              	; PORTS
              	; -----------------------------------------------------------------------------
0070:         	GLCD_INST           .EQU    $70
0071:         	GLCD_DATA           .EQU    $71
              	
0040:         	KEYBOARD		    .EQU	$40
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capsloock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	
              	; -------- Constantes gerais --------
000D:         	CR:       EQU   0DH
000A:         	LF:       EQU   0AH
0008:         	BKS:      EQU   08H
007F:         	DEL:      EQU   7FH
001B:         	ESC:      EQU   1BH
0020:         	SPACE:    EQU   20H
0000:         	NUL:      EQU   00H
000C:         	FF:       EQU   0CH                 ; Form Feed -> Limpa lcd
              	
              	; -----------------------------------------------------------------------------
              	; SIO/2 - SERIAL
              	; -----------------------------------------------------------------------------
0000:         	SIOA_D:   EQU   $00
0002:         	SIOA_C:   EQU   $02
0001:         	SIOB_D:   EQU   $01   ; Conector P2
0003:         	SIOB_C:   EQU   $03   ; Conector P2
              	
              	
              	
              	; ============================================================
              	; MAX7219.asm — Driver para modulo(s) MAX7219 (matriz LED 8x8)
              	; Z80Mini — porta de saida 0xC0, bit-bang SPI
              	; Compilar:  zasm --z80 -w -u --bin MAX7219.asm
              	; Executar:  G 8000
              	;
              	; Pinagem assumida no byte de saida (porta 0xC0):
              	;   bit0 = DIN   (dado serial)
              	;   bit1 = CLK   (clock)
              	;   bit2 = CS/LD (ativo baixo durante envio, pulso alto = latch)
              	; ============================================================
              	
8000:         	    org 8000h
              	
              	; ---- porta e mascaras de bits ----
00C0:         	PORT_MAX    equ $C0
              	
0001:         	BIT_DIN     equ 00000001b
0002:         	BIT_CLK     equ 00000010b
0004:         	BIT_CS      equ 00000100b
              	
              	; ---- registradores do MAX7219 ----
0000:         	REG_NOOP    equ $00
0001:         	REG_DIG0    equ $01      ; digitos/linhas 1-8 = 01h..08h
0009:         	REG_DECODE  equ $09
000A:         	REG_INTENS  equ $0A
000B:         	REG_SCANLIM equ $0B
000C:         	REG_SHUTDN  equ $0C
000F:         	REG_DISPTST equ $0F
              	
              	; ---- numero de modulos em cascata (1 = so um modulo) ----
0001:         	NUM_MODULES equ 1
              	
              	; ============================================================
              	; PONTO DE ENTRADA — demo padrao: inicializa e desenha um "X"
              	; ============================================================
8000:         	START:
8000: CD0A80  	    call MAX_INIT
8003: CD3280  	    call MAX_CLEAR
              	    
              	    ;ld   hl,PATTERN_X
              	    ;call MAX_DRAW
8006: C3B982  	    JP DEMO_SCROLL
8009: C9      	    ret
              	
              	; demos alternativas (chame na monitor com G <endereco> se quiser
              	; testar uma coisa de cada vez em vez do START completo):
              	;   DEMO_BRIGHT_LOOP  -> varre o brilho de 0 a 15 e volta
              	;   DEMO_SLEEP_WAKE   -> pisca o display via shutdown/wake
              	;   DEMO_TEST         -> acende tudo via modo de teste do chip
              	;   DEMO_MIRROR       -> desenha o X e mostra o espelho horizontal
              	;   DEMO_ROTATE       -> desenha o X e mostra rotacionado 90 graus
              	;   DEMO_SCROLL       -> faz scroll da mensagem "OI"
              	
              	; ============================================================
              	; MAX_INIT — sequencia de inicializacao do MAX7219
              	; ============================================================
800A:         	MAX_INIT:
800A: AF      	    xor  a
800B: 32D382  	    ld   (SHADOW_PORT),a       ; estado inicial do latch: tudo em 0
              	
800E: 060C    	    ld   b,REG_SHUTDN
8010: 0E01    	    ld   c,01h                 ; sai do modo shutdown (liga o chip)
8012: CD5580  	    call MAX_SEND
              	
8015: 0609    	    ld   b,REG_DECODE
8017: 0E00    	    ld   c, $00                 ; sem decode BCD — modo matriz de LED
8019: CD5580  	    call MAX_SEND
              	
801C: 060B    	    ld   b,REG_SCANLIM
801E: 0E07    	    ld   c, $07                 ; varre os 8 digitos (linhas)
8020: CD5580  	    call MAX_SEND
              	
8023: 060A    	    ld   b,REG_INTENS
8025: 0E08    	    ld   c, $08                 ; brilho medio (00h..0Fh)
8027: CD5580  	    call MAX_SEND
              	
802A: 060F    	    ld   b,REG_DISPTST
802C: 0E00    	    ld   c, $00                 ; desliga modo de teste
802E: CD5580  	    call MAX_SEND
8031: C9      	    ret
              	
              	; ============================================================
              	; MAX_CLEAR — apaga todas as 8 linhas
              	; ============================================================
8032:         	MAX_CLEAR:
8032: 0601    	    ld   b,REG_DIG0
8034: 1E08    	    ld   e,8
8036:         	MAX_CLEAR_LOOP:
8036: C5      	    push bc
8037: 0E00    	    ld   c,$00
8039: CD5580  	    call MAX_SEND
803C: C1      	    pop  bc
803D: 04      	    inc  b
803E: 1D      	    dec  e
803F: 20F5    	    jr   nz,MAX_CLEAR_LOOP
8041: C9      	    ret
              	
              	; ============================================================
              	; MAX_DRAW — desenha um padrao de 8 bytes (um por linha)
              	; entrada: HL = ponteiro para buffer de 8 bytes (linha 1..8)
              	; ============================================================
8042:         	MAX_DRAW:
8042: 0601    	    ld   b,REG_DIG0
8044: 1E08    	    ld   e,8
8046:         	MAX_DRAW_LOOP:
8046: C5      	    push bc
8047: E5      	    push hl
8048: 7E      	    ld   a,(hl)
8049: 4F      	    ld   c,a
804A: CD5580  	    call MAX_SEND
804D: E1      	    pop  hl
804E: C1      	    pop  bc
804F: 23      	    inc  hl
8050: 04      	    inc  b
8051: 1D      	    dec  e
8052: 20F2    	    jr   nz,MAX_DRAW_LOOP
8054: C9      	    ret
              	
              	; ============================================================
              	; MAX_SEND — envia um frame de 16 bits (registrador+dado)
              	; para UM modulo (uso normal, NUM_MODULES=1)
              	; entrada: B = numero do registrador, C = dado
              	; ============================================================
8055:         	MAX_SEND:
8055: 3AD382  	    ld   a,(SHADOW_PORT)
8058: E6FB    	    and  ~BIT_CS & $FF
805A: 32D382  	    ld   (SHADOW_PORT),a
805D: D3C0    	    out  (PORT_MAX),a
              	
805F: 78      	    ld   a,b
8060: CD7280  	    call MAX_SENDBYTE
              	
8063: 79      	    ld   a,c
8064: CD7280  	    call MAX_SENDBYTE
              	
8067: 3AD382  	    ld   a,(SHADOW_PORT)
806A: F604    	    or   BIT_CS
806C: 32D382  	    ld   (SHADOW_PORT),a
806F: D3C0    	    out  (PORT_MAX),a
8071: C9      	    ret
              	
              	; ------------------------------------------------------------
              	; MAX_SENDBYTE — envia byte em A, MSB primeiro
              	; ------------------------------------------------------------
8072:         	MAX_SENDBYTE:
8072: 1608    	    ld   d,8
8074:         	MAX_SENDBYTE_LOOP:
8074: 07      	    rlca                       ; bit mais significativo vai para carry
8075: F5      	    push af                    ; guarda o byte sendo deslocado (e o carry)
8076: 3AD382  	    ld   a,(SHADOW_PORT)       ; LD nao mexe nas flags -> carry preservado
8079: 3804    	    jr   c,MAX_SB_SETBIT
807B: E6FE    	    and  ~BIT_DIN & $FF        ; bit=0 -> zera DIN
807D: 1802    	    jr   MAX_SB_CLKLOW
807F:         	MAX_SB_SETBIT:
807F: F601    	    or   BIT_DIN                ; bit=1 -> seta DIN
8081:         	MAX_SB_CLKLOW:
8081: E6FD    	    and  ~BIT_CLK & $FF         ; CLK baixo (mascara nao afeta o bit DIN)
8083: 32D382  	    ld   (SHADOW_PORT),a
8086: D3C0    	    out  (PORT_MAX),a
              	
8088: F602    	    or   BIT_CLK                ; CLK alto -> MAX7219 amostra o bit
808A: 32D382  	    ld   (SHADOW_PORT),a
808D: D3C0    	    out  (PORT_MAX),a
              	
808F: F1      	    pop  af
8090: 15      	    dec  d
8091: 20E1    	    jr   nz,MAX_SENDBYTE_LOOP
8093: C9      	    ret
              	
              	; ============================================================
              	; BRILHO / SHUTDOWN / MODO TESTE
              	; ============================================================
              	
              	; MAX_SET_BRIGHT — ajusta o brilho
              	; entrada: A = 0 (minimo) a 15 (maximo)
8094:         	MAX_SET_BRIGHT:
8094: 4F      	    ld   c,a
8095: 060A    	    ld   b,REG_INTENS
8097: CD5580  	    call MAX_SEND
809A: C9      	    ret
              	
              	; MAX_SLEEP — desliga o display (baixo consumo, mantem conteudo)
809B:         	MAX_SLEEP:
809B: 060C    	    ld   b,REG_SHUTDN
809D: 0E00    	    ld   c,$00
809F: CD5580  	    call MAX_SEND
80A2: C9      	    ret
              	
              	; MAX_WAKE — religa o display (volta a mostrar o que tinha antes)
80A3:         	MAX_WAKE:
80A3: 060C    	    ld   b,REG_SHUTDN
80A5: 0E01    	    ld   c,$01
80A7: CD5580  	    call MAX_SEND
80AA: C9      	    ret
              	
              	; MAX_TEST_ON — acende todos os LEDs no brilho maximo (ignora o buffer)
              	; util para checar solda/fiacao
80AB:         	MAX_TEST_ON:
80AB: 060F    	    ld   b,REG_DISPTST
80AD: 0E01    	    ld   c,$01
80AF: CD5580  	    call MAX_SEND
80B2: C9      	    ret
              	
              	; MAX_TEST_OFF — volta ao funcionamento normal
80B3:         	MAX_TEST_OFF:
80B3: 060F    	    ld   b,REG_DISPTST
80B5: 0E00    	    ld   c,$00
80B7: CD5580  	    call MAX_SEND
80BA: C9      	    ret
              	
              	; ============================================================
              	; CASCATA DE MODULOS (para quando NUM_MODULES > 1)
              	; ============================================================
              	
              	; MAX_SEND_ALL — manda o MESMO registrador+dado para todos os modulos
              	; da cadeia de uma vez (bom para comandos de init: decode, scan limit,
              	; intensidade, shutdown, etc.)
              	; entrada: B = registrador, C = dado
80BB:         	MAX_SEND_ALL:
80BB: 3AD382  	    ld   a,(SHADOW_PORT)
80BE: E6FB    	    and  ~BIT_CS & $FF
80C0: 32D382  	    ld   (SHADOW_PORT),a
80C3: D3C0    	    out  (PORT_MAX),a
              	
80C5: 1E01    	    ld   e,NUM_MODULES
80C7:         	SEND_ALL_LOOP:
80C7: C5      	    push bc
80C8: D5      	    push de
80C9: 78      	    ld   a,b
80CA: CD7280  	    call MAX_SENDBYTE
80CD: 79      	    ld   a,c
80CE: CD7280  	    call MAX_SENDBYTE
80D1: D1      	    pop  de
80D2: C1      	    pop  bc
80D3: 1D      	    dec  e
80D4: 20F1    	    jr   nz,SEND_ALL_LOOP
              	
80D6: 3AD382  	    ld   a,(SHADOW_PORT)
80D9: F604    	    or   BIT_CS
80DB: 32D382  	    ld   (SHADOW_PORT),a
80DE: D3C0    	    out  (PORT_MAX),a
80E0: C9      	    ret
              	
              	; MAX_SEND_ROW_CASCADE — manda o MESMO registrador (ex: uma linha)
              	; com um dado DIFERENTE para cada modulo da cadeia
              	; entrada: B = registrador, HL = ponteiro para NUM_MODULES bytes de dado
              	;          HL[0] = dado do ultimo modulo da cadeia (mais distante do Z80)
              	;          HL[NUM_MODULES-1] = dado do primeiro modulo (mais perto do Z80)
80E1:         	MAX_SEND_ROW_CASCADE:
80E1: C5      	    push bc
80E2: 3AD382  	    ld   a,(SHADOW_PORT)
80E5: E6FB    	    and  ~BIT_CS & $FF
80E7: 32D382  	    ld   (SHADOW_PORT),a
80EA: D3C0    	    out  (PORT_MAX),a
80EC: C1      	    pop  bc
              	
80ED: 1601    	    ld   d,NUM_MODULES
80EF:         	CASCADE_LOOP:
80EF: C5      	    push bc
80F0: D5      	    push de
80F1: E5      	    push hl
80F2: 78      	    ld   a,b
80F3: CD7280  	    call MAX_SENDBYTE
80F6: 7E      	    ld   a,(hl)
80F7: CD7280  	    call MAX_SENDBYTE
80FA: E1      	    pop  hl
80FB: 23      	    inc  hl
80FC: D1      	    pop  de
80FD: C1      	    pop  bc
80FE: 15      	    dec  d
80FF: 20EE    	    jr   nz,CASCADE_LOOP
              	
8101: 3AD382  	    ld   a,(SHADOW_PORT)
8104: F604    	    or   BIT_CS
8106: 32D382  	    ld   (SHADOW_PORT),a
8109: D3C0    	    out  (PORT_MAX),a
810B: C9      	    ret
              	
              	; ============================================================
              	; BIT_MASKS / GET_BIT / SET_BIT_C — helpers usados por
              	; espelhamento, rotacao e scroll
              	; ============================================================
              	
810C:         	BITMASKS:
810C: 01020408	    defb 00000001b,00000010b,00000100b,00001000b
8110: 10204080	    defb 00010000b,00100000b,01000000b,10000000b
              	
              	; GET_BIT — entrada: A=byte, B=posicao do bit (0..7, 0=LSB)
              	;           saida: carry = valor do bit; A destruido
8114:         	GET_BIT:
8114: E5      	    push hl
8115: D5      	    push de
8116: F5      	    push af
8117: 210C81  	    ld   hl,BITMASKS
811A: 1600    	    ld   d,0
811C: 58      	    ld   e,b
811D: 19      	    add  hl,de
811E: 56      	    ld   d,(hl)
811F: F1      	    pop  af
8120: A2      	    and  d
8121: D1      	    pop  de
8122: E1      	    pop  hl
8123: 2802    	    jr   z,GET_BIT_ZERO
8125: 37      	    scf
8126: C9      	    ret
8127:         	GET_BIT_ZERO:
8127: B7      	    or   a
8128: C9      	    ret
              	
              	; SET_BIT_C — entrada: A=byte, C=posicao do bit (0..7)
              	;             saida: A = byte com aquele bit setado em 1
8129:         	SET_BIT_C:
8129: E5      	    push hl
812A: D5      	    push de
812B: C5      	    push bc
812C: 210C81  	    ld   hl,BITMASKS
