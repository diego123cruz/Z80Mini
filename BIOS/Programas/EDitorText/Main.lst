8383: 3E00    	    LD A,0
8385: CD9C01  		CALL plotAlways
8388: CD5D01  		CALL plotToLCD
838B: C9      	    RET
              	
              	; Converte A para maiúscula (a-z -> A-Z)
838C:         	UPCASE:
