              	; UTILITÁRIOS
              	; =============================================================================
8363:         	PRINT_PROMPT:
8363: CD6A83  	    CALL LCD_NEWLINE
8366: 3E2A    	    LD A, '*'
8368: CF      	    RST 8
8369: C9      	    RET
              	
836A:         	LCD_NEWLINE:
836A: 3E0D    	    LD A, CR
836C: CF      	    RST 8
836D: 3E0A    	    LD A, LF
836F: CF      	    RST 8
8370: C9      	    RET
              	
              	
              	; Imprime string terminada em NUL apontada por HL
8371:         	PRINT_STR:
8371: 7E      	    LD A, (HL)
8372: B7      	    OR A
