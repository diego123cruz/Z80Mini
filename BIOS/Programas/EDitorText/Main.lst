              	; --------------------------------------
              	; zasm: assemble "Main.asm"
              	; date: 2026-08-09 21:44:16
              	; --------------------------------------


              	;#include "../../Z80MiniAPI.asm"
              	
              	; =============================================================================
              	; EDMINI.ASM - Editor de texto estilo ED.COM (CP/M) para o Z80Mini
              	; -----------------------------------------------------------------------------
              	; Roda em RAM a partir de 0x8000 (tecla LUZ do Z80Mini faz CALL 8000H).
              	; Monta com zasm.
              	;
              	; ESTILO: como o ED.COM original do CP/M, este é um editor ORIENTADO A LINHA,
              	; não um editor de tela cheia (full-screen). Comandos de uma letra digitados
              	; num prompt "*", texto do buffer aparece no terminal do GLCD com scroll
              	; automático (autoLF). Isso combina bem com uma tela pequena de 128x64.
              	;
              	; COMANDOS (digite no prompt "*" e pressione ENTER):
              	;   I        - Insere linha(s) ANTES da linha atual
              	;   A        - Adiciona linha(s) DEPOIS da linha atual
              	;                (em I/A, digite uma linha por ENTER; ENTER em branco termina;
              	;                 ESC cancela a entrada da linha atual)
              	;   D        - Apaga a linha atual
              	;   N        - Vai para a próxima linha (e mostra)
              	;   P        - Vai para a linha anterior (e mostra)
              	;   G<num>   - Vai para a linha <num>, ex: G10
              	;   L        - Lista o buffer inteiro (pausa a cada algumas linhas)
              	;   W        - Envia o buffer inteiro pela serial (para capturar/salvar
              	;              num terminal externo, já que a API não expõe um FS aqui)
              	;   H ou ?   - Mostra a ajuda
              	;   E        - Sai do editor (volta para o monitor)
              	;
              	; LIMITAÇÕES (mantido simples de propósito):
              	;   - Números de linha são de 1 byte (1-255 linhas no máximo)
              	;   - Sem undo, sem busca/substituição, sem numeração automática de reflow
              	;   - "Salvar" = enviar pela serial (W); não grava em EEPROM/FS. Se você tiver
              	;     rotinas de sistema de arquivos, é só trocar CMD_WRITE por chamadas a elas.
              	;   - Backspace: mandamos BKS,SPACE,BKS para o terminal para apagar visualmente
              	;     mesmo que o driver não trate BKS sozinho. Ajuste se seu driver já tratar.
              	;   - O programa NÃO mexe no SP (mantém a pilha que o monitor já preparou),
              	;     assim "E"/RET volta corretamente para quem deu CALL 8000H.
              	;
              	; AJUSTES: mude MAXLINE e BUFSIZE conforme a RAM livre acima do programa.
              	; =============================================================================
              	
8000:         	    ORG 8000h
              	
              	; -----------------------------------------------------------------------------
              	; API do Z80Mini (ver BIOS/Programas/Z80MiniAPI.asm)
              	; -----------------------------------------------------------------------------
0112:         	keyboardIsEsc:    EQU 0112h
0115:         	keyboardWaitA:    EQU 0115h
0118:         	keyboardA:        EQU 0118h
0121:         	serialPrintA:     EQU 0121h
012A:         	serialCRLF:       EQU 012Ah
017E:         	initTerminal:     EQU 017Eh
0181:         	CoresendCharToLCD:    EQU 0181h
0196:         	autoLF:           EQU 0196h
              	
000D:         	CR:    EQU 0Dh
000A:         	LF:    EQU 0Ah
0008:         	BKS:   EQU 08h
007F:         	DEL:   EQU 7Fh
001B:         	ESC:   EQU 1Bh
0020:         	SPACE: EQU 20h
0000:         	NUL:   EQU 00h
              	
              	; -----------------------------------------------------------------------------
              	; Configuração (ajuste conforme a RAM livre do seu Z80Mini)
              	; -----------------------------------------------------------------------------
003C:         	MAXLINE:  EQU 60      ; tamanho máximo de uma linha de texto digitada
1000:         	BUFSIZE:  EQU 4096    ; tamanho da área de armazenamento do texto
0006:         	PAGESIZE: EQU 6        ; linhas mostradas por "página" no comando L
              	
              	; =============================================================================
              	; PONTO DE ENTRADA
              	; =============================================================================
8000:         	START:
8000: CD7E01  	    CALL initTerminal
8003: AF      	    XOR A
8004: CD9601  	    CALL autoLF             ; A=0 -> quebra de linha automática ligada
              	
8007: CD9981  	    CALL CMD_HELP            ; mostra banner/ajuda ao abrir
              	
800A:         	MAINLOOP:
800A: CD3283  	    CALL PRINT_PROMPT
800D: CDD082  	    CALL READ_LINE
8010: DA0A80  	    JP C, MAINLOOP            ; ESC no prompt -> ignora, volta a perguntar
8013: 3A6585  	    LD A, (LINEBUF)
8016: B7      	    OR A
8017: CA0A80  	    JP Z, MAINLOOP             ; linha vazia -> ignora
801A: CD2080  	    CALL EXEC_CMD
801D: C30A80  	    JP MAINLOOP
              	
              	; =============================================================================
              	; DESPACHO DE COMANDOS
              	; =============================================================================
              	; Lê o primeiro caractere de LINEBUF+1 e chama a rotina correspondente.
8020:         	EXEC_CMD:
8020: 3A6685  	    LD A, (LINEBUF+1)
8023: CD5683  	    CALL UPCASE
8026: FE49    	    CP 'I'
8028: CA6380  	    JP Z, CMD_INSERT
802B: FE41    	    CP 'A'
802D: CA9C80  	    JP Z, CMD_APPEND
8030: FE44    	    CP 'D'
8032: CAAC80  	    JP Z, CMD_DELETE
8035: FE4E    	    CP 'N'
8037: CACA80  	    JP Z, CMD_NEXT
803A: FE50    	    CP 'P'
803C: CAEB80  	    JP Z, CMD_PREV
803F: FE47    	    CP 'G'
8041: CA0381  	    JP Z, CMD_GOTO
8044: FE4C    	    CP 'L'
8046: CA2081  	    JP Z, CMD_LIST
8049: FE57    	    CP 'W'
804B: CA6981  	    JP Z, CMD_WRITE
804E: FE48    	    CP 'H'
8050: CA9981  	    JP Z, CMD_HELP
8053: FE3F    	    CP '?'
8055: CA9981  	    JP Z, CMD_HELP
8058: FE45    	    CP 'E'
805A: CAA081  	    JP Z, CMD_EXIT
805D: 21B483  	    LD HL, MSG_UNKNOWN
8060: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8063:         	CMD_INSERT:
8063: 3A5485  	    LD A, (LINECOUNT)
8066: B7      	    OR A
8067: CA7080  	    JP Z, CI_ATSTART
806A: 3A5385  	    LD A, (CURLINE)
806D: C37280  	    JP CI_GOTIN
8070:         	CI_ATSTART:
8070: 3E01    	    LD A, 1
8072:         	CI_GOTIN:
8072: 325785  	    LD (INS_POS), A
8075: 219E84  	    LD HL, MSG_INSERT_HELP
8078: CD4683  	    CALL PRINT_STR
807B:         	CI_LOOP:
807B: CDD082  	    CALL READ_LINE
807E: DA9B80  	    JP C, CI_END               ; ESC termina
8081: 3A6585  	    LD A, (LINEBUF)
8084: B7      	    OR A
8085: CA9B80  	    JP Z, CI_END                ; linha vazia termina
8088: 3A5785  	    LD A, (INS_POS)
808B: CD3082  	    CALL ADD_LINE_AT
808E: 215785  	    LD HL, INS_POS
8091: 34      	    INC (HL)
8092: 3A5785  	    LD A, (INS_POS)
8095: 325385  	    LD (CURLINE), A
8098: C37B80  	    JP CI_LOOP
809B:         	CI_END:
809B: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
809C:         	CMD_APPEND:
809C: 3A5385  	    LD A, (CURLINE)
809F: 3C      	    INC A
80A0: 325785  	    LD (INS_POS), A
80A3: 219E84  	    LD HL, MSG_INSERT_HELP
80A6: CD4683  	    CALL PRINT_STR
80A9: C37B80  	    JP CI_LOOP
              	
              	; -----------------------------------------------------------------------------
80AC:         	CMD_DELETE:
80AC: 3A5485  	    LD A, (LINECOUNT)
80AF: B7      	    OR A
80B0: CAC480  	    JP Z, CX_EMPTY
80B3: 3A5385  	    LD A, (CURLINE)
80B6: CDCA81  	    CALL DELETE_LINE
80B9: 3A5485  	    LD A, (LINECOUNT)
80BC: B7      	    OR A
80BD: C8      	    RET Z
80BE: 3A5385  	    LD A, (CURLINE)
80C1: C3A282  	    JP DISPLAY_LINE
80C4:         	CX_EMPTY:
80C4: 21D283  	    LD HL, MSG_EMPTY
80C7: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
80CA:         	CMD_NEXT:
80CA: 3A5485  	    LD A, (LINECOUNT)
80CD: B7      	    OR A
80CE: CAC480  	    JP Z, CX_EMPTY
80D1: 215485  	    LD HL, LINECOUNT
80D4: 3A5385  	    LD A, (CURLINE)
80D7: BE      	    CP (HL)
80D8: CAE580  	    JP Z, CN_ATEND
80DB: 215385  	    LD HL, CURLINE
80DE: 34      	    INC (HL)
80DF: 3A5385  	    LD A, (CURLINE)
80E2: C3A282  	    JP DISPLAY_LINE
80E5:         	CN_ATEND:
80E5: 211484  	    LD HL, MSG_LASTLINE
80E8: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
80EB:         	CMD_PREV:
80EB: 3A5385  	    LD A, (CURLINE)
80EE: FE02    	    CP 2
80F0: DAFD80  	    JP C, CP_ATSTART
80F3: 215385  	    LD HL, CURLINE
80F6: 35      	    DEC (HL)
80F7: 3A5385  	    LD A, (CURLINE)
80FA: C3A282  	    JP DISPLAY_LINE
80FD:         	CP_ATSTART:
80FD: 212E84  	    LD HL, MSG_FIRSTLINE
8100: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8103:         	CMD_GOTO:
8103: 216785  	    LD HL, LINEBUF+2           ; pula o 'G'; PARSE_NUMBER ainda pula espaços
8106: CD8E83  	    CALL PARSE_NUMBER
8109: B7      	    OR A
810A: CA1A81  	    JP Z, CG_ERR
810D: CDA781  	    CALL FIND_LINE               ; entrada A=alvo; saída D=alvo preservado
8110: DA1A81  	    JP C, CG_ERR
8113: 7A      	    LD A, D
8114: 325385  	    LD (CURLINE), A
8117: C3A282  	    JP DISPLAY_LINE
811A:         	CG_ERR:
811A: 21E183  	    LD HL, MSG_NOLINE
811D: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8120:         	CMD_LIST:
8120: 3A5485  	    LD A, (LINECOUNT)
8123: B7      	    OR A
8124: CAC480  	    JP Z, CX_EMPTY
8127: 325885  	    LD (LIST_TOTAL), A
812A: 3E01    	    LD A, 1
812C: 325985  	    LD (LIST_CUR), A
812F: AF      	    XOR A
8130: 325A85  	    LD (LIST_PAGE), A
8133:         	CL_LOOP:
8133: 3A5985  	    LD A, (LIST_CUR)
8136: 57      	    LD D, A
8137: 3A5885  	    LD A, (LIST_TOTAL)
813A: BA      	    CP D
813B: DA6881  	    JP C, CL_END
813E: 7A      	    LD A, D
813F: CDA282  	    CALL DISPLAY_LINE
8142: 215985  	    LD HL, LIST_CUR
8145: 34      	    INC (HL)
8146: 215A85  	    LD HL, LIST_PAGE
8149: 34      	    INC (HL)
814A: 7E      	    LD A, (HL)
814B: FE06    	    CP PAGESIZE
814D: DA3381  	    JP C, CL_LOOP
8150: 214A84  	    LD HL, MSG_MORE
8153: CD4683  	    CALL PRINT_STR
8156: CD1501  	    CALL keyboardWaitA
8159: CD3B83  	    CALL LCD_NEWLINE
815C: FE1B    	    CP ESC
815E: CA6881  	    JP Z, CL_END
8161: AF      	    XOR A
8162: 325A85  	    LD (LIST_PAGE), A
8165: C33381  	    JP CL_LOOP
8168:         	CL_END:
8168: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
              	; Envia o buffer inteiro pela serial, uma linha de texto por linha,
              	; para ser capturado/salvo por um terminal externo.
8169:         	CMD_WRITE:
8169: 3A5485  	    LD A, (LINECOUNT)
816C: B7      	    OR A
816D: CAC480  	    JP Z, CX_EMPTY
8170: 216284  	    LD HL, MSG_SENDING
8173: CD4F83  	    CALL PRINT_MSG
8176: 21A385  	    LD HL, BUFSTART
8179: 3A5485  	    LD A, (LINECOUNT)
817C: 47      	    LD B, A
817D:         	CW_LOOP:
817D: 7E      	    LD A, (HL)
817E: 4F      	    LD C, A
817F: 23      	    INC HL
8180: 79      	    LD A, C
8181: B7      	    OR A
8182: CA8E81  	    JP Z, CW_EOL
8185:         	CW_CHAR:
8185: 7E      	    LD A, (HL)
8186: CD2101  	    CALL serialPrintA
8189: 23      	    INC HL
818A: 0D      	    DEC C
818B: C28581  	    JP NZ, CW_CHAR
818E:         	CW_EOL:
818E: CD2A01  	    CALL serialCRLF
8191: 10EA    	    DJNZ CW_LOOP
8193: 217C84  	    LD HL, MSG_DONE
8196: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8199:         	CMD_HELP:
8199: 21D284  	    LD HL, MSG_HELP
819C: CD4683  	    CALL PRINT_STR
819F: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
81A0:         	CMD_EXIT:
81A0: 218884  	    LD HL, MSG_BYE
81A3: CD4F83  	    CALL PRINT_MSG
81A6: C9      	    RET                         ; volta para quem deu CALL 8000H (ex.: monitor)
              	
              	; =============================================================================
              	; MOTOR DO BUFFER DE TEXTO
              	; -----------------------------------------------------------------------------
              	; Cada linha é gravada como: [tamanho:1 byte][texto:tamanho bytes], uma após
              	; a outra, sem separador, a partir de BUFSTART. BUFPTR aponta para o primeiro
              	; byte livre. LINECOUNT = total de linhas. CURLINE = linha atual (1-based).
              	; =============================================================================
              	
              	; Entrada: A = número da linha desejada (1-based)
              	; Saída:   HL = endereço do byte de tamanho do registro daquela linha,
              	;          (ou, se A = LINECOUNT+1, HL = BUFPTR, útil para inserir no fim)
              	;          D  = número da linha alvo (preservado, útil para quem chamou)
              	;          Carry=1 se A é inválido (0, ou maior que LINECOUNT+1)
81A7:         	FIND_LINE:
81A7: B7      	    OR A
81A8: CAC881  	    JP Z, FL_INVALID
81AB: 57      	    LD D, A
81AC: 3A5485  	    LD A, (LINECOUNT)
81AF: 3C      	    INC A
81B0: BA      	    CP D
81B1: DAC881  	    JP C, FL_INVALID            ; D > LINECOUNT+1
81B4: 21A385  	    LD HL, BUFSTART
81B7: 1E01    	    LD E, 1
81B9:         	FL_LOOP:
81B9: 7B      	    LD A, E
81BA: BA      	    CP D
81BB: 2809    	    JR Z, FL_FOUND
81BD: 7E      	    LD A, (HL)
81BE: 4F      	    LD C, A
81BF: 0600    	    LD B, 0
81C1: 03      	    INC BC
81C2: 09      	    ADD HL, BC
81C3: 1C      	    INC E
81C4: 18F3    	    JR FL_LOOP
81C6:         	FL_FOUND:
81C6: B7      	    OR A                          ; garante Carry=0
81C7: C9      	    RET
81C8:         	FL_INVALID:
81C8: 37      	    SCF
81C9: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = número da linha a apagar
81CA:         	DELETE_LINE:
81CA: CDA781  	    CALL FIND_LINE
81CD: D8      	    RET C
81CE: 3A5485  	    LD A, (LINECOUNT)
81D1: BA      	    CP D
81D2: DA2A82  	    JP C, DL_INVALID             ; D > LINECOUNT -> linha não existe de fato
81D5: 225B85  	    LD (T_DEST), HL
81D8: 7E      	    LD A, (HL)
81D9: 5F      	    LD E, A
81DA: 1600    	    LD D, 0
81DC: 13      	    INC DE
81DD: ED536185	    LD (T_SIZE), DE               ; tamanho do registro (1+tamanho do texto)
81E1: 2A5B85  	    LD HL, (T_DEST)
81E4: 19      	    ADD HL, DE
81E5: 225F85  	    LD (T_SRC), HL                 ; início do próximo registro
81E8: 2A5585  	    LD HL, (BUFPTR)
81EB: ED5B5F85	    LD DE, (T_SRC)
81EF: B7      	    OR A
81F0: ED52    	    SBC HL, DE
81F2: 226385  	    LD (T_COUNT), HL                ; bytes que sobraram depois da linha removida
81F5: 7C      	    LD A, H
81F6: B5      	    OR L
81F7: 280D    	    JR Z, DL_SKIPMOVE
81F9: 2A5F85  	    LD HL, (T_SRC)
81FC: ED5B5B85	    LD DE, (T_DEST)
8200: ED4B6385	    LD BC, (T_COUNT)
8204: EDB0    	    LDIR                              ; desloca o resto do buffer para trás
8206:         	DL_SKIPMOVE:
8206: 2A5585  	    LD HL, (BUFPTR)
8209: ED5B6185	    LD DE, (T_SIZE)
820D: B7      	    OR A
820E: ED52    	    SBC HL, DE
8210: 225585  	    LD (BUFPTR), HL
8213: 215485  	    LD HL, LINECOUNT
8216: 35      	    DEC (HL)
8217: 3A5385  	    LD A, (CURLINE)
821A: 215485  	    LD HL, LINECOUNT
821D: BE      	    CP (HL)
821E: 3804    	    JR C, DL_KEEPCUR
8220: 7E      	    LD A, (HL)
8221: 325385  	    LD (CURLINE), A                  ; se CURLINE ficou > LINECOUNT, recua
8224:         	DL_KEEPCUR:
8224: 210484  	    LD HL, MSG_DELETED
8227: C34F83  	    JP PRINT_MSG
822A:         	DL_INVALID:
822A: 21E183  	    LD HL, MSG_NOLINE
822D: C34F83  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = posição (número de linha, 1..LINECOUNT+1) onde a nova linha
              	;          deve ficar. LINEBUF = [tamanho][texto] da nova linha (já lida).
8230:         	ADD_LINE_AT:
8230: CDA781  	    CALL FIND_LINE
8233: D8      	    RET C
8234: 225D85  	    LD (T_DEST_INS), HL
8237: 3A6585  	    LD A, (LINEBUF)
823A: 5F      	    LD E, A
823B: 1600    	    LD D, 0
823D: 13      	    INC DE
823E: ED536185	    LD (T_SIZE), DE                  ; tamanho do novo registro
8242: 2A5585  	    LD HL, (BUFPTR)
8245: 19      	    ADD HL, DE
8246: 11A395  	    LD DE, BUFEND
8249: B7      	    OR A
824A: ED52    	    SBC HL, DE
824C: D29282  	    JP NC, AL_FULL                    ; não cabe no buffer
824F: 2A5585  	    LD HL, (BUFPTR)
8252: ED5B5D85	    LD DE, (T_DEST_INS)
8256: B7      	    OR A
8257: ED52    	    SBC HL, DE
8259: 226385  	    LD (T_COUNT), HL                   ; bytes existentes que precisam abrir espaço
825C: 7C      	    LD A, H
825D: B5      	    OR L
825E: 2815    	    JR Z, AL_NOSHIFT
8260: 2A5585  	    LD HL, (BUFPTR)
8263: ED4B6185	    LD BC, (T_SIZE)
8267: 09      	    ADD HL, BC
8268: 2B      	    DEC HL
8269: 54      	    LD D, H
826A: 5D      	    LD E, L                              ; DE = último byte de destino
826B: 2A5585  	    LD HL, (BUFPTR)
826E: 2B      	    DEC HL                                ; HL = último byte de origem
826F: ED4B6385	    LD BC, (T_COUNT)
8273: EDB8    	    LDDR                                   ; abre espaço, copiando de trás pra frente
8275:         	AL_NOSHIFT:
8275: 216585  	    LD HL, LINEBUF
8278: ED5B5D85	    LD DE, (T_DEST_INS)
827C: ED4B6185	    LD BC, (T_SIZE)
8280: EDB0    	    LDIR                                    ; grava a nova linha no espaço aberto
8282: 2A5585  	    LD HL, (BUFPTR)
8285: ED5B6185	    LD DE, (T_SIZE)
8289: 19      	    ADD HL, DE
828A: 225585  	    LD (BUFPTR), HL
828D: 215485  	    LD HL, LINECOUNT
8290: 34      	    INC (HL)
8291: C9      	    RET
8292:         	AL_FULL:
8292: 21F483  	    LD HL, MSG_FULL
8295: C34F83  	    JP PRINT_MSG
              	    
              	    
8298:         	sendCharToLCD:
8298: C5      	    push bc
8299: D5      	    push de
829A: E5      	    push hl
829B: CD8101  	    CALL CoresendCharToLCD
829E: E1      	    pop hl
829F: D1      	    pop de
82A0: C1      	    pop bc
82A1: C9      	    ret
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = número da linha a exibir. Mostra "NNN: texto".
82A2:         	DISPLAY_LINE:
82A2: F5      	    PUSH AF
82A3: CDA781  	    CALL FIND_LINE
82A6: DAC982  	    JP C, DSP_ERR
82A9: F1      	    POP AF
82AA: CD5F83  	    CALL PRINT_DEC
82AD: 3E3A    	    LD A, ':'
82AF: CD9882  	    CALL sendCharToLCD
82B2: 3E20    	    LD A, SPACE
82B4: CD9882  	    CALL sendCharToLCD
82B7: 7E      	    LD A, (HL)
82B8: 47      	    LD B, A
82B9: 23      	    INC HL
82BA: 78      	    LD A, B
82BB: B7      	    OR A
82BC: 2807    	    JR Z, DSP_NL
82BE:         	DSP_PRINTCH:
82BE: 7E      	    LD A, (HL)
82BF: CD9882  	    CALL sendCharToLCD
82C2: 23      	    INC HL
82C3: 10F9    	    DJNZ DSP_PRINTCH
82C5:         	DSP_NL:
82C5: CD3B83  	    CALL LCD_NEWLINE
82C8: C9      	    RET
82C9:         	DSP_ERR:
82C9: F1      	    POP AF
82CA: 21E183  	    LD HL, MSG_NOLINE
82CD: C34F83  	    JP PRINT_MSG
              	
              	; =============================================================================
              	; ENTRADA DE LINHA PELO TECLADO
              	; =============================================================================
              	; Lê uma linha do teclado para LINEBUF: [tamanho][texto...][NUL].
              	; Ecoa cada caractere no LCD. BKS/DEL apaga o último caractere (envia
              	; BKS,SPACE,BKS para garantir que apague visualmente). ESC cancela a linha.
              	; Saída: B = tamanho da linha lida. Carry=1 se cancelado com ESC.
82D0:         	READ_LINE:
82D0: 216685  	    LD HL, LINEBUF+1
82D3: 0600    	    LD B, 0
82D5:         	RL_LOOP:
