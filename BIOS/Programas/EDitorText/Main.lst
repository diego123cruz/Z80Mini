81E7: C37883  	    JP PRINT_MSG
              	
              	; =============================================================================
              	; MOTOR DO BUFFER DE TEXTO
              	; -----------------------------------------------------------------------------
              	; Cada linha é gravada como: [tamanho:1 byte][texto:tamanho bytes], uma após
              	; a outra, sem separador, a partir de BUFSTART. BUFPTR aponta para o primeiro
              	; byte livre. LINECOUNT = total de linhas. CURLINE = linha atual (1-based).
              	; =============================================================================
              	
              	; Entrada: A = número da linha desejada (1-based)
              	; Saída:   HL = endereço do byte de tamanho do registro daquela linha,
              	;          (ou, se A = LINECOUNT+1, HL = BUFPTR, útil para inserir no fim)
              	;          D  = número da linha alvo (preservado, útil para quem chamou)
              	;          Carry=1 se A é inválido (0, ou maior que LINECOUNT+1)
81EA:         	FIND_LINE:
81EA: B7      	    OR A
81EB: CA0B82  	    JP Z, FL_INVALID
81EE: 57      	    LD D, A
81EF: 3AF985  	    LD A, (LINECOUNT)
81F2: 3C      	    INC A
81F3: BA      	    CP D
81F4: DA0B82  	    JP C, FL_INVALID            ; D > LINECOUNT+1
81F7: 214886  	    LD HL, BUFSTART
81FA: 1E01    	    LD E, 1
81FC:         	FL_LOOP:
81FC: 7B      	    LD A, E
81FD: BA      	    CP D
81FE: 2809    	    JR Z, FL_FOUND
8200: 7E      	    LD A, (HL)
8201: 4F      	    LD C, A
8202: 0600    	    LD B, 0
8204: 03      	    INC BC
8205: 09      	    ADD HL, BC
8206: 1C      	    INC E
8207: 18F3    	    JR FL_LOOP
8209:         	FL_FOUND:
8209: B7      	    OR A                          ; garante Carry=0
820A: C9      	    RET
820B:         	FL_INVALID:
820B: 37      	    SCF
820C: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = número da linha a apagar
820D:         	DELETE_LINE:
820D: CDEA81  	    CALL FIND_LINE
8210: D8      	    RET C
8211: 3AF985  	    LD A, (LINECOUNT)
8214: BA      	    CP D
8215: DA6D82  	    JP C, DL_INVALID             ; D > LINECOUNT -> linha não existe de fato
8218: 220086  	    LD (T_DEST), HL
821B: 7E      	    LD A, (HL)
821C: 5F      	    LD E, A
821D: 1600    	    LD D, 0
821F: 13      	    INC DE
8220: ED530686	    LD (T_SIZE), DE               ; tamanho do registro (1+tamanho do texto)
8224: 2A0086  	    LD HL, (T_DEST)
8227: 19      	    ADD HL, DE
8228: 220486  	    LD (T_SRC), HL                 ; início do próximo registro
822B: 2AFA85  	    LD HL, (BUFPTR)
822E: ED5B0486	    LD DE, (T_SRC)
8232: B7      	    OR A
8233: ED52    	    SBC HL, DE
8235: 220886  	    LD (T_COUNT), HL                ; bytes que sobraram depois da linha removida
8238: 7C      	    LD A, H
8239: B5      	    OR L
823A: 280D    	    JR Z, DL_SKIPMOVE
823C: 2A0486  	    LD HL, (T_SRC)
823F: ED5B0086	    LD DE, (T_DEST)
8243: ED4B0886	    LD BC, (T_COUNT)
8247: EDB0    	    LDIR                              ; desloca o resto do buffer para trás
8249:         	DL_SKIPMOVE:
8249: 2AFA85  	    LD HL, (BUFPTR)
824C: ED5B0686	    LD DE, (T_SIZE)
8250: B7      	    OR A
8251: ED52    	    SBC HL, DE
8253: 22FA85  	    LD (BUFPTR), HL
8256: 21F985  	    LD HL, LINECOUNT
8259: 35      	    DEC (HL)
825A: 3AF885  	    LD A, (CURLINE)
825D: 21F985  	    LD HL, LINECOUNT
8260: BE      	    CP (HL)
8261: 3804    	    JR C, DL_KEEPCUR
8263: 7E      	    LD A, (HL)
8264: 32F885  	    LD (CURLINE), A                  ; se CURLINE ficou > LINECOUNT, recua
8267:         	DL_KEEPCUR:
8267: 215F84  	    LD HL, MSG_DELETED
826A: C37883  	    JP PRINT_MSG
826D:         	DL_INVALID:
826D: 211C84  	    LD HL, MSG_NOLINE
8270: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = posição (número de linha, 1..LINECOUNT+1) onde a nova linha
              	;          deve ficar. LINEBUF = [tamanho][texto] da nova linha (já lida).
              	; Saída:   Carry=1 se a inserção falhou (posição inválida ou buffer cheio);
              	;          nesse caso já foi impressa uma mensagem de erro.
8273:         	ADD_LINE_AT:
8273: CDEA81  	    CALL FIND_LINE
8276: 3008    	    JR NC, AL_POSOK
8278: 213F84  	    LD HL, MSG_MAXLINES          ; ex.: CURLINE estourou 255 (byte) ao incrementar
827B: CD7883  	    CALL PRINT_MSG
827E: 37      	    SCF
827F: C9      	    RET
8280:         	AL_POSOK:
8280: 220286  	    LD (T_DEST_INS), HL
8283: 3A0A86  	    LD A, (LINEBUF)
8286: 5F      	    LD E, A
8287: 1600    	    LD D, 0
8289: 13      	    INC DE
828A: ED530686	    LD (T_SIZE), DE                  ; tamanho do novo registro
828E: 2AFA85  	    LD HL, (BUFPTR)
8291: 19      	    ADD HL, DE
8292: 114896  	    LD DE, BUFEND
8295: B7      	    OR A
8296: ED52    	    SBC HL, DE
8298: D2DF82  	    JP NC, AL_FULL                    ; não cabe no buffer
829B: 2AFA85  	    LD HL, (BUFPTR)
829E: ED5B0286	    LD DE, (T_DEST_INS)
82A2: B7      	    OR A
82A3: ED52    	    SBC HL, DE
82A5: 220886  	    LD (T_COUNT), HL                   ; bytes existentes que precisam abrir espaço
82A8: 7C      	    LD A, H
82A9: B5      	    OR L
82AA: 2815    	    JR Z, AL_NOSHIFT
82AC: 2AFA85  	    LD HL, (BUFPTR)
82AF: ED4B0686	    LD BC, (T_SIZE)
82B3: 09      	    ADD HL, BC
82B4: 2B      	    DEC HL
82B5: 54      	    LD D, H
82B6: 5D      	    LD E, L                              ; DE = último byte de destino
82B7: 2AFA85  	    LD HL, (BUFPTR)
82BA: 2B      	    DEC HL                                ; HL = último byte de origem
82BB: ED4B0886	    LD BC, (T_COUNT)
82BF: EDB8    	    LDDR                                   ; abre espaço, copiando de trás pra frente
82C1:         	AL_NOSHIFT:
82C1: 210A86  	    LD HL, LINEBUF
82C4: ED5B0286	    LD DE, (T_DEST_INS)
82C8: ED4B0686	    LD BC, (T_SIZE)
82CC: EDB0    	    LDIR                                    ; grava a nova linha no espaço aberto
82CE: 2AFA85  	    LD HL, (BUFPTR)
82D1: ED5B0686	    LD DE, (T_SIZE)
82D5: 19      	    ADD HL, DE
82D6: 22FA85  	    LD (BUFPTR), HL
82D9: 21F985  	    LD HL, LINECOUNT
82DC: 34      	    INC (HL)
82DD: B7      	    OR A                                    ; garante Carry=0 (sucesso)
82DE: C9      	    RET
82DF:         	AL_FULL:
82DF: 212F84  	    LD HL, MSG_FULL
82E2: CD7883  	    CALL PRINT_MSG
82E5: 37      	    SCF
82E6: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
              	; Entrada: A = número da linha a exibir. Mostra "NNN: texto".
82E7:         	DISPLAY_LINE:
82E7: F5      	    PUSH AF
82E8: CDEA81  	    CALL FIND_LINE
82EB: DA0883  	    JP C, DSP_ERR
82EE: F1      	    POP AF
82EF: CD9583  	    CALL PRINT_DEC
82F2: 3E3A    	    LD A, ':'
82F4: CF      	    RST 8
82F5: 3E20    	    LD A, SPACE
82F7: CF      	    RST 8
82F8: 7E      	    LD A, (HL)
82F9: 47      	    LD B, A
82FA: 23      	    INC HL
82FB: 78      	    LD A, B
82FC: B7      	    OR A
82FD: 2805    	    JR Z, DSP_NL
82FF:         	DSP_PRINTCH:
82FF: 7E      	    LD A, (HL)
8300: CF      	    RST 8
8301: 23      	    INC HL
8302: 10FB    	    DJNZ DSP_PRINTCH
8304:         	DSP_NL:
8304: CD6A83  	    CALL LCD_NEWLINE
8307: C9      	    RET
8308:         	DSP_ERR:
8308: F1      	    POP AF
8309: 211C84  	    LD HL, MSG_NOLINE
830C: C37883  	    JP PRINT_MSG
              	
              	; =============================================================================
              	; ENTRADA DE LINHA PELO TECLADO
              	; =============================================================================
              	; Lê uma linha do teclado para LINEBUF: [tamanho][texto...][NUL].
              	; Ecoa cada caractere no LCD. BKS/DEL apaga o último caractere (envia
              	; BKS,SPACE,BKS para garantir que apague visualmente). ESC cancela a linha.
              	; Saída: B = tamanho da linha lida. Carry=1 se cancelado com ESC.
830F:         	READ_LINE:
830F: 210B86  	    LD HL, LINEBUF+1
8312: 0600    	    LD B, 0
8314:         	RL_LOOP:
8314: CD1501  	    CALL keyboardWaitA
8317: 5F      	    LD E, A
8318: FE1B    	    CP ESC
831A: 283D    	    JR Z, RL_ABORT
831C: FE0D    	    CP CR
831E: 2827    	    JR Z, RL_DONE
8320: FE08    	    CP BKS
8322: 2818    	    JR Z, RL_BACK
8324: FE7F    	    CP DEL
8326: 2814    	    JR Z, RL_BACK
8328: FE20    	    CP SPACE
832A: 38E8    	    JR C, RL_LOOP                 ; ignora controles não tratados
832C: FE7F    	    CP 7Fh
832E: 30E4    	    JR NC, RL_LOOP                  ; ignora teclas especiais (0x7F-0xFF)
8330: 78      	    LD A, B
8331: FE3C    	    CP MAXLINE
8333: 28DF    	    JR Z, RL_LOOP                    ; linha cheia, ignora tecla
8335: 73      	    LD (HL), E
8336: 23      	    INC HL
8337: 04      	    INC B
8338: 7B      	    LD A, E
8339: CF      	    RST 8
833A: 18D8    	    JR RL_LOOP
833C:         	RL_BACK:
833C: 78      	    LD A, B
833D: B7      	    OR A
833E: 28D4    	    JR Z, RL_LOOP
8340: 05      	    DEC B
8341: 2B      	    DEC HL
8342: 3E08    	    LD A, BKS
8344: CF      	    RST 8
8345: 18CD    	    JR RL_LOOP
8347:         	RL_DONE:
8347: 78      	    LD A, B
8348: 320A86  	    LD (LINEBUF), A
834B: 210B86  	    LD HL, LINEBUF+1
834E: 1600    	    LD D, 0
8350: 58      	    LD E, B
8351: 19      	    ADD HL, DE
8352: AF      	    XOR A
8353: 77      	    LD (HL), A                       ; termina com NUL (facilita PARSE_NUMBER)
8354: CD6A83  	    CALL LCD_NEWLINE
8357: B7      	    OR A
8358: C9      	    RET
8359:         	RL_ABORT:
8359: AF      	    XOR A
835A: 320A86  	    LD (LINEBUF), A
835D: 47      	    LD B, A
835E: CD6A83  	    CALL LCD_NEWLINE
8361: 37      	    SCF
8362: C9      	    RET
              	
