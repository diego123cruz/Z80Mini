83DE: 87      	    ADD A, A
83DF: 57      	    LD D, A
83E0: 87      	    ADD A, A
83E1: 87      	    ADD A, A
83E2: 82      	    ADD A, D
83E3: 80      	    ADD A, B
83E4: 3807    	    JR C, PN_OVERFLOW         ; estourou 255 na soma final
83E6: 4F      	    LD C, A
83E7: 23      	    INC HL
83E8: 18E0    	    JR PN_DIGITS
83EA:         	PN_DONE:
