              	    ; Limpa o buffer
81CB: AF      	    XOR A
81CC: 32F885  	    LD (CURLINE), A
81CF: 32F985  	    LD (LINECOUNT), A
81D2: 214886  	    LD HL, BUFSTART
81D5: 22FA85  	    LD (BUFPTR), HL
              	    
81D8: 214185  	    LD HL, MSG_CLEARED
81DB: C37883  	    JP PRINT_MSG
              	    
81DE:         	CC_ABORT:
81DE: 215085  	    LD HL, MSG_CLEAR_CANCEL
