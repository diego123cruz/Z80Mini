              	; --------------------------------------
              	; zasm: assemble "Main.asm"
              	; date: 2026-09-20 21:38:25
              	; --------------------------------------


              	#include "../Z80MiniAPI.asm"
              	;   API Z80Mini:
0100:         	delay500ms          equ     0x0100  ;   Delay 500ms
0103:         	delay               equ     0x0103  ;   On entry: DE = Delay time in milliseconds
0106:         	I2C_Open            equ     0x0106  ;   On entry: A = Device address (bit zero is read flag)
0109:         	I2C_Close           equ     0x0109  ;   Close
010C:         	I2C_Read            equ     0x010C  ;   On exit: If successful A = data byte and Z flagged
010F:         	I2C_Write           equ     0x010F  ;   On entry: A = Data byte, or Address byte (bit zero is read flag)
0112:         	keyboardIsEsc       equ     0x0112  ;   Verifica se ESC foi precionada. On exit: If press A = CTRLC and NZ flagged
0115:         	keyboardWaitA       equ     0x0115  ;   Aguarda tecla, letra em A. (BC DE HL preserved)
0118:         	keyboardA           equ     0x0118  ;   Lê teclado, Se tecla Carry=1. Letra em A. (BC DE HL preserved)
011B:         	setDefaultSerialA   equ     0x011B  ;   Seta terminal padrao porta A, Quando reinicia volta para A.
011E:         	setDefaultSerialB   equ     0x011E  ;   Seta terminal padrao porta B (P2), Quando reinicia volta para A.
0121:         	serialPrintA        equ     0x0121  ;   Imprime char in A no terminal setado.
0124:         	serialInputA        equ     0x0124  ;   Aguarda receber char no terminal setado. Retorno em A.
0127:         	serialPrintStr      equ     0x0127  ;   Imprime string (HL) terminado em 0 no terminal setado. MAX 128 chars. MODIFIES : A,B,C
012A:         	serialCRLF          equ     0x012A  ;   Imprime CR e LF no terminal setado.
012D:         	serialHexA          equ     0x012D  ;   Imprime byte em A no formato HEX, no terminal setado. Ex: 'D' = 44
0130:         	serialHexHL         equ     0x0130  ;   Imprime HL como 4 digitos hexadecimais, no terminal setado. Ex: HL=$80FF -> imprime "80FF"
0133:         	serialInHexA        equ     0x0133  ;   Pegar 2 caracteres ASCII (0-9 A-F), do terminal setado e converte em um byte em A. SEM ECHO
0136:         	serialInHexHL       equ     0x0136  ;   Pegar 4 caracteres ASCII (0-9 A-F), do terminal setado e converte em HL. SEM ECHO
              	
0139:         	initLCD             equ     0x0139  ;   Inicializa GLCD
013C:         	clearGBUF           equ     0x013C  ;   Limpa buffer da memoria de grafico. Precisa do plotToLCD para refletir no lcd.
013F:         	clearGrLCD          equ     0x013F  ;   Limpa memoria grafico do GLCD. Sem o plotToLCD.
0142:         	clearTxtLCD         equ     0x0142  ;   Limpar caracteres do LCD
0145:         	setGrMode           equ     0x0145  ;   Seta modo Grafico. 128x64
0148:         	setTxtMode          equ     0x0148  ;   Seta mode Text. 16x4 equivalente
014B:         	drawBox             equ     0x014B  ;   Desenha caixa. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
014E:         	drawLine            equ     0x014E  ;   Desenha linha.  Entradas: BC = X0,Y0 - DE = X1,Y1
0151:         	drawCircle          equ     0x0151  ;   Desenha circulo. Entradas BC = xm,ym (Ponro do Meio) - E = radius
0154:         	drawPixel           equ     0x0154  ;   Desenha um pixel em X Y.  Entrada B = column/X (0-127), C = row/Y (0-63)   Destroys: HL
0157:         	fillBox             equ     0x0157  ;   Desenha caixa preenchida. Entradas: BC = X0,Y0 - DE = X1,Y1    Destroys: HL
015A:         	fillCircle          equ     0x015A  ;   Desenha circulo preenchido. Entradas BC = xm,ym (Ponro do Meio) - E = radius
015D:         	plotToLCD           equ     0x015D  ;   Rotina principal de desenho. Move GBUF para o LCD e limpa o buffer ou não (setBufClear, setBufNoClear).  Destroys: ALL
0160:         	printString         equ     0x0160  ;   Imprimir texto ASCII em uma determinada linha. Entradas: A = 0 a 3 Número da linha. .db "String" na próxima linha, terminar com 0
0163:         	printChars          equ     0x0163  ;   (Ver detalhes) Imprimir caracteres na posição X,Y. Entrada B = coluna/X (0-7), C = linha/Y (0-3). HL = Endereço inicial do texto a ser exibido, termina com 0
0166:         	setInt38            equ     0x0166  ;   Seta vetor de interrupcao int38. Entradas HL = RST38_ADDR
0169:         	setint66            equ     0x0169  ;   Seta vetor de interrupcao int66. Entradas HL = RST66_ADDR
016C:         	setBufClear         equ     0x016C  ;   Configura limpeza do buffer após a saída para o LCD e vai para clearGBUF.
016F:         	setBufNoClear       equ     0x016F  ;   Configura para não limpar o buffer após a saída para o LCD.
0172:         	clearPixel          equ     0x0172  ;   Limpa um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0175:         	flipPixel           equ     0x0175  ;   Inverte um pixel X Y.  Input B = column/X (0-127), C = row/Y (0-63)    Destroy HL
0178:         	drawGraphic         equ     0x0178  ;   Desenha no buffer. Entrada: A = número ASCII ou se A=0 Então  HL = Endereço dos dados gráficos. B = (MULTIPLO DE 8) largura do gráfico em pixels (1-128). C = altura do gráfico em pixels (1-64). Destroy: ALL
017B:         	invGraphic          equ     0x017B  ;   Altera a flag de desenho inverso. (não inverte grafico atual) Destroy A
017E:         	initTerminal        equ     0x017E  ;   Inicializa o Terminal GLCD. Cursor 0,0 e limpa buffer.
0181:         	sendCharToLCD       equ     0x0181  ;   Envia ou manipula caracteres ASCII para a tela GLCD (Terminal). Entrada: A = caractere ASCII a ser enviado para a tela GLCD. A = somente cursor desenhado.
0184:         	sendStringToLCD     equ     0x0184  ;   Imprime string no terminal GLCD. DE = inicio da string. A = caractere para parar a impressão. A impressão para e retorna quando um CR é impresso. Destroy ALL
0187:         	sendRegToLCD        equ     0x0187  ;   Imprime byte em A no formato HEX, no GLCD. Ex: 'D' = 44
018A:         	sendHLToLCD         equ     0x018A  ;   Imprime HL como 4 digitos hexadecimais, no GLCD. Ex: HL=$80FF -> imprime "80FF"
018D:         	setCursor           equ     0x018D  ;   Define a posição do cursor gráfico. Entradas: BC = X,Y onde X = 0..127, Y = 0..63   Destroy A
0190:         	getCursor           equ     0x0190  ;   Obter a posição do cursor. Saídas: BC = X,Y onde X = 0..127, Y = 0..63
0193:         	displayCursor       equ     0x0193  ;   Exibir Cursor. Entrada: A = 0, Ativar cursor, A = diferente de zero, Desativar cursor.
0196:         	autoLF              equ     0x0196  ;   Avanço de linha automático quando o cursor atinge o final da linha (Terminal). Entrada: A = 0, Avanço de linha automático; A = diferente de zero, Sem avanço de linha automático. Padrao LIGADO.
0199:         	underline           equ     0x0199  ;   Exibir sublinhado no caractere (Terminal). O estado inicial é sem sublinhado. Chamar esta rotina irá ALTERAR/DESLIGAR o sinalizador de sublinhado.
019C:         	plotAlways          equ     0x019C  ;   Quando sendCharToLCD é chamado, Atualiza GLCD ou não. Se Desativado plotToLCD deve ser chamado atualizar o GLCD. Entrada: A=0, Plotar sempre; A>0, Não plotar. O padrão é Plotar sempre.
019F:         	resetCollisionPixel equ     0x019F  ;   Limpa flag de colisao
01A2:         	checkCollisionPixel equ     0x01A2  ;   Check se um pixel ja estava ligado quando tenta ligar. JP Z, SEM_COLISAO. JP NZ, COLISAO.
01A5:         	I2C_OpenRead        equ     0x01A5  ;   I2C Open Read  (On entry: A = Device address)
01A8:         	I2C_OpenWrite       equ     0x01A8  ;   I2C Open Write (On entry: A = Device address)
              	
              	
              	
              	; -----------------------------------------------------------------------------
              	; PORTS
              	; -----------------------------------------------------------------------------
0070:         	GLCD_INST           .EQU    $70
0071:         	GLCD_DATA           .EQU    $71
              	
0040:         	KEYBOARD		    .EQU	$40
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capsloock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	
              	; -------- Constantes gerais --------
000D:         	CR:       EQU   0DH
000A:         	LF:       EQU   0AH
0008:         	BKS:      EQU   08H
007F:         	DEL:      EQU   7FH
001B:         	ESC:      EQU   1BH
0020:         	SPACE:    EQU   20H
0000:         	NUL:      EQU   00H
000C:         	FF:       EQU   0CH                 ; Form Feed -> Limpa lcd
              	
              	; -----------------------------------------------------------------------------
              	; SIO/2 - SERIAL
              	; -----------------------------------------------------------------------------
0000:         	SIOA_D:   EQU   $00
0002:         	SIOA_C:   EQU   $02
0001:         	SIOB_D:   EQU   $01   ; Conector P2
0003:         	SIOB_C:   EQU   $03   ; Conector P2
              	
              	
              	
              	; =============================================================================
              	; EDMINI.ASM - Editor de texto estilo ED.COM (CP/M) para o Z80Mini
              	; -----------------------------------------------------------------------------
              	; Roda em RAM a partir de 0x8000 (tecla LUZ do Z80Mini faz CALL 8000H).
              	; Monta com zasm.
              	;
              	; ESTILO: como o ED.COM original do CP/M, este é um editor ORIENTADO A LINHA,
              	; não um editor de tela cheia (full-screen). Comandos de uma letra digitados
              	; num prompt "*", texto do buffer aparece no terminal do GLCD com scroll
              	; automático (autoLF). Isso combina bem com uma tela pequena de 128x64.
              	;
              	; COMANDOS (digite no prompt "*" e pressione ENTER):
              	;   I        - Insere linha(s) ANTES da linha atual
              	;   A        - Adiciona linha(s) DEPOIS da linha atual
              	;                (em I/A, digite uma linha por ENTER; ENTER em branco termina;
              	;                 ESC cancela a entrada da linha atual)
              	;   D        - Apaga a linha atual
              	;   N        - Vai para a próxima linha (e mostra)
              	;   P        - Vai para a linha anterior (e mostra)
              	;   G<num>   - Vai para a linha <num>, ex: G10
              	;   L        - Lista o buffer inteiro (pausa a cada algumas linhas)
              	;   W        - Envia o buffer inteiro pela serial (para capturar/salvar
              	;              num terminal externo, já que a API não expõe um FS aqui)
              	;   H ou ?   - Mostra a ajuda
              	;   E        - Sai do editor (volta para o monitor)
              	;
              	; LIMITAÇÕES (mantido simples de propósito):
              	;   - Números de linha são de 1 byte (1-255 linhas no máximo)
              	;   - Sem undo, sem busca/substituição, sem numeração automática de reflow
              	;   - "Salvar" = enviar pela serial (W); não grava em EEPROM/FS. Se você tiver
              	;     rotinas de sistema de arquivos, é só trocar CMD_WRITE por chamadas a elas.
              	;   - Backspace: mandamos BKS,SPACE,BKS para o terminal para apagar visualmente
              	;     mesmo que o driver não trate BKS sozinho. Ajuste se seu driver já tratar.
              	;   - O programa NÃO mexe no SP (mantém a pilha que o monitor já preparou),
              	;     assim "E"/RET volta corretamente para quem deu CALL 8000H.
              	;
              	; AJUSTES: mude MAXLINE e BUFSIZE conforme a RAM livre acima do programa.
              	; =============================================================================
              	
8000:         	    ORG 8000h
              	
000D:         	CR:    EQU 0Dh
000A:         	LF:    EQU 0Ah
0008:         	BKS:   EQU 08h
007F:         	DEL:   EQU 7Fh
001B:         	ESC:   EQU 1Bh
0020:         	SPACE: EQU 20h
0000:         	NUL:   EQU 00h
              	
              	; -----------------------------------------------------------------------------
              	; Configuração (ajuste conforme a RAM livre do seu Z80Mini)
              	; -----------------------------------------------------------------------------
003C:         	MAXLINE:  EQU 60      ; tamanho máximo de uma linha de texto digitada
1000:         	BUFSIZE:  EQU 4096    ; tamanho da área de armazenamento do texto
000A:         	PAGESIZE: EQU 10      ; linhas mostradas por "página" no comando L
              	
              	; =============================================================================
              	; PONTO DE ENTRADA
              	; =============================================================================
8000:         	START:
8000: CD7E01  	    CALL initTerminal
8003: AF      	    XOR A
8004: CD9601  	    CALL autoLF             ; A=0 -> quebra de linha automática ligada
              	
8007: CDA681  	    CALL CMD_HELP            ; mostra banner/ajuda ao abrir
              	
800A:         	MAINLOOP:
800A: CD6383  	    CALL PRINT_PROMPT
800D: CD0F83  	    CALL READ_LINE
8010: DA0A80  	    JP C, MAINLOOP            ; ESC no prompt -> ignora, volta a perguntar
8013: 3A0A86  	    LD A, (LINEBUF)
8016: B7      	    OR A
8017: CA0A80  	    JP Z, MAINLOOP             ; linha vazia -> ignora
801A: CD2080  	    CALL EXEC_CMD
801D: C30A80  	    JP MAINLOOP
              	
              	; =============================================================================
              	; DESPACHO DE COMANDOS
              	; =============================================================================
              	; Lê o primeiro caractere de LINEBUF+1 e chama a rotina correspondente.
8020:         	EXEC_CMD:
8020: 3A0B86  	    LD A, (LINEBUF+1)
8023: CD8C83  	    CALL UPCASE
8026: FE49    	    CP 'I'
8028: CA6880  	    JP Z, CMD_INSERT
802B: FE41    	    CP 'A'
802D: CAA680  	    JP Z, CMD_APPEND
8030: FE44    	    CP 'D'
8032: CAB080  	    JP Z, CMD_DELETE
8035: FE4E    	    CP 'N'
8037: CACE80  	    JP Z, CMD_NEXT
803A: FE50    	    CP 'P'
803C: CAEF80  	    JP Z, CMD_PREV
803F: FE47    	    CP 'G'
8041: CA0781  	    JP Z, CMD_GOTO
8044: FE4C    	    CP 'L'
8046: CA2781  	    JP Z, CMD_LIST
8049: FE57    	    CP 'W'
804B: CA7081  	    JP Z, CMD_WRITE
804E: FE48    	    CP 'H'
8050: CAA681  	    JP Z, CMD_HELP
8053: FE3F    	    CP '?'
8055: CAA681  	    JP Z, CMD_HELP
8058: FE45    	    CP 'E'
805A: CAAD81  	    JP Z, CMD_EXIT
805D: FE43    	    CP 'C'
805F: CAB481  	    JP Z, CMD_CLEAR
8062: 21EF83  	    LD HL, MSG_UNKNOWN
8065: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8068:         	CMD_INSERT:
8068: 3AF985  	    LD A, (LINECOUNT)
806B: B7      	    OR A
806C: CA7580  	    JP Z, CI_ATSTART
806F: 3AF885  	    LD A, (CURLINE)
8072: C37780  	    JP CI_GOTIN
8075:         	CI_ATSTART:
8075: 3E01    	    LD A, 1
8077:         	CI_GOTIN:
8077: 32FC85  	    LD (INS_POS), A
              	    ;LD HL, MSG_INSERT_HELP
              	    ;CALL PRINT_STR
807A:         	CI_LOOP:
807A: CD0F83  	    CALL READ_LINE
807D: DAA580  	    JP C, CI_END               ; ESC termina
8080: 3A0A86  	    LD A, (LINEBUF)
8083: B7      	    OR A
8084: CAA580  	    JP Z, CI_END                ; linha vazia termina
8087: 3AFC85  	    LD A, (INS_POS)
808A: CD7382  	    CALL ADD_LINE_AT
808D: DAA580  	    JP C, CI_END                 ; buffer cheio ou posição inválida - aborta
8090: 3AFC85  	    LD A, (INS_POS)
8093: 32F885  	    LD (CURLINE), A               ; CURLINE = linha que acabou de ser inserida
8096: 3AF985  	    LD A, (LINECOUNT)
8099: FEFF    	    CP 255
809B: CAA580  	    JP Z, CI_END                   ; atingiu o maximo de 255 linhas - encerra
809E: 21FC85  	    LD HL, INS_POS
80A1: 34      	    INC (HL)
80A2: C37A80  	    JP CI_LOOP
80A5:         	CI_END:
80A5: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
80A6:         	CMD_APPEND:
80A6: 3AF885  	    LD A, (CURLINE)
80A9: 3C      	    INC A
80AA: 32FC85  	    LD (INS_POS), A
              	    ;LD HL, MSG_INSERT_HELP
              	    ;CALL PRINT_STR
80AD: C37A80  	    JP CI_LOOP
              	
              	; -----------------------------------------------------------------------------
80B0:         	CMD_DELETE:
80B0: 3AF985  	    LD A, (LINECOUNT)
80B3: B7      	    OR A
80B4: CAC880  	    JP Z, CX_EMPTY
80B7: 3AF885  	    LD A, (CURLINE)
80BA: CD0D82  	    CALL DELETE_LINE
80BD: 3AF985  	    LD A, (LINECOUNT)
80C0: B7      	    OR A
80C1: C8      	    RET Z
80C2: 3AF885  	    LD A, (CURLINE)
80C5: C3E782  	    JP DISPLAY_LINE
80C8:         	CX_EMPTY:
80C8: 210D84  	    LD HL, MSG_EMPTY
80CB: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
80CE:         	CMD_NEXT:
80CE: 3AF985  	    LD A, (LINECOUNT)
80D1: B7      	    OR A
80D2: CAC880  	    JP Z, CX_EMPTY
80D5: 21F985  	    LD HL, LINECOUNT
80D8: 3AF885  	    LD A, (CURLINE)
80DB: BE      	    CP (HL)
80DC: CAE980  	    JP Z, CN_ATEND
80DF: 21F885  	    LD HL, CURLINE
80E2: 34      	    INC (HL)
80E3: 3AF885  	    LD A, (CURLINE)
80E6: C3E782  	    JP DISPLAY_LINE
80E9:         	CN_ATEND:
80E9: 216F84  	    LD HL, MSG_LASTLINE
80EC: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
80EF:         	CMD_PREV:
80EF: 3AF885  	    LD A, (CURLINE)
80F2: FE02    	    CP 2
80F4: DA0181  	    JP C, CP_ATSTART
80F7: 21F885  	    LD HL, CURLINE
80FA: 35      	    DEC (HL)
80FB: 3AF885  	    LD A, (CURLINE)
80FE: C3E782  	    JP DISPLAY_LINE
8101:         	CP_ATSTART:
8101: 218984  	    LD HL, MSG_FIRSTLINE
8104: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8107:         	CMD_GOTO:
8107: 210C86  	    LD HL, LINEBUF+2           ; pula o 'G'; PARSE_NUMBER ainda pula espaços
810A: CDC083  	    CALL PARSE_NUMBER
810D: DA2181  	    JP C, CG_ERR                ; número > 255 (estouro) - inválido
8110: B7      	    OR A
8111: CA2181  	    JP Z, CG_ERR
8114: CDEA81  	    CALL FIND_LINE               ; entrada A=alvo; saída D=alvo preservado
8117: DA2181  	    JP C, CG_ERR
811A: 7A      	    LD A, D
811B: 32F885  	    LD (CURLINE), A
811E: C3E782  	    JP DISPLAY_LINE
8121:         	CG_ERR:
8121: 211C84  	    LD HL, MSG_NOLINE
8124: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
8127:         	CMD_LIST:
8127: 3AF985  	    LD A, (LINECOUNT)
812A: B7      	    OR A
812B: CAC880  	    JP Z, CX_EMPTY
812E: 32FD85  	    LD (LIST_TOTAL), A
8131: 3E01    	    LD A, 1
8133: 32FE85  	    LD (LIST_CUR), A
8136: AF      	    XOR A
8137: 32FF85  	    LD (LIST_PAGE), A
813A:         	CL_LOOP:
813A: 3AFE85  	    LD A, (LIST_CUR)
813D: 57      	    LD D, A
813E: 3AFD85  	    LD A, (LIST_TOTAL)
8141: BA      	    CP D
8142: DA6F81  	    JP C, CL_END
8145: 7A      	    LD A, D
8146: CDE782  	    CALL DISPLAY_LINE
8149: 21FE85  	    LD HL, LIST_CUR
814C: 34      	    INC (HL)
814D: 21FF85  	    LD HL, LIST_PAGE
8150: 34      	    INC (HL)
8151: 7E      	    LD A, (HL)
8152: FE0A    	    CP PAGESIZE
8154: DA3A81  	    JP C, CL_LOOP
8157: 21A584  	    LD HL, MSG_MORE
815A: CD7883  	    CALL PRINT_MSG
815D: CD1501  	    CALL keyboardWaitA
8160: CD6A83  	    CALL LCD_NEWLINE
8163: FE1B    	    CP ESC
8165: CA6F81  	    JP Z, CL_END
8168: AF      	    XOR A
8169: 32FF85  	    LD (LIST_PAGE), A
816C: C33A81  	    JP CL_LOOP
816F:         	CL_END:
816F: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
              	; Envia o buffer inteiro pela serial, uma linha de texto por linha,
              	; para ser capturado/salvo por um terminal externo. Troca temporariamente
              	; o canal serial padrão para a impressora térmica (Serial B) e restaura
              	; o canal original (Serial A) ao final, mesmo em caso de erro.
8170:         	CMD_WRITE:
8170: 3AF985  	    LD A, (LINECOUNT)
8173: B7      	    OR A
8174: CAC880  	    JP Z, CX_EMPTY
              	
8177: CD1E01  	    CALL setDefaultSerialB ; impressora termica
              	
817A: 21BD84  	    LD HL, MSG_SENDING
817D: CD7883  	    CALL PRINT_MSG
8180: 214886  	    LD HL, BUFSTART
8183: 3AF985  	    LD A, (LINECOUNT)
8186: 47      	    LD B, A
8187:         	CW_LOOP:
8187: 7E      	    LD A, (HL)
8188: 4F      	    LD C, A
8189: 23      	    INC HL
818A: 79      	    LD A, C
818B: B7      	    OR A
818C: CA9881  	    JP Z, CW_EOL
818F:         	CW_CHAR:
818F: 7E      	    LD A, (HL)
8190: CD2101  	    CALL serialPrintA
8193: 23      	    INC HL
8194: 0D      	    DEC C
8195: C28F81  	    JP NZ, CW_CHAR
8198:         	CW_EOL:
8198: CD2A01  	    CALL serialCRLF
819B: 10EA    	    DJNZ CW_LOOP
              	
819D: CD1B01  	    CALL setDefaultSerialA  ; restaura o canal serial padrão (Serial A)
              	
81A0: 21D784  	    LD HL, MSG_DONE
81A3: C37883  	    JP PRINT_MSG
              	
              	; -----------------------------------------------------------------------------
81A6:         	CMD_HELP:
81A6: 215C85  	    LD HL, MSG_HELP
81A9: CD7883  	    CALL PRINT_MSG
81AC: C9      	    RET
              	
              	; -----------------------------------------------------------------------------
81AD:         	CMD_EXIT:
81AD: 21E384  	    LD HL, MSG_BYE
81B0: CD7883  	    CALL PRINT_MSG
81B3: C9      	    RET                         ; volta para quem deu CALL 8000H (ex.: monitor)
              	
              	;------------------------------------------------------------------------------
              	
              	; =============================================================================
81B4:         	CMD_CLEAR:
81B4: 3AF985  	    LD A, (LINECOUNT)
81B7: B7      	    OR A
81B8: CAE481  	    JP Z, CC_EMPTY              ; se já está vazio, avisa e sai
              	    
81BB: 212D85  	    LD HL, MSG_CLEAR_CONFIRM
81BE: CD7883  	    CALL PRINT_MSG
              	    
81C1: CD1501  	    CALL keyboardWaitA
