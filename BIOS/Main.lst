2434: 47      	    LD B, A
2435: 3A50FC  	    LD A, (FS_TMP1)
2438: B0      	    OR B                    ; seta o bit (marca pagina como livre)
2439: 3250FC  	    LD (FS_TMP1), A
              	
              	    ; Grava
243C: 3A57FC  	    LD A, (FS_BMPADDR)
243F: 5F      	    LD E, A
2440: 1600    	    LD D, 0
2442: 2150FC  	    LD HL, FS_TMP1
2445: 010100  	    LD BC, 1
2448: CD871D  	    CALL I2C_MemWr
244B: 1808    	    JR FS_FP_DONE
              	
