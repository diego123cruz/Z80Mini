              	#include "SERIAL.asm"
              	; Inicializa SIO/2 Serial 115200
101A:         	initSerial:
101A: 217710  	    LD    HL,TXDATA
101D: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
1020: 218A10  	    LD    HL,RXDATA
1023: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
              	
              	
              	    ;	Initialise SIO/2 A - Onboard USB
1026: 3E04    		LD	A,$04
1028: D302    		OUT	(SIOA_C),A
102A: 3EC4    		LD	A,$C4
102C: D302    		OUT	(SIOA_C),A
              	
102E: 3E03    		LD	A,$03
1030: D302    		OUT	(SIOA_C),A
1032: 3EE1    		LD	A,$E1
1034: D302    		OUT	(SIOA_C),A
              	
1036: 3E05    		LD	A,$05
1038: D302    		OUT	(SIOA_C),A
103A: 3E68    		LD	A, $68
103C: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
103E: 3E04    		LD	A,$04
1040: D303    		OUT	(SIOB_C),A
1042: 3EC4    		LD	A,$C4
1044: D303    		OUT	(SIOB_C),A
              	
1046: 3E03    		LD	A,$03
1048: D303    		OUT	(SIOB_C),A
104A: 3EE1    		LD	A,$E1
104C: D303    		OUT	(SIOB_C),A
              	
104E: 3E05    		LD	A,$05
1050: D303    		OUT	(SIOB_C),A
1052: 3E68    		LD	A, $68
1054: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
1056: 212A23  	    LD HL, WELLCOME
1059: CD6910  	    CALL SNDSTR
              	
105C: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
105D: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
1061: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
1063: DD2AA0FB	INCH:  LD   IX,(GETCH)
1067: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
1069: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
106B: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
106C: FE00    	       CP    00H          ;ZERO TERMINATOR?
106E: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
1070: CD5D10  	       CALL  OUTCH         ;TRANSMIT THE CHAR
1073: 23      	       INC   HL
1074: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
1076: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
1077:         	TXDATA:		
1077: F5      			PUSH	AF		; Store character
1078: CD8110  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
107B: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
107D: F1      			POP	AF		; RETrieve character
107E: D300    			OUT	(SIOA_D),A	; OUTput the character
1080: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
1081:         	CKSIOA
1081: 97      			SUB	A
1082: D302    			OUT 	(SIOA_C),A
1084: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1086: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1087: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
1089: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
108A:         	RXDATA:	
108A:         	waitForChar:
              	        ; Check if there is a char in channel A
108A: 97      			SUB	A
108B: D302    			OUT 	(SIOA_C),A
108D: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
108F: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1090: 30F8    			JR	NC, waitForChar
1092: DB00    			IN	A,(SIOA_D)
1094: B7      			OR A ; clear carry
1095: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
1096:         	TXDATA_B:		
1096: F5      			PUSH	AF		; Store character
1097: CDA010  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
109A: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
109C: F1      			POP	AF		; RETrieve character
109D: D301    			OUT	(SIOB_D),A	; OUTput the character
109F: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10A0:         	CKSIOB
10A0: 97      			SUB	A
10A1: D303    			OUT 	(SIOB_C),A
10A3: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10A5: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10A6: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10A8: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10A9:         	RXDATA_B:	
10A9:         	waitForCharB:
              	        ; Check if there is a char in channel A
10A9: 97      			SUB	A
10AA: D303    			OUT 	(SIOB_C),A
10AC: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10AE: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10AF: 30F8    			JR	NC, waitForCharB
10B1: DB01    			IN	A,(SIOB_D)
10B3: B7      			OR A ; clear carry
10B4: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
10B5:         	PARSE_CMD:
10B5: 21A7FB  	            LD   HL, LINEBUF
10B8: CD1A14  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
10BB: 7E      	            LD   A, (HL)
10BC: FE0D    	            CP   CR
10BE: C8      	            RET  Z
10BF: FE00    	            CP   NUL
10C1: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
10C2: CD8614  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
10C5: 21FE10  	            LD   HL, CMD_TABLE
10C8:         	CMD_SCAN:
10C8: 7E      	            LD   A, (HL)
10C9: FE00    	            CP   NUL
10CB: CAF710  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
10CE: E5      	            PUSH HL
10CF: 11F7FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
10D2: CDAB14  	            CALL STRCMP
10D5: E1      	            POP  HL
10D6: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
10D8:         	SKIP_ENTRY:
10D8: 7E      	            LD   A, (HL)
10D9: 23      	            INC  HL
10DA: FE00    	            CP   NUL
10DC: 20FA    	            JR   NZ, SKIP_ENTRY
10DE: 23      	            INC  HL                  ; pula high byte do endereço
10DF: 23      	            INC  HL                  ; pula low  byte do endereço
10E0: C3C810  	            JP   CMD_SCAN
              	
10E3:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
10E3: 7E      	            LD   A, (HL)
10E4: 23      	            INC  HL
10E5: FE00    	            CP   NUL
10E7: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
10E9: 7E      	            LD   A, (HL)
10EA: 23      	            INC  HL
10EB: 66      	            LD   H, (HL)
10EC: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
10ED: 11A7FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
10F0: CD1314  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
10F3: CD2114  	            CALL SKIP_SPACES_DE      ; DE aponta para args
10F6: E9      	            JP   (HL)                ; chama handler
              	
10F7:         	CMD_UNKNOWN:
10F7: 21B415  	            LD   HL, MSG_UNKNOWN
10FA: CD6404  	            CALL PUTS
10FD: C9      	            RET
              	
              	; -------- Tabela de comandos --------
10FE:         	CMD_TABLE:
10FE: 434C5300	            DB   "CLS",  NUL
1102: F011    	            DW   CLS_CMD
1104: 44554D50	            DB   "DUMP", NUL
1108: 00      	
1109: F611    	            DW   DUMP_CMD
110B: 57524954	            DB   "WRITE", NUL
110F: 4500    	
1111: 3812    	            DW   LOAD_CMD
1113: 45444954	            DB   "EDIT", NUL
1117: 00      	
1118: 8C12    	            DW   EDIT_CMD
111A: 4F555400	            DB   "OUT",  NUL
111E: E112    	            DW   OUT_CMD
1120: 494E00  	            DB   "IN",   NUL
1123: FF12    	            DW   IN_CMD
1125: 4A554D50	            DB   "JUMP",    NUL
1129: 00      	
112A: 1513    	            DW   GO_CMD
112C: 43414C4C	            DB   "CALL",    NUL
1130: 00      	
1131: 2213    	            DW   CALL_CMD
1133: 4800    	            DB   "H",    NUL
1135: 3313    	            DW   HELP_CMD
1137: 3F00    	            DB   "?",    NUL
1139: 3313    	            DW   HELP_CMD
113B: 49484558	            DB   "IHEX",    NUL
113F: 00      	
1140: E511    	            DW   LOAD_HEX_CMD
1142: 4932434C	            DB   "I2CLIST",    NUL
1146: 49535400	
114A: 621A    	            DW   I2CLIST
114C: 44495200	            DB   "DIR",    NUL
1150: 4A1C    	            DW   FS_DIR
1152: 52554E00	            DB   "RUN",    NUL
1156: 3F1E    	            DW   FS_EXEC
1158: 53415645	            DB   "SAVE",    NUL
115C: 00      	
115D: 791D    	            DW   FS_SAVE
115F: 44454C00	            DB   "DEL",    NUL
1163: 701E    	            DW   FS_ERASE
1165: 464F524D	            DB   "FORMAT",    NUL
1169: 415400  	
116C: CF1E    	            DW   FS_FORMAT
116E: 4C4F4144	            DB   "LOAD",    NUL
1172: 00      	
1173: D81C    	            DW   FS_LOAD_CMD
1175: 42415349	            DB   "BASIC",    NUL
1179: 4300    	
117B: 0060    	            DW   COLD
117D: 57424153	            DB   "WBASIC",    NUL
1181: 494300  	
1184: 0360    	            DW   WARM
1186: 413A00  	            DB   "A:",    NUL
1189: B511    	            DW   CHANGE_DRIVE_A
118B: 423A00  	            DB   "B:",    NUL
118E: BB11    	            DW   CHANGE_DRIVE_B
1190: 433A00  	            DB   "C:",    NUL
1193: C111    	            DW   CHANGE_DRIVE_C
1195: 443A00  	            DB   "D:",    NUL
1198: C711    	            DW   CHANGE_DRIVE_D
119A: 453A00  	            DB   "E:",    NUL
119D: CD11    	            DW   CHANGE_DRIVE_E
119F: 463A00  	            DB   "F:",    NUL
11A2: D311    	            DW   CHANGE_DRIVE_F
11A4: 473A00  	            DB   "G:",    NUL
11A7: D911    	            DW   CHANGE_DRIVE_G
11A9: 5A3A00  	            DB   "Z:",    NUL
11AC: DF11    	            DW   CHANGE_DRIVE_Z
11AE: 49324300	            DB   "I2C", NUL
11B2: DB14    	            DW   I2C_CMD
              	
11B4: 00      	            DB   NUL                 ; fim da tabela
              	
              	
              	; ============================================================
              	;  CHANGE_DRIVE_A  -  Altera drive para device A - EEDRIVE_A
              	; ============================================================
11B5:         	CHANGE_DRIVE_A:
11B5: 3EA0    	    LD A, EEDRIVE_A
11B7: 3204FC  	    LD (I2CA_BLOCK), A
11BA: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_B  -  Altera drive para device B - EEDRIVE_B
              	; ============================================================
11BB:         	CHANGE_DRIVE_B:
11BB: 3EA2    	    LD A, EEDRIVE_B
11BD: 3204FC  	    LD (I2CA_BLOCK), A
11C0: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_C  -  Altera drive para device C - EEDRIVE_C
              	; ============================================================
11C1:         	CHANGE_DRIVE_C:
11C1: 3EA4    	    LD A, EEDRIVE_C
11C3: 3204FC  	    LD (I2CA_BLOCK), A
11C6: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_D  -  Altera drive para device D - EEDRIVE_D
              	; ============================================================
11C7:         	CHANGE_DRIVE_D:
11C7: 3EA6    	    LD A, EEDRIVE_D
11C9: 3204FC  	    LD (I2CA_BLOCK), A
11CC: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_E  -  Altera drive para device E - EEDRIVE_E
              	; ============================================================
11CD:         	CHANGE_DRIVE_E:
11CD: 3EA8    	    LD A, EEDRIVE_E
11CF: 3204FC  	    LD (I2CA_BLOCK), A
11D2: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_F  -  Altera drive para device F - EEDRIVE_F
              	; ============================================================
11D3:         	CHANGE_DRIVE_F:
11D3: 3EAC    	    LD A, EEDRIVE_F
11D5: 3204FC  	    LD (I2CA_BLOCK), A
11D8: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_G  -  Altera drive para device G - EEDRIVE_G
              	; ============================================================
11D9:         	CHANGE_DRIVE_G:
11D9: 3EAE    	    LD A, EEDRIVE_G
11DB: 3204FC  	    LD (I2CA_BLOCK), A
11DE: C9      	    RET
              	
              	
              	; ============================================================
              	;  CHANGE_DRIVE_Z  -  Altera drive para device Z - EEDRIVE_Z
              	; ============================================================
11DF:         	CHANGE_DRIVE_Z:
11DF: 3EAA    	    LD A, EEDRIVE_Z
11E1: 3204FC  	    LD (I2CA_BLOCK), A
11E4: C9      	    RET
              	
              	
              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
11E5:         	LOAD_HEX_CMD;
11E5: CD7E17  	    CALL loadInit
11E8: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
11E9:         	CALL_8000:
11E9: 11B402  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
11EC: D5      	    PUSH DE
11ED: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
11F0:         	CLS_CMD:
11F0: 3E0C    	            LD A, 0CH ; FF
11F2: CDCB07  	            CALL sendCharToLCD
11F5: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
11F6:         	DUMP_CMD:
              	            ; DE aponta para argumentos
11F6: CD7B14  	            CALL PARSE_HEX16_DE      ; HL = endereço
11F9: 3836    	            JR   C, DUMP_BAD_ADDR
11FB: 22FDFB  	            LD   (ADDR_TMP), HL
              	
11FE: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
1200:         	DUMP_LINE:
1200: C5      	            PUSH BC
              	            ; Exibe endereço
1201: 2AFDFB  	            LD   HL, (ADDR_TMP)
1204: CDD214  	            CALL PRINT_HEX16
1207: 3E3A    	            LD   A, ':'
1209: CD5804  	            CALL PUTCHAR
120C: 3E20    	            LD   A, SPACE
120E: CD5804  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
1211: 2AFDFB  	            LD   HL, (ADDR_TMP)
1214: 0E05    	            LD   C, 5
1216:         	DUMP_HEX:
1216: 7E      	            LD   A, (HL)
1217: CDB714  	            CALL PRINT_HEX8
121A: 3E20    	            LD   A, SPACE
121C: CD5804  	            CALL PUTCHAR
121F: 23      	            INC  HL
1220: 0D      	            DEC  C
1221: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
1223: 2AFDFB  	            LD   HL, (ADDR_TMP)
1226: 110500  	            LD   DE, 5
1229: 19      	            ADD  HL, DE
122A: 22FDFB  	            LD   (ADDR_TMP), HL
122D: C1      	            POP  BC
122E: 10D0    	            DJNZ DUMP_LINE
1230: C9      	            RET
              	
1231:         	DUMP_BAD_ADDR:
1231: 21D515  	            LD   HL, MSG_BAD_ADDR
1234: CD6404  	            CALL PUTS
1237: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
1238:         	LOAD_CMD:
1238: CD7B14  	            CALL PARSE_HEX16_DE
123B: 3848    	            JR   C, LOAD_BAD
123D: 22FDFB  	            LD   (ADDR_TMP), HL
1240: 21FF15  	            LD   HL, MSG_LOAD_HINT
1243: CD6404  	            CALL PUTS
              	
1246:         	LOAD_LOOP:
              	            ; Exibe endereço atual
1246: 2AFDFB  	            LD   HL, (ADDR_TMP)
1249: CDD214  	            CALL PRINT_HEX16
124C: 3E3A    	            LD   A, ':'
124E: CD5804  	            CALL PUTCHAR
1251: 3E20    	            LD   A, SPACE
1253: CD5804  	            CALL PUTCHAR
              	
1256: CDBD13  	            CALL GETLINE             ; Lê linha
1259: 21A7FB  	            LD   HL, LINEBUF
125C: CD1A14  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
125F: 7E      	            LD   A, (HL)
1260: FE0D    	            CP   CR
1262: C8      	            RET  Z
1263: FE00    	            CP   NUL
1265: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
1266:         	LOAD_BYTE:
1266: CD4914  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
1269: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
126B: ED5BFDFB	            LD   DE, (ADDR_TMP)
126F: 12      	            LD   (DE), A
1270: 13      	            INC  DE
1271: ED53FDFB	            LD   (ADDR_TMP), DE
1275: CD2814  	            CALL SKIP_SPACES_HL
1278: 7E      	            LD   A, (HL)
1279: FE0D    	            CP   CR
127B: 28C9    	            JR   Z, LOAD_LOOP
127D: FE00    	            CP   NUL
127F: 28C5    	            JR   Z, LOAD_LOOP
1281: 18E3    	            JR   LOAD_BYTE
              	
1283:         	LOAD_NEXT_LINE:
1283: 18C1    	            JR   LOAD_LOOP
              	
1285:         	LOAD_BAD:
1285: 21D515  	            LD   HL, MSG_BAD_ADDR
1288: CD6404  	            CALL PUTS
128B: C9      	            RET
              	
              	; ============================================================
              	;  EDIT_CMD  -  Edita memória byte a byte
              	;  Sintaxe: EDIT xxxx
              	;  Exibe: XXXX: AA  _  (digitar novo valor ou Enter p/ manter)
              	;  '.' encerra
              	; ============================================================
128C:         	EDIT_CMD:
128C: CD7B14  	            CALL PARSE_HEX16_DE
128F: 3849    	            JR   C, EDIT_BAD
1291: 22FDFB  	            LD   (ADDR_TMP), HL
              	
1294:         	EDIT_LOOP:
1294: 2AFDFB  	            LD   HL, (ADDR_TMP)
1297: CDD214  	            CALL PRINT_HEX16
129A: 3E3A    	            LD   A, ':'
129C: CD5804  	            CALL PUTCHAR
129F: 3E20    	            LD   A, SPACE
12A1: CD5804  	            CALL PUTCHAR
12A4: 7E      	            LD   A, (HL)             ; Valor atual
12A5: CDB714  	            CALL PRINT_HEX8
12A8: 3E20    	            LD   A, SPACE
12AA: CD5804  	            CALL PUTCHAR
12AD: 3E20    	            LD   A, SPACE
12AF: CD5804  	            CALL PUTCHAR
              	
              	            ; Lê até 3 chars (2 hex + CR)
12B2: CDBD13  	            CALL GETLINE
12B5: 21A7FB  	            LD   HL, LINEBUF
12B8: CD1A14  	            CALL SKIP_SPACES
              	
12BB: 7E      	            LD   A, (HL)
12BC: FE2E    	            CP   '.'                 ; '.' = sair
12BE: C8      	            RET  Z
12BF: FE0D    	            CP   CR
12C1: 280E    	            JR   Z, EDIT_KEEP       ; Enter = mantém byte
12C3: FE00    	            CP   NUL
12C5: 280A    	            JR   Z, EDIT_KEEP
              	
              	            ; Tenta parsear novo byte
12C7: CD4914  	            CALL PARSE_HEX8_HL
12CA: 38C8    	            JR   C, EDIT_LOOP       ; Hex inválido: repete
              	
              	            ; Grava novo byte
12CC: ED5BFDFB	            LD   DE, (ADDR_TMP)
12D0: 12      	            LD   (DE), A
              	
12D1:         	EDIT_KEEP:
12D1: 2AFDFB  	            LD   HL, (ADDR_TMP)
12D4: 23      	            INC  HL
12D5: 22FDFB  	            LD   (ADDR_TMP), HL
12D8: 18BA    	            JR   EDIT_LOOP
              	
12DA:         	EDIT_BAD:
12DA: 21D515  	            LD   HL, MSG_BAD_ADDR
12DD: CD6404  	            CALL PUTS
12E0: C9      	            RET
              	
              	; ============================================================
