              	; Fill a block I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             L = BYTE to Fill
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; pages.
1D19: C5      	I2C_MemFill:  PUSH BC
1D1A: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D1D:         	I2C_MemFillRepeat:    
1D1D: 3A1BFC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D20: CDDB1A  	            CALL I2C_Open       ;Open for write
1D23: 280A    	            JR   Z,I2C_MemFillReady       ;If open okay then skip on
1D25: 0B      	            DEC  BC
1D26: 78      	            LD   A,B
1D27: B1      	            OR   C              ;Timeout?
1D28: 20F3    	            JR   NZ,I2C_MemFillRepeat     ;No, so go try again
1D2A: C1      	            POP  BC
1D2B: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D2D: B7      	            OR   A              ;Error, so NZ flagged
1D2E: C9      	            RET                 ;Return with error
              	; Device opened okay
1D2F: C1      	I2C_MemFillReady:     POP  BC             ;Restore byte counter
1D30: 7A      	I2C_MemFillBlock:     LD   A,D            ;Address (hi) in I2C memory
1D31: CDEF1A  	            CALL I2C_Write      ;Write address
1D34: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D35: CDEF1A  	            CALL I2C_Write      ;Write address
1D38: 7D      	I2C_MemFillWrite:     LD   A, L         ;Get data byte to fill
1D39: CDEF1A  	            CALL I2C_Write      ;Read byte from I2C memory
1D3C: 13      	            INC  DE             ;Increment I2C memory pointer
1D3D: 0B      	            DEC  BC             ;Decrement byte counter
1D3E: 78      	            LD   A,B
1D3F: B1      	            OR   C              ;Finished?
1D40: 2805    	            JR   Z,I2C_MemFillStore       ;Yes, so go store this page
1D42: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1D43: E63F    	            AND  63             ;64 byte page boundary?
1D45: 20F1    	            JR   NZ,I2C_MemFillWrite      ;No, so go write another byte
1D47: CD641B  	I2C_MemFillStore:     CALL I2C_Stop       ;Generate I2C stop
1D4A: 78      	            LD   A,B
1D4B: B1      	            OR   C              ;Finished?
1D4C: 20CB    	            JR   NZ,I2C_MemFill   ;No, so go write some more
1D4E: C9      	            RET  
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1D4F: C5      	I2C_MemRd:  PUSH BC
1D50: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D53:         	I2C_MemRdRepeat:    
1D53: 3A1BFC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D56: CDDB1A  	            CALL I2C_Open       ;Open for write
1D59: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
1D5B: 0B      	            DEC  BC
1D5C: 78      	            LD   A,B
1D5D: B1      	            OR   C              ;Timeout?
1D5E: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1D60: C1      	            POP  BC
1D61: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D63: B7      	            OR   A              ;Error, so NZ flagged
1D64: C9      	            RET                 ;Return with error
              	; Device opened okay
1D65: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1D66: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1D67: CDEF1A  	            CALL I2C_Write      ;Write address
1D6A: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D6B: CDEF1A  	            CALL I2C_Write      ;Write address
1D6E: 3A1BFC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1D71: 3C      	            INC  A              ; Device read equal DeviceId+1
1D72: CDDB1A  	            CALL I2C_Open       ;Open for read
1D75: C0      	            RET  NZ             ;Abort if error
1D76: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1D77: 78      	            LD   A,B
1D78: B1      	            OR   C              ;Last byte to be read?
1D79: CD2C1B  	            CALL I2C_Read       ;Read byte with no ack on last byte
1D7C: 77      	            LD   (HL),A         ;Write byte in CPU memory
1D7D: 23      	            INC  HL             ;Increment CPU memory pointer
1D7E: 78      	            LD   A,B
1D7F: B1      	            OR   C              ;Finished?
1D80: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1D82: CD641B  	            CALL I2C_Stop       ;Generate I2C stop
1D85: AF      	            XOR  A              ;Return with success (Z flagged)
1D86: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1D87: C5      	I2C_MemWr:  PUSH BC
1D88: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D8B:         	I2C_MemWrRepeat:    
1D8B: 3A1BFC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D8E: CDDB1A  	            CALL I2C_Open       ;Open for write
1D91: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1D93: 0B      	            DEC  BC
1D94: 78      	            LD   A,B
1D95: B1      	            OR   C              ;Timeout?
1D96: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1D98: C1      	            POP  BC
1D99: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D9B: B7      	            OR   A              ;Error, so NZ flagged
1D9C: C9      	            RET                 ;Return with error
              	; Device opened okay
1D9D: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1D9E: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1D9F: CDEF1A  	            CALL I2C_Write      ;Write address
1DA2: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1DA3: CDEF1A  	            CALL I2C_Write      ;Write address
1DA6: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1DA7: CDEF1A  	            CALL I2C_Write      ;Read byte from I2C memory
1DAA: 23      	            INC  HL             ;Increment CPU memory pointer
1DAB: 13      	            INC  DE             ;Increment I2C memory pointer
1DAC: 0B      	            DEC  BC             ;Decrement byte counter
1DAD: 78      	            LD   A,B
1DAE: B1      	            OR   C              ;Finished?
1DAF: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1DB1: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1DB2: E63F    	            AND  63             ;64 byte page boundary?
1DB4: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1DB6: CD641B  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1DB9: 78      	            LD   A,B
1DBA: B1      	            OR   C              ;Finished?
1DBB: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1DBD: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1DBE: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1DBF: 1F      	            RRA                 ;Shift top nibble to
1DC0: 1F      	            RRA                 ;  botom four bits..
1DC1: 1F      	            RRA
1DC2: 1F      	            RRA
1DC3: E60F    	            AND  $0F           ;Mask off unwanted bits
1DC5: CDCB1D  	            CALL HexOutHex           ;Output hi nibble
1DC8: F1      	            POP  AF             ;Restore byte to be output
1DC9: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1DCB: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1DCD: 3802    	            JR   C,HexOutSkip        ;No, so skip
1DCF: C607    	            ADD  A,7            ;Yes, so add 7
1DD1: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1DD3: CDF704  	            CALL CONOUT       ;Write character
1DD6: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5        ; Assinatura da EEPROM formatada
0000:         	FS_PG_BMP:  .EQU $00        ; Número da página do bitmap
0001:         	FS_PG_DIR:  .EQU $01        ; Número da página do diretório
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8          ; Máximo de arquivos
0020:         	FS_ENTRY_SZ:.EQU 32         ; Bytes por entrada do diretório
0010:         	FS_NAME_SZ: .EQU 16         ; Bytes do nome
00FF:         	FS_DATAPG:  .EQU 255        ; Bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF      ; Slot do diretório livre
0001:         	FS_FLAG_USED: .EQU $01      ; Slot do diretório usado - File
0002:         	FS_FLAG_USED_FOLDER: .EQU $02      ; Slot do diretório usado - Folder
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0          ; Nome (16 bytes)
0010:         	FS_O_FSTPG: .EQU 16         ; Primeira página de dados
0011:         	FS_O_SIZEH: .EQU 17         ; Tamanho hi
0012:         	FS_O_SIZEL: .EQU 18         ; Tamanho lo
0013:         	FS_O_RADRH: .EQU 19         ; Load RAM hi
0014:         	FS_O_RADRL: .EQU 20         ; Load RAM lo
0015:         	FS_O_FLAGS: .EQU 21         ; Flags ($FF=livre, $01=usado por arquivo, $02=usado por pasta)
              	
              	
              	
              	
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; FS_INFO - Espaco usado/livre da EEPROM
              	;   Le bitmap, conta paginas, imprime barra e valores
              	; **********************************************************************
1DD7:         	FS_INFO:
1DD7: CD1305  	    CALL CRLF
1DDA: 213B27  	    LD HL, str_info_hdr
1DDD: CD0305  	    CALL PUTS
              	
              	    ; Le 16 bytes do bitmap (bytes 1..16 da pagina 0)
1DE0: 110100  	    LD DE, $0001
1DE3: 2159FC  	    LD HL, PG_BUF
1DE6: 011000  	    LD BC, 16
1DE9: CD4F1D  	    CALL I2C_MemRd
1DEC: C2B625  	    JP NZ, FS_ERR_I2C
              	
              	    ; Conta paginas livres (bits=1) → C
1DEF: 2159FC  	    LD HL, PG_BUF
1DF2: 0610    	    LD B, 16
1DF4: 0E00    	    LD C, 0
1DF6:         	FS_INF_CNT:
1DF6: 7E      	    LD A, (HL)
1DF7: 23      	    INC HL
1DF8: 1608    	    LD D, 8
1DFA:         	FS_INF_BIT:
1DFA: 0F      	    RRCA
1DFB: 3001    	    JR NC, FS_INF_NB
1DFD: 0C      	    INC C
1DFE:         	FS_INF_NB:
1DFE: 15      	    DEC D
1DFF: 20F9    	    JR NZ, FS_INF_BIT
1E01: 10F3    	    DJNZ FS_INF_CNT
              	
              	    ; C = pags livres (0..126)
              	    ; paginas usadas = 126 - C → salva em E
1E03: 3E7E    	    LD A, 126
1E05: 91      	    SUB C
1E06: 5F      	    LD E, A                 ; E = paginas usadas
              	
              	    ; === Linha 1: barra visual ===
              	    ; Formato: "[##########..........] UUh/7Eh pags"
              	    ; Barra de 19 chars: cada char = ~6.6 pags
              	    ; chars_usados = E * 19 / 126
              	    ;   = E / 6  (aproximacao boa o suficiente para barra)
1E07: 7B      	    LD A, E
1E08: 0600    	    LD B, 0                 ; B = chars usados
1E0A:         	FS_INF_DIV6:
1E0A: FE06    	    CP 6
1E0C: 3805    	    JR C, FS_INF_DIV6_DONE
1E0E: D606    	    SUB 6
1E10: 04      	    INC B
1E11: 18F7    	    JR FS_INF_DIV6
1E13:         	FS_INF_DIV6_DONE:
              	    ; B = chars usados (0..21, clamp a 20)
1E13: 78      	    LD A, B
1E14: FE15    	    CP 21
1E16: 3802    	    JR C, FS_INF_CLAMP
1E18: 0613    	    LD B, 19
