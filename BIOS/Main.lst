0276:         	INICIO:
0276: 21B301  	    LD HL, INT_DEFAULT
0279: 2200F0  	    LD (RST38), HL
027C: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
027F: 3EA0    	    LD A, EEDRIVE_A
0281: 3204FC  	    LD (I2CA_BLOCK), A     
              	
