              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
2746: CD8019  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
2749: 47      	    LD   B,A	; Load it in B
274A: CD8019  	    CALL GETCHR_S	; Get us another character
274D: 4F      	    LD   C,A	; load it in C
274E: CD9C19  	    CALL BCTOA	; Convert ASCII to byte
