              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
1396:         	SKIP_COMMAND_DE:
1396: 1A      				LD A, (DE)
1397: FE20    				CP SPACE
1399: C8      				RET Z
139A: 13      				INC DE
139B: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
139D:         	SKIP_SPACES:
139D: 7E      	            LD   A, (HL)
139E: FE20    	            CP   SPACE
13A0: C0      	            RET  NZ
13A1: 23      	            INC  HL
13A2: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
13A4:         	SKIP_SPACES_DE:
13A4: 1A      	            LD   A, (DE)
13A5: FE20    	            CP   SPACE
13A7: C0      	            RET  NZ
13A8: 13      	            INC  DE
13A9: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
13AB:         	SKIP_SPACES_HL:
13AB: 7E      	            LD   A, (HL)
13AC: FE20    	            CP   SPACE
13AE: C0      	            RET  NZ
13AF: 23      	            INC  HL
13B0: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
13B2:         	IS_HEX:
13B2: FE30    	            CP   '0'
13B4: 3814    	            JR   C, IS_HEX_BAD
13B6: FE3A    	            CP   '9'+1
13B8: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
13BA: E6DF    	            AND  0DFH               ; Uppercase
13BC: FE41    	            CP   'A'
13BE: 380A    	            JR   C, IS_HEX_BAD
13C0: FE47    	            CP   'F'+1
13C2: 3006    	            JR   NC, IS_HEX_BAD
13C4: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
13C6: C9      	            RET
13C7:         	IS_HEX_DIG:
13C7: D630    	            SUB  '0'
13C9: C9      	            RET
13CA:         	IS_HEX_BAD:
13CA: 37      	            SCF
13CB: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
13CC:         	PARSE_HEX8_HL:
13CC: 7E      	            LD   A, (HL)
13CD: CDB213  	            CALL IS_HEX
13D0: D8      	            RET  C
13D1: 0F      	            RRCA
13D2: 0F      	            RRCA
13D3: 0F      	            RRCA
13D4: 0F      	            RRCA
13D5: E6F0    	            AND  0F0H
13D7: 47      	            LD   B, A
13D8: 23      	            INC  HL
13D9: 7E      	            LD   A, (HL)
13DA: CDB213  	            CALL IS_HEX
13DD: 3803    	            JR   C, PHX8_ERR
13DF: B0      	            OR   B
13E0: 23      	            INC  HL
13E1: C9      	            RET
13E2:         	PHX8_ERR:
13E2: 2B      	            DEC  HL
13E3: 37      	            SCF
13E4: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
13E5:         	PARSE_HEX8_DE:
13E5: 1A      	            LD   A, (DE)
13E6: CDB213  	            CALL IS_HEX
13E9: D8      	            RET  C
13EA: 0F      	            RRCA
13EB: 0F      	            RRCA
13EC: 0F      	            RRCA
13ED: 0F      	            RRCA
13EE: E6F0    	            AND  0F0H
13F0: 47      	            LD   B, A
13F1: 13      	            INC  DE
13F2: 1A      	            LD   A, (DE)
13F3: CDB213  	            CALL IS_HEX
13F6: 3803    	            JR   C, PHX8D_ERR
13F8: B0      	            OR   B
13F9: 13      	            INC  DE
13FA: C9      	            RET
13FB:         	PHX8D_ERR:
13FB: 1B      	            DEC  DE
13FC: 37      	            SCF
13FD: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
13FE:         	PARSE_HEX16_DE:
13FE: CDE513  	            CALL PARSE_HEX8_DE
1401: D8      	            RET  C
1402: 67      	            LD   H, A
1403: CDE513  	            CALL PARSE_HEX8_DE
1406: D8      	            RET  C
1407: 6F      	            LD   L, A
1408: C9      	            RET
              	
