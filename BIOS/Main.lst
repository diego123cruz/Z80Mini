              	; Char is in A, NC if char is 0 or 1
7C23: 13      	CHKBIN: INC     DE
7C24: 1A      	        LD      A,(DE)
7C25: FE20    	        CP      ' '
7C27: CA237C  	        JP      Z,CHKBIN        ; Skip spaces
7C2A: FE30    	        CP      '0'             ; Set C if < '0'
7C2C: D8      	        RET     C
7C2D: FE32    	        CP      '2'
7C2F: 3F      	        CCF                     ; Set C if > '1'
7C30: C9      	        RET
              	
7C31: 1E28    	BINERR: LD      E,BN            ; ?BIN Error
7C33: C3A863  	        JP      ERROR
              	
              	
7C36:         	JJUMP1: 
7C36: DD21FFFF	        LD      IX,-1           ; Flag cold start
7C3A: C31160  	        JP      CSTART          ; Go and initialise
              	
7C3D:         	MONOUT: 
7C3D: C30800  	        JP      $0008           ; output a char
              	
              	
7C40:         	MONITR: 
7C40: C30000  	        JP      $0000           ; Restart (Normally Monitor Start)
              	
              	
7C43: 3E00    	INITST: LD      A,0             ; Clear break flag
7C45: 324D80  	        LD      (BRKFLG),A
7C48: C31860  	        JP      INIT
              	
7C4B: ED45    	ARETN:  RETN                    ; Return from NMI
              	
              	
7C4D: F5      	TSTBIT: PUSH    AF              ; Save bit mask
7C4E: A0      	        AND     B               ; Get common bits
7C4F: C1      	        POP     BC              ; Restore bit mask
7C50: B8      	        CP      B               ; Same bit set?
7C51: 3E00    	        LD      A,0             ; Return 0 in A
7C53: C9      	        RET
              	
7C54: CD6D66  	OUTNCR: CALL    OUTC            ; Output character in A
7C57: C3A46A  	        JP      PRNTCRLF        ; Output CRLF
              	
7C5A:         	EELOAD:
7C5A: F5      	        PUSH AF
7C5B: E5      	        PUSH HL
7C5C: D5      	        PUSH DE
7C5D: C5      	        PUSH BC
              	
7C5E: 110000  	        LD DE, $0000
7C61: 210080  	        LD HL, $8000 ; BASIC
7C64: 010020  	        LD BC, $2000 ; copy 8kb from EEPROM I2C
              	        ;CALL I2CMEMTOCPU_BASIC
              	
7C67: 3E0D    	        LD A, CR ; new line
7C69: CD3D7C  	        CALL MONOUT
              	
7C6C: C1      	        POP BC
7C6D: D1      	        POP DE
7C6E: E1      	        POP HL
7C6F: F1      	        POP AF 
7C70: C9      	        RET
              	
              	
7C71:         	EESAVE:
7C71: F5      	        PUSH AF
7C72: E5      	        PUSH HL
7C73: D5      	        PUSH DE
7C74: C5      	        PUSH BC
              	
7C75: 210080  	        LD HL, $8000
7C78: 110000  	        LD DE, $0000
7C7B: 010020  	        LD BC, $2000 ; save 8kb to EEPROM I2C
              	        ;CALL I2CCPUTOMEM_BASIC
              	
7C7E: 3E0D    	        LD A, CR ; new line
7C80: CD3D7C  	        CALL MONOUT
              	
7C83: C1      	        POP BC
7C84: D1      	        POP DE
7C85: E1      	        POP HL
7C86: F1      	        POP AF
7C87: C9      	        RET
              	
              	
7C88:         	diego:
7C88: 3E01    	        LD a, 1
7C8A: D310    	        OUT($10),A
7C8C: C3DF63  	        JP PRNTOK
              	
7C8F:         	cruz:
7C8F: CDCA73  	        CALL GETINT
7C92: 7B      	        LD A, E
7C93: D310    	        OUT($10), A 
7C95: C9      	        RET
7C96: C3DF63  	        JP PRNTOK
              	
              	;.end
              	
              	
              	
              	; RAM AREA
              	.ORG $F000              ;Start location
F000: 0000    	RST38:	DW 0000H 	    ;INT INTERRUPT JUMP
F002: 0000    	RST66:	DW 0000H 	    ;NMI INTERRUPT JUMP
              	
              	; DISPLAY GRAFICO
0780:         	SBUF:   EQU 16 * $78     ;Scroll Buffer size  16 * 60 = 960 byte (10 lines), change to 20 lines (16 * 120($78))
F004: FFFFFFFF	        DS SBUF         ;Scroll Buffer space abover GBUF 
F008: FF...   	
F784: FFFFFFFF	GBUF:   DS 0400H        ;Graphics Buffer 16 * 64 = 1024 byte
F788: FF...   	
F784:         	TGBUF:  EQU GBUF        ;Terminal GBUF
FB84: 84F7    	VPORT:  DW GBUF         ;View port start address
FB86: 84F7    	TBUF:   DW GBUF         ;Top of Buffer pointer
FB88: 0000    	ENDPT:  DW 0000H        ;End Point for Line
FB8A: 00      	SX:     DB 00H          ;Sign of X
FB8B: 00      	SY:     DB 00H          ;Sign of Y
FB8C: 0000    	DX:     DW 0000H        ;Change of X
FB8E: 0000    	DY:     DW 0000H        ;Change of Y
FB90: 0000    	ERR:    DW 0000H        ;Error Rate
FB92: 0000    	RAD:    DW 0000H        ;Radius
FB94: 00      	CLRBUF: DB 00H          ;Clear Buffer Flag on LCD Displaying
FB95: 0000    	CURSOR_XY: DW 0000H     ;Cursor Address X,Y
FB95:         	CURSOR_Y: EQU CURSOR_XY   ;Cursor Y
FB96:         	CURSOR_X: EQU CURSOR_XY+1 ;Cursor X
FB97: 00      	CURSOR_YS: DB 00H       ;Start Y row for new line
FB98: 00      	CURSOR_ON: DB 00H       ;Cursor on/off flag
FB99: 00      	INVERSE: DB 00H         ;Inverse Flag
FB9A: 00      	PIXEL_X: DB 00H         ;Pixel X length
FB9B: 00      	ULINE: DB 00H   ;Underline flag
FB9C: 00      	AUTO_LF: DB 00H   ;Auto line feed flag
FB9D: 00      	PLOT_ALWAYS: DB 00H   ;Plot always flag
              	
              	; PORTA SERIAL
FB9E: 0000    	PUTCH:  DW  0000H       ; Serial
FBA0: 0000    	GETCH:  DW  0000H       ; Serial
              	
              	; TECLADO
FBA2: 00      	MEN_SHIFT: DB 00H
FBA3: 00      	MEN_CAPSL: DB 00H
FBA4: 00      	KEY_PRESS: DB 00H
              	
              	; COMANDOS
FBA5: FFFFFFFF	LINEBUF:    DS 80          ; Buffer de linha de comando
FBA9: FF...   	
FBF5: FFFFFFFF	HEXBUF:     DS 6           ; Buffer temporário hex
FBF9: FFFF    	
FBFB: 0000    	ADDR_TMP:   DW $0000       ; Endereço temporário de trabalho
              	
              	; IHEX
FBFD: FF      	LOAD_FIRST_FLAG:    .DB    $FF   ; FF=virgem  01=primeira linha  00=demais
FBFE: 0000    	LOAD_START_ADDR:    .DW    $0000 ; Endereco inicial do carregamento
FC00: 0000    	LOAD_END_ADDR:      .DW    $0000 ; Endereco final do carregamento
              	
              	; I2C
FC02: 00      	I2CA_BLOCK:         .DB    $00   ; I2C device addess: 24LC256 (Copy from/to Mem) dir, del, save, load
FC03: 00      	I2C_RAMCPY:         .DB    $00   ; 1 byte - RAM copy of output port
FC04: 00      	I2C_ADDR            .DB    $00   ; 1 byte - device address
FC05: 00      	I2C_RR              .DB    $00   ; 1 byte - register
FC06: 00      	I2C_DD              .DB    $00   ; 1 byte - data
              	
              	; FS
FC07: 00      	FS_CUR:     .DB $00         ; 1b: entrada corrente do dir
FC08: FFFFFFFF	FS_WRKBUF:  .DS $20         ; 32b: buffer entrada dir
FC0C: FF...   	
FC28: FFFFFFFF	FS_NAMBUF:  .DS $0F         ; 9b: nome digitado
FC2C: FF...   	
FC37: 00      	FS_TMP1:    .DB $00         ; 1b: uso geral
FC38: 0000    	FS_TMPSZ:   .DW $0000       ; 2b: tamanho restante
FC3A: 0000    	FS_TMPRAM:  .DW $0000       ; 2b: ponteiro RAM atual
FC3C: 00      	FS_CURPG:   .DB $00         ; 1b: pagina corrente
FC3D: 00      	FS_SLOTBK:  .DB $00         ; 1b: backup slot dir
FC3E: 00      	FS_BMPADDR: .DB $00         ; 1b: endereco EEPROM do byte do bitmap
FC3F: 00      	FS_INFOTMP: .DB $00         ; 1b: temp para FS_INFO (paginas livres)
              	; Buffer de pagina em RAM (256 bytes) - longe do codigo
FC40: FFFFFFFF	PG_BUF:     .DS $FF
FC44: FF...   	
              	
              	; pixel collision
FD3F: 00      	DRAW_PIXEL_COLLISION: .DB $00 ; 0 - reset, 1 - set
FD40: FF      	I2C_ADDR7:  DS 1
FD41: FF      	I2C_STATE:  DS 1   ; 0=fechado, 1=aberto p/ write, 2=aberto p/ read
              	
