              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
148F:         	SKIP_COMMAND_DE:
148F: 1A      				LD A, (DE)
1490: FE20    				CP SPACE
1492: C8      				RET Z
1493: 13      				INC DE
1494: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
1496:         	SKIP_SPACES:
