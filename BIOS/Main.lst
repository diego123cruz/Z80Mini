0A5F: 23      	        INC HL              ;move to next pixel byte
0A60: D1      	        POP DE              ;restore Column/Row bit count
0A61: 7A      	        LD A,D
0A62: B7      	        OR A                ;check for zero or lessor
0A63: 2803    	        JR Z,$+5
