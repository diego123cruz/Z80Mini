01A8: C3EA1A  	    JP I2C_OpenWrite
              	
              	
01AB:         	SET_INT38:
01AB: 2200F0  	    LD (RST38), HL
01AE: C9      	    RET
              	
01AF:         	SET_INT66:
01AF: 2202F0  	    LD (RST66), HL
01B2: C9      	    RET
              	
              	; exemplo de uso de interrupcao
              	; IM 1
              	; EI
              	; RETI
01B3:         	INT_DEFAULT:
01B3: E1      	    POP HL ; sempre usar o POP HL
              	    ; faz alguma coisa
              	    ; EI
01B4: ED4D    	    RETI
              	
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; KEYMAPS  (índice = coluna*8 + linha)
              	; ============================================================
              	;   $FF - Capslock          (tratado internamente, não é retornado)
              	;   $FE - Shift left        (modificador, não é retornado)
              	;   $FD - Ctrl left         (modificador, não é retornado)
              	;   $FC - Windows           (não é retornado)
              	;   $FB - Alt left          (não é retornado)
              	;   $FA - Alt Gr    (Load intel hex - Serial A)
              	;   $F9 - LUZ       (CALL 8000H)
              	;   $F8 - Shift Right   (Display Scroll UP)
              	;   $F7 - Ctrl Right    (Display Scroll DOWN)
              	;   $F6 - Fn                (não é retornado)
              	;
              	
              	
01B6:         	KEYMAP_NORMAL:
01B6: 1B09FFFE	    DB  $1B,  $09,  $FF,  $FE,  $FD,  $FC,  $FB,  $20
01BA: FDFCFB20	
01BE: 3171615C	    DB   '1', 'q',  'a',  '\',  $00,  $FA,  $F6,  $F9
01C2: 00FAF6F9	
01C6: 33656478	    DB   '3', 'e',  'd',  'x',  ',',  'l',  'o',  '9'
