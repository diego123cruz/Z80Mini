              	#include "IHEX.asm"
              	
              	
187D:         	loadInit:
187D: 3EFF    	    LD A, $FF
187F: 32FDFB  	    LD (LOAD_FIRST_FLAG), A
              	
1882: 21411A  	    LD HL, MSG_LOAD_HELP
1885: CDE219  	    CALL SERIAL_A_PRINT_STRING
              	
1888: 11431A  	    LD DE, MSG_LOAD_HELP_LCD
188B: CD8208  	    CALL sendStringToLCD
              	
188E:         	loopHexLoad:
188E: CDD010  	    CALL RXDATA
              	
1891: FE3A    	    CP   ':'	; ":"?
1893: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
1895: 3AFDFB  		LD   A, (LOAD_FIRST_FLAG)
1898: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
189A: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
189C: 3E01    		LD   A, $01
189E: 32FDFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
18A1:         	monitor_do_load:
18A1: CDB218  		CALL    LOAD
18A4: CDEB19  		CALL SERIAL_A_TXCRLF
18A7: C38E18  	    JP loopHexLoad
              	
              	
18AA:         	CALL_IHEX:
18AA: 21C702  		LD HL, MAIN_LOOP
18AD: E5      		PUSH HL
18AE: CD7D18  		CALL loadInit
18B1: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
18B2:         	LOAD:
18B2: 1E00    			LD   E,0	        ; Zera checksum
18B4: CD9019  			CALL GET2	        ; Record Length -> D
18B7: 57      			LD   D,A
18B8: CD9019  			CALL GET2	        ; Endereco High -> H
18BB: 67      			LD   H,A
18BC: CD9019  			CALL GET2	        ; Endereco Low -> L
18BF: 6F      			LD   L,A
18C0: CD9019  			CALL GET2	        ; Record Type -> A
18C3: FE01    			CP   $01	        ; EOF record?
18C5: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
18C7: CD9019  			CALL GET2	        ; Consome checksum do EOF
18CA: 7B      			LD   A,E
18CB: A7      			AND  A
18CC: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
18CE: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
18D0:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
18D0: 3AFDFB  			LD   A, (LOAD_FIRST_FLAG)
18D3: FE01    			CP   $01                    ; e a primeira linha?
18D5: 2008    			JR   NZ, LOAD2_SKIP
18D7: 3E00    			LD   A, $00
18D9: 32FDFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
18DC: 22FEFB  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
18DF:         	LOAD2_SKIP:
18DF: 7A      			LD   A,D	        ; Contador de bytes da linha
18E0: A7      			AND  A
18E1: 280D    			JR   Z,LOAD3
              	
18E3: CD9019  			CALL GET2	        ; Le proximo byte
18E6: 77      			LD   (HL),A	        ; Grava na memoria
18E7: 23      			INC  HL
18E8: 3E2E    			LD   A,'.'
18EA: CDA310  			CALL OUTCH
18ED: 15      			DEC  D
18EE: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
18F0:         	LOAD3:
18F0: 2200FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
18F3: CD9019  			CALL GET2	                ; Consome checksum da linha
18F6: 7B      			LD   A,E
18F7: A7      			AND  A
18F8: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
18F9:         	LOADERR:
18F9: 21F619  			LD   HL,CKSUMERR
18FC: CDE219  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
18FF: 11F619  	        LD   DE, CKSUMERR
1902: CD8208  	        CALL sendStringToLCD
              	
1905: E1      	        POP HL
              	
1906: C9      			RET
              	
1907:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
1907: 21071A  			LD   HL, LDETXT
190A: CDE219  			CALL SERIAL_A_PRINT_STRING
              	
190D: 21261A  			LD   HL, msg_load_start
1910: CDE219  			CALL SERIAL_A_PRINT_STRING
1913: 2AFEFB  			LD   HL, (LOAD_START_ADDR)
1916: CDBA19  			CALL SERIAL_A_PRINT_HL_HEX
1919: CDEB19  			CALL SERIAL_A_TXCRLF
              	
191C: 212F1A  			LD   HL, msg_load_end
191F: CDE219  			CALL SERIAL_A_PRINT_STRING
1922: 2A00FC  			LD   HL, (LOAD_END_ADDR)
1925: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1926: CDBA19  			CALL SERIAL_A_PRINT_HL_HEX
1929: CDEB19  			CALL SERIAL_A_TXCRLF
              	
192C: 21381A  			LD   HL, msg_load_total
192F: CDE219  			CALL SERIAL_A_PRINT_STRING
1932: ED5BFEFB			LD   DE, (LOAD_START_ADDR)
1936: 2A00FC  			LD   HL, (LOAD_END_ADDR)
1939: B7      			OR   A                      ; limpa carry flag
193A: ED52    			SBC  HL, DE                 ; HL = total de bytes
193C: CDBA19  			CALL SERIAL_A_PRINT_HL_HEX
193F: CDEB19  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
1942: 11201A  	        LD   DE, LDETXTLCD
1945: CD8208  	        CALL sendStringToLCD
              	
1948: 11261A  	        LD   DE, msg_load_start
194B: 3E00    	        LD   A, 0
194D: CD8208  			CALL sendStringToLCD
1950: 2AFEFB  			LD   HL, (LOAD_START_ADDR)
1953: CDC608  			CALL sendHLToLCD
1956: CDBB04  			CALL CRLF
              	
1959: 112F1A  			LD   DE, msg_load_end
195C: 3E00    	        LD   A, 0
195E: CD8208  			CALL sendStringToLCD
1961: 2A00FC  			LD   HL, (LOAD_END_ADDR)
1964: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1965: CDC608  			CALL sendHLToLCD
1968: CDBB04  			CALL CRLF
              	
196B: 11381A  			LD   DE, msg_load_total
196E: 3E00    	        LD   A, 0
1970: CD8208  			CALL sendStringToLCD
1973: ED5BFEFB			LD   DE, (LOAD_START_ADDR)
1977: 2A00FC  			LD   HL, (LOAD_END_ADDR)
197A: B7      			OR   A                      ; limpa carry flag
197B: ED52    			SBC  HL, DE                 ; HL = total de bytes
197D: CDC608  			CALL sendHLToLCD
              	
1980: CDBB04  	        CALL CRLF
              	
1983: E1      	        POP HL 
1984: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
1985: CDA910  	GETCHR_S:	CALL INCH	; RX a Character
1988: FE03    			CP   $03	; <ctrl-c> User break?
198A: C8      			RET  Z			
198B: FE20    			CP   $20	; <space> or better?
198D: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
198F: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
1990: CD8519  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
1993: 47      			LD   B,A	; Load it in B
1994: CD8519  			CALL GETCHR_S	; Get us another character
1997: 4F      			LD   C,A	; load it in C
1998: CDA119  			CALL BCTOA	; Convert ASCII to byte
199B: 4F      			LD   C,A	; Build the checksum
199C: 7B      			LD   A,E
199D: 91      			SUB  C		; The checksum should always equal zero when checked
199E: 5F      			LD   E,A	; Save the checksum back where it came from
199F: 79      			LD   A,C	; Retrieve the byte and go back
19A0: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
19A1: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
19A2: D630    			SUB  $30	; Take it down from Ascii
19A4: FE0A    			CP   $0A	; Are we in the 0-9 range here?
19A6: 3802    			JR   C,BCTOA1	; If so, get the next nybble
19A8: D607    			SUB  $07	; But if A-F, take it down some more
19AA: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
19AB: 07      			RLCA		; One bit at a time
19AC: 07      			RLCA		; Until we
19AD: 07      			RLCA		; Get there with it
19AE: 47      			LD   B,A	; Save the converted high nybble
19AF: 79      			LD   A,C	; Now get the low order byte
19B0: D630    			SUB  $30	; Convert it down from Ascii
19B2: FE0A    			CP   $0A	; 0-9 at this point?
19B4: 3802    			JR   C,BCTOA2	; Good enough then, but
19B6: D607    			SUB  $07	; Take off 7 more if it's A-F
19B8: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
19B9: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
19BA:         	SERIAL_A_PRINT_HL_HEX:
19BA: 7C      			LD   A, H
19BB: CDC319  			CALL SERIAL_A_PRINT_A_HEX
19BE: 7D      			LD   A, L
19BF: CDC319  			CALL SERIAL_A_PRINT_A_HEX
19C2: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
19C3:         	SERIAL_A_PRINT_A_HEX:
19C3: F5      			PUSH AF
19C4: 0F      			RRCA
19C5: 0F      			RRCA
19C6: 0F      			RRCA
19C7: 0F      			RRCA
19C8: CDD019  			CALL SERIAL_A_PRINT_NIBBLE
19CB: F1      			POP  AF
19CC: CDD019  			CALL SERIAL_A_PRINT_NIBBLE
19CF: C9      			RET
              	
19D0:         	SERIAL_A_PRINT_NIBBLE:
19D0: E60F    			AND  $0F
19D2: FE0A    			CP   $0A
19D4: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
19D6: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
19D8: CDA310  			CALL OUTCH
19DB: C9      			RET
19DC:         	SERIAL_A_PRINT_NIBBLE_09:
19DC: C630    			ADD  A, $30             ; 0-9
