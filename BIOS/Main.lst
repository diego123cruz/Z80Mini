              	#include "IHEX.asm"
              	
              	
18D5:         	loadInit:
18D5: 3EFF    	    LD A, $FF
18D7: 3216FC  	    LD (LOAD_FIRST_FLAG), A
              	
18DA: 21991A  	    LD HL, MSG_LOAD_HELP
18DD: CD3A1A  	    CALL SERIAL_A_PRINT_STRING
              	
18E0: 119B1A  	    LD DE, MSG_LOAD_HELP_LCD
18E3: CDDA08  	    CALL sendStringToLCD
              	
18E6:         	loopHexLoad:
18E6: CD2811  	    CALL RXDATA
              	
18E9: FE3A    	    CP   ':'	; ":"?
18EB: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
18ED: 3A16FC  		LD   A, (LOAD_FIRST_FLAG)
18F0: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
18F2: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
18F4: 3E01    		LD   A, $01
18F6: 3216FC  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
18F9:         	monitor_do_load:
18F9: CD0A19  		CALL    LOAD
18FC: CD431A  		CALL SERIAL_A_TXCRLF
18FF: C3E618  	    JP loopHexLoad
              	
              	
1902:         	CALL_IHEX:
1902: 21C502  		LD HL, MAIN_LOOP
1905: E5      		PUSH HL
1906: CDD518  		CALL loadInit
1909: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
190A:         	LOAD:
190A: 1E00    			LD   E,0	        ; Zera checksum
190C: CDE819  			CALL GET2	        ; Record Length -> D
190F: 57      			LD   D,A
1910: CDE819  			CALL GET2	        ; Endereco High -> H
1913: 67      			LD   H,A
1914: CDE819  			CALL GET2	        ; Endereco Low -> L
1917: 6F      			LD   L,A
1918: CDE819  			CALL GET2	        ; Record Type -> A
191B: FE01    			CP   $01	        ; EOF record?
191D: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
191F: CDE819  			CALL GET2	        ; Consome checksum do EOF
1922: 7B      			LD   A,E
1923: A7      			AND  A
1924: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
1926: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
1928:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
1928: 3A16FC  			LD   A, (LOAD_FIRST_FLAG)
192B: FE01    			CP   $01                    ; e a primeira linha?
192D: 2008    			JR   NZ, LOAD2_SKIP
192F: 3E00    			LD   A, $00
1931: 3216FC  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
1934: 2217FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
1937:         	LOAD2_SKIP:
1937: 7A      			LD   A,D	        ; Contador de bytes da linha
1938: A7      			AND  A
1939: 280D    			JR   Z,LOAD3
              	
193B: CDE819  			CALL GET2	        ; Le proximo byte
193E: 77      			LD   (HL),A	        ; Grava na memoria
193F: 23      			INC  HL
1940: 3E2E    			LD   A,'.'
1942: CDFB10  			CALL OUTCH
1945: 15      			DEC  D
1946: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
1948:         	LOAD3:
1948: 2219FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
194B: CDE819  			CALL GET2	                ; Consome checksum da linha
194E: 7B      			LD   A,E
194F: A7      			AND  A
1950: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
1951:         	LOADERR:
1951: 214E1A  			LD   HL,CKSUMERR
1954: CD3A1A  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
1957: 114E1A  	        LD   DE, CKSUMERR
195A: CDDA08  	        CALL sendStringToLCD
              	
195D: E1      	        POP HL
              	
195E: C9      			RET
              	
195F:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
195F: 215F1A  			LD   HL, LDETXT
1962: CD3A1A  			CALL SERIAL_A_PRINT_STRING
              	
1965: 217E1A  			LD   HL, msg_load_start
1968: CD3A1A  			CALL SERIAL_A_PRINT_STRING
196B: 2A17FC  			LD   HL, (LOAD_START_ADDR)
196E: CD121A  			CALL SERIAL_A_PRINT_HL_HEX
1971: CD431A  			CALL SERIAL_A_TXCRLF
              	
1974: 21871A  			LD   HL, msg_load_end
1977: CD3A1A  			CALL SERIAL_A_PRINT_STRING
197A: 2A19FC  			LD   HL, (LOAD_END_ADDR)
197D: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
197E: CD121A  			CALL SERIAL_A_PRINT_HL_HEX
1981: CD431A  			CALL SERIAL_A_TXCRLF
              	
1984: 21901A  			LD   HL, msg_load_total
1987: CD3A1A  			CALL SERIAL_A_PRINT_STRING
198A: ED5B17FC			LD   DE, (LOAD_START_ADDR)
198E: 2A19FC  			LD   HL, (LOAD_END_ADDR)
1991: B7      			OR   A                      ; limpa carry flag
1992: ED52    			SBC  HL, DE                 ; HL = total de bytes
1994: CD121A  			CALL SERIAL_A_PRINT_HL_HEX
1997: CD431A  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
199A: 11781A  	        LD   DE, LDETXTLCD
199D: CDDA08  	        CALL sendStringToLCD
              	
19A0: 117E1A  	        LD   DE, msg_load_start
19A3: 3E00    	        LD   A, 0
19A5: CDDA08  			CALL sendStringToLCD
19A8: 2A17FC  			LD   HL, (LOAD_START_ADDR)
19AB: CD1E09  			CALL sendHLToLCD
19AE: CD1305  			CALL CRLF
              	
19B1: 11871A  			LD   DE, msg_load_end
19B4: 3E00    	        LD   A, 0
19B6: CDDA08  			CALL sendStringToLCD
19B9: 2A19FC  			LD   HL, (LOAD_END_ADDR)
19BC: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
19BD: CD1E09  			CALL sendHLToLCD
19C0: CD1305  			CALL CRLF
              	
19C3: 11901A  			LD   DE, msg_load_total
19C6: 3E00    	        LD   A, 0
19C8: CDDA08  			CALL sendStringToLCD
19CB: ED5B17FC			LD   DE, (LOAD_START_ADDR)
19CF: 2A19FC  			LD   HL, (LOAD_END_ADDR)
19D2: B7      			OR   A                      ; limpa carry flag
19D3: ED52    			SBC  HL, DE                 ; HL = total de bytes
19D5: CD1E09  			CALL sendHLToLCD
              	
19D8: CD1305  	        CALL CRLF
              	
19DB: E1      	        POP HL 
19DC: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
19DD: CD0111  	GETCHR_S:	CALL INCH	; RX a Character
19E0: FE03    			CP   $03	; <ctrl-c> User break?
19E2: C8      			RET  Z			
19E3: FE20    			CP   $20	; <space> or better?
19E5: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
19E7: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
19E8: CDDD19  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
19EB: 47      			LD   B,A	; Load it in B
19EC: CDDD19  			CALL GETCHR_S	; Get us another character
19EF: 4F      			LD   C,A	; load it in C
19F0: CDF919  			CALL BCTOA	; Convert ASCII to byte
19F3: 4F      			LD   C,A	; Build the checksum
19F4: 7B      			LD   A,E
19F5: 91      			SUB  C		; The checksum should always equal zero when checked
19F6: 5F      			LD   E,A	; Save the checksum back where it came from
19F7: 79      			LD   A,C	; Retrieve the byte and go back
19F8: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
19F9: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
19FA: D630    			SUB  $30	; Take it down from Ascii
19FC: FE0A    			CP   $0A	; Are we in the 0-9 range here?
19FE: 3802    			JR   C,BCTOA1	; If so, get the next nybble
1A00: D607    			SUB  $07	; But if A-F, take it down some more
1A02: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
1A03: 07      			RLCA		; One bit at a time
1A04: 07      			RLCA		; Until we
1A05: 07      			RLCA		; Get there with it
1A06: 47      			LD   B,A	; Save the converted high nybble
1A07: 79      			LD   A,C	; Now get the low order byte
1A08: D630    			SUB  $30	; Convert it down from Ascii
1A0A: FE0A    			CP   $0A	; 0-9 at this point?
1A0C: 3802    			JR   C,BCTOA2	; Good enough then, but
1A0E: D607    			SUB  $07	; Take off 7 more if it's A-F
1A10: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
1A11: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
1A12:         	SERIAL_A_PRINT_HL_HEX:
1A12: 7C      			LD   A, H
1A13: CD1B1A  			CALL SERIAL_A_PRINT_A_HEX
1A16: 7D      			LD   A, L
1A17: CD1B1A  			CALL SERIAL_A_PRINT_A_HEX
1A1A: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
1A1B:         	SERIAL_A_PRINT_A_HEX:
1A1B: F5      			PUSH AF
1A1C: 0F      			RRCA
1A1D: 0F      			RRCA
1A1E: 0F      			RRCA
1A1F: 0F      			RRCA
1A20: CD281A  			CALL SERIAL_A_PRINT_NIBBLE
1A23: F1      			POP  AF
1A24: CD281A  			CALL SERIAL_A_PRINT_NIBBLE
1A27: C9      			RET
              	
1A28:         	SERIAL_A_PRINT_NIBBLE:
1A28: E60F    			AND  $0F
1A2A: FE0A    			CP   $0A
1A2C: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
1A2E: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
1A30: CDFB10  			CALL OUTCH
1A33: C9      			RET
1A34:         	SERIAL_A_PRINT_NIBBLE_09:
1A34: C630    			ADD  A, $30             ; 0-9
1A36: CDFB10  			CALL OUTCH
1A39: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
1A3A:         	SERIAL_A_PRINT_STRING:
1A3A: 7E      	        LD   A,(HL)	; Get character
1A3B: B7      			OR   A		; Is it $00 ?
1A3C: C8      			RET  Z		; Then RETurn on terminator
1A3D: CDFB10  			CALL OUTCH	; Print it
1A40: 23      			INC  HL		; Next Character
1A41: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
1A43: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
1A45: CDFB10  			CALL OUTCH	; Print character 
1A48: 3E0A    			LD   A,$0A	; 
1A4A: CDFB10  			CALL OUTCH	; Print character
1A4D: C9      			RET
              	
              	
              	
