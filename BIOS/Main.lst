              	#include "IHEX.asm"
              	
              	
185A:         	loadInit:
185A: 3EFF    	    LD A, $FF
185C: 32FFFB  	    LD (LOAD_FIRST_FLAG), A
              	
185F: 211E1A  	    LD HL, MSG_LOAD_HELP
1862: CDBF19  	    CALL SERIAL_A_PRINT_STRING
              	
1865: 11201A  	    LD DE, MSG_LOAD_HELP_LCD
1868: CD6A08  	    CALL sendStringToLCD
              	
186B:         	loopHexLoad:
186B: CDB910  	    CALL RXDATA
              	
186E: FE3A    	    CP   ':'	; ":"?
1870: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
1872: 3AFFFB  		LD   A, (LOAD_FIRST_FLAG)
1875: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
1877: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
1879: 3E01    		LD   A, $01
187B: 32FFFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
187E:         	monitor_do_load:
187E: CD8F18  		CALL    LOAD
1881: CDC819  		CALL SERIAL_A_TXCRLF
1884: C36B18  	    JP loopHexLoad
              	
              	
1887:         	CALL_IHEX:
1887: 21CE02  		LD HL, MAIN_LOOP
188A: E5      		PUSH HL
188B: CD5A18  		CALL loadInit
188E: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
188F:         	LOAD:
188F: 1E00    			LD   E,0	        ; Zera checksum
1891: CD6D19  			CALL GET2	        ; Record Length -> D
1894: 57      			LD   D,A
1895: CD6D19  			CALL GET2	        ; Endereco High -> H
1898: 67      			LD   H,A
1899: CD6D19  			CALL GET2	        ; Endereco Low -> L
189C: 6F      			LD   L,A
189D: CD6D19  			CALL GET2	        ; Record Type -> A
18A0: FE01    			CP   $01	        ; EOF record?
18A2: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
18A4: CD6D19  			CALL GET2	        ; Consome checksum do EOF
18A7: 7B      			LD   A,E
18A8: A7      			AND  A
18A9: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
18AB: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
18AD:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
18AD: 3AFFFB  			LD   A, (LOAD_FIRST_FLAG)
18B0: FE01    			CP   $01                    ; e a primeira linha?
18B2: 2008    			JR   NZ, LOAD2_SKIP
18B4: 3E00    			LD   A, $00
18B6: 32FFFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
18B9: 2200FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
18BC:         	LOAD2_SKIP:
18BC: 7A      			LD   A,D	        ; Contador de bytes da linha
18BD: A7      			AND  A
18BE: 280D    			JR   Z,LOAD3
              	
18C0: CD6D19  			CALL GET2	        ; Le proximo byte
18C3: 77      			LD   (HL),A	        ; Grava na memoria
18C4: 23      			INC  HL
18C5: 3E2E    			LD   A,'.'
18C7: CD8C10  			CALL OUTCH
18CA: 15      			DEC  D
18CB: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
18CD:         	LOAD3:
18CD: 2202FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
18D0: CD6D19  			CALL GET2	                ; Consome checksum da linha
18D3: 7B      			LD   A,E
18D4: A7      			AND  A
18D5: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
18D6:         	LOADERR:
18D6: 21D319  			LD   HL,CKSUMERR
18D9: CDBF19  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
18DC: 11D319  	        LD   DE, CKSUMERR
18DF: CD6A08  	        CALL sendStringToLCD
              	
18E2: E1      	        POP HL
              	
18E3: C9      			RET
              	
18E4:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
18E4: 21E419  			LD   HL, LDETXT
18E7: CDBF19  			CALL SERIAL_A_PRINT_STRING
              	
18EA: 21031A  			LD   HL, msg_load_start
18ED: CDBF19  			CALL SERIAL_A_PRINT_STRING
18F0: 2A00FC  			LD   HL, (LOAD_START_ADDR)
18F3: CD9719  			CALL SERIAL_A_PRINT_HL_HEX
18F6: CDC819  			CALL SERIAL_A_TXCRLF
              	
18F9: 210C1A  			LD   HL, msg_load_end
18FC: CDBF19  			CALL SERIAL_A_PRINT_STRING
18FF: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1902: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1903: CD9719  			CALL SERIAL_A_PRINT_HL_HEX
1906: CDC819  			CALL SERIAL_A_TXCRLF
              	
1909: 21151A  			LD   HL, msg_load_total
190C: CDBF19  			CALL SERIAL_A_PRINT_STRING
190F: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1913: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1916: B7      			OR   A                      ; limpa carry flag
1917: ED52    			SBC  HL, DE                 ; HL = total de bytes
1919: CD9719  			CALL SERIAL_A_PRINT_HL_HEX
191C: CDC819  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
191F: 11FD19  	        LD   DE, LDETXTLCD
1922: CD6A08  	        CALL sendStringToLCD
              	
1925: 11031A  	        LD   DE, msg_load_start
1928: 3E00    	        LD   A, 0
192A: CD6A08  			CALL sendStringToLCD
192D: 2A00FC  			LD   HL, (LOAD_START_ADDR)
1930: CDAE08  			CALL sendHLToLCD
1933: CDA304  			CALL CRLF
              	
1936: 110C1A  			LD   DE, msg_load_end
1939: 3E00    	        LD   A, 0
193B: CD6A08  			CALL sendStringToLCD
193E: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1941: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1942: CDAE08  			CALL sendHLToLCD
1945: CDA304  			CALL CRLF
              	
1948: 11151A  			LD   DE, msg_load_total
194B: 3E00    	        LD   A, 0
194D: CD6A08  			CALL sendStringToLCD
1950: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1954: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1957: B7      			OR   A                      ; limpa carry flag
1958: ED52    			SBC  HL, DE                 ; HL = total de bytes
195A: CDAE08  			CALL sendHLToLCD
              	
195D: CDA304  	        CALL CRLF
              	
1960: E1      	        POP HL 
1961: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
1962: CD9210  	GETCHR_S:	CALL INCH	; RX a Character
1965: FE03    			CP   $03	; <ctrl-c> User break?
1967: C8      			RET  Z			
1968: FE20    			CP   $20	; <space> or better?
196A: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
196C: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
196D: CD6219  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
1970: 47      			LD   B,A	; Load it in B
1971: CD6219  			CALL GETCHR_S	; Get us another character
1974: 4F      			LD   C,A	; load it in C
1975: CD7E19  			CALL BCTOA	; Convert ASCII to byte
1978: 4F      			LD   C,A	; Build the checksum
1979: 7B      			LD   A,E
197A: 91      			SUB  C		; The checksum should always equal zero when checked
197B: 5F      			LD   E,A	; Save the checksum back where it came from
197C: 79      			LD   A,C	; Retrieve the byte and go back
197D: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
197E: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
197F: D630    			SUB  $30	; Take it down from Ascii
1981: FE0A    			CP   $0A	; Are we in the 0-9 range here?
1983: 3802    			JR   C,BCTOA1	; If so, get the next nybble
1985: D607    			SUB  $07	; But if A-F, take it down some more
1987: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
1988: 07      			RLCA		; One bit at a time
1989: 07      			RLCA		; Until we
198A: 07      			RLCA		; Get there with it
198B: 47      			LD   B,A	; Save the converted high nybble
198C: 79      			LD   A,C	; Now get the low order byte
198D: D630    			SUB  $30	; Convert it down from Ascii
198F: FE0A    			CP   $0A	; 0-9 at this point?
1991: 3802    			JR   C,BCTOA2	; Good enough then, but
1993: D607    			SUB  $07	; Take off 7 more if it's A-F
1995: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
1996: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
1997:         	SERIAL_A_PRINT_HL_HEX:
1997: 7C      			LD   A, H
1998: CDA019  			CALL SERIAL_A_PRINT_A_HEX
199B: 7D      			LD   A, L
199C: CDA019  			CALL SERIAL_A_PRINT_A_HEX
199F: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
19A0:         	SERIAL_A_PRINT_A_HEX:
19A0: F5      			PUSH AF
19A1: 0F      			RRCA
19A2: 0F      			RRCA
19A3: 0F      			RRCA
19A4: 0F      			RRCA
19A5: CDAD19  			CALL SERIAL_A_PRINT_NIBBLE
19A8: F1      			POP  AF
19A9: CDAD19  			CALL SERIAL_A_PRINT_NIBBLE
19AC: C9      			RET
              	
19AD:         	SERIAL_A_PRINT_NIBBLE:
19AD: E60F    			AND  $0F
19AF: FE0A    			CP   $0A
19B1: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
19B3: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
19B5: CD8C10  			CALL OUTCH
19B8: C9      			RET
19B9:         	SERIAL_A_PRINT_NIBBLE_09:
19B9: C630    			ADD  A, $30             ; 0-9
19BB: CD8C10  			CALL OUTCH
19BE: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
19BF:         	SERIAL_A_PRINT_STRING:
19BF: 7E      	        LD   A,(HL)	; Get character
19C0: B7      			OR   A		; Is it $00 ?
19C1: C8      			RET  Z		; Then RETurn on terminator
19C2: CD8C10  			CALL OUTCH	; Print it
19C5: 23      			INC  HL		; Next Character
19C6: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
19C8: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
19CA: CD8C10  			CALL OUTCH	; Print character 
19CD: 3E0A    			LD   A,$0A	; 
19CF: CD8C10  			CALL OUTCH	; Print character
19D2: C9      			RET
              	
              	
              	
19D3:         	CKSUMERR:
19D3: 43686563			.db	"Checksum error"
19D7: 6B73756D	
19DB: 20657272	
19DF: 6F72    	
19E1: 0D0A00  			.db	CR, LF,$00
              	
19E4:         	LDETXT:
19E4: 43617272			.db	"Carregamento completo."
19E8: 6567616D	
19EC: 656E746F	
