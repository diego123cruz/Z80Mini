0270:         	INICIO:
0270: 21AD01  	    LD HL, INT_DEFAULT
0273: 2200F0  	    LD (RST38), HL
0276: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
0279: 3EA0    	    LD A, EEDRIVE_A
027B: 3204FC  	    LD (I2CA_BLOCK), A     
              	
027E: 3E01    	    LD A, 1 ;capslock OFF
0280: 32A3FB  	    LD (MEN_CAPSL), A
0283: 010606  	    LD BC, $0606
0286: ED43A5FB	    LD (MEN_CURSR), BC   
              	
              	
028A: 3E01    	    LD A, $01
028C: 3244FD  	    LD (FS_DIR_CUR), A ; default folder - HOME
              	
028F: CDD402  	    CALL M_C_DIR_C
              	
0292: CD6822  	    CALL FS_CHK_SIG
0295: CA9E02  	    JP Z, INICIO1
0298: 213C26  	    LD HL, str_notfmt
029B: CD8D04  	    CALL PUTS
029E:         	INICIO1:
              	
029E: 31F0FF  	    LD SP, SYSTEM_SP
              	
02A1: 116400  	    LD DE, $0064 ; 100ms
02A4: CD4003  	    CALL H_Delay
              	
              	    ;Init Serial
02A7: CD4310  	    CALL initSerial
              	
              	    ;Init Teclado
02AA: 3EFF    	    LD      A, 0xFF
02AC: D340    	    OUT     (KEYBOARD), A           ; Todas as colunas desativadas
              	
              	    ; Init LCD
02AE: CDC707  	    CALL initTerminal
02B1: CD1005  	    CALL setGrMode
02B4: CDC207  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02B7: 010000  	    LD BC, $0000
02BA: CDB408  	    CALL setCursor
02BD: 113F27  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02C0: 3E00    	    LD A, 0
02C2: 3298FB  	    LD (CURSOR_ON), A
              	    ; send cursor
02C5: CD6408  	    CALL sendStringToLCD
              	
              	
02C8:         	MAIN_LOOP:
02C8: CDE902  	    CALL showCurrentDriver
              	
02CB: CD3914  	    CALL GETLINE             ; Lê linha em LINEBUF
02CE: CDDE10  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02D1: C3C802  	    JP      MAIN_LOOP
              	
              	
02D4:         	M_C_DIR_C:
02D4: 0611    	    LD B, FS_NAME_SZ + 1
02D6: 2145FD  	    LD HL, FS_DIR_NAME
02D9: 115427  	    LD DE, FOLDER_HOME
02DC:         	M_C_DIR:
02DC: 1A      	    LD A, (DE)
02DD: FE00    	    CP 0
02DF: 2805    	    JR Z, M_C_DIR_F
02E1: 77      	    LD (HL), A
02E2: 23      	    INC HL
02E3: 13      	    INC DE
02E4: 10F6    	    djnz M_C_DIR
02E6:         	M_C_DIR_F:
02E6: AF      	    XOR A
02E7: 77      	    LD (HL), A
02E8: C9      	    RET
              	
              	
02E9:         	showCurrentDriver:
02E9: 3A04FC  	    LD A, (I2CA_BLOCK)
02EC: FEA0    	    CP EEDRIVE_A  ; Drive A
02EE: 281D    	    JR Z, showDriveA
02F0: FEA2    	    CP EEDRIVE_B  ; Drive B
02F2: 281D    	    JR Z, showDriveB
02F4: FEA4    	    CP EEDRIVE_C  ; Drive C
02F6: 281D    	    JR Z, showDriveC
02F8: FEA6    	    CP EEDRIVE_D  ; Drive D
02FA: 281D    	    JR Z, showDriveD
02FC: FEA8    	    CP EEDRIVE_E  ; Drive E
02FE: 281D    	    JR Z, showDriveE
0300: FEAC    	    CP EEDRIVE_F  ; Drive F
0302: 281D    	    JR Z, showDriveF
0304: FEAE    	    CP EEDRIVE_G  ; Drive G
0306: 281D    	    JR Z, showDriveG
0308: FEAA    	    CP EEDRIVE_Z  ; Drive Z
030A: 281D    	    JR Z, showDriveZ
030C: C9      	    RET
              	
030D:         	showDriveA:
030D: 3E41    	    LD A, 'A'
030F: 181C    	    JR showCursor
0311:         	showDriveB:
0311: 3E42    	    LD A, 'B'
0313: 1818    	    JR showCursor
0315:         	showDriveC:
0315: 3E43    	    LD A, 'C'
0317: 1814    	    JR showCursor
0319:         	showDriveD:
0319: 3E44    	    LD A, 'D'
031B: 1810    	    JR showCursor
031D:         	showDriveE:
031D: 3E45    	    LD A, 'E'
031F: 180C    	    JR showCursor
0321:         	showDriveF:
0321: 3E46    	    LD A, 'F'
0323: 1808    	    JR showCursor
0325:         	showDriveG:
0325: 3E47    	    LD A, 'G'
0327: 1804    	    JR showCursor
0329:         	showDriveZ:
0329: 3E5A    	    LD A, 'Z'
032B: 1800    	    JR showCursor
032D:         	showCursor:
032D: CDF407  	    CALL sendCharToLCD
0330: 3E3A    	    LD A, ':'
0332: CDF407  	    CALL sendCharToLCD
0335: C9      	    RET
              	
              	
              	
0336:         	resetCollisionPixel:
0336: AF      	    XOR A
0337: 3241FD  	    LD (DRAW_PIXEL_COLLISION), A
033A: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
033B:         	checkCollisionPixel:
033B: 3A41FD  	    LD A, (DRAW_PIXEL_COLLISION)
033E: B7      	    OR A
033F: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
0340: F5      	H_Delay:    PUSH AF
0341: C5      	            PUSH BC
0342: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
0343: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
0346: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
0347: 79      	            LD   A,C            ;[4]     [4]
0348: B0      	            OR   B              ;[4]     [4]
0349: C24603  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
034C: 1B      	            DEC  DE             ;[6]     [4]
034D: 7B      	            LD   A,E            ;[4]     [4]
034E: B2      	            OR   D              ;[4]     [4]
034F: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
0351: D1      	            POP  DE
0352: C1      	            POP  BC
0353: F1      	            POP  AF
0354: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       On exit: If press A = CTRLC and NZ flagged
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
0355:         	CHKKEY:
0355: 3EFE    	    LD      A, 0xFE             ; Máscara: bit 0 baixo = col 0
0357: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0359: 00      	    NOP                         ; ~270 ns de estabilização
035A: 00      	    NOP
035B: 00      	    NOP
035C: 00      	    NOP
035D: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
035F: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
0360: FE01    	    CP 1
0362: C26A03  	    jp nz, GRET
0365: 3E03    		LD  A, CTRLC
0367: FE00    		CP	0
0369: C9      		RET
036A:         	GRET:
036A: 3E00    		LD  A, 0
036C: FE00    		CP 0
036E: C9      		RET
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
036F:         	CONIN:
036F: C5      	    PUSH BC
0370: D5      	    PUSH DE
0371: E5      	    PUSH HL
0372: CDF603  	    CALL readKeyboarWaitPressA
0375: E1      	    POP HL
0376: D1      	    POP DE
0377: C1      	    POP BC
0378: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
0379:         	CONIN_NOT_LOOP:
0379: C5      	    PUSH BC
037A: D5      	    PUSH DE
037B: E5      	    PUSH HL
037C: CD8303  	    CALL readKeyboarPressA
037F: E1      	    POP HL
0380: D1      	    POP DE
0381: C1      	    POP BC
0382: C9      	    RET
              	
              	
0383:         	readKeyboarPressA;
0383: AF      	    XOR A
0384: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
0387: CD3404  	    CALL    SCAN_MATRIX
038A: D0      	    RET      NC
038B: CD9603  	    CALl GetKeycode
038E: CD9C03  	    CALL checkShiftKey
0391: 3AA4FB  	    LD A, (KEY_PRESS)
0394: 37      	    SCF  ; Carry = 1
0395: C9      	    RET
              	
              	
              	
              	; A = col*8 + row  (0x00 – 0x3F)
0396:         	GetKeycode:
              	    ; --- Tecla confirmada: calcula keycode ---
              	    ; col*8 + row  (0x00 – 0x3F)
0396: 78      	    LD      A, B                ; B = coluna
0397: 87      	    ADD     A, A                ; ×2
0398: 87      	    ADD     A, A                ; ×4
0399: 87      	    ADD     A, A                ; ×8
039A: 81      	    ADD     A, C                ; + linha (C) = keycode
039B: C9      	    RET
              	
              	
              	; Verifica se shift e recupera ascii
              	;   Salva tecla em KEY_PRESS
039C:         	checkShiftKey:
              	    ; Verifica Shift
039C: 5F      	    LD E, A
039D: 21B001  	    LD HL, KEYMAP_NORMAL
03A0: 3AA2FB  	    LD A, (MEN_SHIFT)
03A3: FE01    	    CP 1
03A5: C2B203  	    JP NZ, NO_SHIFT
03A8: 21F001  	    LD HL, KEYMAP_SHIFT
03AB: CD2F04  	    CALL DO_LOOKUP
03AE: 32A4FB  	    LD (KEY_PRESS), A
03B1: C9      	    RET
03B2:         	NO_SHIFT:
03B2: CD2F04  	    CALL 	DO_LOOKUP	; pega tecla
03B5: 32A4FB  	    LD (KEY_PRESS), A
03B8: FEFF    	    CP $FF ;capslook?
03BA: CACD03  	    JP Z, CAPSLOCK
03BD: 3AA3FB  	    LD A, (MEN_CAPSL)
03C0: FE00    	    CP 0
03C2: C0      	    RET NZ
03C3: 213002  	    LD HL, KEYMAP_CAPSLOCK
03C6: CD2F04  	    CALL DO_LOOKUP
03C9: 32A4FB  	    LD (KEY_PRESS), A
03CC: C9      	    RET
              	
              	
              	
              	
              	
03CD:         	CAPSLOCK:
03CD: 3AA3FB  	    LD A, (MEN_CAPSL)
03D0: FE00    	    CP 0
03D2: CAE303  	    JP Z, CAPSLOCK_OFF
03D5: AF      	    XOR A
03D6: 32A3FB  	    LD (MEN_CAPSL), A
03D9: 010306  	    LD BC, $0603
03DC: ED43A5FB	    LD (MEN_CURSR), BC
03E0: C3EF03  	    JP CAPSLOCK_OK
03E3:         	CAPSLOCK_OFF:
03E3: 3E01    	    LD A, 1
03E5: 32A3FB  	    LD (MEN_CAPSL), A
03E8: 010606  	    LD BC, $0606
03EB: ED43A5FB	    LD (MEN_CURSR), BC
03EF:         	CAPSLOCK_OK:
03EF: 116400  	    LD DE, $0064 ; 100ms
03F2: CD4003  	    CALL H_Delay
03F5: C9      	    RET
              	
              	
              	
              	
              	; LER TECLADO
              	; Aguarda até uma teclad for pressionada e retorna em A
03F6:         	readKeyboarWaitPressA:
03F6: CD3404  	    CALL    SCAN_MATRIX
03F9: D2F603  	    JP      NC, readKeyboarWaitPressA       ; Nenhuma tecla, continua
              	
              	    ; --- Primeira leitura positiva: aguarda debounce ---
03FC: CD2304  	    CALL    DEBOUNCE
              	
              	    ; --- Confirma que a tecla ainda está pressionada ---
03FF: AF      	    XOR A
0400: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
0403: CD3404  	    CALL    SCAN_MATRIX
0406: D2F603  	    JP      NC, readKeyboarWaitPressA       ; Foi ruído, descarta
              	
0409: CD9603  	    CALL GetKeycode
              	    
040C: CD9C03  	    CALL checkShiftKey
              	    
              	    ; --- Aguarda soltar + debounce de release ---
040F:         	WAIT_RELEASE:
040F: CD3404  	    CALL    SCAN_MATRIX
0412: DA0F04  	    JP      C, WAIT_RELEASE     ; Ainda pressionada
0415: CD2304  	    CALL    DEBOUNCE            ; Debounce do soltar
0418: CD3404  	    CALL    SCAN_MATRIX
041B: DA0F04  	    JP      C, WAIT_RELEASE     ; Bounce no release, volta a esperar
              	
041E: 3AA4FB  	    LD A, (KEY_PRESS)
0421: B7      	    OR A
0422: C9      	    RET
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  espera ~10 ms (calibrado para 7.3728 MHz)
              	;   Usa DE como contador, preserva BC
              	;   T-states totais ≈ 69.080  →  ~9.36 ms
              	; ============================================================
0423:         	DEBOUNCE:
0423: C5      	    PUSH    BC
0424: 0616    	    LD      B, DB_OUTER         ; B = contador externo
0426:         	DB_OUTER_LOOP:
0426: 0EF0    	    LD      C, DB_INNER         ; C = contador interno
0428:         	DB_INNER_LOOP:
0428: 0D      	    DEC     C                   ; 4 T
0429: 20FD    	    JR      NZ, DB_INNER_LOOP   ; 12 T (não salta) / 7 T (salta)
042B: 10F9    	    DJNZ    DB_OUTER_LOOP       ; 13 T (não salta) / 8 T (salta)
042D: C1      	    POP     BC
042E: C9      	    RET
              	
              	
              	; Pega char in table
042F:         	DO_LOOKUP:
042F: 1600    	    LD      D, 0
0431: 19      	    ADD     HL, DE
0432: 7E      	    LD      A, (HL)
0433: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_MATRIX
              	;   Varre 8 colunas, uma por vez (bit baixo = ativo)
              	;   Saída: B = col (0-7), C = row (0-7), Carry=1 se tecla
              	; ============================================================
0434:         	SCAN_MATRIX:
0434: 0600    	    LD      B, 0                ; Coluna atual
0436: 16FE    	    LD      D, 0xFE             ; Máscara: bit 0 baixo = col 0
0438:         	SCAN_COL:
0438: 7A      	    LD      A, D
0439: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
043B: 00      	    NOP                         ; ~270 ns de estabilização
043C: 00      	    NOP
043D: 00      	    NOP
043E: 00      	    NOP
043F: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0441: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
              	    
              	    ; SHIFT
0442: F5      	    PUSH AF
0443: 7A      	    LD A, D
0444: FEFE    	    CP $FE
0446: C25904  	    JP NZ, FIM
0449: F1      	    POP AF
044A: F5      	    PUSH AF
044B: FE08    	    CP $08
044D: C25904  	    JP NZ, FIM
0450: 3E01    	    LD A, 1
0452: 32A2FB  	    LD (MEN_SHIFT), A
0455: F1      	    POP AF
0456: 3E00    	    LD A, 0
0458: F5      	    PUSH AF
              	    
0459:         	FIM:
0459: F1      		POP AF
              	    
045A: E6FF    	    AND     0xFF
045C: 280E    	    JR      Z, NEXT_COL         ; Nenhuma linha nesta coluna
              	    
              	    ; Encontrou linha — identifica bit
045E: 0E00    	    LD      C, 0
0460:         	FIND_ROW:
0460: 1F      	    RRA
0461: 3803    	    JR      C, ROW_FOUND
0463: 0C      	    INC     C
0464: 18FA    	    JR      FIND_ROW
              	
0466:         	ROW_FOUND:
0466: 3EFF    	    LD      A, 0xFF
0468: D340    	    OUT     (KEYBOARD), A           ; Desativa colunas
046A: 37      	    SCF                         ; Carry = 1
046B: C9      	    RET
              	
046C:         	NEXT_COL:
046C: 04      	    INC     B
046D: 78      	    LD      A, B
046E: FE08    	    CP      8
0470: 2809    	    JR      Z, SCAN_NONE        ; Todas varridas, nada encontrado
              	
              	    ; Rotaciona máscara para próxima coluna
0472: 7A      	    LD      A, D
0473: 37      	    SCF
0474: CB17    	    RL      A                   ; Desloca bit baixo para esquerda
0476: F601    	    OR      0x01                ; Garante que o bit 0 volta alto (inativo)
0478: 57      	    LD      D, A
0479: 18BD    	    JR      SCAN_COL
              	
047B:         	SCAN_NONE:
047B: 3EFF    	    LD      A, 0xFF
047D: D340    	    OUT     (KEYBOARD), A
047F: B7      	    OR      A                   ; Limpa Carry
0480: C9      	    RET
              	
              	
              	    
              	    
              	    
              	#include "GLCD.asm"
              	; Graphical LCD 128 x 64 Library
              	; ------------------------------
              	; By B. Chiha May-2023
              	; Modificações para funcionar no Z80 Mini - 2026
              	;
              	; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
              	;
              	; There are a few variants of these LCD screens, but they must all must use the ST7920
              	; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
              	; ST7921 Panels (128 x 32) stacked one above the other.
              	;
              	; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can 
              	; be displayed at the same time.
              	;
              	; The Pinout for the QC12864B board is as follows:
              	;
              	; Pin	Name	Desc                    Serial  Parallel
              	; ---   ----    -------------           ------  -------------
              	; 1     VSS     Ground                  GND     GND
              	; 2     VDD     Power                   5v      5v
              	; 3     V0      Contrast                N/A     N/A
              	; 4     D/I     IR/DR (CS)              5v      A7
              	; 5     R/W     R/W (SID)               D0      RD (inverted)
              	; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
              	; 7     DB0     Data                    N/A     D0
              	; 8     DB1     Data                    N/A     D1
              	; 9     DB2     Data                    N/A     D2
              	; 10    DB3     Data                    N/A     D3
              	; 11    DB4     Data                    N/A     D4
              	; 12    DB5     Data                    N/A     D5
              	; 13    DB6     Data                    N/A     D6
              	; 14    DB7     Data                    N/A     D7
              	; 15    PSB     Serial/Para             GND     5v
              	; 16    NC
              	; 17    RST     Reset                   RST     RST
              	; 18    VEE     LCD Drive               N/A     N/A
              	; 19    A       Backlight               5v/NC   5v/NC
              	; 20    K       Backlight               GND/NC  GND/NC
              	;
              	;
              	        
              	        
              	; Modifiable values.  Thse three values can be modified to suit your own set up
              	; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
              	; V_DELAY_US is the minimum delay needed for a command to be processed by the
              	; LCD board.  If only some of the data is being sent, make this value larger
              	        
              	;Port 7 on TEC is connected to LCD Enable (Pin 6)
              	;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
0010:         	V_DELAY_US: .equ $0010   ;Delay for 76us on your system
              	
              	; Dont need to modify anything else below.
00F8:         	UP:     .equ $F8                 ; Up Arrow
00F7:         	DN:     .equ $F7                 ; Down Arrow
000C:         	FF:     .equ 0CH                 ; Form Feed
008F:         	CURSOR: .equ 8FH                 ; Cursor
              	        
              	
              	
              	
              	
              	; --- CONOUT: Envia byte em A ---
0481:         	PUTCHAR:
0481:         	CONOUT:
0481: F5      	        PUSH AF
0482: C5      	        PUSH BC
0483: D5      	        PUSH DE
0484: E5      	        PUSH HL
0485: CDF407  	        CALL sendCharToLCD
0488: E1      	        POP HL
0489: D1      	        POP DE
048A: C1      	        POP BC
048B: F1      	        POP AF
048C: C9      	        RET
              	
              	
              	; --- PUTS: Envia string terminada em NUL apontada por HL ---
048D:         	PUTS:
048D: F5      	        PUSH AF
048E: C5      	        PUSH BC
048F: D5      	        PUSH DE
0490: E5      	        PUSH HL
0491: 545D    	        LD DE, HL
0493: 3E00    	        LD A, NUL
0495: CD6408  	        CALL sendStringToLCD
0498: E1      	        POP HL
0499: D1      	        POP DE
049A: C1      	        POP BC
049B: F1      	        POP AF
049C: C9      	        RET
              	
              	; --- CRLF: Envia CR+LF ---
049D:         	CRLF:
049D: 3E0D    	        LD   A, CR
049F: CD8104  	        CALL PUTCHAR
04A2: C9      	        RET
              	
              	
              	
              	; Initialise LCD
04A3:         	initLCD:
04A3: 213F0A  	        LD HL, INIT_BASIC       ;POINT HL TO LCD INITIALIZE TABLE
04A6: 0604    	        LD B, 04H               ;B=4 BYTES
04A8:         	NEXT_CMD:
04A8: 7E      	        LD A, (HL)
04A9: D370    	        OUT (GLCD_INST), A
04AB: CDB107  	        CALL delayUS
04AE: 23      	        INC HL
04AF: 10F7    	        DJNZ NEXT_CMD
04B1: 114001  	        LD DE, 0140H            ;1.6 ms
04B4: CDB407  	        CALL delayMS
              	        
04B7: 2184F7  	        LD HL,GBUF              ;Set viewport
04BA: 2284FB  	        LD (VPORT),HL           ;to GBUF
              	
04BD: CDD004  	        CALL clearGrLCD
              	        
              	; Clears the Graphics Memory Buffer
04C0:         	clearGBUF:
04C0: 2A84FB  	        LD HL, (VPORT)
04C3: ED5B84FB	        LD DE, (VPORT)
04C7: 13      	        INC DE
04C8: AF      	        XOR A
04C9: 77      	        LD (HL), A
04CA: 01FF03  	        LD BC, 03FFH
04CD: EDB0    	        LDIR
04CF: C9      	        RET
              	        
              	; Clears the Graphics LCD Buffer
04D0:         	clearGrLCD:
04D0: CD1005  	        CALL setGrMode
04D3: 0E00    	        LD C, 00H
04D5:         	CLR_X:
04D5: 3E80    	        LD A, 80H
04D7: B1      	        OR C
04D8: D370    	        OUT (GLCD_INST), A
04DA: CDB107  	        CALL delayUS
04DD: 3E80    	        LD A, 80H
04DF: D370    	        OUT (GLCD_INST), A
04E1: CDB107  	        CALL delayUS
04E4: AF      	        XOR A                   ;Clear Byte
04E5: 0610    	        LD B, 10H
04E7:         	CLR_Y:
04E7: D371    	        OUT (GLCD_DATA), A
04E9: CDB107  	        CALL delayUS
04EC: D371    	        OUT (GLCD_DATA), A
04EE: CDB107  	        CALL delayUS
04F1: 10F4    	        DJNZ CLR_Y
04F3: 0C      	        INC C
04F4: 79      	        LD A, C
04F5: FE20    	        CP 20H
04F7: 20DC    	        JR NZ, CLR_X        
04F9: C9      	        RET
              	
              	; Clears the ASCII Text LCD
04FA:         	clearTxtLCD:
04FA: CD1E05  	        CALL setTxtMode
04FD: 3E80    	        LD A, 80H
