              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
2315: CD8618  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
2318: 47      	    LD   B,A	; Load it in B
2319: CD8618  	    CALL GETCHR_S	; Get us another character
231C: 4F      	    LD   C,A	; load it in C
231D: CDA218  	    CALL BCTOA	; Convert ASCII to byte
2320: C9      	    RET
              	
              	;------------------------------------------------------------------------------
