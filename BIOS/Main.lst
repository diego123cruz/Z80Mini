              	#include "I2C.asm"
              	; **********************************************************************
              	; I2C support functions
              	
              	; I2C bus open device
              	;   On entry: A = Device address (bit zero is read flag)
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A60: F5      	I2C_Open:   PUSH AF
1A61: CDDE1A  	            CALL I2C_Start      ;Output start condition
1A64: F1      	            POP  AF
1A65: 180D    	            JR   I2C_Write      ;Write data byte
              	
              	
              	; I2C bus close device
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A=0 and Z flagged
              	;             If unsuccessfully A=Error and NZ flagged
              	;             SCL = hi, SDA = hi
              	;             BC DE HL IX IY preserved
1A67: C3E91A  	I2C_Close:  JP   I2C_Stop       ;Output stop condition
              	
              	
              	; I2C bus open read device
              	;   On entry: A = Device address
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A6A:         	I2C_OpenRead:   
1A6A: CB37    	            SLL A
1A6C: C3601A  	            JP I2C_Open
              	
              	
              	; I2C bus open write device
              	;   On entry: A = Device address 
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A6F:         	I2C_OpenWrite:   
1A6F: CB27    	            SLA     A
1A71: C3601A  	            JP I2C_Open
              	
              	; **********************************************************************
              	; **********************************************************************
              	; I2C bus master driver
              	; **********************************************************************
              	; **********************************************************************
              	
              	; Functions provided are:
              	;     I2C_Start
              	;     I2C_Stop
              	;     I2C_Read
              	;     I2C_Write
              	;
              	; This code has delays between all I/O operations to ensure it works
              	; with the slowest I2C devices
              	;
              	; I2C transfer sequence
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;   | Start |  | Address |  | Data    | ... | Data    |  | Stop  |
              	;   |       |  | frame   |  | frame 1 |     | frame N |  |       |
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;
              	;
              	; Start condition                     Stop condition
              	; Output by master device             Output by master device
              	;       ----+                                      +----
              	; SDA       |                         SDA          |
              	;           +-------                        -------+
              	;       -------+                                +-------
              	; SCL          |                      SCL       |
              	;              +----                        ----+
              	;
              	;
              	; Address frame
              	; Clock and data output from master device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | A 7 | A 6 | A 5 | A 4 | A 3 | A 2 | A 1 | R/W | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	;
              	; Data frame 
              	; Clock output by master device
              	; Data output by transmitting device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | D 7 | D 6 | D 5 | D 4 | D 3 | D 2 | D 1 | D 0 | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	
              	
              	; **********************************************************************
              	; I2C constants
              	
              	
              	; I2C bus master interface
              	; The default device option is for SC126 or compatible
              	
0021:         	I2C_PORT:   .EQU $21           ;Host I2C port address
0007:         	I2C_SDA_WR: .EQU 7              ;Host I2C write SDA bit number
0007:         	I2C_SDA_RD: .EQU 7              ;Host I2C read SDA bit number
0000:         	I2C_SCL_WR: .EQU 0              ;Host I2C write SCL bit number
0000:         	I2C_SCL_RD: .EQU 0              ;Host I2C read SCL bit number 
0081:         	I2C_QUIES:  .EQU 0b10000001     ;Host I2C output port quiescent value
              	
              	
              	; I2C support constants
0000:         	ERR_NONE:   .EQU 0              ;Error = None
0001:         	ERR_JAM:    .EQU 1              ;Error = Bus jammed [not used]
0002:         	ERR_NOACK:  .EQU 2              ;Error = No ackonowledge
0003:         	ERR_TOUT:   .EQU 3              ;Error = Timeout
              	
              	
              	; **********************************************************************
              	; Hardware dependent I2C bus functions
              	
              	
              	; I2C bus transmit frame (address or data)
              	;   On entry: A = Data byte, or
              	;                 Address byte (bit zero is read flag)
              	;             SCL = low, SDA = low
              	;   On exit:  If successful A=0 and Z flagged
              	;                SCL = lo, SDA = lo
              	;             If unsuccessful A=Error and NZ flagged
              	;                SCL = high, SDA = high, I2C closed
              	;             BC DE HL IX IY preserved
1A74: C5      	I2C_Write:  PUSH BC             ;Preserve registers
1A75: D5      	            PUSH DE
1A76: 57      	            LD   D,A            ;Store byte to be written
1A77: 0608    	            LD   B,8            ;8 data bits, bit 7 first
1A79: CB12    	I2C_WriteWr_Loop:   RL   D              ;Test M.S.Bit
1A7B: 3805    	            JR   C,I2C_WriteBit_Hi      ;High, so skip
1A7D: CD101B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = data bit)
1A80: 1803    	            JR   I2C_WriteBit_Clk
1A82: CD091B  	I2C_WriteBit_Hi:    CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA = data bit)
1A85: CDFB1A  	I2C_WriteBit_Clk:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = data bit)
1A88: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = data bit)
1A8B: 10EC    	            DJNZ I2C_WriteWr_Loop
              	; Test for acknowledge from slave (receiver)
              	; On arriving here, SCL = lo, SDA = data bit
1A8D: CD091B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/ack)
1A90: CDFB1A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/ack)
1A93: CD211B  	            CALL I2C_RdPort     ;Read SDA input
1A96: 47      	            LD   B,A
1A97: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = hi)
1A9A: CB78    	            BIT  I2C_SDA_RD,B
1A9C: 2004    	            JR   NZ,I2C_WriteNoAck      ;Skip if no acknowledge
1A9E: D1      	            POP  DE             ;Restore registers
1A9F: C1      	            POP  BC
1AA0: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AA1: C9      	            RET
              	; I2C STOP required as no acknowledge
              	; On arriving here, SCL = lo, SDA = hi
1AA2: CD101B  	I2C_WriteNoAck:     CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = lo)
1AA5: CDFB1A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = lo)
1AA8: CD091B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA = hi)
1AAB: D1      	            POP  DE             ;Restore registers
1AAC: C1      	            POP  BC
1AAD: 3E02    	            LD   A,ERR_NOACK    ;Return error = No Acknowledge
1AAF: B7      	            OR   A              ;  and NZ flagged
1AB0: C9      	            RET
              	
              	
              	; I2C bus receive frame (data)
              	;   On entry: A = Acknowledge flag
              	;               If A != 0 the read is acknowledged
              	;             SCL low, SDA low
              	;   On exit:  If successful A = data byte and Z flagged
              	;               SCL = low, SDA = low
              	;             If unsuccessul* A = Error and NZ flagged
              	;               SCL = low, SDA = low
              	;             BC DE HL IX IY preserved
              	; *This function always returns successful
1AB1: C5      	I2C_Read:   PUSH BC             ;Preserve registers
1AB2: D5      	            PUSH DE
1AB3: 5F      	            LD   E,A            ;Store acknowledge flag
1AB4: 0608    	            LD   B,8            ;8 data bits, 7 first
1AB6: CD091B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/input)
1AB9: CDFB1A  	I2C_ReadRd_Loop:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/input)
1ABC: CD211B  	            CALL I2C_RdPort     ;Read SDA input bit
1ABF: 37      	            SCF                 ;Set carry flag
1AC0: CB7F    	            BIT  I2C_SDA_RD,A   ;SDA input high?
1AC2: 2001    	            JR   NZ, I2C_ReadRotate     ;Yes, skip with carry flag set
1AC4: 3F      	            CCF                 ;Clear carry flag
1AC5: CB12    	I2C_ReadRotate:    RL   D              ;Rotate result into D
1AC7: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA hi/input)
1ACA: 10ED    	            DJNZ  I2C_ReadRd_Loop       ;Repeat for all 8 bits
              	; Acknowledge input byte
              	; On arriving here, SCL = lo, SDA = hi/input
1ACC: 7B      	            LD   A,E            ;Get acknowledge flag
1ACD: B7      	            OR   A              ;A = 0? (indicates no acknowledge)
1ACE: 2803    	            JR   Z, I2C_ReadNoAck       ;Yes, so skip acknowledge
1AD0: CD101B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA lo)
1AD3: CDFB1A  	I2C_ReadNoAck:     CALL I2C_SCL_HI     ;SCL hi    (SCL hi, SDA lo)
1AD6: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1AD9: 7A      	            LD   A,D            ;Get data byte received
1ADA: D1      	            POP  DE             ;Restore registers
1ADB: C1      	            POP  BC
1ADC: BF      	            CP   A              ;Return success Z flagged
1ADD: C9      	            RET
              	
              	
              	; I2C bus start
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = low, SDA = low
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are high
1ADE: CDF71A  	I2C_Start:  CALL I2C_INIT       ;Initialise I2C control port
              	;           CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA ??)
              	;           CALL I2C_SDA_HI     ;SDA high  (SCL hi, SDA hi)
              	; Generate I2C start condition
1AE1: CD101B  	            CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1AE4: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1AE7: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AE8: C9      	            RET
              	
              	
              	; I2C bus stop 
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = high, SDA = high
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are low
1AE9: CD101B  	I2C_Stop:   CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1AEC: CD021B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
              	; Generate stop condition
1AEF: CDFB1A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA lo)
1AF2: CD091B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA hi)
1AF5: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AF6: C9      	            RET
              	
              	
              	; **********************************************************************
              	; I2C bus simple I/O functions
              	;   On entry: No parameters required
              	;   On exit:  BC DE HL IX IY preserved
              	
1AF7: 3E81    	I2C_INIT:   LD   A,I2C_QUIES    ;I2C control port quiescent value
1AF9: 181A    	            JR   I2C_WrPort
              	
1AFB: 3A05FC  	I2C_SCL_HI: LD   A,(I2C_RAMCPY)
1AFE: CBC7    	            SET  I2C_SCL_WR,A
1B00: 1813    	            JR   I2C_WrPort
              	
1B02: 3A05FC  	I2C_SCL_LO: LD   A,(I2C_RAMCPY)
1B05: CB87    	            RES  I2C_SCL_WR,A
1B07: 180C    	            JR   I2C_WrPort
              	
1B09: 3A05FC  	I2C_SDA_HI: LD   A,(I2C_RAMCPY)
1B0C: CBFF    	            SET  I2C_SDA_WR,A
1B0E: 1805    	            JR   I2C_WrPort
              	
1B10: 3A05FC  	I2C_SDA_LO: LD   A,(I2C_RAMCPY)
1B13: CBBF    	            RES  I2C_SDA_WR,A
              	
1B15: C5      	I2C_WrPort: PUSH BC             ;Preserve registers
1B16: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B18: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B1A: ED79    	            OUT  (C),A          ;Write A to I2C I/O port
1B1C: 3205FC  	            LD   (I2C_RAMCPY),A ;Write A to RAM copy
1B1F: C1      	            POP  BC             ;Restore registers
1B20: C9      	            RET
              	
1B21: C5      	I2C_RdPort: PUSH BC             ;Preserve registers
1B22: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B24: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B26: ED78    	            IN   A,(C)          ;Read A from I/O port
1B28: C1      	            POP  BC             ;Restore registers
1B29: C9      	            RET
              	
              	
