13D5: FE1B    	            CP   ESC
13D7: 28E9    	            JR   Z, GETLINE_LOOP    ; Ignora
13D9: FEFF    	            CP   $FF ;capslock Ignora
13DB: CAC213  	            JP   Z, GETLINE_LOOP
13DE: FE08    	            CP   BkS
13E0: 281D    	            JR   Z, GETLINE_BS
13E2: FE7F    	            CP   DEL
13E4: 2819    	            JR   Z, GETLINE_BS
13E6: FEFA    	            CP   $FA ; AltGr
13E8: CAAB17  	            JP   Z, CALL_IHEX
13EB: FEF9    	            CP   $F9 ; LUZ
13ED: CAE911  	            JP   Z, CALL_8000
