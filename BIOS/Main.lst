              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
271A: CD6219  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
271D: 47      	    LD   B,A	; Load it in B
271E: CD6219  	    CALL GETCHR_S	; Get us another character
2721: 4F      	    LD   C,A	; load it in C
2722: CD7E19  	    CALL BCTOA	; Convert ASCII to byte
2725: C9      	    RET
              	
              	;------------------------------------------------------------------------------
              	; Pegar 4 caracteres ASCII (0-9 A-F) converte em HL
              	;------------------------------------------------------------------------------
2726:         	SERIAL_GET_HEX_HL:
2726: CD1A27  	    CALL SERIAL_GET_HEX_A	        ; Endereco High -> H
2729: 67      		LD   H,A
272A: CD1A27  		CALL SERIAL_GET_HEX_A	        ; Endereco Low -> L
272D: 6F      		LD   L,A
272E: C9      	    RET
              	
              	
              	
