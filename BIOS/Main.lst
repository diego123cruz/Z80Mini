              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
2451:         	FS_WRITE_PG:
2451: C5      	    PUSH BC
2452: D5      	    PUSH DE
2453: E5      	    PUSH HL
2454: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
2455: 2A38FC  	    LD HL, (FS_TMPSZ)
2458: 7C      	    LD A, H
2459: B7      	    OR A
245A: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
245C: 7D      	    LD A, L
245D: FEFF    	    CP FS_DATAPG            ; L < 255?
245F: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
2461:         	FS_WP_USE255:
