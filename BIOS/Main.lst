1E1A: 3E5B    	    LD A, '['
1E1C: CF      	    RST $08
              	
              	    ; Imprime B x '#' (usado)
1E1D: 78      	    LD A, B
1E1E: B7      	    OR A
1E1F: 2808    	    JR Z, FS_INF_NO_HASH
1E21: C5      	    PUSH BC
1E22: 47      	    LD B, A
