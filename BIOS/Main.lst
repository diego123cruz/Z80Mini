2445: DD23    	    INC IX
2447: 23      	    INC HL
2448: 1D      	    DEC E
2449: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
244B: 3EFF    	    LD A, FS_DATAPG         ; 255
244D: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
244E: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
2450: 5F      	    LD E, A
2451:         	FS_WP_PADLOOP:
2451: 36FF    	    LD (HL), $FF
2453: 23      	    INC HL
2454: 1D      	    DEC E
2455: 20FA    	    JR NZ, FS_WP_PADLOOP
2457:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
2457: F1      	    POP AF                  ; A = numero da pagina
2458: F5      	    PUSH AF
2459: 57      	    LD D, A
245A: 1E00    	    LD E, 0
245C: 2142FC  	    LD HL, PG_BUF
245F: 010001  	    LD BC, 256
2462: CD0C1D  	    CALL I2C_MemWr
2465: C29224  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
2468: F1      	    POP AF                  ; A = pagina (descarta)
2469: E1      	    POP HL                  ; restaura HL original
246A: D1      	    POP DE                  ; restaura DE original
246B: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
246C: 2A3AFC  	    LD HL, (FS_TMPSZ)
246F: 7C      	    LD A, H
2470: B7      	    OR A
2471: 2005    	    JR NZ, FS_WP_UPD255
2473: 7D      	    LD A, L
2474: FEFF    	    CP FS_DATAPG
2476: 3805    	    JR C, FS_WP_UPDLT
2478:         	FS_WP_UPD255:
2478: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
247B: 1803    	    JR FS_WP_UPDATE
247D:         	FS_WP_UPDLT:
247D: 0600    	    LD B, 0
247F: 4D      	    LD C, L                 ; bytes gravados = L
              	
2480:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
2480: 2A3CFC  	    LD HL, (FS_TMPRAM)
2483: 09      	    ADD HL, BC
2484: 223CFC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
2487: 2A3AFC  	    LD HL, (FS_TMPSZ)
248A: B7      	    OR A                    ; limpa carry
248B: ED42    	    SBC HL, BC
248D: 223AFC  	    LD (FS_TMPSZ), HL
2490: AF      	    XOR A                   ; Z = sucesso
2491: C9      	    RET
              	
2492:         	FS_WP_ERR:
2492: F1      	    POP AF
2493: E1      	    POP HL
2494: D1      	    POP DE
2495: C1      	    POP BC
2496: 3E01    	    LD A, 1
2498: B7      	    OR A
2499: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
249A:         	FS_SET_NEXT:
249A: C5      	    PUSH BC
249B: D5      	    PUSH DE
249C: E5      	    PUSH HL
249D: 57      	    LD D, A
249E: 1E00    	    LD E, 0
24A0: 78      	    LD A, B
24A1: 3239FC  	    LD (FS_TMP1), A
24A4: 2139FC  	    LD HL, FS_TMP1
24A7: 010100  	    LD BC, 1
24AA: CD0C1D  	    CALL I2C_MemWr
24AD: E1      	    POP HL
24AE: D1      	    POP DE
24AF: C1      	    POP BC
24B0: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
