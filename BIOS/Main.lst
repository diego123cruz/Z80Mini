              	    ; Le byte 0 (next page)
1F79: 57      	    LD D, A
1F7A: 1E00    	    LD E, 0
1F7C: 2139FC  	    LD HL, FS_TMP1
1F7F: 010100  	    LD BC, 1
1F82: CDD41C  	    CALL I2C_MemRd
1F85: C0      	    RET NZ
              	
              	    ; min(FS_TMPSZ, 255) bytes a ler
1F86: 2A3AFC  	    LD HL, (FS_TMPSZ)
1F89: 7C      	    LD A, H
1F8A: B7      	    OR A
