              	; ============================================================
              	;  CHANGE_DRIVE_A  -  Altera drive para device A - EEDRIVE_A
              	; ============================================================
1201:         	CHANGE_DRIVE_A:
1201: 3EA0    	    LD A, EEDRIVE_A
1203: 3204FC  	    LD (I2CA_BLOCK), A
1206: CD6322  	    CALL CHECK_DISK_FORMAT
1209: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_B  -  Altera drive para device B - EEDRIVE_B
              	; ============================================================
