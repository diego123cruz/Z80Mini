1EE6: CD030A  	    CALL plotAlways
              	
1EE9: CD1305  	    CALL CRLF
              	    ;LD HL, str_dir_hdr
              	    ;CALL PUTS
1EEC: AF      	    XOR A
1EED: 3220FC  	    LD (FS_CUR), A
1EF0: 0608    	    LD B, FS_MAXFILES
1EF2: 0E00    	    LD C, 0
1EF4:         	FS_DIR_LOOP:
1EF4: C5      	    PUSH BC
1EF5: CD2C23  	    CALL FS_RD_ENTRY
1EF8: C2BD25  	    JP NZ, FS_ERR_I2C_POP
1EFB: 3A36FC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
1EFE: FEFF    	    CP FS_FLAG_FREE
1F00: 2827    	    JR Z, FS_DIR_SKIP
1F02: 2121FC  	    LD HL, FS_WRKBUF + FS_O_NAME
1F05: 0610    	    LD B, FS_NAME_SZ
              	    ; sinaliza pasta '+'
1F07: 3A36FC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
1F0A: FE01    	    CP FS_FLAG_USED
1F0C: 2803    	    JR Z, FS_DIR_NM
1F0E: 3E2B    	    LD A, '+'
1F10: CF      	    RST $08
1F11:         	FS_DIR_NM:
1F11: 7E      	    LD A, (HL)
1F12: B7      	    OR A
1F13: 2806    	    JR Z, FS_DIR_PAD
1F15: CF      	    RST $08
1F16: 23      	    INC HL
1F17: 10F8    	    DJNZ FS_DIR_NM
1F19: 1806    	    JR FS_DIR_AFT
1F1B:         	FS_DIR_PAD:
