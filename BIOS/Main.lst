              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
14AF:         	SKIP_COMMAND_DE:
14AF: 1A      				LD A, (DE)
14B0: FE20    				CP SPACE
14B2: C8      				RET Z
14B3: 13      				INC DE
14B4: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
14B6:         	SKIP_SPACES:
14B6: 7E      	            LD   A, (HL)
14B7: FE20    	            CP   SPACE
14B9: C0      	            RET  NZ
14BA: 23      	            INC  HL
14BB: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
14BD:         	SKIP_SPACES_DE:
14BD: 1A      	            LD   A, (DE)
14BE: FE20    	            CP   SPACE
14C0: C0      	            RET  NZ
14C1: 13      	            INC  DE
14C2: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
14C4:         	SKIP_SPACES_HL:
14C4: 7E      	            LD   A, (HL)
14C5: FE20    	            CP   SPACE
14C7: C0      	            RET  NZ
14C8: 23      	            INC  HL
14C9: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
14CB:         	IS_HEX:
14CB: FE30    	            CP   '0'
14CD: 3814    	            JR   C, IS_HEX_BAD
14CF: FE3A    	            CP   '9'+1
14D1: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
14D3: E6DF    	            AND  0DFH               ; Uppercase
14D5: FE41    	            CP   'A'
14D7: 380A    	            JR   C, IS_HEX_BAD
14D9: FE47    	            CP   'F'+1
14DB: 3006    	            JR   NC, IS_HEX_BAD
14DD: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
14DF: C9      	            RET
14E0:         	IS_HEX_DIG:
14E0: D630    	            SUB  '0'
14E2: C9      	            RET
14E3:         	IS_HEX_BAD:
14E3: 37      	            SCF
14E4: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
14E5:         	PARSE_HEX8_HL:
14E5: 7E      	            LD   A, (HL)
14E6: CDCB14  	            CALL IS_HEX
14E9: D8      	            RET  C
14EA: 0F      	            RRCA
14EB: 0F      	            RRCA
14EC: 0F      	            RRCA
14ED: 0F      	            RRCA
14EE: E6F0    	            AND  0F0H
14F0: 47      	            LD   B, A
14F1: 23      	            INC  HL
14F2: 7E      	            LD   A, (HL)
14F3: CDCB14  	            CALL IS_HEX
14F6: 3803    	            JR   C, PHX8_ERR
14F8: B0      	            OR   B
14F9: 23      	            INC  HL
14FA: C9      	            RET
14FB:         	PHX8_ERR:
14FB: 2B      	            DEC  HL
14FC: 37      	            SCF
14FD: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
14FE:         	PARSE_HEX8_DE:
14FE: 1A      	            LD   A, (DE)
14FF: CDCB14  	            CALL IS_HEX
1502: D8      	            RET  C
1503: 0F      	            RRCA
1504: 0F      	            RRCA
1505: 0F      	            RRCA
1506: 0F      	            RRCA
1507: E6F0    	            AND  0F0H
1509: 47      	            LD   B, A
150A: 13      	            INC  DE
150B: 1A      	            LD   A, (DE)
150C: CDCB14  	            CALL IS_HEX
150F: 3803    	            JR   C, PHX8D_ERR
1511: B0      	            OR   B
1512: 13      	            INC  DE
1513: C9      	            RET
1514:         	PHX8D_ERR:
1514: 1B      	            DEC  DE
1515: 37      	            SCF
1516: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
1517:         	PARSE_HEX16_DE:
1517: CDFE14  	            CALL PARSE_HEX8_DE
151A: D8      	            RET  C
151B: 67      	            LD   H, A
151C: CDFE14  	            CALL PARSE_HEX8_DE
151F: D8      	            RET  C
1520: 6F      	            LD   L, A
1521: C9      	            RET
              	
              	; --- UPCASE_TOKEN: copia token de (HL) em maiúscula para HEXBUF; HL avança após token ---
1522:         	UPCASE_TOKEN:
1522: 11F7FB  	            LD   DE, HEXBUF
1525: 060A    	            LD   B, 10
1527:         	UPCASE_LOOP:
1527: 7E      	            LD   A, (HL)
1528: FE20    	            CP   SPACE
152A: 2817    	            JR   Z, UPCASE_DONE
152C: FE0D    	            CP   CR
152E: 2813    	            JR   Z, UPCASE_DONE
1530: FE00    	            CP   NUL
1532: 280F    	            JR   Z, UPCASE_DONE
1534: FE61    	            CP   'a'
1536: 3806    	            JR   C, UPCASE_STORE
1538: FE7B    	            CP   'z'+1
153A: 3002    	            JR   NC, UPCASE_STORE
153C: E6DF    	            AND  0DFH               ; Converte para maiúscula
153E:         	UPCASE_STORE:
153E: 12      	            LD   (DE), A
153F: 23      	            INC  HL
1540: 13      	            INC  DE
1541: 10E4    	            DJNZ UPCASE_LOOP
1543:         	UPCASE_DONE:
1543: 3E00    	            LD   A, NUL
1545: 12      	            LD   (DE), A
1546: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
1547:         	STRCMP:
1547: 7E      	            LD   A, (HL)
1548: 47      	            LD   B, A
1549: 1A      	            LD   A, (DE)
154A: B8      	            CP   B
154B: C0      	            RET  NZ
154C: FE00    	            CP   NUL
154E: C8      	            RET  Z
154F: 23      	            INC  HL
1550: 13      	            INC  DE
1551: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
1553:         	PRINT_HEX8:
1553: F5      	            PUSH AF
1554: 0F      	            RRCA
1555: 0F      	            RRCA
1556: 0F      	            RRCA
1557: 0F      	            RRCA
1558: CD6015  	            CALL PRINT_NIBBLE
155B: F1      	            POP  AF
155C: CD6015  	            CALL PRINT_NIBBLE
155F: C9      	            RET
              	
1560:         	PRINT_NIBBLE:
1560: E60F    	            AND  0FH
1562: C630    	            ADD  A, '0'
1564: FE3A    	            CP   '9'+1
1566: 3802    	            JR   C, PN_DONE
1568: C607    	            ADD  A, 07H              ; 'A'-'9'-1
156A:         	PN_DONE:
156A: CD9904  	            CALL PUTCHAR
156D: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
156E:         	PRINT_HEX16:
156E: 7C      	            LD   A, H
156F: CD5315  	            CALL PRINT_HEX8
1572: 7D      	            LD   A, L
1573: CD5315  	            CALL PRINT_HEX8
1576: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
1577:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
1577: CDFE14  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
157A: DA2B16  	    JP  C, I2C_BAD_SYNTAX
157D: 3242FD  	    LD  (I2C_ADDR7), A
1580: AF      	    XOR A
1581: 3243FD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
1584:         	I2C_LOOP:
1584: CDBD14  	    CALL SKIP_SPACES_DE
1587: 1A      	    LD  A, (DE)
1588: FE0D    	    CP  CR
158A: CA1716  	    JP  Z, I2C_DONE
158D: FE00    	    CP  NUL
158F: CA1716  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
1592: 1A      	    LD  A, (DE)
1593: E6DF    	    AND 0DFH                ; forca maiuscula
1595: 13      	    INC DE
1596: FE57    	    CP  'W'
1598: 2807    	    JR  Z, I2C_DO_WRITE
159A: FE52    	    CP  'R'
159C: 2829    	    JR  Z, I2C_DO_READ
159E: C32B16  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
15A1:         	I2C_DO_WRITE:
15A1: CDFE14  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
15A4: DA2B16  	    JP  C, I2C_BAD_SYNTAX
15A7: 4F      	    LD  C, A                ; guarda o byte
              	
15A8: 3A43FD  	    LD  A, (I2C_STATE)
15AB: FE01    	    CP  1
15AD: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
15AF: 3A42FD  	    LD  A, (I2C_ADDR7)
15B2: 07      	    RLCA                     ; addr << 1
15B3: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
15B5: CD7E1A  	    CALL I2C_Open
15B8: 204D    	    JR  NZ, I2C_NOACK
15BA: 3E01    	    LD  A, 1
15BC: 3243FD  	    LD  (I2C_STATE), A
              	
15BF:         	I2C_WRITE_GO:
15BF: 79      	    LD  A, C
15C0: CD921A  	    CALL I2C_Write
15C3: 2042    	    JR  NZ, I2C_NOACK
15C5: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
15C7:         	I2C_DO_READ:
15C7: CDFE14  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
15CA: 385F    	    JR  C, I2C_BAD_SYNTAX
15CC: 47      	    LD  B, A
15CD: 78      	    LD  A, B
15CE: B7      	    OR  A
15CF: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
15D1: 3A43FD  	    LD  A, (I2C_STATE)
15D4: FE02    	    CP  2
15D6: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
15D8: 3A42FD  	    LD  A, (I2C_ADDR7)
15DB: 07      	    RLCA
15DC: F601    	    OR  01H                    ; bit0 = 1 (read)
15DE: CD7E1A  	    CALL I2C_Open
15E1: 2024    	    JR  NZ, I2C_NOACK
15E3: 3E02    	    LD  A, 2
15E5: 3243FD  	    LD  (I2C_STATE), A
              	
15E8:         	I2C_READ_GO:
15E8: 78      	    LD  A, B
15E9: FE01    	    CP  1
15EB: 2804    	    JR  Z, I2C_READ_LASTBYTE
15ED: 3EFF    	    LD  A, 0FFH                 ; ACK - ainda tem mais bytes
15EF: 1801    	    JR  I2C_READ_DOIT
15F1:         	I2C_READ_LASTBYTE:
15F1: AF      	    XOR A                        ; NACK - ultimo byte do bloco
15F2:         	I2C_READ_DOIT:
15F2: CDCF1A  	    CALL I2C_Read                ; A = byte lido
15F5: C5      	    PUSH BC
15F6: CD5315  	    CALL PRINT_HEX8
15F9: 3E20    	    LD  A, SPACE
15FB: CD9904  	    CALL PUTCHAR
15FE: C1      	    POP BC
15FF: 05      	    DEC B
1600: 78      	    LD  A, B
1601: B7      	    OR  A
1602: 20E4    	    JR  NZ, I2C_READ_GO
1604: C38415  	    JP  I2C_LOOP
              	
              	; -------- Erro / fim --------
1607:         	I2C_NOACK:
1607: F5      	    PUSH AF
1608: CD851A  	    CALL I2C_Close               ; garante que o barramento nao trava
160B: AF      	    XOR A
160C: 3243FD  	    LD  (I2C_STATE), A
160F: F1      	    POP AF
1610: 213216  	    LD  HL, MSG_I2C_NOACK
1613: CDA504  	    CALL PUTS
1616: C9      	    RET
              	
1617:         	I2C_DONE:
1617: 3A43FD  	    LD  A, (I2C_STATE)
161A: B7      	    OR  A
161B: 2807    	    JR  Z, I2C_OK
161D: CD851A  	    CALL I2C_Close
1620: AF      	    XOR A
1621: 3243FD  	    LD  (I2C_STATE), A
1624:         	I2C_OK:
1624: 219716  	    LD  HL, MSG_OK
1627: CDA504  	    CALL PUTS
162A: C9      	    RET
              	
162B:         	I2C_BAD_SYNTAX:
162B: 218516  	    LD  HL, MSG_SYNTAX
162E: CDA504  	    CALL PUTS
1631: C9      	    RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
