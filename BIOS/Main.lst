1D09: CD7404  	    CALL CRLF
1D0C: C9      	    RET
              	
              	; FS_DO_LOAD - carrega arquivo (FS_WRKBUF preenchido)
              	;   On exit: Z=OK  NZ=erro
1D0D:         	FS_DO_LOAD:
1D0D: 3A15FC  	    LD A, (FS_WRKBUF + FS_O_RADRH)
1D10: 67      	    LD H, A
1D11: 3A16FC  	    LD A, (FS_WRKBUF + FS_O_RADRL)
1D14: 6F      	    LD L, A
1D15: 2237FC  	    LD (FS_TMPRAM), HL      ; destino RAM
1D18: 3A13FC  	    LD A, (FS_WRKBUF + FS_O_SIZEH)
1D1B: 67      	    LD H, A
1D1C: 3A14FC  	    LD A, (FS_WRKBUF + FS_O_SIZEL)
1D1F: 6F      	    LD L, A
1D20: 2235FC  	    LD (FS_TMPSZ), HL       ; bytes restantes
1D23: 3A12FC  	    LD A, (FS_WRKBUF + FS_O_FSTPG)
1D26: 3239FC  	    LD (FS_CURPG), A
              	
1D29:         	FS_DL_PG:
1D29: 3A39FC  	    LD A, (FS_CURPG)
1D2C: B7      	    OR A
1D2D: 2848    	    JR Z, FS_DL_DONE
              	
              	    ; Le byte 0 (next page)
1D2F: 57      	    LD D, A
1D30: 1E00    	    LD E, 0
1D32: 2134FC  	    LD HL, FS_TMP1
1D35: 010100  	    LD BC, 1
1D38: CDC21B  	    CALL I2C_MemRd
1D3B: C0      	    RET NZ
              	
              	    ; min(FS_TMPSZ, 255) bytes a ler
1D3C: 2A35FC  	    LD HL, (FS_TMPSZ)
1D3F: 7C      	    LD A, H
1D40: B7      	    OR A
1D41: 2005    	    JR NZ, FS_DL_255
1D43: 7D      	    LD A, L
1D44: FEFF    	    CP FS_DATAPG
1D46: 3805    	    JR C, FS_DL_LT
1D48:         	FS_DL_255:
1D48: 01FF00  	    LD BC, FS_DATAPG
1D4B: 1803    	    JR FS_DL_RD
1D4D:         	FS_DL_LT:
1D4D: 0600    	    LD B, 0
1D4F: 4D      	    LD C, L
              	
1D50:         	FS_DL_RD:
              	    ; BC=bytes, DE=pag*256+1, HL=destino
1D50: C5      	    PUSH BC
1D51: 3A39FC  	    LD A, (FS_CURPG)
1D54: 57      	    LD D, A
1D55: 1E01    	    LD E, 1
1D57: 2A37FC  	    LD HL, (FS_TMPRAM)
1D5A: CDC21B  	    CALL I2C_MemRd
1D5D: C1      	    POP BC
1D5E: C0      	    RET NZ
              	
              	    ; Atualiza ponteiros
1D5F: 2A37FC  	    LD HL, (FS_TMPRAM)
1D62: 09      	    ADD HL, BC
1D63: 2237FC  	    LD (FS_TMPRAM), HL
1D66: 2A35FC  	    LD HL, (FS_TMPSZ)
1D69: B7      	    OR A                    ; limpa carry
1D6A: ED42    	    SBC HL, BC
1D6C: 2235FC  	    LD (FS_TMPSZ), HL
              	
              	    ; Proxima pagina
1D6F: 3A34FC  	    LD A, (FS_TMP1)
1D72: 3239FC  	    LD (FS_CURPG), A
1D75: 18B2    	    JR FS_DL_PG
              	
1D77:         	FS_DL_DONE:
1D77: AF      	    XOR A
1D78: C9      	    RET
              	
              	
