1FA6: 09      	    ADD HL, BC
1FA7: 223CFC  	    LD (FS_TMPRAM), HL
1FAA: 2A3AFC  	    LD HL, (FS_TMPSZ)
1FAD: B7      	    OR A                    ; limpa carry
1FAE: ED42    	    SBC HL, BC
1FB0: 223AFC  	    LD (FS_TMPSZ), HL
              	
