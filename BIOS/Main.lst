1E3E: 4D      	    LD C, L                 ; C = L (< 255)
              	
1E3F:         	FS_WP_COPY:
              	    ; C = bytes a gravar (1..255). Salva em D para nao perder.
1E3F: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
1E40: 213DFC  	    LD HL, PG_BUF
1E43: 3600    	    LD (HL), $00            ; byte 0 = next = $00
1E45: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
1E46: DD2A37FC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
1E4A: 5A      	    LD E, D                 ; E = contador de copia
1E4B:         	FS_WP_CPLOOP:
1E4B: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
1E4E: 77      	    LD (HL), A              ; grava no PG_BUF
1E4F: DD23    	    INC IX
1E51: 23      	    INC HL
1E52: 1D      	    DEC E
1E53: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
1E55: 3EFF    	    LD A, FS_DATAPG         ; 255
1E57: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
1E58: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
1E5A: 5F      	    LD E, A
1E5B:         	FS_WP_PADLOOP:
1E5B: 36FF    	    LD (HL), $FF
1E5D: 23      	    INC HL
1E5E: 1D      	    DEC E
1E5F: 20FA    	    JR NZ, FS_WP_PADLOOP
1E61:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
1E61: F1      	    POP AF                  ; A = numero da pagina
1E62: F5      	    PUSH AF
1E63: 57      	    LD D, A
1E64: 1E00    	    LD E, 0
1E66: 213DFC  	    LD HL, PG_BUF
1E69: 010001  	    LD BC, 256
1E6C: CD5A19  	    CALL I2C_MemWr
1E6F: C29C1E  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
1E72: F1      	    POP AF                  ; A = pagina (descarta)
1E73: E1      	    POP HL                  ; restaura HL original
1E74: D1      	    POP DE                  ; restaura DE original
1E75: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
1E76: 2A35FC  	    LD HL, (FS_TMPSZ)
1E79: 7C      	    LD A, H
1E7A: B7      	    OR A
1E7B: 2005    	    JR NZ, FS_WP_UPD255
1E7D: 7D      	    LD A, L
1E7E: FEFF    	    CP FS_DATAPG
1E80: 3805    	    JR C, FS_WP_UPDLT
1E82:         	FS_WP_UPD255:
1E82: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
1E85: 1803    	    JR FS_WP_UPDATE
1E87:         	FS_WP_UPDLT:
1E87: 0600    	    LD B, 0
1E89: 4D      	    LD C, L                 ; bytes gravados = L
              	
1E8A:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
1E8A: 2A37FC  	    LD HL, (FS_TMPRAM)
1E8D: 09      	    ADD HL, BC
1E8E: 2237FC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
1E91: 2A35FC  	    LD HL, (FS_TMPSZ)
1E94: B7      	    OR A                    ; limpa carry
1E95: ED42    	    SBC HL, BC
1E97: 2235FC  	    LD (FS_TMPSZ), HL
1E9A: AF      	    XOR A                   ; Z = sucesso
1E9B: C9      	    RET
              	
1E9C:         	FS_WP_ERR:
1E9C: F1      	    POP AF
1E9D: E1      	    POP HL
1E9E: D1      	    POP DE
1E9F: C1      	    POP BC
1EA0: 3E01    	    LD A, 1
1EA2: B7      	    OR A
1EA3: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
1EA4:         	FS_SET_NEXT:
1EA4: C5      	    PUSH BC
1EA5: D5      	    PUSH DE
1EA6: E5      	    PUSH HL
1EA7: 57      	    LD D, A
1EA8: 1E00    	    LD E, 0
1EAA: 78      	    LD A, B
1EAB: 3234FC  	    LD (FS_TMP1), A
1EAE: 2134FC  	    LD HL, FS_TMP1
1EB1: 010100  	    LD BC, 1
1EB4: CD5A19  	    CALL I2C_MemWr
1EB7: E1      	    POP HL
1EB8: D1      	    POP DE
1EB9: C1      	    POP BC
1EBA: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
1EBB:         	FS_FIND_NAME:
1EBB: AF      	    XOR A
1EBC: 3209FC  	    LD (FS_CUR), A
1EBF: 0608    	    LD B, FS_MAXFILES
1EC1:         	FS_FN_LP:
1EC1: C5      	    PUSH BC
1EC2: CDB11C  	    CALL FS_RD_ENTRY
1EC5: C2F41E  	    JP NZ, FS_FN_ERR
1EC8: 3A17FC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
1ECB: FE01    	    CP FS_FLAG_USED
1ECD: 2017    	    JR NZ, FS_FN_NXT
1ECF: 212AFC  	    LD HL, FS_NAMBUF
1ED2: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
1ED5: 0E08    	    LD C, FS_NAME_SZ
1ED7:         	FS_FN_CMP:
1ED7: 7E      	    LD   A, (HL)
1ED8: 47      	    LD   B, A
1ED9: 1A      	    LD   A, (DE)
1EDA: B8      	    CP   B
1EDB: C2E61E  	    JP  NZ, FS_FN_NXT
1EDE: 23      	    INC HL
1EDF: 13      	    INC DE
1EE0: 0D      	    DEC C
1EE1: 20F4    	    JR NZ, FS_FN_CMP
1EE3: C1      	    POP BC
1EE4: AF      	    XOR A
1EE5: C9      	    RET
1EE6:         	FS_FN_NXT:
1EE6: 3A09FC  	    LD A, (FS_CUR)
1EE9: 3C      	    INC A
1EEA: 3209FC  	    LD (FS_CUR), A
1EED: C1      	    POP BC
1EEE: 10D1    	    DJNZ FS_FN_LP
1EF0: 3E01    	    LD A, 1
1EF2: B7      	    OR A
1EF3: C9      	    RET
1EF4:         	FS_FN_ERR:
1EF4: C1      	    POP BC
1EF5: 3E03    	    LD A, ERR_TOUT
1EF7: B7      	    OR A
1EF8: C9      	    RET
              	
              	
