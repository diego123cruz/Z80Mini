0A1C: ED5BA5FB	        LD DE, (MEN_CURSR) ;0606H         ;Six pixels across, Six pixels down
0A20: ED4B95FB	        LD BC,(CURSOR_XY)   ;Get graphics cursor position
0A24:         	FLIP_BIT:        
0A24: 3A99FB  	        LD A,(INVERSE)      ;check inverse flag
0A27: B7      	        OR A
