158B: 2813    	            JR   Z, UPCASE_DONE
158D: FE00    	            CP   NUL
158F: 280F    	            JR   Z, UPCASE_DONE
1591: FE61    	            CP   'a'
1593: 3806    	            JR   C, UPCASE_STORE
1595: FE7B    	            CP   'z'+1
1597: 3002    	            JR   NC, UPCASE_STORE
1599: E6DF    	            AND  0DFH               ; Converte para maiúscula
159B:         	UPCASE_STORE:
159B: 12      	            LD   (DE), A
159C: 23      	            INC  HL
159D: 13      	            INC  DE
159E: 10E4    	            DJNZ UPCASE_LOOP
15A0:         	UPCASE_DONE:
15A0: 3E00    	            LD   A, NUL
15A2: 12      	            LD   (DE), A
15A3: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
15A4:         	STRCMP:
15A4: 7E      	            LD   A, (HL)
15A5: 47      	            LD   B, A
15A6: 1A      	            LD   A, (DE)
15A7: B8      	            CP   B
15A8: C0      	            RET  NZ
15A9: FE00    	            CP   NUL
15AB: C8      	            RET  Z
15AC: 23      	            INC  HL
15AD: 13      	            INC  DE
15AE: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
15B0:         	PRINT_HEX8:
15B0: F5      	            PUSH AF
15B1: 0F      	            RRCA
15B2: 0F      	            RRCA
15B3: 0F      	            RRCA
15B4: 0F      	            RRCA
15B5: CDBD15  	            CALL PRINT_NIBBLE
15B8: F1      	            POP  AF
15B9: CDBD15  	            CALL PRINT_NIBBLE
15BC: C9      	            RET
              	
15BD:         	PRINT_NIBBLE:
15BD: E60F    	            AND  0FH
15BF: C630    	            ADD  A, '0'
15C1: FE3A    	            CP   '9'+1
15C3: 3802    	            JR   C, PN_DONE
15C5: C607    	            ADD  A, 07H              ; 'A'-'9'-1
15C7:         	PN_DONE:
15C7: CDF704  	            CALL PUTCHAR
15CA: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
15CB:         	PRINT_HEX16:
15CB: 7C      	            LD   A, H
15CC: CDB015  	            CALL PRINT_HEX8
15CF: 7D      	            LD   A, L
15D0: CDB015  	            CALL PRINT_HEX8
15D3: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
15D4:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
15D4: CD5B15  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
15D7: DA8816  	    JP  C, I2C_BAD_SYNTAX
15DA: 3259FD  	    LD  (I2C_ADDR7), A
15DD: AF      	    XOR A
15DE: 325AFD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
15E1:         	I2C_LOOP:
15E1: CD1A15  	    CALL SKIP_SPACES_DE
15E4: 1A      	    LD  A, (DE)
15E5: FE0D    	    CP  CR
15E7: CA7416  	    JP  Z, I2C_DONE
15EA: FE00    	    CP  NUL
15EC: CA7416  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
15EF: 1A      	    LD  A, (DE)
15F0: E6DF    	    AND 0DFH                ; forca maiuscula
15F2: 13      	    INC DE
15F3: FE57    	    CP  'W'
15F5: 2807    	    JR  Z, I2C_DO_WRITE
15F7: FE52    	    CP  'R'
15F9: 2829    	    JR  Z, I2C_DO_READ
15FB: C38816  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
15FE:         	I2C_DO_WRITE:
15FE: CD5B15  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
1601: DA8816  	    JP  C, I2C_BAD_SYNTAX
1604: 4F      	    LD  C, A                ; guarda o byte
              	
1605: 3A5AFD  	    LD  A, (I2C_STATE)
1608: FE01    	    CP  1
160A: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
160C: 3A59FD  	    LD  A, (I2C_ADDR7)
160F: 07      	    RLCA                     ; addr << 1
1610: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
1612: CDDB1A  	    CALL I2C_Open
1615: 204D    	    JR  NZ, I2C_NOACK
1617: 3E01    	    LD  A, 1
1619: 325AFD  	    LD  (I2C_STATE), A
              	
161C:         	I2C_WRITE_GO:
161C: 79      	    LD  A, C
161D: CDEF1A  	    CALL I2C_Write
1620: 2042    	    JR  NZ, I2C_NOACK
1622: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
1624:         	I2C_DO_READ:
1624: CD5B15  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
1627: 385F    	    JR  C, I2C_BAD_SYNTAX
1629: 47      	    LD  B, A
162A: 78      	    LD  A, B
162B: B7      	    OR  A
162C: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
162E: 3A5AFD  	    LD  A, (I2C_STATE)
1631: FE02    	    CP  2
1633: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
1635: 3A59FD  	    LD  A, (I2C_ADDR7)
1638: 07      	    RLCA
1639: F601    	    OR  01H                    ; bit0 = 1 (read)
163B: CDDB1A  	    CALL I2C_Open
163E: 2024    	    JR  NZ, I2C_NOACK
1640: 3E02    	    LD  A, 2
1642: 325AFD  	    LD  (I2C_STATE), A
              	
1645:         	I2C_READ_GO:
1645: 78      	    LD  A, B
1646: FE01    	    CP  1
1648: 2804    	    JR  Z, I2C_READ_LASTBYTE
164A: 3EFF    	    LD  A, 0FFH                 ; ACK - ainda tem mais bytes
164C: 1801    	    JR  I2C_READ_DOIT
164E:         	I2C_READ_LASTBYTE:
164E: AF      	    XOR A                        ; NACK - ultimo byte do bloco
164F:         	I2C_READ_DOIT:
164F: CD2C1B  	    CALL I2C_Read                ; A = byte lido
1652: C5      	    PUSH BC
1653: CDB015  	    CALL PRINT_HEX8
1656: 3E20    	    LD  A, SPACE
1658: CDF704  	    CALL PUTCHAR
165B: C1      	    POP BC
165C: 05      	    DEC B
165D: 78      	    LD  A, B
165E: B7      	    OR  A
165F: 20E4    	    JR  NZ, I2C_READ_GO
1661: C3E115  	    JP  I2C_LOOP
              	
              	; -------- Erro / fim --------
1664:         	I2C_NOACK:
1664: F5      	    PUSH AF
1665: CDE21A  	    CALL I2C_Close               ; garante que o barramento nao trava
1668: AF      	    XOR A
1669: 325AFD  	    LD  (I2C_STATE), A
166C: F1      	    POP AF
166D: 218F16  	    LD  HL, MSG_I2C_NOACK
1670: CD0305  	    CALL PUTS
1673: C9      	    RET
              	
1674:         	I2C_DONE:
1674: 3A5AFD  	    LD  A, (I2C_STATE)
1677: B7      	    OR  A
1678: 2807    	    JR  Z, I2C_OK
167A: CDE21A  	    CALL I2C_Close
167D: AF      	    XOR A
167E: 325AFD  	    LD  (I2C_STATE), A
1681:         	I2C_OK:
1681: 21F416  	    LD  HL, MSG_OK
1684: CD0305  	    CALL PUTS
1687: C9      	    RET
              	
1688:         	I2C_BAD_SYNTAX:
1688: 21E216  	    LD  HL, MSG_SYNTAX
168B: CD0305  	    CALL PUTS
168E: C9      	    RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
