1FC7: 2A3CFC  	    LD HL, (FS_TMPRAM)
1FCA: 09      	    ADD HL, BC
1FCB: 223CFC  	    LD (FS_TMPRAM), HL
1FCE: 2A3AFC  	    LD HL, (FS_TMPSZ)
1FD1: B7      	    OR A                    ; limpa carry
1FD2: ED42    	    SBC HL, BC
1FD4: 223AFC  	    LD (FS_TMPSZ), HL
              	
