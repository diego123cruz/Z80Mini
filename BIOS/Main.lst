24B8: CDA322  	    CALL FS_RD_ENTRY
24BB: C2EA24  	    JP NZ, FS_FN_ERR
24BE: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
24C1: FE01    	    CP FS_FLAG_USED
24C3: 2017    	    JR NZ, FS_FN_NXT
24C5: 212AFC  	    LD HL, FS_NAMBUF
24C8: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
24CB: 0E10    	    LD C, FS_NAME_SZ
24CD:         	FS_FN_CMP:
24CD: 7E      	    LD   A, (HL)
24CE: 47      	    LD   B, A
24CF: 1A      	    LD   A, (DE)
24D0: B8      	    CP   B
24D1: C2DC24  	    JP  NZ, FS_FN_NXT
24D4: 23      	    INC HL
24D5: 13      	    INC DE
24D6: 0D      	    DEC C
24D7: 20F4    	    JR NZ, FS_FN_CMP
24D9: C1      	    POP BC
24DA: AF      	    XOR A
24DB: C9      	    RET
24DC:         	FS_FN_NXT:
24DC: 3A09FC  	    LD A, (FS_CUR)
24DF: 3C      	    INC A
24E0: 3209FC  	    LD (FS_CUR), A
24E3: C1      	    POP BC
24E4: 10D1    	    DJNZ FS_FN_LP
24E6: 3E01    	    LD A, 1
24E8: B7      	    OR A
24E9: C9      	    RET
24EA:         	FS_FN_ERR:
