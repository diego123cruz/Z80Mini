249E: 46432045	str_fc_err:  .TEXT "FC ERRO!"
24A2: 52524F21	
24A6: 0D0A00  	             .DB CR, LF, 0
              	
              	
              	
              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
24A9:         	FS_WRITE_PG:
24A9: C5      	    PUSH BC
24AA: D5      	    PUSH DE
24AB: E5      	    PUSH HL
24AC: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
24AD: 2A51FC  	    LD HL, (FS_TMPSZ)
24B0: 7C      	    LD A, H
24B1: B7      	    OR A
24B2: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
24B4: 7D      	    LD A, L
24B5: FEFF    	    CP FS_DATAPG            ; L < 255?
24B7: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
24B9:         	FS_WP_USE255:
24B9: 0EFF    	    LD C, FS_DATAPG         ; C = 255
24BB: 1801    	    JR FS_WP_COPY
24BD:         	FS_WP_USELT:
24BD: 4D      	    LD C, L                 ; C = L (< 255)
              	
24BE:         	FS_WP_COPY:
              	    ; C = bytes a gravar (1..255). Salva em D para nao perder.
24BE: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
24BF: 2159FC  	    LD HL, PG_BUF
24C2: 3600    	    LD (HL), $00            ; byte 0 = next = $00
24C4: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
24C5: DD2A53FC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
24C9: 5A      	    LD E, D                 ; E = contador de copia
24CA:         	FS_WP_CPLOOP:
24CA: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
24CD: 77      	    LD (HL), A              ; grava no PG_BUF
24CE: DD23    	    INC IX
24D0: 23      	    INC HL
24D1: 1D      	    DEC E
24D2: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
24D4: 3EFF    	    LD A, FS_DATAPG         ; 255
24D6: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
24D7: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
24D9: 5F      	    LD E, A
24DA:         	FS_WP_PADLOOP:
24DA: 36FF    	    LD (HL), $FF
24DC: 23      	    INC HL
24DD: 1D      	    DEC E
24DE: 20FA    	    JR NZ, FS_WP_PADLOOP
24E0:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
24E0: F1      	    POP AF                  ; A = numero da pagina
24E1: F5      	    PUSH AF
24E2: 57      	    LD D, A
24E3: 1E00    	    LD E, 0
24E5: 2159FC  	    LD HL, PG_BUF
24E8: 010001  	    LD BC, 256
24EB: CD871D  	    CALL I2C_MemWr
24EE: C21B25  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
24F1: F1      	    POP AF                  ; A = pagina (descarta)
24F2: E1      	    POP HL                  ; restaura HL original
24F3: D1      	    POP DE                  ; restaura DE original
24F4: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
24F5: 2A51FC  	    LD HL, (FS_TMPSZ)
24F8: 7C      	    LD A, H
24F9: B7      	    OR A
24FA: 2005    	    JR NZ, FS_WP_UPD255
24FC: 7D      	    LD A, L
24FD: FEFF    	    CP FS_DATAPG
24FF: 3805    	    JR C, FS_WP_UPDLT
2501:         	FS_WP_UPD255:
2501: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
2504: 1803    	    JR FS_WP_UPDATE
2506:         	FS_WP_UPDLT:
2506: 0600    	    LD B, 0
2508: 4D      	    LD C, L                 ; bytes gravados = L
              	
2509:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
2509: 2A53FC  	    LD HL, (FS_TMPRAM)
250C: 09      	    ADD HL, BC
250D: 2253FC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
2510: 2A51FC  	    LD HL, (FS_TMPSZ)
2513: B7      	    OR A                    ; limpa carry
2514: ED42    	    SBC HL, BC
2516: 2251FC  	    LD (FS_TMPSZ), HL
2519: AF      	    XOR A                   ; Z = sucesso
251A: C9      	    RET
              	
251B:         	FS_WP_ERR:
251B: F1      	    POP AF
251C: E1      	    POP HL
251D: D1      	    POP DE
251E: C1      	    POP BC
251F: 3E01    	    LD A, 1
2521: B7      	    OR A
2522: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
2523:         	FS_SET_NEXT:
2523: C5      	    PUSH BC
2524: D5      	    PUSH DE
2525: E5      	    PUSH HL
2526: 57      	    LD D, A
2527: 1E00    	    LD E, 0
2529: 78      	    LD A, B
252A: 3250FC  	    LD (FS_TMP1), A
252D: 2150FC  	    LD HL, FS_TMP1
2530: 010100  	    LD BC, 1
2533: CD871D  	    CALL I2C_MemWr
2536: E1      	    POP HL
2537: D1      	    POP DE
2538: C1      	    POP BC
2539: C9      	    RET
              	
              	
              	
