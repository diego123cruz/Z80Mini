              	;==============================================================================
              	;==============================================================================
              	;==============================================================================
              	;===================       FUNCTIONS    =======================================
              	;==============================================================================
              	;==============================================================================
              	
              	
              	
              	
              	; **********************************************************************
              	; List devices found on the I2C bus
              	;
              	; Test each I2C device address and reports any that acknowledge
              	
18F4: 21DE18  	I2CLIST:    LD   HL, I2C_LIST_MSG        ;Address of message string
              	            ;XOR A ; A = character to stop printing.
18F7: CD3704  	            CALL PUTS         ;Output string
18FA: 1600    	            LD   D,0            ;First I2C device address to test
18FC: D5      	LISTLOOP:      PUSH DE             ;Preserve DE
18FD: 7A      	            LD   A,D            ;Get device address to be tested
18FE: CD1919  	            CALL LISTTEST          ;Test if device is present
1901: D1      	            POP  DE             ;Restore DE
1902: 2009    	            JR   NZ,LISTNEXT       ;Skip if no acknowledge
1904: 7A      	            LD   A,D            ;Get address of device tested
1905: CD9119  	            CALL HexOut         ;Output as two character hex 
1908: 3E20    	            LD A, ' '; space
190A: CD2B04  	            CALL PUTCHAR       ;Output space character
190D: 14      	LISTNEXT:      INC  D              ;Get next write address
190E: 14      	            INC  D
190F: 7A      	            LD   A,D            ;Address of next device to test
1910: B7      	            OR   A              ;Have we tested all addresses?
1911: 20E9    	            JR   NZ,LISTLOOP       ;No, so loop again
1913: 3E0D    	            LD A, CR; enter
1915: CD2B04  	            CALL PUTCHAR       ;Output space character
1918: C9      	            RET
              	
              	; Test if device at I2C address A acknowledges
              	;   On entry: A = I2C device address (8-bit, bit 0 = lo for write)
              	;   On exit:  Z flagged if device acknowledges
              	;             NZ flagged if devices does not acknowledge
1919: CD1E18  	LISTTEST:      CALL I2C_Open       ;Open I2C device for write
191C: C0      	            RET  NZ             ;Abort if failed to open
191D: CD2518  	            CALL I2C_Close      ;Close I2C device 
1920: AF      	            XOR  A              ;Return with Z flagged
1921: C9      	            RET
              	
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1922: C5      	I2C_MemRd:  PUSH BC
1923: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1926:         	I2C_MemRdRepeat:    
1926: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1929: CD1E18  	            CALL I2C_Open       ;Open for write
192C: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
192E: 0B      	            DEC  BC
192F: 78      	            LD   A,B
1930: B1      	            OR   C              ;Timeout?
1931: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1933: C1      	            POP  BC
1934: 3E03    	            LD   A,ERR_TOUT     ;Error code
1936: B7      	            OR   A              ;Error, so NZ flagged
1937: C9      	            RET                 ;Return with error
              	; Device opened okay
1938: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1939: 7A      	            LD   A,D            ;Address (hi) in I2C memory
193A: CD2818  	            CALL I2C_Write      ;Write address
193D: 7B      	            LD   A,E            ;Address (lo) in I2C memory
193E: CD2818  	            CALL I2C_Write      ;Write address
1941: 3A04FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1944: 3C      	            INC  A              ; Device read equal DeviceId+1
1945: CD1E18  	            CALL I2C_Open       ;Open for read
1948: C0      	            RET  NZ             ;Abort if error
1949: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
194A: 78      	            LD   A,B
194B: B1      	            OR   C              ;Last byte to be read?
194C: CD6518  	            CALL I2C_Read       ;Read byte with no ack on last byte
194F: 77      	            LD   (HL),A         ;Write byte in CPU memory
1950: 23      	            INC  HL             ;Increment CPU memory pointer
1951: 78      	            LD   A,B
1952: B1      	            OR   C              ;Finished?
1953: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1955: CD9D18  	            CALL I2C_Stop       ;Generate I2C stop
1958: AF      	            XOR  A              ;Return with success (Z flagged)
1959: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
195A: C5      	I2C_MemWr:  PUSH BC
195B: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
195E:         	I2C_MemWrRepeat:    
195E: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1961: CD1E18  	            CALL I2C_Open       ;Open for write
1964: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1966: 0B      	            DEC  BC
1967: 78      	            LD   A,B
1968: B1      	            OR   C              ;Timeout?
1969: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
196B: C1      	            POP  BC
196C: 3E03    	            LD   A,ERR_TOUT     ;Error code
196E: B7      	            OR   A              ;Error, so NZ flagged
196F: C9      	            RET                 ;Return with error
              	; Device opened okay
1970: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1971: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1972: CD2818  	            CALL I2C_Write      ;Write address
1975: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1976: CD2818  	            CALL I2C_Write      ;Write address
1979: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
197A: CD2818  	            CALL I2C_Write      ;Read byte from I2C memory
197D: 23      	            INC  HL             ;Increment CPU memory pointer
197E: 13      	            INC  DE             ;Increment I2C memory pointer
197F: 0B      	            DEC  BC             ;Decrement byte counter
1980: 78      	            LD   A,B
1981: B1      	            OR   C              ;Finished?
1982: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1984: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1985: E63F    	            AND  63             ;64 byte page boundary?
1987: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1989: CD9D18  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
198C: 78      	            LD   A,B
198D: B1      	            OR   C              ;Finished?
198E: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1990: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1991: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1992: 1F      	            RRA                 ;Shift top nibble to
1993: 1F      	            RRA                 ;  botom four bits..
1994: 1F      	            RRA
1995: 1F      	            RRA
1996: E60F    	            AND  $0F           ;Mask off unwanted bits
1998: CD9E19  	            CALL HexOutHex           ;Output hi nibble
199B: F1      	            POP  AF             ;Restore byte to be output
199C: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
199E: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
19A0: 3802    	            JR   C,HexOutSkip        ;No, so skip
19A2: C607    	            ADD  A,7            ;Yes, so add 7
19A4: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
19A6: CD2B04  	            CALL CONOUT       ;Write character
19A9: C9      	            RET
              	#include "FS.asm"
              	
