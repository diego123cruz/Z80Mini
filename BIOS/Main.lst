1F1D: CF      	    RST $08
1F1E: 23      	    INC HL
1F1F: 10FA    	    DJNZ FS_DIR_PAD
1F21:         	FS_DIR_AFT:
              	    ;LD A, ' '
              	    ;RST $08
              	    ;LD A, (FS_WRKBUF + FS_O_SIZEH)
              	    ;CALL HexOut
              	    ;LD A, (FS_WRKBUF + FS_O_SIZEL)
              	    ;CALL HexOut
              	    ;LD A, ' '
              	    ;RST $08
              	    ;LD A, (FS_WRKBUF + FS_O_RADRH)
              	    ;CALL HexOut
              	    ;LD A, (FS_WRKBUF + FS_O_RADRL)
              	    ;CALL HexOut
              	    ;LD A, ' '
              	    ;RST $08
              	    ;LD A, (FS_WRKBUF + FS_O_FSTPG)
              	    ;CALL HexOut
1F21: CD1305  	    CALL CRLF
1F24: C1      	    POP BC
1F25: 0C      	    INC C
1F26: C32A1F  	    JP FS_DIR_INC
1F29:         	FS_DIR_SKIP:
1F29: C1      	    POP BC
