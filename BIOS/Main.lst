              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
1720: CD3610  	GETCHR_S:	CALL INCH	; RX a Character
1723: FE03    			CP   $03	; <ctrl-c> User break?
1725: C8      			RET  Z			
1726: FE20    			CP   $20	; <space> or better?
1728: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
172A: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
172B: CD2017  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
172E: 47      			LD   B,A	; Load it in B
172F: CD2017  			CALL GETCHR_S	; Get us another character
1732: 4F      			LD   C,A	; load it in C
1733: CD3C17  			CALL BCTOA	; Convert ASCII to byte
1736: 4F      			LD   C,A	; Build the checksum
1737: 7B      			LD   A,E
1738: 91      			SUB  C		; The checksum should always equal zero when checked
1739: 5F      			LD   E,A	; Save the checksum back where it came from
173A: 79      			LD   A,C	; Retrieve the byte and go back
173B: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
173C: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
173D: D630    			SUB  $30	; Take it down from Ascii
173F: FE0A    			CP   $0A	; Are we in the 0-9 range here?
1741: 3802    			JR   C,BCTOA1	; If so, get the next nybble
1743: D607    			SUB  $07	; But if A-F, take it down some more
1745: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
1746: 07      			RLCA		; One bit at a time
1747: 07      			RLCA		; Until we
1748: 07      			RLCA		; Get there with it
1749: 47      			LD   B,A	; Save the converted high nybble
174A: 79      			LD   A,C	; Now get the low order byte
174B: D630    			SUB  $30	; Convert it down from Ascii
174D: FE0A    			CP   $0A	; 0-9 at this point?
174F: 3802    			JR   C,BCTOA2	; Good enough then, but
1751: D607    			SUB  $07	; Take off 7 more if it's A-F
1753: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
1754: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
1755:         	SERIAL_A_PRINT_HL_HEX:
1755: 7C      			LD   A, H
1756: CD5E17  			CALL SERIAL_A_PRINT_A_HEX
1759: 7D      			LD   A, L
175A: CD5E17  			CALL SERIAL_A_PRINT_A_HEX
175D: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
175E:         	SERIAL_A_PRINT_A_HEX:
175E: F5      			PUSH AF
175F: 0F      			RRCA
1760: 0F      			RRCA
1761: 0F      			RRCA
1762: 0F      			RRCA
1763: CD6B17  			CALL SERIAL_A_PRINT_NIBBLE
1766: F1      			POP  AF
1767: CD6B17  			CALL SERIAL_A_PRINT_NIBBLE
176A: C9      			RET
              	
176B:         	SERIAL_A_PRINT_NIBBLE:
176B: E60F    			AND  $0F
176D: FE0A    			CP   $0A
176F: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
1771: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
1773: CD3010  			CALL OUTCH
1776: C9      			RET
1777:         	SERIAL_A_PRINT_NIBBLE_09:
1777: C630    			ADD  A, $30             ; 0-9
1779: CD3010  			CALL OUTCH
177C: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
177D:         	SERIAL_A_PRINT_STRING:
177D: 7E      	        LD   A,(HL)	; Get character
177E: B7      			OR   A		; Is it $00 ?
177F: C8      			RET  Z		; Then RETurn on terminator
1780: CD3010  			CALL OUTCH	; Print it
1783: 23      			INC  HL		; Next Character
1784: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
1786: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
1788: CD3010  			CALL OUTCH	; Print character 
178B: 3E0A    			LD   A,$0A	; 
178D: CD3010  			CALL OUTCH	; Print character
1790: C9      			RET
              	
              	
              	
