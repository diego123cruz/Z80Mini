1508: CD1305  	            CALL CRLF
150B: C9      	            RET
              	
              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
150C:         	SKIP_COMMAND_DE:
150C: 1A      				LD A, (DE)
150D: FE20    				CP SPACE
150F: C8      				RET Z
1510: 13      				INC DE
1511: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
1513:         	SKIP_SPACES:
1513: 7E      	            LD   A, (HL)
1514: FE20    	            CP   SPACE
1516: C0      	            RET  NZ
1517: 23      	            INC  HL
1518: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
151A:         	SKIP_SPACES_DE:
151A: 1A      	            LD   A, (DE)
151B: FE20    	            CP   SPACE
151D: C0      	            RET  NZ
151E: 13      	            INC  DE
151F: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
1521:         	SKIP_SPACES_HL:
1521: 7E      	            LD   A, (HL)
1522: FE20    	            CP   SPACE
1524: C0      	            RET  NZ
1525: 23      	            INC  HL
1526: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
1528:         	IS_HEX:
1528: FE30    	            CP   '0'
152A: 3814    	            JR   C, IS_HEX_BAD
152C: FE3A    	            CP   '9'+1
152E: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
1530: E6DF    	            AND  0DFH               ; Uppercase
1532: FE41    	            CP   'A'
1534: 380A    	            JR   C, IS_HEX_BAD
1536: FE47    	            CP   'F'+1
1538: 3006    	            JR   NC, IS_HEX_BAD
153A: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
153C: C9      	            RET
153D:         	IS_HEX_DIG:
153D: D630    	            SUB  '0'
153F: C9      	            RET
1540:         	IS_HEX_BAD:
1540: 37      	            SCF
1541: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
1542:         	PARSE_HEX8_HL:
1542: 7E      	            LD   A, (HL)
1543: CD2815  	            CALL IS_HEX
1546: D8      	            RET  C
1547: 0F      	            RRCA
1548: 0F      	            RRCA
1549: 0F      	            RRCA
154A: 0F      	            RRCA
154B: E6F0    	            AND  0F0H
154D: 47      	            LD   B, A
154E: 23      	            INC  HL
154F: 7E      	            LD   A, (HL)
1550: CD2815  	            CALL IS_HEX
1553: 3803    	            JR   C, PHX8_ERR
1555: B0      	            OR   B
1556: 23      	            INC  HL
1557: C9      	            RET
1558:         	PHX8_ERR:
1558: 2B      	            DEC  HL
1559: 37      	            SCF
155A: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
155B:         	PARSE_HEX8_DE:
155B: 1A      	            LD   A, (DE)
155C: CD2815  	            CALL IS_HEX
155F: D8      	            RET  C
1560: 0F      	            RRCA
1561: 0F      	            RRCA
1562: 0F      	            RRCA
1563: 0F      	            RRCA
1564: E6F0    	            AND  0F0H
1566: 47      	            LD   B, A
1567: 13      	            INC  DE
1568: 1A      	            LD   A, (DE)
1569: CD2815  	            CALL IS_HEX
156C: 3803    	            JR   C, PHX8D_ERR
156E: B0      	            OR   B
156F: 13      	            INC  DE
1570: C9      	            RET
1571:         	PHX8D_ERR:
1571: 1B      	            DEC  DE
1572: 37      	            SCF
1573: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
1574:         	PARSE_HEX16_DE:
1574: CD5B15  	            CALL PARSE_HEX8_DE
1577: D8      	            RET  C
1578: 67      	            LD   H, A
1579: CD5B15  	            CALL PARSE_HEX8_DE
157C: D8      	            RET  C
157D: 6F      	            LD   L, A
157E: C9      	            RET
              	
