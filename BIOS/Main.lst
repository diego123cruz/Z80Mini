1F95: 2848    	    JR Z, FS_DL_DONE
              	
              	    ; Le byte 0 (next page)
1F97: 57      	    LD D, A
1F98: 1E00    	    LD E, 0
1F9A: 2139FC  	    LD HL, FS_TMP1
1F9D: 010100  	    LD BC, 1
1FA0: CDF21C  	    CALL I2C_MemRd
1FA3: C0      	    RET NZ
              	
              	    ; min(FS_TMPSZ, 255) bytes a ler
