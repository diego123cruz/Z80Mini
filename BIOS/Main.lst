              	; ============================================================
              	;  CHANGE_DRIVE_A  -  Altera drive para device A - EEDRIVE_A
              	; ============================================================
1220:         	CHANGE_DRIVE_A:
1220: 3EA0    	    LD A, EEDRIVE_A
1222: 3202FC  	    LD (I2CA_BLOCK), A
1225: CD9422  	    CALL CHECK_DISK_FORMAT
1228: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_B  -  Altera drive para device B - EEDRIVE_B
              	; ============================================================
