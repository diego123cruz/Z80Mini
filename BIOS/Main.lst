234F: 07      	    RLCA
2350: 07      	    RLCA
2351: 07      	    RLCA
2352: 07      	    RLCA
2353: 07      	    RLCA
2354: 5F      	    LD E, A
2355: 3A5BFD  	    LD A, (FS_DIR_CUR)
2358: 57      	    LD D, A ; $01
2359: 2121FC  	    LD HL, FS_WRKBUF
