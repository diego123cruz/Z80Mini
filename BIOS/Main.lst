01AB:         	SET_INT38:
01AB: 2200F0  	    LD (RST38), HL
01AE: C9      	    RET
              	
01AF:         	SET_INT66:
01AF: 2202F0  	    LD (RST66), HL
01B2: C9      	    RET
              	
              	; exemplo de uso de interrupcao
              	; IM 1
              	; EI
              	; RETI
01B3:         	INT_DEFAULT:
01B3: E1      	    POP HL ; sempre usar o POP HL
              	    ; faz alguma coisa
              	    ; EI
01B4: ED4D    	    RETI
              	
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; KEYMAPS
              	; ============================================================
              	
              	;	$FF - Capslock
              	;	$FE - Shift left
              	;	$FD - Ctrl left
              	;	$FC - Windows
              	;	$FB - Alt left
              	;	$FA - Alt Gr    (Load intel hex - Serial A)
              	;	$F9 - LUZ   (CALL 8000H)
              	;	$F8 - Shift Right   (Display Scroll UP)
              	;	$F7 - Ctrl Right    (Display Scroll DOWN)
              	;	$F6 - Fn
              	;	$F5 - 
              	;	$F4 - 
              	
