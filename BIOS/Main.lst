15DB: C5      	    PUSH BC
15DC: CD3915  	    CALL PRINT_HEX8
15DF: 3E20    	    LD  A, SPACE
15E1: CD8704  	    CALL PUTCHAR
15E4: C1      	    POP BC
15E5: 05      	    DEC B
15E6: 78      	    LD  A, B
15E7: B7      	    OR  A
15E8: 20E4    	    JR  NZ, I2C_READ_GO
15EA: C36A15  	    JP  I2C_LOOP
              	
