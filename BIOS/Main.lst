0A35: C8      	        RET Z               ;if its zero no more to do, just exit
0A36: 0C      	        INC C               ;move down a row
0A37: 1606    	        LD D,6              ;reset pixel length per row
0A39: 3A96FB  	        LD A,(CURSOR_X)     ;restore original column
0A3C: 47      	        LD B,A              ;reset column
0A3D: 18EA    	        JR FLIP_BIT
              	
