130F: CD0305  	            CALL PUTS
1312: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
1313:         	LOAD_CMD:
1313: CD7415  	            CALL PARSE_HEX16_DE
1316: 3848    	            JR   C, LOAD_BAD
1318: 2214FC  	            LD   (ADDR_TMP), HL
131B: 21F816  	            LD   HL, MSG_LOAD_HINT
131E: CD0305  	            CALL PUTS
              	
1321:         	LOAD_LOOP:
              	            ; Exibe endereço atual
1321: 2A14FC  	            LD   HL, (ADDR_TMP)
1324: CDCB15  	            CALL PRINT_HEX16
1327: 3E3A    	            LD   A, ':'
1329: CDF704  	            CALL PUTCHAR
132C: 3E20    	            LD   A, SPACE
132E: CDF704  	            CALL PUTCHAR
              	
1331: CDB614  	            CALL GETLINE             ; Lê linha
1334: 21BEFB  	            LD   HL, LINEBUF
1337: CD1315  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
133A: 7E      	            LD   A, (HL)
133B: FE0D    	            CP   CR
133D: C8      	            RET  Z
133E: FE00    	            CP   NUL
1340: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
1341:         	LOAD_BYTE:
1341: CD4215  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
1344: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
1346: ED5B14FC	            LD   DE, (ADDR_TMP)
134A: 12      	            LD   (DE), A
134B: 13      	            INC  DE
134C: ED5314FC	            LD   (ADDR_TMP), DE
1350: CD2115  	            CALL SKIP_SPACES_HL
1353: 7E      	            LD   A, (HL)
1354: FE0D    	            CP   CR
1356: 28C9    	            JR   Z, LOAD_LOOP
1358: FE00    	            CP   NUL
135A: 28C5    	            JR   Z, LOAD_LOOP
135C: 18E3    	            JR   LOAD_BYTE
              	
135E:         	LOAD_NEXT_LINE:
135E: 18C1    	            JR   LOAD_LOOP
              	
1360:         	LOAD_BAD:
1360: 21CE16  	            LD   HL, MSG_BAD_ADDR
1363: CD0305  	            CALL PUTS
1366: C9      	            RET
              	
              	; ============================================================
              	;  EDIT_CMD  -  Edita memória byte a byte
              	;  Sintaxe: EDIT xxxx
              	;  Exibe: XXXX: AA  _  (digitar novo valor ou Enter p/ manter)
              	;  '.' encerra
              	; ============================================================
1367:         	EDIT_CMD:
1367: CD7415  	            CALL PARSE_HEX16_DE
136A: 3849    	            JR   C, EDIT_BAD
136C: 2214FC  	            LD   (ADDR_TMP), HL
              	
136F:         	EDIT_LOOP:
136F: 2A14FC  	            LD   HL, (ADDR_TMP)
1372: CDCB15  	            CALL PRINT_HEX16
1375: 3E3A    	            LD   A, ':'
1377: CDF704  	            CALL PUTCHAR
137A: 3E20    	            LD   A, SPACE
137C: CDF704  	            CALL PUTCHAR
137F: 7E      	            LD   A, (HL)             ; Valor atual
1380: CDB015  	            CALL PRINT_HEX8
1383: 3E20    	            LD   A, SPACE
1385: CDF704  	            CALL PUTCHAR
1388: 3E20    	            LD   A, SPACE
138A: CDF704  	            CALL PUTCHAR
              	
              	            ; Lê até 3 chars (2 hex + CR)
138D: CDB614  	            CALL GETLINE
1390: 21BEFB  	            LD   HL, LINEBUF
1393: CD1315  	            CALL SKIP_SPACES
              	
1396: 7E      	            LD   A, (HL)
1397: FE2E    	            CP   '.'                 ; '.' = sair
1399: C8      	            RET  Z
139A: FE0D    	            CP   CR
139C: 280E    	            JR   Z, EDIT_KEEP       ; Enter = mantém byte
139E: FE00    	            CP   NUL
13A0: 280A    	            JR   Z, EDIT_KEEP
              	
              	            ; Tenta parsear novo byte
13A2: CD4215  	            CALL PARSE_HEX8_HL
13A5: 38C8    	            JR   C, EDIT_LOOP       ; Hex inválido: repete
              	
              	            ; Grava novo byte
13A7: ED5B14FC	            LD   DE, (ADDR_TMP)
13AB: 12      	            LD   (DE), A
              	
13AC:         	EDIT_KEEP:
13AC: 2A14FC  	            LD   HL, (ADDR_TMP)
13AF: 23      	            INC  HL
13B0: 2214FC  	            LD   (ADDR_TMP), HL
13B3: 18BA    	            JR   EDIT_LOOP
              	
13B5:         	EDIT_BAD:
13B5: 21CE16  	            LD   HL, MSG_BAD_ADDR
13B8: CD0305  	            CALL PUTS
13BB: C9      	            RET
              	
