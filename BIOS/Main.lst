2433: 3600    	    LD (HL), $00            ; byte 0 = next = $00
2435: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
2436: DD2A3CFC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
243A: 5A      	    LD E, D                 ; E = contador de copia
243B:         	FS_WP_CPLOOP:
