142E: 7E      	            LD   A, (HL)
142F: 47      	            LD   B, A
1430: 1A      	            LD   A, (DE)
1431: B8      	            CP   B
1432: C0      	            RET  NZ
1433: FE00    	            CP   NUL
1435: C8      	            RET  Z
1436: 23      	            INC  HL
1437: 13      	            INC  DE
1438: 18F4    	            JR   STRCMP
              	
