              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
1413:         	SKIP_COMMAND_DE:
1413: 1A      				LD A, (DE)
1414: FE20    				CP SPACE
1416: C8      				RET Z
1417: 13      				INC DE
1418: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
141A:         	SKIP_SPACES:
141A: 7E      	            LD   A, (HL)
141B: FE20    	            CP   SPACE
141D: C0      	            RET  NZ
141E: 23      	            INC  HL
141F: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
1421:         	SKIP_SPACES_DE:
1421: 1A      	            LD   A, (DE)
1422: FE20    	            CP   SPACE
1424: C0      	            RET  NZ
1425: 13      	            INC  DE
1426: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
1428:         	SKIP_SPACES_HL:
1428: 7E      	            LD   A, (HL)
1429: FE20    	            CP   SPACE
142B: C0      	            RET  NZ
142C: 23      	            INC  HL
142D: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
142F:         	IS_HEX:
142F: FE30    	            CP   '0'
1431: 3814    	            JR   C, IS_HEX_BAD
1433: FE3A    	            CP   '9'+1
1435: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
1437: E6DF    	            AND  0DFH               ; Uppercase
1439: FE41    	            CP   'A'
143B: 380A    	            JR   C, IS_HEX_BAD
143D: FE47    	            CP   'F'+1
143F: 3006    	            JR   NC, IS_HEX_BAD
1441: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
1443: C9      	            RET
1444:         	IS_HEX_DIG:
1444: D630    	            SUB  '0'
1446: C9      	            RET
1447:         	IS_HEX_BAD:
1447: 37      	            SCF
1448: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
1449:         	PARSE_HEX8_HL:
1449: 7E      	            LD   A, (HL)
144A: CD2F14  	            CALL IS_HEX
144D: D8      	            RET  C
144E: 0F      	            RRCA
144F: 0F      	            RRCA
1450: 0F      	            RRCA
1451: 0F      	            RRCA
1452: E6F0    	            AND  0F0H
1454: 47      	            LD   B, A
1455: 23      	            INC  HL
1456: 7E      	            LD   A, (HL)
1457: CD2F14  	            CALL IS_HEX
145A: 3803    	            JR   C, PHX8_ERR
145C: B0      	            OR   B
145D: 23      	            INC  HL
145E: C9      	            RET
145F:         	PHX8_ERR:
145F: 2B      	            DEC  HL
1460: 37      	            SCF
1461: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
1462:         	PARSE_HEX8_DE:
1462: 1A      	            LD   A, (DE)
1463: CD2F14  	            CALL IS_HEX
1466: D8      	            RET  C
1467: 0F      	            RRCA
1468: 0F      	            RRCA
1469: 0F      	            RRCA
146A: 0F      	            RRCA
146B: E6F0    	            AND  0F0H
146D: 47      	            LD   B, A
146E: 13      	            INC  DE
146F: 1A      	            LD   A, (DE)
1470: CD2F14  	            CALL IS_HEX
1473: 3803    	            JR   C, PHX8D_ERR
1475: B0      	            OR   B
1476: 13      	            INC  DE
1477: C9      	            RET
1478:         	PHX8D_ERR:
1478: 1B      	            DEC  DE
1479: 37      	            SCF
147A: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
147B:         	PARSE_HEX16_DE:
147B: CD6214  	            CALL PARSE_HEX8_DE
147E: D8      	            RET  C
147F: 67      	            LD   H, A
1480: CD6214  	            CALL PARSE_HEX8_DE
1483: D8      	            RET  C
1484: 6F      	            LD   L, A
1485: C9      	            RET
              	
              	; --- UPCASE_TOKEN: copia token de (HL) em maiúscula para HEXBUF; HL avança após token ---
1486:         	UPCASE_TOKEN:
1486: 11F7FB  	            LD   DE, HEXBUF
1489: 060A    	            LD   B, 10
148B:         	UPCASE_LOOP:
148B: 7E      	            LD   A, (HL)
148C: FE20    	            CP   SPACE
148E: 2817    	            JR   Z, UPCASE_DONE
1490: FE0D    	            CP   CR
1492: 2813    	            JR   Z, UPCASE_DONE
1494: FE00    	            CP   NUL
1496: 280F    	            JR   Z, UPCASE_DONE
1498: FE61    	            CP   'a'
149A: 3806    	            JR   C, UPCASE_STORE
149C: FE7B    	            CP   'z'+1
149E: 3002    	            JR   NC, UPCASE_STORE
14A0: E6DF    	            AND  0DFH               ; Converte para maiúscula
14A2:         	UPCASE_STORE:
14A2: 12      	            LD   (DE), A
14A3: 23      	            INC  HL
14A4: 13      	            INC  DE
14A5: 10E4    	            DJNZ UPCASE_LOOP
14A7:         	UPCASE_DONE:
14A7: 3E00    	            LD   A, NUL
14A9: 12      	            LD   (DE), A
14AA: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
14AB:         	STRCMP:
14AB: 7E      	            LD   A, (HL)
14AC: 47      	            LD   B, A
14AD: 1A      	            LD   A, (DE)
14AE: B8      	            CP   B
14AF: C0      	            RET  NZ
14B0: FE00    	            CP   NUL
14B2: C8      	            RET  Z
14B3: 23      	            INC  HL
14B4: 13      	            INC  DE
14B5: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
14B7:         	PRINT_HEX8:
14B7: F5      	            PUSH AF
14B8: 0F      	            RRCA
14B9: 0F      	            RRCA
14BA: 0F      	            RRCA
14BB: 0F      	            RRCA
14BC: CDC414  	            CALL PRINT_NIBBLE
14BF: F1      	            POP  AF
14C0: CDC414  	            CALL PRINT_NIBBLE
14C3: C9      	            RET
              	
14C4:         	PRINT_NIBBLE:
14C4: E60F    	            AND  0FH
14C6: C630    	            ADD  A, '0'
14C8: FE3A    	            CP   '9'+1
14CA: 3802    	            JR   C, PN_DONE
14CC: C607    	            ADD  A, 07H              ; 'A'-'9'-1
14CE:         	PN_DONE:
14CE: CD5804  	            CALL PUTCHAR
14D1: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
14D2:         	PRINT_HEX16:
14D2: 7C      	            LD   A, H
14D3: CDB714  	            CALL PRINT_HEX8
14D6: 7D      	            LD   A, L
14D7: CDB714  	            CALL PRINT_HEX8
14DA: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
14DB:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
14DB: CD6214  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
14DE: DA8F15  	    JP  C, I2C_BAD_SYNTAX
14E1: 323DFD  	    LD  (I2C_ADDR7), A
14E4: AF      	    XOR A
14E5: 323EFD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
14E8:         	I2C_LOOP:
14E8: CD2114  	    CALL SKIP_SPACES_DE
14EB: 1A      	    LD  A, (DE)
14EC: FE0D    	    CP  CR
14EE: CA7B15  	    JP  Z, I2C_DONE
14F1: FE00    	    CP  NUL
14F3: CA7B15  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
14F6: 1A      	    LD  A, (DE)
14F7: E6DF    	    AND 0DFH                ; forca maiuscula
14F9: 13      	    INC DE
14FA: FE57    	    CP  'W'
14FC: 2807    	    JR  Z, I2C_DO_WRITE
14FE: FE52    	    CP  'R'
1500: 2829    	    JR  Z, I2C_DO_READ
1502: C38F15  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
1505:         	I2C_DO_WRITE:
1505: CD6214  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
1508: DA8F15  	    JP  C, I2C_BAD_SYNTAX
150B: 4F      	    LD  C, A                ; guarda o byte
              	
150C: 3A3EFD  	    LD  A, (I2C_STATE)
150F: FE01    	    CP  1
1511: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
1513: 3A3DFD  	    LD  A, (I2C_ADDR7)
1516: 07      	    RLCA                     ; addr << 1
1517: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
1519: CD8419  	    CALL I2C_Open
151C: 204D    	    JR  NZ, I2C_NOACK
151E: 3E01    	    LD  A, 1
1520: 323EFD  	    LD  (I2C_STATE), A
              	
1523:         	I2C_WRITE_GO:
1523: 79      	    LD  A, C
1524: CD9819  	    CALL I2C_Write
1527: 2042    	    JR  NZ, I2C_NOACK
1529: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
152B:         	I2C_DO_READ:
152B: CD6214  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
152E: 385F    	    JR  C, I2C_BAD_SYNTAX
1530: 47      	    LD  B, A
1531: 78      	    LD  A, B
1532: B7      	    OR  A
1533: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
1535: 3A3EFD  	    LD  A, (I2C_STATE)
1538: FE02    	    CP  2
153A: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
153C: 3A3DFD  	    LD  A, (I2C_ADDR7)
153F: 07      	    RLCA
1540: F601    	    OR  01H                    ; bit0 = 1 (read)
1542: CD8419  	    CALL I2C_Open
1545: 2024    	    JR  NZ, I2C_NOACK
1547: 3E02    	    LD  A, 2
1549: 323EFD  	    LD  (I2C_STATE), A
              	
154C:         	I2C_READ_GO:
154C: 78      	    LD  A, B
154D: FE01    	    CP  1
154F: 2804    	    JR  Z, I2C_READ_LASTBYTE
1551: 3EFF    	    LD  A, 0FFH                 ; ACK - ainda tem mais bytes
1553: 1801    	    JR  I2C_READ_DOIT
1555:         	I2C_READ_LASTBYTE:
1555: AF      	    XOR A                        ; NACK - ultimo byte do bloco
1556:         	I2C_READ_DOIT:
1556: CDD519  	    CALL I2C_Read                ; A = byte lido
1559: C5      	    PUSH BC
155A: CDB714  	    CALL PRINT_HEX8
155D: 3E20    	    LD  A, SPACE
155F: CD5804  	    CALL PUTCHAR
1562: C1      	    POP BC
1563: 05      	    DEC B
1564: 78      	    LD  A, B
1565: B7      	    OR  A
1566: 20E4    	    JR  NZ, I2C_READ_GO
1568: C3E814  	    JP  I2C_LOOP
              	
              	; -------- Erro / fim --------
156B:         	I2C_NOACK:
156B: F5      	    PUSH AF
156C: CD8B19  	    CALL I2C_Close               ; garante que o barramento nao trava
156F: AF      	    XOR A
1570: 323EFD  	    LD  (I2C_STATE), A
1573: F1      	    POP AF
1574: 219615  	    LD  HL, MSG_I2C_NOACK
1577: CD6404  	    CALL PUTS
157A: C9      	    RET
              	
157B:         	I2C_DONE:
157B: 3A3EFD  	    LD  A, (I2C_STATE)
157E: B7      	    OR  A
