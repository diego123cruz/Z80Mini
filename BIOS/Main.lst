201F: 1600    	    LD D, 0
2021: 1C      	    INC E                   ; E = byte_index + 1
2022: 010100  	    LD BC, 1
2025: CDFA1B  	    CALL I2C_MemWr
2028: C0      	    RET NZ
              	
2029: 3A3BFC  	    LD A, (FS_BMPADDR)      ; A = pagina alocada
202C: B7      	    OR A                    ; NZ = sucesso
202D: C9      	    RET
              	
              	; FS_FREE_PG: Libera pagina A no bitmap (seta bit = 1)
              	;   On exit: Z=OK  NZ=erro I2C
202E:         	FS_FREE_PG:
202E: C5      	    PUSH BC
202F: D5      	    PUSH DE
2030: E5      	    PUSH HL
2031: F5      	    PUSH AF                 ; salva numero da pagina
              	
              	    ; bit_index = pagina mod 8
2032: E607    	    AND $07
2034: 4F      	    LD C, A                 ; C = bit_index
              	
              	    ; byte_index = pagina / 8 → endereco EEPROM = byte_index + 1
2035: F1      	    POP AF
2036: F5      	    PUSH AF
2037: CB3F    	    SRL A
2039: CB3F    	    SRL A
203B: CB3F    	    SRL A                   ; A = byte_index
