1AD4: 636F7264	
1AD8: 0D0A00  	
              	#include "I2C.asm"
              	; **********************************************************************
              	; I2C support functions
              	
              	; I2C bus open device
              	;   On entry: A = Device address (bit zero is read flag)
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1ADB: F5      	I2C_Open:   PUSH AF
1ADC: CD591B  	            CALL I2C_Start      ;Output start condition
1ADF: F1      	            POP  AF
1AE0: 180D    	            JR   I2C_Write      ;Write data byte
              	
              	
              	; I2C bus close device
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A=0 and Z flagged
              	;             If unsuccessfully A=Error and NZ flagged
              	;             SCL = hi, SDA = hi
              	;             BC DE HL IX IY preserved
1AE2: C3641B  	I2C_Close:  JP   I2C_Stop       ;Output stop condition
              	
              	
              	; I2C bus open read device
              	;   On entry: A = Device address
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1AE5:         	I2C_OpenRead:   
1AE5: CB37    	            SLL A
1AE7: C3DB1A  	            JP I2C_Open
              	
              	
              	; I2C bus open write device
              	;   On entry: A = Device address 
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1AEA:         	I2C_OpenWrite:   
1AEA: CB27    	            SLA     A
1AEC: C3DB1A  	            JP I2C_Open
              	
              	; **********************************************************************
              	; **********************************************************************
              	; I2C bus master driver
              	; **********************************************************************
              	; **********************************************************************
              	
              	; Functions provided are:
              	;     I2C_Start
              	;     I2C_Stop
              	;     I2C_Read
              	;     I2C_Write
              	;
              	; This code has delays between all I/O operations to ensure it works
              	; with the slowest I2C devices
              	;
              	; I2C transfer sequence
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;   | Start |  | Address |  | Data    | ... | Data    |  | Stop  |
              	;   |       |  | frame   |  | frame 1 |     | frame N |  |       |
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;
              	;
              	; Start condition                     Stop condition
              	; Output by master device             Output by master device
              	;       ----+                                      +----
              	; SDA       |                         SDA          |
              	;           +-------                        -------+
              	;       -------+                                +-------
              	; SCL          |                      SCL       |
              	;              +----                        ----+
              	;
              	;
              	; Address frame
              	; Clock and data output from master device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | A 7 | A 6 | A 5 | A 4 | A 3 | A 2 | A 1 | R/W | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	;
              	; Data frame 
              	; Clock output by master device
              	; Data output by transmitting device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | D 7 | D 6 | D 5 | D 4 | D 3 | D 2 | D 1 | D 0 | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	
              	
              	; **********************************************************************
              	; I2C constants
              	
              	
              	; I2C bus master interface
              	; The default device option is for SC126 or compatible
              	
0021:         	I2C_PORT:   .EQU $21           ;Host I2C port address
0007:         	I2C_SDA_WR: .EQU 7              ;Host I2C write SDA bit number
0007:         	I2C_SDA_RD: .EQU 7              ;Host I2C read SDA bit number
0000:         	I2C_SCL_WR: .EQU 0              ;Host I2C write SCL bit number
0000:         	I2C_SCL_RD: .EQU 0              ;Host I2C read SCL bit number 
0081:         	I2C_QUIES:  .EQU 0b10000001     ;Host I2C output port quiescent value
              	
              	
              	; I2C support constants
0000:         	ERR_NONE:   .EQU 0              ;Error = None
0001:         	ERR_JAM:    .EQU 1              ;Error = Bus jammed [not used]
0002:         	ERR_NOACK:  .EQU 2              ;Error = No ackonowledge
0003:         	ERR_TOUT:   .EQU 3              ;Error = Timeout
              	
              	
              	; **********************************************************************
              	; Hardware dependent I2C bus functions
              	
              	
              	; I2C bus transmit frame (address or data)
              	;   On entry: A = Data byte, or
              	;                 Address byte (bit zero is read flag)
              	;             SCL = low, SDA = low
              	;   On exit:  If successful A=0 and Z flagged
              	;                SCL = lo, SDA = lo
              	;             If unsuccessful A=Error and NZ flagged
              	;                SCL = high, SDA = high, I2C closed
              	;             BC DE HL IX IY preserved
1AEF: C5      	I2C_Write:  PUSH BC             ;Preserve registers
1AF0: D5      	            PUSH DE
1AF1: 57      	            LD   D,A            ;Store byte to be written
1AF2: 0608    	            LD   B,8            ;8 data bits, bit 7 first
1AF4: CB12    	I2C_WriteWr_Loop:   RL   D              ;Test M.S.Bit
1AF6: 3805    	            JR   C,I2C_WriteBit_Hi      ;High, so skip
1AF8: CD8B1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = data bit)
1AFB: 1803    	            JR   I2C_WriteBit_Clk
1AFD: CD841B  	I2C_WriteBit_Hi:    CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA = data bit)
1B00: CD761B  	I2C_WriteBit_Clk:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = data bit)
1B03: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = data bit)
1B06: 10EC    	            DJNZ I2C_WriteWr_Loop
              	; Test for acknowledge from slave (receiver)
              	; On arriving here, SCL = lo, SDA = data bit
1B08: CD841B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/ack)
1B0B: CD761B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/ack)
1B0E: CD9C1B  	            CALL I2C_RdPort     ;Read SDA input
1B11: 47      	            LD   B,A
1B12: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = hi)
1B15: CB78    	            BIT  I2C_SDA_RD,B
1B17: 2004    	            JR   NZ,I2C_WriteNoAck      ;Skip if no acknowledge
1B19: D1      	            POP  DE             ;Restore registers
1B1A: C1      	            POP  BC
1B1B: AF      	            XOR  A              ;Return success A=0 and Z flagged
1B1C: C9      	            RET
              	; I2C STOP required as no acknowledge
              	; On arriving here, SCL = lo, SDA = hi
1B1D: CD8B1B  	I2C_WriteNoAck:     CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = lo)
1B20: CD761B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = lo)
1B23: CD841B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA = hi)
1B26: D1      	            POP  DE             ;Restore registers
1B27: C1      	            POP  BC
1B28: 3E02    	            LD   A,ERR_NOACK    ;Return error = No Acknowledge
1B2A: B7      	            OR   A              ;  and NZ flagged
1B2B: C9      	            RET
              	
              	
              	; I2C bus receive frame (data)
              	;   On entry: A = Acknowledge flag
              	;               If A != 0 the read is acknowledged
              	;             SCL low, SDA low
              	;   On exit:  If successful A = data byte and Z flagged
              	;               SCL = low, SDA = low
              	;             If unsuccessul* A = Error and NZ flagged
              	;               SCL = low, SDA = low
              	;             BC DE HL IX IY preserved
              	; *This function always returns successful
1B2C: C5      	I2C_Read:   PUSH BC             ;Preserve registers
1B2D: D5      	            PUSH DE
1B2E: 5F      	            LD   E,A            ;Store acknowledge flag
1B2F: 0608    	            LD   B,8            ;8 data bits, 7 first
1B31: CD841B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/input)
1B34: CD761B  	I2C_ReadRd_Loop:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/input)
1B37: CD9C1B  	            CALL I2C_RdPort     ;Read SDA input bit
1B3A: 37      	            SCF                 ;Set carry flag
1B3B: CB7F    	            BIT  I2C_SDA_RD,A   ;SDA input high?
1B3D: 2001    	            JR   NZ, I2C_ReadRotate     ;Yes, skip with carry flag set
1B3F: 3F      	            CCF                 ;Clear carry flag
1B40: CB12    	I2C_ReadRotate:    RL   D              ;Rotate result into D
1B42: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA hi/input)
1B45: 10ED    	            DJNZ  I2C_ReadRd_Loop       ;Repeat for all 8 bits
              	; Acknowledge input byte
              	; On arriving here, SCL = lo, SDA = hi/input
1B47: 7B      	            LD   A,E            ;Get acknowledge flag
1B48: B7      	            OR   A              ;A = 0? (indicates no acknowledge)
1B49: 2803    	            JR   Z, I2C_ReadNoAck       ;Yes, so skip acknowledge
1B4B: CD8B1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA lo)
1B4E: CD761B  	I2C_ReadNoAck:     CALL I2C_SCL_HI     ;SCL hi    (SCL hi, SDA lo)
1B51: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1B54: 7A      	            LD   A,D            ;Get data byte received
1B55: D1      	            POP  DE             ;Restore registers
1B56: C1      	            POP  BC
1B57: BF      	            CP   A              ;Return success Z flagged
1B58: C9      	            RET
              	
              	
              	; I2C bus start
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = low, SDA = low
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are high
1B59: CD721B  	I2C_Start:  CALL I2C_INIT       ;Initialise I2C control port
              	;           CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA ??)
              	;           CALL I2C_SDA_HI     ;SDA high  (SCL hi, SDA hi)
              	; Generate I2C start condition
1B5C: CD8B1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1B5F: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1B62: AF      	            XOR  A              ;Return success A=0 and Z flagged
1B63: C9      	            RET
              	
              	
              	; I2C bus stop 
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = high, SDA = high
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are low
1B64: CD8B1B  	I2C_Stop:   CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1B67: CD7D1B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
              	; Generate stop condition
1B6A: CD761B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA lo)
1B6D: CD841B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA hi)
1B70: AF      	            XOR  A              ;Return success A=0 and Z flagged
1B71: C9      	            RET
              	
              	
              	; **********************************************************************
              	; I2C bus simple I/O functions
              	;   On entry: No parameters required
              	;   On exit:  BC DE HL IX IY preserved
              	
1B72: 3E81    	I2C_INIT:   LD   A,I2C_QUIES    ;I2C control port quiescent value
1B74: 181A    	            JR   I2C_WrPort
              	
1B76: 3A1CFC  	I2C_SCL_HI: LD   A,(I2C_RAMCPY)
1B79: CBC7    	            SET  I2C_SCL_WR,A
1B7B: 1813    	            JR   I2C_WrPort
              	
1B7D: 3A1CFC  	I2C_SCL_LO: LD   A,(I2C_RAMCPY)
1B80: CB87    	            RES  I2C_SCL_WR,A
1B82: 180C    	            JR   I2C_WrPort
              	
1B84: 3A1CFC  	I2C_SDA_HI: LD   A,(I2C_RAMCPY)
1B87: CBFF    	            SET  I2C_SDA_WR,A
1B89: 1805    	            JR   I2C_WrPort
              	
1B8B: 3A1CFC  	I2C_SDA_LO: LD   A,(I2C_RAMCPY)
1B8E: CBBF    	            RES  I2C_SDA_WR,A
              	
1B90: C5      	I2C_WrPort: PUSH BC             ;Preserve registers
1B91: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B93: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B95: ED79    	            OUT  (C),A          ;Write A to I2C I/O port
1B97: 321CFC  	            LD   (I2C_RAMCPY),A ;Write A to RAM copy
1B9A: C1      	            POP  BC             ;Restore registers
1B9B: C9      	            RET
              	
1B9C: C5      	I2C_RdPort: PUSH BC             ;Preserve registers
