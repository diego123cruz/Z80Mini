              	    ; Salva C na RAM antes.
2041: 79      	    LD A, C
2042: 323CFC  	    LD (FS_BMPADDR+1), A    ; salva bit_index em FS_BMPADDR+1
              	
2045: 3A3BFC  	    LD A, (FS_BMPADDR)
2048: 5F      	    LD E, A
2049: 1600    	    LD D, 0
204B: 2134FC  	    LD HL, FS_TMP1
