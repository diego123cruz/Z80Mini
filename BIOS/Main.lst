152B: C0      	            RET  NZ
152C: FE00    	            CP   NUL
152E: C8      	            RET  Z
152F: 23      	            INC  HL
1530: 13      	            INC  DE
1531: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
1533:         	PRINT_HEX8:
1533: F5      	            PUSH AF
1534: 0F      	            RRCA
1535: 0F      	            RRCA
1536: 0F      	            RRCA
1537: 0F      	            RRCA
1538: CD4015  	            CALL PRINT_NIBBLE
153B: F1      	            POP  AF
153C: CD4015  	            CALL PRINT_NIBBLE
153F: C9      	            RET
              	
1540:         	PRINT_NIBBLE:
1540: E60F    	            AND  0FH
1542: C630    	            ADD  A, '0'
1544: FE3A    	            CP   '9'+1
1546: 3802    	            JR   C, PN_DONE
1548: C607    	            ADD  A, 07H              ; 'A'-'9'-1
154A:         	PN_DONE:
154A: CD8104  	            CALL PUTCHAR
154D: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
154E:         	PRINT_HEX16:
154E: 7C      	            LD   A, H
154F: CD3315  	            CALL PRINT_HEX8
1552: 7D      	            LD   A, L
1553: CD3315  	            CALL PRINT_HEX8
1556: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
1557:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
1557: CDDE14  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
155A: DA0B16  	    JP  C, I2C_BAD_SYNTAX
155D: 3242FD  	    LD  (I2C_ADDR7), A
1560: AF      	    XOR A
1561: 3243FD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
1564:         	I2C_LOOP:
1564: CD9D14  	    CALL SKIP_SPACES_DE
1567: 1A      	    LD  A, (DE)
1568: FE0D    	    CP  CR
156A: CAF715  	    JP  Z, I2C_DONE
156D: FE00    	    CP  NUL
156F: CAF715  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
1572: 1A      	    LD  A, (DE)
1573: E6DF    	    AND 0DFH                ; forca maiuscula
1575: 13      	    INC DE
1576: FE57    	    CP  'W'
1578: 2807    	    JR  Z, I2C_DO_WRITE
157A: FE52    	    CP  'R'
157C: 2829    	    JR  Z, I2C_DO_READ
157E: C30B16  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
1581:         	I2C_DO_WRITE:
1581: CDDE14  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
1584: DA0B16  	    JP  C, I2C_BAD_SYNTAX
1587: 4F      	    LD  C, A                ; guarda o byte
              	
1588: 3A43FD  	    LD  A, (I2C_STATE)
158B: FE01    	    CP  1
158D: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
158F: 3A42FD  	    LD  A, (I2C_ADDR7)
1592: 07      	    RLCA                     ; addr << 1
1593: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
1595: CD5A1A  	    CALL I2C_Open
1598: 204D    	    JR  NZ, I2C_NOACK
159A: 3E01    	    LD  A, 1
159C: 3243FD  	    LD  (I2C_STATE), A
              	
159F:         	I2C_WRITE_GO:
159F: 79      	    LD  A, C
15A0: CD6E1A  	    CALL I2C_Write
15A3: 2042    	    JR  NZ, I2C_NOACK
15A5: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
15A7:         	I2C_DO_READ:
15A7: CDDE14  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
15AA: 385F    	    JR  C, I2C_BAD_SYNTAX
15AC: 47      	    LD  B, A
15AD: 78      	    LD  A, B
15AE: B7      	    OR  A
15AF: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
15B1: 3A43FD  	    LD  A, (I2C_STATE)
15B4: FE02    	    CP  2
15B6: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
15B8: 3A42FD  	    LD  A, (I2C_ADDR7)
15BB: 07      	    RLCA
15BC: F601    	    OR  01H                    ; bit0 = 1 (read)
15BE: CD5A1A  	    CALL I2C_Open
15C1: 2024    	    JR  NZ, I2C_NOACK
15C3: 3E02    	    LD  A, 2
15C5: 3243FD  	    LD  (I2C_STATE), A
              	
