              	#include "I2C.asm"
              	; **********************************************************************
              	; I2C support functions
              	
              	; I2C bus open device
              	;   On entry: A = Device address (bit zero is read flag)
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A83: F5      	I2C_Open:   PUSH AF
1A84: CD011B  	            CALL I2C_Start      ;Output start condition
1A87: F1      	            POP  AF
1A88: 180D    	            JR   I2C_Write      ;Write data byte
              	
              	
              	; I2C bus close device
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A=0 and Z flagged
              	;             If unsuccessfully A=Error and NZ flagged
              	;             SCL = hi, SDA = hi
              	;             BC DE HL IX IY preserved
1A8A: C30C1B  	I2C_Close:  JP   I2C_Stop       ;Output stop condition
              	
              	
              	; I2C bus open read device
              	;   On entry: A = Device address
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A8D:         	I2C_OpenRead:   
1A8D: CB37    	            SLL A
1A8F: C3831A  	            JP I2C_Open
              	
              	
              	; I2C bus open write device
              	;   On entry: A = Device address 
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A92:         	I2C_OpenWrite:   
1A92: CB27    	            SLA     A
1A94: C3831A  	            JP I2C_Open
              	
              	; **********************************************************************
              	; **********************************************************************
              	; I2C bus master driver
              	; **********************************************************************
              	; **********************************************************************
              	
              	; Functions provided are:
              	;     I2C_Start
              	;     I2C_Stop
              	;     I2C_Read
              	;     I2C_Write
              	;
              	; This code has delays between all I/O operations to ensure it works
              	; with the slowest I2C devices
              	;
              	; I2C transfer sequence
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;   | Start |  | Address |  | Data    | ... | Data    |  | Stop  |
              	;   |       |  | frame   |  | frame 1 |     | frame N |  |       |
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;
              	;
              	; Start condition                     Stop condition
              	; Output by master device             Output by master device
              	;       ----+                                      +----
              	; SDA       |                         SDA          |
              	;           +-------                        -------+
              	;       -------+                                +-------
              	; SCL          |                      SCL       |
              	;              +----                        ----+
              	;
              	;
              	; Address frame
              	; Clock and data output from master device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | A 7 | A 6 | A 5 | A 4 | A 3 | A 2 | A 1 | R/W | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	;
              	; Data frame 
              	; Clock output by master device
              	; Data output by transmitting device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | D 7 | D 6 | D 5 | D 4 | D 3 | D 2 | D 1 | D 0 | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	
              	
              	; **********************************************************************
              	; I2C constants
              	
              	
              	; I2C bus master interface
              	; The default device option is for SC126 or compatible
              	
0021:         	I2C_PORT:   .EQU $21           ;Host I2C port address
0007:         	I2C_SDA_WR: .EQU 7              ;Host I2C write SDA bit number
0007:         	I2C_SDA_RD: .EQU 7              ;Host I2C read SDA bit number
0000:         	I2C_SCL_WR: .EQU 0              ;Host I2C write SCL bit number
0000:         	I2C_SCL_RD: .EQU 0              ;Host I2C read SCL bit number 
0081:         	I2C_QUIES:  .EQU 0b10000001     ;Host I2C output port quiescent value
              	
              	
              	; I2C support constants
0000:         	ERR_NONE:   .EQU 0              ;Error = None
0001:         	ERR_JAM:    .EQU 1              ;Error = Bus jammed [not used]
0002:         	ERR_NOACK:  .EQU 2              ;Error = No ackonowledge
0003:         	ERR_TOUT:   .EQU 3              ;Error = Timeout
              	
              	
              	; **********************************************************************
              	; Hardware dependent I2C bus functions
              	
              	
              	; I2C bus transmit frame (address or data)
              	;   On entry: A = Data byte, or
              	;                 Address byte (bit zero is read flag)
              	;             SCL = low, SDA = low
              	;   On exit:  If successful A=0 and Z flagged
              	;                SCL = lo, SDA = lo
              	;             If unsuccessful A=Error and NZ flagged
              	;                SCL = high, SDA = high, I2C closed
              	;             BC DE HL IX IY preserved
1A97: C5      	I2C_Write:  PUSH BC             ;Preserve registers
1A98: D5      	            PUSH DE
1A99: 57      	            LD   D,A            ;Store byte to be written
1A9A: 0608    	            LD   B,8            ;8 data bits, bit 7 first
1A9C: CB12    	I2C_WriteWr_Loop:   RL   D              ;Test M.S.Bit
1A9E: 3805    	            JR   C,I2C_WriteBit_Hi      ;High, so skip
1AA0: CD331B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = data bit)
1AA3: 1803    	            JR   I2C_WriteBit_Clk
1AA5: CD2C1B  	I2C_WriteBit_Hi:    CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA = data bit)
1AA8: CD1E1B  	I2C_WriteBit_Clk:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = data bit)
1AAB: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = data bit)
1AAE: 10EC    	            DJNZ I2C_WriteWr_Loop
              	; Test for acknowledge from slave (receiver)
              	; On arriving here, SCL = lo, SDA = data bit
1AB0: CD2C1B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/ack)
1AB3: CD1E1B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/ack)
1AB6: CD441B  	            CALL I2C_RdPort     ;Read SDA input
1AB9: 47      	            LD   B,A
1ABA: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = hi)
1ABD: CB78    	            BIT  I2C_SDA_RD,B
1ABF: 2004    	            JR   NZ,I2C_WriteNoAck      ;Skip if no acknowledge
1AC1: D1      	            POP  DE             ;Restore registers
1AC2: C1      	            POP  BC
1AC3: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AC4: C9      	            RET
              	; I2C STOP required as no acknowledge
              	; On arriving here, SCL = lo, SDA = hi
1AC5: CD331B  	I2C_WriteNoAck:     CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = lo)
1AC8: CD1E1B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = lo)
1ACB: CD2C1B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA = hi)
1ACE: D1      	            POP  DE             ;Restore registers
1ACF: C1      	            POP  BC
1AD0: 3E02    	            LD   A,ERR_NOACK    ;Return error = No Acknowledge
1AD2: B7      	            OR   A              ;  and NZ flagged
1AD3: C9      	            RET
              	
              	
              	; I2C bus receive frame (data)
              	;   On entry: A = Acknowledge flag
              	;               If A != 0 the read is acknowledged
              	;             SCL low, SDA low
              	;   On exit:  If successful A = data byte and Z flagged
              	;               SCL = low, SDA = low
              	;             If unsuccessul* A = Error and NZ flagged
              	;               SCL = low, SDA = low
              	;             BC DE HL IX IY preserved
              	; *This function always returns successful
1AD4: C5      	I2C_Read:   PUSH BC             ;Preserve registers
1AD5: D5      	            PUSH DE
1AD6: 5F      	            LD   E,A            ;Store acknowledge flag
1AD7: 0608    	            LD   B,8            ;8 data bits, 7 first
1AD9: CD2C1B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/input)
1ADC: CD1E1B  	I2C_ReadRd_Loop:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/input)
1ADF: CD441B  	            CALL I2C_RdPort     ;Read SDA input bit
1AE2: 37      	            SCF                 ;Set carry flag
1AE3: CB7F    	            BIT  I2C_SDA_RD,A   ;SDA input high?
1AE5: 2001    	            JR   NZ, I2C_ReadRotate     ;Yes, skip with carry flag set
1AE7: 3F      	            CCF                 ;Clear carry flag
1AE8: CB12    	I2C_ReadRotate:    RL   D              ;Rotate result into D
1AEA: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA hi/input)
1AED: 10ED    	            DJNZ  I2C_ReadRd_Loop       ;Repeat for all 8 bits
              	; Acknowledge input byte
              	; On arriving here, SCL = lo, SDA = hi/input
1AEF: 7B      	            LD   A,E            ;Get acknowledge flag
1AF0: B7      	            OR   A              ;A = 0? (indicates no acknowledge)
1AF1: 2803    	            JR   Z, I2C_ReadNoAck       ;Yes, so skip acknowledge
1AF3: CD331B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA lo)
1AF6: CD1E1B  	I2C_ReadNoAck:     CALL I2C_SCL_HI     ;SCL hi    (SCL hi, SDA lo)
1AF9: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1AFC: 7A      	            LD   A,D            ;Get data byte received
1AFD: D1      	            POP  DE             ;Restore registers
1AFE: C1      	            POP  BC
1AFF: BF      	            CP   A              ;Return success Z flagged
1B00: C9      	            RET
              	
              	
              	; I2C bus start
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = low, SDA = low
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are high
1B01: CD1A1B  	I2C_Start:  CALL I2C_INIT       ;Initialise I2C control port
              	;           CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA ??)
              	;           CALL I2C_SDA_HI     ;SDA high  (SCL hi, SDA hi)
              	; Generate I2C start condition
1B04: CD331B  	            CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1B07: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1B0A: AF      	            XOR  A              ;Return success A=0 and Z flagged
1B0B: C9      	            RET
              	
              	
              	; I2C bus stop 
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = high, SDA = high
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are low
1B0C: CD331B  	I2C_Stop:   CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1B0F: CD251B  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
              	; Generate stop condition
1B12: CD1E1B  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA lo)
1B15: CD2C1B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA hi)
1B18: AF      	            XOR  A              ;Return success A=0 and Z flagged
1B19: C9      	            RET
              	
              	
              	; **********************************************************************
              	; I2C bus simple I/O functions
              	;   On entry: No parameters required
              	;   On exit:  BC DE HL IX IY preserved
              	
1B1A: 3E81    	I2C_INIT:   LD   A,I2C_QUIES    ;I2C control port quiescent value
1B1C: 181A    	            JR   I2C_WrPort
              	
1B1E: 3A03FC  	I2C_SCL_HI: LD   A,(I2C_RAMCPY)
1B21: CBC7    	            SET  I2C_SCL_WR,A
1B23: 1813    	            JR   I2C_WrPort
              	
1B25: 3A03FC  	I2C_SCL_LO: LD   A,(I2C_RAMCPY)
1B28: CB87    	            RES  I2C_SCL_WR,A
1B2A: 180C    	            JR   I2C_WrPort
              	
1B2C: 3A03FC  	I2C_SDA_HI: LD   A,(I2C_RAMCPY)
1B2F: CBFF    	            SET  I2C_SDA_WR,A
1B31: 1805    	            JR   I2C_WrPort
              	
1B33: 3A03FC  	I2C_SDA_LO: LD   A,(I2C_RAMCPY)
1B36: CBBF    	            RES  I2C_SDA_WR,A
              	
1B38: C5      	I2C_WrPort: PUSH BC             ;Preserve registers
1B39: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B3B: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B3D: ED79    	            OUT  (C),A          ;Write A to I2C I/O port
1B3F: 3203FC  	            LD   (I2C_RAMCPY),A ;Write A to RAM copy
1B42: C1      	            POP  BC             ;Restore registers
1B43: C9      	            RET
              	
1B44: C5      	I2C_RdPort: PUSH BC             ;Preserve registers
1B45: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B47: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B49: ED78    	            IN   A,(C)          ;Read A from I/O port
1B4B: C1      	            POP  BC             ;Restore registers
1B4C: C9      	            RET
              	
              	
1B4D: 202E3A20	I2C_LIST_MSG:    .DB " .: I2C devices :.",CR,0
1B51: 49324320	
1B55: 64657669	
1B59: 63657320	
1B5D: 3A2E0D00	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	;==============================================================================
              	;==============================================================================
              	;==============================================================================
              	;===================       FUNCTIONS    =======================================
              	;==============================================================================
              	;==============================================================================
              	
              	
              	
              	
              	; **********************************************************************
              	; List devices found on the I2C bus
              	;
              	; Test each I2C device address and reports any that acknowledge
              	
1B61: 214D1B  	I2CLIST:    LD   HL, I2C_LIST_MSG        ;Address of message string
              	            ;XOR A ; A = character to stop printing.
1B64: CDAB04  	            CALL PUTS         ;Output string
1B67: 1600    	            LD   D,0            ;First I2C device address to test
1B69: D5      	LISTLOOP:      PUSH DE             ;Preserve DE
1B6A: 7A      	            LD   A,D            ;Get device address to be tested
1B6B: CDC11B  	            CALL LISTTEST          ;Test if device is present
1B6E: D1      	            POP  DE             ;Restore DE
1B6F: 2044    	            JR   NZ,LISTNEXT       ;Skip if no acknowledge
1B71: 7A      	            LD   A,D            ;Get address of device tested
1B72: CB3F    	            SRL  A     ; remove bit R/W
1B74: F5      	            PUSH AF
1B75: CD661D  	            CALL HexOut         ;Output as two character hex 
              	            ;LD A, ' '; space
              	            ;CALL PUTCHAR       ;Output space character
1B78: F1      	            POP AF
1B79: FE07    	            CP  $07
1B7B: CCCA1B  	            CALL Z, i2cPrintL07
1B7E: FE08    	            CP  $08
1B80: CCD21B  	            CALL Z, i2cPrintL08
1B83: FE32    	            CP  $32
1B85: CCDA1B  	            CALL Z, i2cPrintL32
1B88: FE50    	            CP  $50
1B8A: CCE21B  	            CALL Z, i2cPrintL50
1B8D: FE51    	            CP  $51
1B8F: CCEA1B  	            CALL Z, i2cPrintL51
1B92: FE52    	            CP  $52
1B94: CCF21B  	            CALL Z, i2cPrintL52
1B97: FE53    	            CP  $53
1B99: CCFA1B  	            CALL Z, i2cPrintL53
1B9C: FE54    	            CP  $54
1B9E: CC021C  	            CALL Z, i2cPrintL54
1BA1: FE55    	            CP  $55
1BA3: CC0A1C  	            CALL Z, i2cPrintL55
1BA6: FE56    	            CP  $56
1BA8: CC121C  	            CALL Z, i2cPrintL56
1BAB: FE57    	            CP  $57
1BAD: CC1A1C  	            CALL Z, i2cPrintL57
1BB0: 3E0D    	            LD A, CR; enter
1BB2: CD9F04  	            CALL PUTCHAR       ;Output space character
1BB5: 14      	LISTNEXT:      INC  D              ;Get next write address
1BB6: 14      	            INC  D
1BB7: 7A      	            LD   A,D            ;Address of next device to test
1BB8: B7      	            OR   A              ;Have we tested all addresses?
1BB9: 20AE    	            JR   NZ,LISTLOOP       ;No, so loop again
1BBB: 3E0D    	            LD A, CR; enter
1BBD: CD9F04  	            CALL PUTCHAR       ;Output space character
1BC0: C9      	            RET
              	
              	; Test if device at I2C address A acknowledges
              	;   On entry: A = I2C device address (8-bit, bit 0 = lo for write)
              	;   On exit:  Z flagged if device acknowledges
              	;             NZ flagged if devices does not acknowledge
1BC1: CD831A  	LISTTEST:      CALL I2C_Open       ;Open I2C device for write
1BC4: C0      	            RET  NZ             ;Abort if failed to open
1BC5: CD8A1A  	            CALL I2C_Close      ;Close I2C device 
1BC8: AF      	            XOR  A              ;Return with Z flagged
1BC9: C9      	            RET
              	
