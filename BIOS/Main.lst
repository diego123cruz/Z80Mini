2321: CD1523  	    CALL SERIAL_GET_HEX_A	        ; Endereco High -> H
2324: 67      		LD   H,A
2325: CD1523  		CALL SERIAL_GET_HEX_A	        ; Endereco Low -> L
2328: 6F      		LD   L,A
2329: C9      	    RET
              	
              	
              	
