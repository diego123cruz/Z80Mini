              	; Fill a block I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             L = BYTE to Fill
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; pages.
1CC1: C5      	I2C_MemFill:  PUSH BC
1CC2: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CC5:         	I2C_MemFillRepeat:    
1CC5: 3A02FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CC8: CD831A  	            CALL I2C_Open       ;Open for write
1CCB: 280A    	            JR   Z,I2C_MemFillReady       ;If open okay then skip on
1CCD: 0B      	            DEC  BC
1CCE: 78      	            LD   A,B
1CCF: B1      	            OR   C              ;Timeout?
1CD0: 20F3    	            JR   NZ,I2C_MemFillRepeat     ;No, so go try again
1CD2: C1      	            POP  BC
1CD3: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CD5: B7      	            OR   A              ;Error, so NZ flagged
1CD6: C9      	            RET                 ;Return with error
              	; Device opened okay
1CD7: C1      	I2C_MemFillReady:     POP  BC             ;Restore byte counter
1CD8: 7A      	I2C_MemFillBlock:     LD   A,D            ;Address (hi) in I2C memory
1CD9: CD971A  	            CALL I2C_Write      ;Write address
1CDC: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CDD: CD971A  	            CALL I2C_Write      ;Write address
1CE0: 7D      	I2C_MemFillWrite:     LD   A, L         ;Get data byte to fill
1CE1: CD971A  	            CALL I2C_Write      ;Read byte from I2C memory
1CE4: 13      	            INC  DE             ;Increment I2C memory pointer
1CE5: 0B      	            DEC  BC             ;Decrement byte counter
1CE6: 78      	            LD   A,B
1CE7: B1      	            OR   C              ;Finished?
1CE8: 2805    	            JR   Z,I2C_MemFillStore       ;Yes, so go store this page
1CEA: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1CEB: E63F    	            AND  63             ;64 byte page boundary?
1CED: 20F1    	            JR   NZ,I2C_MemFillWrite      ;No, so go write another byte
1CEF: CD0C1B  	I2C_MemFillStore:     CALL I2C_Stop       ;Generate I2C stop
1CF2: 78      	            LD   A,B
1CF3: B1      	            OR   C              ;Finished?
1CF4: 20CB    	            JR   NZ,I2C_MemFill   ;No, so go write some more
1CF6: C9      	            RET  
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1CF7: C5      	I2C_MemRd:  PUSH BC
1CF8: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CFB:         	I2C_MemRdRepeat:    
1CFB: 3A02FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CFE: CD831A  	            CALL I2C_Open       ;Open for write
1D01: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
1D03: 0B      	            DEC  BC
1D04: 78      	            LD   A,B
1D05: B1      	            OR   C              ;Timeout?
1D06: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1D08: C1      	            POP  BC
1D09: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D0B: B7      	            OR   A              ;Error, so NZ flagged
1D0C: C9      	            RET                 ;Return with error
              	; Device opened okay
1D0D: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1D0E: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1D0F: CD971A  	            CALL I2C_Write      ;Write address
1D12: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D13: CD971A  	            CALL I2C_Write      ;Write address
1D16: 3A02FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1D19: 3C      	            INC  A              ; Device read equal DeviceId+1
1D1A: CD831A  	            CALL I2C_Open       ;Open for read
1D1D: C0      	            RET  NZ             ;Abort if error
1D1E: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1D1F: 78      	            LD   A,B
1D20: B1      	            OR   C              ;Last byte to be read?
1D21: CDD41A  	            CALL I2C_Read       ;Read byte with no ack on last byte
1D24: 77      	            LD   (HL),A         ;Write byte in CPU memory
1D25: 23      	            INC  HL             ;Increment CPU memory pointer
1D26: 78      	            LD   A,B
1D27: B1      	            OR   C              ;Finished?
1D28: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1D2A: CD0C1B  	            CALL I2C_Stop       ;Generate I2C stop
1D2D: AF      	            XOR  A              ;Return with success (Z flagged)
1D2E: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1D2F: C5      	I2C_MemWr:  PUSH BC
1D30: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D33:         	I2C_MemWrRepeat:    
1D33: 3A02FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D36: CD831A  	            CALL I2C_Open       ;Open for write
1D39: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1D3B: 0B      	            DEC  BC
1D3C: 78      	            LD   A,B
1D3D: B1      	            OR   C              ;Timeout?
1D3E: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1D40: C1      	            POP  BC
1D41: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D43: B7      	            OR   A              ;Error, so NZ flagged
1D44: C9      	            RET                 ;Return with error
              	; Device opened okay
1D45: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1D46: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1D47: CD971A  	            CALL I2C_Write      ;Write address
1D4A: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D4B: CD971A  	            CALL I2C_Write      ;Write address
1D4E: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1D4F: CD971A  	            CALL I2C_Write      ;Read byte from I2C memory
1D52: 23      	            INC  HL             ;Increment CPU memory pointer
1D53: 13      	            INC  DE             ;Increment I2C memory pointer
1D54: 0B      	            DEC  BC             ;Decrement byte counter
1D55: 78      	            LD   A,B
1D56: B1      	            OR   C              ;Finished?
1D57: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1D59: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1D5A: E63F    	            AND  63             ;64 byte page boundary?
1D5C: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1D5E: CD0C1B  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1D61: 78      	            LD   A,B
1D62: B1      	            OR   C              ;Finished?
1D63: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1D65: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1D66: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1D67: 1F      	            RRA                 ;Shift top nibble to
1D68: 1F      	            RRA                 ;  botom four bits..
1D69: 1F      	            RRA
1D6A: 1F      	            RRA
1D6B: E60F    	            AND  $0F           ;Mask off unwanted bits
1D6D: CD731D  	            CALL HexOutHex           ;Output hi nibble
1D70: F1      	            POP  AF             ;Restore byte to be output
1D71: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1D73: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1D75: 3802    	            JR   C,HexOutSkip        ;No, so skip
1D77: C607    	            ADD  A,7            ;Yes, so add 7
1D79: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1D7B: CD9F04  	            CALL CONOUT       ;Write character
1D7E: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5        ; Assinatura da EEPROM formatada
0000:         	FS_PG_BMP:  .EQU $00        ; Número da página do bitmap
0001:         	FS_PG_DIR:  .EQU $01        ; Número da página do diretório
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8          ; Máximo de arquivos
0020:         	FS_ENTRY_SZ:.EQU 32         ; Bytes por entrada do diretório
0010:         	FS_NAME_SZ: .EQU 16         ; Bytes do nome
00FF:         	FS_DATAPG:  .EQU 255        ; Bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF      ; Slot do diretório livre
0001:         	FS_FLAG_USED: .EQU $01      ; Slot do diretório usado - File
0002:         	FS_FLAG_USED_FOLDER: .EQU $02      ; Slot do diretório usado - Folder
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0          ; Nome (16 bytes)
0010:         	FS_O_FSTPG: .EQU 16         ; Primeira página de dados
0011:         	FS_O_SIZEH: .EQU 17         ; Tamanho hi
0012:         	FS_O_SIZEL: .EQU 18         ; Tamanho lo
0013:         	FS_O_RADRH: .EQU 19         ; Load RAM hi
0014:         	FS_O_RADRL: .EQU 20         ; Load RAM lo
0015:         	FS_O_FLAGS: .EQU 21         ; Flags ($FF=livre, $01=usado por arquivo, $02=usado por pasta)
              	
              	
              	
              	
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; FS_INFO - Espaco usado/livre da EEPROM
              	;   Le bitmap, conta paginas, imprime barra e valores
              	; **********************************************************************
1D7F:         	FS_INFO:
1D7F: CDBB04  	    CALL CRLF
1D82: 21E326  	    LD HL, str_info_hdr
1D85: CDAB04  	    CALL PUTS
              	
              	    ; Le 16 bytes do bitmap (bytes 1..16 da pagina 0)
1D88: 110100  	    LD DE, $0001
1D8B: 2140FC  	    LD HL, PG_BUF
1D8E: 011000  	    LD BC, 16
1D91: CDF71C  	    CALL I2C_MemRd
1D94: C25E25  	    JP NZ, FS_ERR_I2C
              	
              	    ; Conta paginas livres (bits=1) → C
1D97: 2140FC  	    LD HL, PG_BUF
1D9A: 0610    	    LD B, 16
1D9C: 0E00    	    LD C, 0
1D9E:         	FS_INF_CNT:
1D9E: 7E      	    LD A, (HL)
1D9F: 23      	    INC HL
1DA0: 1608    	    LD D, 8
1DA2:         	FS_INF_BIT:
1DA2: 0F      	    RRCA
1DA3: 3001    	    JR NC, FS_INF_NB
1DA5: 0C      	    INC C
1DA6:         	FS_INF_NB:
1DA6: 15      	    DEC D
1DA7: 20F9    	    JR NZ, FS_INF_BIT
1DA9: 10F3    	    DJNZ FS_INF_CNT
              	
              	    ; C = pags livres (0..126)
              	    ; paginas usadas = 126 - C → salva em E
1DAB: 3E7E    	    LD A, 126
1DAD: 91      	    SUB C
1DAE: 5F      	    LD E, A                 ; E = paginas usadas
              	
              	    ; === Linha 1: barra visual ===
              	    ; Formato: "[##########..........] UUh/7Eh pags"
              	    ; Barra de 19 chars: cada char = ~6.6 pags
              	    ; chars_usados = E * 19 / 126
              	    ;   = E / 6  (aproximacao boa o suficiente para barra)
1DAF: 7B      	    LD A, E
1DB0: 0600    	    LD B, 0                 ; B = chars usados
1DB2:         	FS_INF_DIV6:
1DB2: FE06    	    CP 6
1DB4: 3805    	    JR C, FS_INF_DIV6_DONE
1DB6: D606    	    SUB 6
1DB8: 04      	    INC B
1DB9: 18F7    	    JR FS_INF_DIV6
1DBB:         	FS_INF_DIV6_DONE:
              	    ; B = chars usados (0..21, clamp a 20)
1DBB: 78      	    LD A, B
1DBC: FE15    	    CP 21
1DBE: 3802    	    JR C, FS_INF_CLAMP
1DC0: 0613    	    LD B, 19
1DC2:         	FS_INF_CLAMP:
              	
1DC2: 3E5B    	    LD A, '['
1DC4: CF      	    RST $08
              	
              	    ; Imprime B x '#' (usado)
1DC5: 78      	    LD A, B
1DC6: B7      	    OR A
1DC7: 2808    	    JR Z, FS_INF_NO_HASH
1DC9: C5      	    PUSH BC
1DCA: 47      	    LD B, A
1DCB:         	FS_INF_HASH:
1DCB: 3E23    	    LD A, '#'
1DCD: CF      	    RST $08
1DCE: 10FB    	    DJNZ FS_INF_HASH
1DD0: C1      	    POP BC
              	
1DD1:         	FS_INF_NO_HASH:
              	    ; Imprime (20-B) x '.' (livre)
1DD1: 3E13    	    LD A, 19
1DD3: 90      	    SUB B
1DD4: 2806    	    JR Z, FS_INF_NO_DOT
1DD6: 47      	    LD B, A
1DD7:         	FS_INF_DOT:
1DD7: 3E2E    	    LD A, '.'
1DD9: CF      	    RST $08
1DDA: 10FB    	    DJNZ FS_INF_DOT
1DDC:         	FS_INF_NO_DOT:
              	
1DDC: 3E5D    	    LD A, ']'
1DDE: CF      	    RST $08
1DDF: 3E20    	    LD A, ' '
1DE1: CF      	    RST $08
              	
              	    ; Imprime "UUh/7Eh pags"
1DE2: 7B      	    LD A, E                 ; A = usadas
1DE3: CD661D  	    CALL HexOut
1DE6: 3E68    	    LD A, 'h'
1DE8: CF      	    RST $08
1DE9: 3E2F    	    LD A, '/'
1DEB: CF      	    RST $08
1DEC: 3E7E    	    LD A, $7E               ; 126
1DEE: CD661D  	    CALL HexOut
1DF1: 3E68    	    LD A, 'h'
1DF3: CF      	    RST $08
1DF4: 21FA26  	    LD HL, str_inf_pags
1DF7: CDAB04  	    CALL PUTS
              	
              	    ; === Linha 2: Usadas ===
1DFA: 210227  	    LD HL, str_inf_used
1DFD: CDAB04  	    CALL PUTS
1E00: 7B      	    LD A, E
1E01: CD661D  	    CALL HexOut
1E04: 3E68    	    LD A, 'h'
1E06: CF      	    RST $08
1E07: 211227  	    LD HL, str_inf_pags_nl
1E0A: CDAB04  	    CALL PUTS
1E0D: CDBB04  	    CALL CRLF
1E10: 3E20    	    LD A, ' '
1E12: CF      	    RST $08
              	
              	    ; Bytes usados aprox: E * 255  (E = paginas usadas)
              	    ; Salva C (paginas livres) em RAM antes do loop destruir C
1E13: 79      	    LD A, C
1E14: 323FFC  	    LD (FS_INFOTMP), A      ; salva pags livres
              	
1E17: 210000  	    LD HL, 0
1E1A: 7B      	    LD A, E
1E1B: B7      	    OR A
1E1C: 2807    	    JR Z, FS_INF_BYTES_DONE_U
1E1E:         	FS_INF_BYTES_USED:
1E1E: 01FF00  	    LD BC, FS_DATAPG        ; C destruido aqui - mas ja salvamos
1E21: 09      	    ADD HL, BC
1E22: 1D      	    DEC E
1E23: 20F9    	    JR NZ, FS_INF_BYTES_USED
1E25:         	FS_INF_BYTES_DONE_U:
1E25: 7C      	    LD A, H
1E26: CD661D  	    CALL HexOut
1E29: 7D      	    LD A, L
1E2A: CD661D  	    CALL HexOut
1E2D: 3E68    	    LD A, 'h'
1E2F: CF      	    RST $08
1E30: 211927  	    LD HL, str_inf_bytes_nl
1E33: CDAB04  	    CALL PUTS
              	
              	    ; Recupera paginas livres
1E36: 3A3FFC  	    LD A, (FS_INFOTMP)
1E39: 4F      	    LD C, A                 ; C = paginas livres restaurado
              	
              	    ; === Linha 3: Livres ===
1E3A: 210A27  	    LD HL, str_inf_free
1E3D: CDAB04  	    CALL PUTS
1E40: 79      	    LD A, C
1E41: CD661D  	    CALL HexOut
1E44: 3E68    	    LD A, 'h'
1E46: CF      	    RST $08
1E47: 211227  	    LD HL, str_inf_pags_nl
1E4A: CDAB04  	    CALL PUTS
1E4D: CDBB04  	    CALL CRLF
1E50: 3E20    	    LD A, ' '
1E52: CF      	    RST $08
              	
              	    ; Bytes livres aprox: C * 255
1E53: 210000  	    LD HL, 0
1E56: 79      	    LD A, C
1E57: B7      	    OR A
1E58: 2808    	    JR Z, FS_INF_BYTES_DONE_F
1E5A: 59      	    LD E, C
1E5B:         	FS_INF_BYTES_FREE:
1E5B: 01FF00  	    LD BC, FS_DATAPG
1E5E: 09      	    ADD HL, BC
1E5F: 1D      	    DEC E
1E60: 20F9    	    JR NZ, FS_INF_BYTES_FREE
1E62:         	FS_INF_BYTES_DONE_F:
1E62: 7C      	    LD A, H
1E63: CD661D  	    CALL HexOut
1E66: 7D      	    LD A, L
1E67: CD661D  	    CALL HexOut
1E6A: 3E68    	    LD A, 'h'
1E6C: CF      	    RST $08
1E6D: 211927  	    LD HL, str_inf_bytes_nl
1E70: CDAB04  	    CALL PUTS
1E73: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; FS_DIR
              	; **********************************************************************
1E74:         	FS_DIR:
