              	; **********************************************************************
              	; FS_CD  cd name (entra na pasta)
              	;        cd ~ (volta para home)
              	; **********************************************************************
1F5A:         	FS_CD:
1F5A: CD1023  	    CALL FS_COPY_NAME_FROM_BUFFER
1F5D: DAD325  	    JP C, FS_ABORT
1F60: 3A41FC  	    LD A, (FS_NAMBUF)
1F63: FE7E    	    CP '~' ; home
1F65: 2825    	    JR Z, FS_DO_CD_HOME
              	
1F67: CD1305  	    CALL CRLF
1F6A: CD7825  	    CALL FS_FIND_FOLDER_NAME
1F6D: CA771F  	    JP Z, FS_DO_CD
1F70: 213C26  	    LD HL, str_notfound
1F73: CD0305  	    CALL PUTS
1F76: C9      	    RET
              	
1F77:         	FS_DO_CD:
1F77: 3A31FC  	    LD A, (FS_WRKBUF + FS_O_FSTPG)
1F7A: 325BFD  	    LD (FS_DIR_CUR), A
              	
1F7D: 0611    	    LD B, FS_NAME_SZ + 1
1F7F: 215CFD  	    LD HL, FS_DIR_NAME
1F82: 1121FC  	    LD DE, FS_WRKBUF + FS_O_NAME
1F85: CDD902  	    CALL M_C_DIR
1F88: CD1305  	    CALL CRLF
1F8B: C9      	    RET
              	
1F8C:         	FS_DO_CD_HOME:
