              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
1268:         	LOAD_HEX_CMD;
1268: CD7D18  	    CALL loadInit
126B: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
126C:         	CALL_8000:
126C: 11C702  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
126F: D5      	    PUSH DE
1270: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
1273:         	CLS_CMD:
1273: 3E0C    	            LD A, 0CH ; FF
1275: CD1208  	            CALL sendCharToLCD
1278: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
1279:         	DUMP_CMD:
              	            ; DE aponta para argumentos
1279: CD1C15  	            CALL PARSE_HEX16_DE      ; HL = endereço
127C: 3836    	            JR   C, DUMP_BAD_ADDR
127E: 22FBFB  	            LD   (ADDR_TMP), HL
              	
1281: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
1283:         	DUMP_LINE:
1283: C5      	            PUSH BC
              	            ; Exibe endereço
1284: 2AFBFB  	            LD   HL, (ADDR_TMP)
1287: CD7315  	            CALL PRINT_HEX16
128A: 3E3A    	            LD   A, ':'
128C: CD9F04  	            CALL PUTCHAR
128F: 3E20    	            LD   A, SPACE
1291: CD9F04  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
1294: 2AFBFB  	            LD   HL, (ADDR_TMP)
1297: 0E05    	            LD   C, 5
1299:         	DUMP_HEX:
1299: 7E      	            LD   A, (HL)
129A: CD5815  	            CALL PRINT_HEX8
129D: 3E20    	            LD   A, SPACE
129F: CD9F04  	            CALL PUTCHAR
12A2: 23      	            INC  HL
12A3: 0D      	            DEC  C
12A4: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
12A6: 2AFBFB  	            LD   HL, (ADDR_TMP)
12A9: 110500  	            LD   DE, 5
12AC: 19      	            ADD  HL, DE
12AD: 22FBFB  	            LD   (ADDR_TMP), HL
12B0: C1      	            POP  BC
12B1: 10D0    	            DJNZ DUMP_LINE
12B3: C9      	            RET
              	
12B4:         	DUMP_BAD_ADDR:
12B4: 217616  	            LD   HL, MSG_BAD_ADDR
12B7: CDAB04  	            CALL PUTS
12BA: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
12BB:         	LOAD_CMD:
12BB: CD1C15  	            CALL PARSE_HEX16_DE
12BE: 3848    	            JR   C, LOAD_BAD
12C0: 22FBFB  	            LD   (ADDR_TMP), HL
12C3: 21A016  	            LD   HL, MSG_LOAD_HINT
12C6: CDAB04  	            CALL PUTS
              	
12C9:         	LOAD_LOOP:
              	            ; Exibe endereço atual
12C9: 2AFBFB  	            LD   HL, (ADDR_TMP)
12CC: CD7315  	            CALL PRINT_HEX16
12CF: 3E3A    	            LD   A, ':'
12D1: CD9F04  	            CALL PUTCHAR
12D4: 3E20    	            LD   A, SPACE
12D6: CD9F04  	            CALL PUTCHAR
              	
12D9: CD5E14  	            CALL GETLINE             ; Lê linha
12DC: 21A5FB  	            LD   HL, LINEBUF
12DF: CDBB14  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
12E2: 7E      	            LD   A, (HL)
12E3: FE0D    	            CP   CR
12E5: C8      	            RET  Z
12E6: FE00    	            CP   NUL
12E8: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
12E9:         	LOAD_BYTE:
12E9: CDEA14  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
12EC: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
12EE: ED5BFBFB	            LD   DE, (ADDR_TMP)
