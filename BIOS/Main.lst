              	#include "I2C.asm"
              	; **********************************************************************
              	; I2C support functions
              	
              	; I2C bus open device
              	;   On entry: A = Device address (bit zero is read flag)
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
181E: F5      	I2C_Open:   PUSH AF
181F: CD9218  	            CALL I2C_Start      ;Output start condition
1822: F1      	            POP  AF
1823: 1803    	            JR   I2C_Write      ;Write data byte
              	
              	
              	; I2C bus close device
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A=0 and Z flagged
              	;             If unsuccessfully A=Error and NZ flagged
              	;             SCL = hi, SDA = hi
              	;             BC DE HL IX IY preserved
1825: C39D18  	I2C_Close:  JP   I2C_Stop       ;Output stop condition
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; I2C bus master driver
              	; **********************************************************************
              	; **********************************************************************
              	
              	; Functions provided are:
              	;     I2C_Start
              	;     I2C_Stop
              	;     I2C_Read
              	;     I2C_Write
              	;
              	; This code has delays between all I/O operations to ensure it works
              	; with the slowest I2C devices
              	;
              	; I2C transfer sequence
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;   | Start |  | Address |  | Data    | ... | Data    |  | Stop  |
              	;   |       |  | frame   |  | frame 1 |     | frame N |  |       |
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;
              	;
              	; Start condition                     Stop condition
              	; Output by master device             Output by master device
              	;       ----+                                      +----
              	; SDA       |                         SDA          |
              	;           +-------                        -------+
              	;       -------+                                +-------
              	; SCL          |                      SCL       |
              	;              +----                        ----+
              	;
              	;
              	; Address frame
              	; Clock and data output from master device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | A 7 | A 6 | A 5 | A 4 | A 3 | A 2 | A 1 | R/W | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	;
              	; Data frame 
              	; Clock output by master device
              	; Data output by transmitting device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | D 7 | D 6 | D 5 | D 4 | D 3 | D 2 | D 1 | D 0 | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	
              	
              	; **********************************************************************
              	; I2C constants
              	
              	
              	; I2C bus master interface
              	; The default device option is for SC126 or compatible
              	
0021:         	I2C_PORT:   .EQU $21           ;Host I2C port address
0007:         	I2C_SDA_WR: .EQU 7              ;Host I2C write SDA bit number
0007:         	I2C_SDA_RD: .EQU 7              ;Host I2C read SDA bit number
0000:         	I2C_SCL_WR: .EQU 0              ;Host I2C write SCL bit number
0000:         	I2C_SCL_RD: .EQU 0              ;Host I2C read SCL bit number 
0081:         	I2C_QUIES:  .EQU 0b10000001     ;Host I2C output port quiescent value
              	
              	
              	; I2C support constants
0000:         	ERR_NONE:   .EQU 0              ;Error = None
0001:         	ERR_JAM:    .EQU 1              ;Error = Bus jammed [not used]
0002:         	ERR_NOACK:  .EQU 2              ;Error = No ackonowledge
0003:         	ERR_TOUT:   .EQU 3              ;Error = Timeout
              	
              	
              	; **********************************************************************
              	; Hardware dependent I2C bus functions
              	
              	
              	; I2C bus transmit frame (address or data)
              	;   On entry: A = Data byte, or
              	;                 Address byte (bit zero is read flag)
              	;             SCL = low, SDA = low
              	;   On exit:  If successful A=0 and Z flagged
              	;                SCL = lo, SDA = lo
              	;             If unsuccessful A=Error and NZ flagged
              	;                SCL = high, SDA = high, I2C closed
              	;             BC DE HL IX IY preserved
1828: C5      	I2C_Write:  PUSH BC             ;Preserve registers
1829: D5      	            PUSH DE
182A: 57      	            LD   D,A            ;Store byte to be written
182B: 0608    	            LD   B,8            ;8 data bits, bit 7 first
182D: CB12    	I2C_WriteWr_Loop:   RL   D              ;Test M.S.Bit
182F: 3805    	            JR   C,I2C_WriteBit_Hi      ;High, so skip
1831: CDC418  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = data bit)
1834: 1803    	            JR   I2C_WriteBit_Clk
1836: CDBD18  	I2C_WriteBit_Hi:    CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA = data bit)
1839: CDAF18  	I2C_WriteBit_Clk:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = data bit)
183C: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = data bit)
183F: 10EC    	            DJNZ I2C_WriteWr_Loop
              	; Test for acknowledge from slave (receiver)
              	; On arriving here, SCL = lo, SDA = data bit
1841: CDBD18  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/ack)
1844: CDAF18  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/ack)
1847: CDD518  	            CALL I2C_RdPort     ;Read SDA input
184A: 47      	            LD   B,A
184B: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = hi)
184E: CB78    	            BIT  I2C_SDA_RD,B
1850: 2004    	            JR   NZ,I2C_WriteNoAck      ;Skip if no acknowledge
1852: D1      	            POP  DE             ;Restore registers
1853: C1      	            POP  BC
1854: AF      	            XOR  A              ;Return success A=0 and Z flagged
1855: C9      	            RET
              	; I2C STOP required as no acknowledge
              	; On arriving here, SCL = lo, SDA = hi
1856: CDC418  	I2C_WriteNoAck:     CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = lo)
1859: CDAF18  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = lo)
185C: CDBD18  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA = hi)
185F: D1      	            POP  DE             ;Restore registers
1860: C1      	            POP  BC
1861: 3E02    	            LD   A,ERR_NOACK    ;Return error = No Acknowledge
1863: B7      	            OR   A              ;  and NZ flagged
1864: C9      	            RET
              	
              	
              	; I2C bus receive frame (data)
              	;   On entry: A = Acknowledge flag
              	;               If A != 0 the read is acknowledged
              	;             SCL low, SDA low
              	;   On exit:  If successful A = data byte and Z flagged
              	;               SCL = low, SDA = low
              	;             If unsuccessul* A = Error and NZ flagged
              	;               SCL = low, SDA = low
              	;             BC DE HL IX IY preserved
              	; *This function always returns successful
1865: C5      	I2C_Read:   PUSH BC             ;Preserve registers
1866: D5      	            PUSH DE
1867: 5F      	            LD   E,A            ;Store acknowledge flag
1868: 0608    	            LD   B,8            ;8 data bits, 7 first
186A: CDBD18  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/input)
186D: CDAF18  	I2C_ReadRd_Loop:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/input)
1870: CDD518  	            CALL I2C_RdPort     ;Read SDA input bit
1873: 37      	            SCF                 ;Set carry flag
1874: CB7F    	            BIT  I2C_SDA_RD,A   ;SDA input high?
1876: 2001    	            JR   NZ, I2C_ReadRotate     ;Yes, skip with carry flag set
1878: 3F      	            CCF                 ;Clear carry flag
1879: CB12    	I2C_ReadRotate:    RL   D              ;Rotate result into D
187B: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA hi/input)
187E: 10ED    	            DJNZ  I2C_ReadRd_Loop       ;Repeat for all 8 bits
              	; Acknowledge input byte
              	; On arriving here, SCL = lo, SDA = hi/input
1880: 7B      	            LD   A,E            ;Get acknowledge flag
1881: B7      	            OR   A              ;A = 0? (indicates no acknowledge)
1882: 2803    	            JR   Z, I2C_ReadNoAck       ;Yes, so skip acknowledge
1884: CDC418  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA lo)
1887: CDAF18  	I2C_ReadNoAck:     CALL I2C_SCL_HI     ;SCL hi    (SCL hi, SDA lo)
188A: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
188D: 7A      	            LD   A,D            ;Get data byte received
188E: D1      	            POP  DE             ;Restore registers
188F: C1      	            POP  BC
1890: BF      	            CP   A              ;Return success Z flagged
1891: C9      	            RET
              	
              	
              	; I2C bus start
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = low, SDA = low
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are high
1892: CDAB18  	I2C_Start:  CALL I2C_INIT       ;Initialise I2C control port
              	;           CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA ??)
              	;           CALL I2C_SDA_HI     ;SDA high  (SCL hi, SDA hi)
              	; Generate I2C start condition
1895: CDC418  	            CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1898: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
189B: AF      	            XOR  A              ;Return success A=0 and Z flagged
189C: C9      	            RET
              	
              	
              	; I2C bus stop 
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = high, SDA = high
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are low
189D: CDC418  	I2C_Stop:   CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
18A0: CDB618  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
              	; Generate stop condition
18A3: CDAF18  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA lo)
18A6: CDBD18  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA hi)
18A9: AF      	            XOR  A              ;Return success A=0 and Z flagged
18AA: C9      	            RET
              	
              	
              	; **********************************************************************
              	; I2C bus simple I/O functions
              	;   On entry: No parameters required
              	;   On exit:  BC DE HL IX IY preserved
              	
18AB: 3E81    	I2C_INIT:   LD   A,I2C_QUIES    ;I2C control port quiescent value
18AD: 181A    	            JR   I2C_WrPort
              	
18AF: 3A05FC  	I2C_SCL_HI: LD   A,(I2C_RAMCPY)
18B2: CBC7    	            SET  I2C_SCL_WR,A
18B4: 1813    	            JR   I2C_WrPort
              	
18B6: 3A05FC  	I2C_SCL_LO: LD   A,(I2C_RAMCPY)
18B9: CB87    	            RES  I2C_SCL_WR,A
18BB: 180C    	            JR   I2C_WrPort
              	
18BD: 3A05FC  	I2C_SDA_HI: LD   A,(I2C_RAMCPY)
18C0: CBFF    	            SET  I2C_SDA_WR,A
18C2: 1805    	            JR   I2C_WrPort
              	
18C4: 3A05FC  	I2C_SDA_LO: LD   A,(I2C_RAMCPY)
18C7: CBBF    	            RES  I2C_SDA_WR,A
              	
18C9: C5      	I2C_WrPort: PUSH BC             ;Preserve registers
18CA: 0600    	            LD   B,0            ;Set up BC for 16-bit
18CC: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
18CE: ED79    	            OUT  (C),A          ;Write A to I2C I/O port
18D0: 3205FC  	            LD   (I2C_RAMCPY),A ;Write A to RAM copy
18D3: C1      	            POP  BC             ;Restore registers
18D4: C9      	            RET
              	
18D5: C5      	I2C_RdPort: PUSH BC             ;Preserve registers
18D6: 0600    	            LD   B,0            ;Set up BC for 16-bit
18D8: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
18DA: ED78    	            IN   A,(C)          ;Read A from I/O port
18DC: C1      	            POP  BC             ;Restore registers
18DD: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
