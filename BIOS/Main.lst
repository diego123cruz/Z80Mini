7C8C: C3DF63  	        JP PRNTOK
              	
7C8F:         	cruz:
7C8F: CDCA73  	        CALL GETINT
7C92: 7B      	        LD A, E
7C93: D310    	        OUT($10), A 
7C95: C9      	        RET
7C96: C3DF63  	        JP PRNTOK
              	
              	;.end
              	
              	
              	
              	; RAM AREA
              	.ORG $F000              ;Start location
F000: 0000    	RST38:	DW 0000H 	    ;INT INTERRUPT JUMP
F002: 0000    	RST66:	DW 0000H 	    ;NMI INTERRUPT JUMP
              	
              	; DISPLAY GRAFICO
0780:         	SBUF:   EQU 16 * $78     ;Scroll Buffer size  16 * 60 = 960 byte (10 lines), change to 20 lines (16 * 120($78))
F004: FFFFFFFF	        DS SBUF         ;Scroll Buffer space abover GBUF 
F008: FF...   	
F784: FFFFFFFF	GBUF:   DS 0400H        ;Graphics Buffer 16 * 64 = 1024 byte
F788: FF...   	
F784:         	TGBUF:  EQU GBUF        ;Terminal GBUF
FB84: 84F7    	VPORT:  DW GBUF         ;View port start address
FB86: 84F7    	TBUF:   DW GBUF         ;Top of Buffer pointer
FB88: 0000    	ENDPT:  DW 0000H        ;End Point for Line
FB8A: 00      	SX:     DB 00H          ;Sign of X
FB8B: 00      	SY:     DB 00H          ;Sign of Y
FB8C: 0000    	DX:     DW 0000H        ;Change of X
FB8E: 0000    	DY:     DW 0000H        ;Change of Y
FB90: 0000    	ERR:    DW 0000H        ;Error Rate
FB92: 0000    	RAD:    DW 0000H        ;Radius
FB94: 00      	CLRBUF: DB 00H          ;Clear Buffer Flag on LCD Displaying
FB95: 0000    	CURSOR_XY: DW 0000H     ;Cursor Address X,Y
FB95:         	CURSOR_Y: EQU CURSOR_XY   ;Cursor Y
FB96:         	CURSOR_X: EQU CURSOR_XY+1 ;Cursor X
FB97: 00      	CURSOR_YS: DB 00H       ;Start Y row for new line
FB98: 00      	CURSOR_ON: DB 00H       ;Cursor on/off flag
FB99: 00      	INVERSE: DB 00H         ;Inverse Flag
FB9A: 00      	PIXEL_X: DB 00H         ;Pixel X length
FB9B: 00      	ULINE: DB 00H   ;Underline flag
FB9C: 00      	AUTO_LF: DB 00H   ;Auto line feed flag
FB9D: 00      	PLOT_ALWAYS: DB 00H   ;Plot always flag
              	
              	; PORTA SERIAL
FB9E: 0000    	PUTCH:  DW  0000H       ; Serial
FBA0: 0000    	GETCH:  DW  0000H       ; Serial
              	
              	; TECLADO
FBA2: 00      	MEN_SHIFT: DB 00H
FBA3: 00      	MEN_CAPSL: DB 00H
FBA4: 00      	KEY_PRESS: DB 00H
FBA5: 0606    	MEN_CURSR: DW 0606H
              	
              	; COMANDOS
FBA7: FFFFFFFF	LINEBUF:    DS 80          ; Buffer de linha de comando
FBAB: FF...   	
FBF7: FFFFFFFF	HEXBUF:     DS 6           ; Buffer temporário hex
FBFB: FFFF    	
FBFD: 0000    	ADDR_TMP:   DW $0000       ; Endereço temporário de trabalho
              	
              	; IHEX
FBFF: FF      	LOAD_FIRST_FLAG:    .DB    $FF   ; FF=virgem  01=primeira linha  00=demais
FC00: 0000    	LOAD_START_ADDR:    .DW    $0000 ; Endereco inicial do carregamento
FC02: 0000    	LOAD_END_ADDR:      .DW    $0000 ; Endereco final do carregamento
              	
              	; I2C
FC04: 00      	I2CA_BLOCK:         .DB    $00   ; I2C device addess: 24LC256 (Copy from/to Mem) dir, del, save, load
FC05: 00      	I2C_RAMCPY:         .DB    $00   ; 1 byte - RAM copy of output port
FC06: 00      	I2C_ADDR            .DB    $00   ; 1 byte - device address
FC07: 00      	I2C_RR              .DB    $00   ; 1 byte - register
FC08: 00      	I2C_DD              .DB    $00   ; 1 byte - data
              	
              	; FS
FC09: 00      	FS_CUR:     .DB $00         ; 1b: entrada corrente do dir
FC0A: FFFFFFFF	FS_WRKBUF:  .DS $20         ; 32b: buffer entrada dir
FC0E: FF...   	
FC2A: FFFFFFFF	FS_NAMBUF:  .DS $0A         ; 9b: nome digitado
FC2E: FF...   	
FC34: 00      	FS_TMP1:    .DB $00         ; 1b: uso geral
FC35: 0000    	FS_TMPSZ:   .DW $0000       ; 2b: tamanho restante
FC37: 0000    	FS_TMPRAM:  .DW $0000       ; 2b: ponteiro RAM atual
FC39: 00      	FS_CURPG:   .DB $00         ; 1b: pagina corrente
FC3A: 00      	FS_SLOTBK:  .DB $00         ; 1b: backup slot dir
FC3B: 00      	FS_BMPADDR: .DB $00         ; 1b: endereco EEPROM do byte do bitmap
FC3C: 00      	FS_INFOTMP: .DB $00         ; 1b: temp para FS_INFO (paginas livres)
              	; Buffer de pagina em RAM (256 bytes) - longe do codigo
FC3D: FFFFFFFF	PG_BUF:     .DS $FF
FC41: FF...   	
              	
              	; pixel collision
FD3C: 00      	DRAW_PIXEL_COLLISION .db $00 ; 0 - reset, 1 - set


