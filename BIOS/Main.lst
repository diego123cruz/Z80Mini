              	; **********************************************************************
              	; List devices found on the I2C bus
              	;
              	; Test each I2C device address and reports any that acknowledge
              	
1BB9: 21A51B  	I2CLIST:    LD   HL, I2C_LIST_MSG        ;Address of message string
              	            ;XOR A ; A = character to stop printing.
1BBC: CD0305  	            CALL PUTS         ;Output string
1BBF: 1600    	            LD   D,0            ;First I2C device address to test
1BC1: D5      	LISTLOOP:      PUSH DE             ;Preserve DE
1BC2: 7A      	            LD   A,D            ;Get device address to be tested
1BC3: CD191C  	            CALL LISTTEST          ;Test if device is present
1BC6: D1      	            POP  DE             ;Restore DE
1BC7: 2044    	            JR   NZ,LISTNEXT       ;Skip if no acknowledge
1BC9: 7A      	            LD   A,D            ;Get address of device tested
1BCA: CB3F    	            SRL  A     ; remove bit R/W
1BCC: F5      	            PUSH AF
1BCD: CDBE1D  	            CALL HexOut         ;Output as two character hex 
              	            ;LD A, ' '; space
              	            ;CALL PUTCHAR       ;Output space character
1BD0: F1      	            POP AF
1BD1: FE07    	            CP  $07
1BD3: CC221C  	            CALL Z, i2cPrintL07
1BD6: FE08    	            CP  $08
1BD8: CC2A1C  	            CALL Z, i2cPrintL08
1BDB: FE32    	            CP  $32
1BDD: CC321C  	            CALL Z, i2cPrintL32
1BE0: FE50    	            CP  $50
1BE2: CC3A1C  	            CALL Z, i2cPrintL50
1BE5: FE51    	            CP  $51
1BE7: CC421C  	            CALL Z, i2cPrintL51
1BEA: FE52    	            CP  $52
1BEC: CC4A1C  	            CALL Z, i2cPrintL52
1BEF: FE53    	            CP  $53
1BF1: CC521C  	            CALL Z, i2cPrintL53
1BF4: FE54    	            CP  $54
1BF6: CC5A1C  	            CALL Z, i2cPrintL54
1BF9: FE55    	            CP  $55
1BFB: CC621C  	            CALL Z, i2cPrintL55
1BFE: FE56    	            CP  $56
1C00: CC6A1C  	            CALL Z, i2cPrintL56
1C03: FE57    	            CP  $57
1C05: CC721C  	            CALL Z, i2cPrintL57
1C08: 3E0D    	            LD A, CR; enter
1C0A: CDF704  	            CALL PUTCHAR       ;Output space character
1C0D: 14      	LISTNEXT:      INC  D              ;Get next write address
1C0E: 14      	            INC  D
1C0F: 7A      	            LD   A,D            ;Address of next device to test
1C10: B7      	            OR   A              ;Have we tested all addresses?
1C11: 20AE    	            JR   NZ,LISTLOOP       ;No, so loop again
1C13: 3E0D    	            LD A, CR; enter
1C15: CDF704  	            CALL PUTCHAR       ;Output space character
1C18: C9      	            RET
              	
              	; Test if device at I2C address A acknowledges
              	;   On entry: A = I2C device address (8-bit, bit 0 = lo for write)
              	;   On exit:  Z flagged if device acknowledges
              	;             NZ flagged if devices does not acknowledge
1C19: CDDB1A  	LISTTEST:      CALL I2C_Open       ;Open I2C device for write
1C1C: C0      	            RET  NZ             ;Abort if failed to open
1C1D: CDE21A  	            CALL I2C_Close      ;Close I2C device 
1C20: AF      	            XOR  A              ;Return with Z flagged
1C21: C9      	            RET
              	
