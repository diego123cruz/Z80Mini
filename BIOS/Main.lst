2522: CDCF22  	    CALL FS_RD_ENTRY
2525: C25425  	    JP NZ, FS_FFN_ERR
2528: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
252B: FE02    	    CP FS_FLAG_USED_FOLDER
252D: 2017    	    JR NZ, FS_FFN_NXT
252F: 212AFC  	    LD HL, FS_NAMBUF
2532: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
2535: 0E10    	    LD C, FS_NAME_SZ
2537:         	FS_FFN_CMP:
2537: 7E      	    LD   A, (HL)
2538: 47      	    LD   B, A
2539: 1A      	    LD   A, (DE)
253A: B8      	    CP   B
253B: C24625  	    JP  NZ, FS_FFN_NXT
253E: 23      	    INC HL
253F: 13      	    INC DE
2540: 0D      	    DEC C
2541: 20F4    	    JR NZ, FS_FFN_CMP
2543: C1      	    POP BC
2544: AF      	    XOR A
2545: C9      	    RET
2546:         	FS_FFN_NXT:
2546: 3A09FC  	    LD A, (FS_CUR)
2549: 3C      	    INC A
254A: 3209FC  	    LD (FS_CUR), A
254D: C1      	    POP BC
254E: 10D1    	    DJNZ FS_FFN_LP
2550: 3E01    	    LD A, 1
2552: B7      	    OR A
2553: C9      	    RET
2554:         	FS_FFN_ERR:
2554: C1      	    POP BC
2555: 3E03    	    LD A, ERR_TOUT
2557: B7      	    OR A
2558: C9      	    RET
              	
              	
              	
              	
              	
