2419: 52524F21	
241D: 0D0A00  	             .DB CR, LF, 0
              	
              	
              	
              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
2420:         	FS_WRITE_PG:
2420: C5      	    PUSH BC
2421: D5      	    PUSH DE
2422: E5      	    PUSH HL
2423: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
2424: 2A3AFC  	    LD HL, (FS_TMPSZ)
2427: 7C      	    LD A, H
2428: B7      	    OR A
2429: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
242B: 7D      	    LD A, L
242C: FEFF    	    CP FS_DATAPG            ; L < 255?
242E: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
2430:         	FS_WP_USE255:
2430: 0EFF    	    LD C, FS_DATAPG         ; C = 255
2432: 1801    	    JR FS_WP_COPY
2434:         	FS_WP_USELT:
2434: 4D      	    LD C, L                 ; C = L (< 255)
              	
2435:         	FS_WP_COPY:
              	    ; C = bytes a gravar (1..255). Salva em D para nao perder.
2435: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
2436: 2142FC  	    LD HL, PG_BUF
2439: 3600    	    LD (HL), $00            ; byte 0 = next = $00
243B: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
243C: DD2A3CFC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
2440: 5A      	    LD E, D                 ; E = contador de copia
2441:         	FS_WP_CPLOOP:
2441: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
