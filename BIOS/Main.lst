244F: 20FA    	    JR NZ, FS_WP_PADLOOP
2451:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
2451: F1      	    POP AF                  ; A = numero da pagina
2452: F5      	    PUSH AF
2453: 57      	    LD D, A
2454: 1E00    	    LD E, 0
2456: 2142FC  	    LD HL, PG_BUF
2459: 010001  	    LD BC, 256
245C: CD061D  	    CALL I2C_MemWr
245F: C28C24  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
2462: F1      	    POP AF                  ; A = pagina (descarta)
2463: E1      	    POP HL                  ; restaura HL original
2464: D1      	    POP DE                  ; restaura DE original
2465: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
2466: 2A3AFC  	    LD HL, (FS_TMPSZ)
2469: 7C      	    LD A, H
246A: B7      	    OR A
246B: 2005    	    JR NZ, FS_WP_UPD255
246D: 7D      	    LD A, L
246E: FEFF    	    CP FS_DATAPG
2470: 3805    	    JR C, FS_WP_UPDLT
2472:         	FS_WP_UPD255:
2472: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
2475: 1803    	    JR FS_WP_UPDATE
2477:         	FS_WP_UPDLT:
2477: 0600    	    LD B, 0
2479: 4D      	    LD C, L                 ; bytes gravados = L
              	
247A:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
247A: 2A3CFC  	    LD HL, (FS_TMPRAM)
247D: 09      	    ADD HL, BC
247E: 223CFC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
2481: 2A3AFC  	    LD HL, (FS_TMPSZ)
2484: B7      	    OR A                    ; limpa carry
2485: ED42    	    SBC HL, BC
2487: 223AFC  	    LD (FS_TMPSZ), HL
248A: AF      	    XOR A                   ; Z = sucesso
248B: C9      	    RET
              	
248C:         	FS_WP_ERR:
248C: F1      	    POP AF
248D: E1      	    POP HL
248E: D1      	    POP DE
248F: C1      	    POP BC
2490: 3E01    	    LD A, 1
2492: B7      	    OR A
2493: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
2494:         	FS_SET_NEXT:
2494: C5      	    PUSH BC
2495: D5      	    PUSH DE
2496: E5      	    PUSH HL
2497: 57      	    LD D, A
2498: 1E00    	    LD E, 0
249A: 78      	    LD A, B
249B: 3239FC  	    LD (FS_TMP1), A
249E: 2139FC  	    LD HL, FS_TMP1
24A1: 010100  	    LD BC, 1
24A4: CD061D  	    CALL I2C_MemWr
24A7: E1      	    POP HL
24A8: D1      	    POP DE
24A9: C1      	    POP BC
24AA: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
24AB:         	FS_FIND_NAME:
24AB: AF      	    XOR A
24AC: 3209FC  	    LD (FS_CUR), A
24AF: 0608    	    LD B, FS_MAXFILES
24B1:         	FS_FN_LP:
24B1: C5      	    PUSH BC
24B2: CD9D22  	    CALL FS_RD_ENTRY
24B5: C2E424  	    JP NZ, FS_FN_ERR
24B8: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
24BB: FE01    	    CP FS_FLAG_USED
24BD: 2017    	    JR NZ, FS_FN_NXT
24BF: 212AFC  	    LD HL, FS_NAMBUF
24C2: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
24C5: 0E10    	    LD C, FS_NAME_SZ
24C7:         	FS_FN_CMP:
24C7: 7E      	    LD   A, (HL)
24C8: 47      	    LD   B, A
24C9: 1A      	    LD   A, (DE)
24CA: B8      	    CP   B
24CB: C2D624  	    JP  NZ, FS_FN_NXT
24CE: 23      	    INC HL
24CF: 13      	    INC DE
24D0: 0D      	    DEC C
24D1: 20F4    	    JR NZ, FS_FN_CMP
24D3: C1      	    POP BC
24D4: AF      	    XOR A
24D5: C9      	    RET
24D6:         	FS_FN_NXT:
24D6: 3A09FC  	    LD A, (FS_CUR)
24D9: 3C      	    INC A
24DA: 3209FC  	    LD (FS_CUR), A
24DD: C1      	    POP BC
24DE: 10D1    	    DJNZ FS_FN_LP
24E0: 3E01    	    LD A, 1
24E2: B7      	    OR A
24E3: C9      	    RET
24E4:         	FS_FN_ERR:
24E4: C1      	    POP BC
24E5: 3E03    	    LD A, ERR_TOUT
24E7: B7      	    OR A
24E8: C9      	    RET
              	
              	
              	
              	
              	; FS_FIND_FOLDER_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
24E9:         	FS_FIND_FOLDER_NAME:
