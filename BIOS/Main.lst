0276:         	INICIO:
0276: 21B301  	    LD HL, INT_DEFAULT
0279: 2200F0  	    LD (RST38), HL
027C: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
027F: 3EA0    	    LD A, EEDRIVE_A
0281: 321BFC  	    LD (I2CA_BLOCK), A     
              	
0284: 3E01    	    LD A, $01
0286: 325BFD  	    LD (FS_DIR_CUR), A ; default folder - HOME
              	
0289: CDD102  	    CALL M_C_DIR_C
              	
028C: CDF722  	    CALL FS_CHK_SIG
028F: CA9802  	    JP Z, INICIO1
0292: 21CB26  	    LD HL, str_notfmt
0295: CD0305  	    CALL PUTS
0298:         	INICIO1:
              	
0298: 31F0FF  	    LD SP, SYSTEM_SP
              	
029B: 116400  	    LD DE, $0064 ; 100ms
029E: CD3D03  	    CALL H_Delay
              	
02A1: CDAB03  	    call KBD_INIT
              	
              	    ;Init Serial
02A4: CDB810  	    CALL initSerial
              	
              	    ;Init Teclado
02A7: 3EFF    	    LD      A, 0xFF
02A9: D340    	    OUT     (KEYBOARD), A           ; Todas as colunas desativadas
              	
              	    ; Init LCD
02AB: CD3D08  	    CALL initTerminal
02AE: CD8605  	    CALL setGrMode
02B1: CD3808  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02B4: 010000  	    LD BC, $0000
02B7: CD2A09  	    CALL setCursor
02BA: 11CE27  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02BD: 3E00    	    LD A, 0
02BF: 3298FB  	    LD (CURSOR_ON), A
              	 
              	    ; send cursor
02C2: CDDA08  	    CALL sendStringToLCD
              	
              	
02C5:         	MAIN_LOOP:
02C5: CDE602  	    CALL showCurrentDriver
              	
02C8: CDB614  	    CALL GETLINE             ; Lê linha em LINEBUF
02CB: CD5311  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02CE: C3C502  	    JP      MAIN_LOOP
              	
              	
02D1:         	M_C_DIR_C:
02D1: 0611    	    LD B, FS_NAME_SZ + 1
02D3: 215CFD  	    LD HL, FS_DIR_NAME
02D6: 11E327  	    LD DE, FOLDER_HOME
02D9:         	M_C_DIR:
02D9: 1A      	    LD A, (DE)
02DA: FE00    	    CP 0
02DC: 2805    	    JR Z, M_C_DIR_F
02DE: 77      	    LD (HL), A
02DF: 23      	    INC HL
02E0: 13      	    INC DE
02E1: 10F6    	    djnz M_C_DIR
02E3:         	M_C_DIR_F:
02E3: AF      	    XOR A
02E4: 77      	    LD (HL), A
02E5: C9      	    RET
              	
              	
              	
02E6:         	showCurrentDriver:
02E6: 3A1BFC  	    LD A, (I2CA_BLOCK)
02E9: FEA0    	    CP EEDRIVE_A  ; Drive A
02EB: 281D    	    JR Z, showDriveA
02ED: FEA2    	    CP EEDRIVE_B  ; Drive B
02EF: 281D    	    JR Z, showDriveB
02F1: FEA4    	    CP EEDRIVE_C  ; Drive C
02F3: 281D    	    JR Z, showDriveC
02F5: FEA6    	    CP EEDRIVE_D  ; Drive D
02F7: 281D    	    JR Z, showDriveD
02F9: FEA8    	    CP EEDRIVE_E  ; Drive E
02FB: 281D    	    JR Z, showDriveE
02FD: FEAC    	    CP EEDRIVE_F  ; Drive F
02FF: 281D    	    JR Z, showDriveF
0301: FEAE    	    CP EEDRIVE_G  ; Drive G
0303: 281D    	    JR Z, showDriveG
0305: FEAA    	    CP EEDRIVE_Z  ; Drive Z
0307: 281D    	    JR Z, showDriveZ
0309: C9      	    RET
              	
030A:         	showDriveA:
030A: 3E41    	    LD A, 'A'
030C: 181C    	    JR showCursor
030E:         	showDriveB:
030E: 3E42    	    LD A, 'B'
0310: 1818    	    JR showCursor
0312:         	showDriveC:
0312: 3E43    	    LD A, 'C'
0314: 1814    	    JR showCursor
0316:         	showDriveD:
0316: 3E44    	    LD A, 'D'
0318: 1810    	    JR showCursor
031A:         	showDriveE:
031A: 3E45    	    LD A, 'E'
031C: 180C    	    JR showCursor
031E:         	showDriveF:
031E: 3E46    	    LD A, 'F'
0320: 1808    	    JR showCursor
0322:         	showDriveG:
0322: 3E47    	    LD A, 'G'
0324: 1804    	    JR showCursor
0326:         	showDriveZ:
0326: 3E5A    	    LD A, 'Z'
0328: 1800    	    JR showCursor
032A:         	showCursor:
032A: CD6A08  	    CALL sendCharToLCD
032D: 3E3A    	    LD A, ':'
032F: CD6A08  	    CALL sendCharToLCD
0332: C9      	    RET
              	
              	
              	
0333:         	resetCollisionPixel:
0333: AF      	    XOR A
0334: 3258FD  	    LD (DRAW_PIXEL_COLLISION), A
0337: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
0338:         	checkCollisionPixel:
0338: 3A58FD  	    LD A, (DRAW_PIXEL_COLLISION)
033B: B7      	    OR A
033C: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
033D: F5      	H_Delay:    PUSH AF
033E: C5      	            PUSH BC
033F: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
0340: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
0343: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
0344: 79      	            LD   A,C            ;[4]     [4]
0345: B0      	            OR   B              ;[4]     [4]
0346: C24303  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
0349: 1B      	            DEC  DE             ;[6]     [4]
034A: 7B      	            LD   A,E            ;[4]     [4]
034B: B2      	            OR   D              ;[4]     [4]
034C: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
034E: D1      	            POP  DE
034F: C1      	            POP  BC
0350: F1      	            POP  AF
0351: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       Informa se há tecla, SEM consumir: a tecla fica em KEY_BUF e
              	;       a próxima leitura (GETINP -> readKeyboarPressA) a devolve.
              	;       Esc é guardado como CTRLC, pois o BASIC só reconhece Ctrl+C.
              	;       On exit: Z  e A = 0        -> nenhuma tecla
              	;                NZ e A = CTRLC    -> Esc ou Ctrl+C
              	;                NZ e A = tecla    -> outra tecla
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
0352:         	CHKKEY:
0352: 3ABDFB  	    LD      A, (KEY_BUF)        ; já tem tecla guardada?
0355: B7      	    OR      A
0356: 2014    	    JR      NZ, CK_HAVE
              	
0358: C5      	    PUSH    BC
0359: D5      	    PUSH    DE
035A: E5      	    PUSH    HL
035B: CDC703  	    CALL    readKeyboarPressA   ; Carry=1 e A=tecla nova
035E: E1      	    POP     HL                  ; POP não altera flags
035F: D1      	    POP     DE
0360: C1      	    POP     BC
0361: 3017    	    JR      NC, CK_NONE
              	
0363: FE1B    	    CP      $1B                 ; Esc vira Ctrl+C para o BASIC
0365: 2002    	    JR      NZ, CK_STORE
0367: 3E03    	    LD      A, CTRLC
0369:         	CK_STORE:
0369: 32BDFB  	    LD      (KEY_BUF), A        ; guarda para o GETINP ler
              	
036C:         	CK_HAVE:
036C: FE1B    	    CP      $1B                 ; Esc
036E: 2806    	    JR      Z, CK_BREAK
0370: FE03    	    CP      CTRLC               ; Ctrl+C ($03)
0372: 2802    	    JR      Z, CK_BREAK
0374: B7      	    OR      A                   ; NZ (A != 0)
0375: C9      	    RET
              	
0376:         	CK_BREAK:
0376: 3E03    	    LD      A, CTRLC
0378: B7      	    OR      A                   ; NZ
0379: C9      	    RET
              	
037A:         	CK_NONE:
037A: AF      	    XOR     A                   ; A = 0, Z
037B: C9      	    RET
              	
              	
              	
              	
              	
              	
037C:         	LCD_SCROLL_CONIN:
037C: CDF704  	    CALL PUTCHAR
037F: C38503  	    JP CONIN_K
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
0382:         	CONIN:
0382: C5      	    PUSH BC
0383: D5      	    PUSH DE
0384: E5      	    PUSH HL
0385:         	CONIN_K:
0385: CDC103  	    CALL readKeyboarWaitPressA
0388: FEF8    	    CP   $F8    ; ignora scroll up - GLCD
038A: 28F0    	    JR   Z, LCD_SCROLL_CONIN
038C: FEF7    	    CP   $F7    ; ignora scroll down - GLCD
038E: 28EC    	    JR   Z, LCD_SCROLL_CONIN
0390: FE0A    	    CP   LF
0392: 28F1    	    JR   Z, CONIN_K    ; Ignora LF
0394: FE1B    	    CP   ESC
0396: 28ED    	    JR   Z, CONIN_K    ; Ignora
0398: FEFF    	    CP   $FF ;capslock Ignora
039A: CA8503  	    JP   Z, CONIN_K
039D: E1      	    POP HL
039E: D1      	    POP DE
039F: C1      	    POP BC
03A0: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
03A1:         	CONIN_NOT_LOOP:
03A1: C5      	    PUSH BC
03A2: D5      	    PUSH DE
03A3: E5      	    PUSH HL
03A4: CDC703  	    CALL readKeyboarPressA
03A7: E1      	    POP HL
03A8: D1      	    POP DE
03A9: C1      	    POP BC
03AA: C9      	    RET
              	
              	
              	
              	; ============================================================
              	; KBD_INIT  -  chamar uma vez no boot
              	; ============================================================
03AB:         	KBD_INIT:
03AB: AF      	    XOR     A
03AC: 32BDFB  	    LD      (KEY_BUF), A
03AF: 32A3FB  	    LD      (CAPS_ON), A
03B2: 32A4FB  	    LD      (KEY_HELD), A
03B5: 21B5FB  	    LD      HL, KEY_PREV
03B8: 0608    	    LD      B, 8
03BA:         	KI_CLR:
03BA: 77      	    LD      (HL), A
03BB: 23      	    INC     HL
03BC: 10FC    	    DJNZ    KI_CLR
03BE: C34F04  	    JP      KBD_IDLE            ; porta em repouso, LED apagado
              	
              	
              	; ============================================================
              	; readKeyboarWaitPressA  (bloqueante)
              	;   Aguarda uma tecla NOVA e retorna o caractere em A.
              	;   Não espera soltar -> permite digitação rápida (rollover).
              	; ============================================================
03C1:         	readKeyboarWaitPressA:
03C1: CDC703  	    CALL    readKeyboarPressA
03C4: 30FB    	    JR      NC, readKeyboarWaitPressA
03C6: C9      	    RET
              	
              	
              	; ============================================================
              	; readKeyboarPressA  (não bloqueante)
              	;   Saída: Carry=1 e A=caractere se uma tecla acabou de ser
              	;          pressionada; Carry=0 caso contrário.
              	; ============================================================
03C7:         	readKeyboarPressA:
              	    ; --- Tecla guardada pelo CHKKEY? ---
03C7: 3ABDFB  	    LD      A, (KEY_BUF)
03CA: B7      	    OR      A
03CB: 2808    	    JR      Z, KP_POLL
03CD: F5      	    PUSH    AF
03CE: AF      	    XOR     A
03CF: 32BDFB  	    LD      (KEY_BUF), A        ; esvazia o buffer
03D2: F1      	    POP     AF
03D3: 37      	    SCF
03D4: C9      	    RET
              	
03D5:         	KP_POLL:
              	    ; --- Caminho rápido: nada pressionado agora nem antes ---
              	    ; --- Caminho rápido: nada pressionado agora nem antes ---
03D5: CD2704  	    CALL    ANY_KEY
03D8: 2005    	    JR      NZ, KP_SCAN
03DA: 3AA4FB  	    LD      A, (KEY_HELD)
03DD: B7      	    OR      A                   ; Carry=0
03DE: C8      	    RET     Z
              	
03DF:         	KP_SCAN:
03DF: 21A5FB  	    LD      HL, KEY_CUR
03E2: CD3804  	    CALL    SCAN_ALL
              	
              	    ; --- Mudou algo desde o último estado estável? ---
03E5: 21A5FB  	    LD      HL, KEY_CUR
03E8: 11B5FB  	    LD      DE, KEY_PREV
03EB: CD5C04  	    CALL    COMPARE8
03EE: 2835    	    JR      Z, KP_NONE          ; nada mudou, sem debounce
              	
              	    ; --- Mudou: debounce e confirma ---
03F0: CDEB04  	    CALL    DEBOUNCE
03F3: 21ADFB  	    LD      HL, KEY_CHK
03F6: CD3804  	    CALL    SCAN_ALL
03F9: 21A5FB  	    LD      HL, KEY_CUR
03FC: 11ADFB  	    LD      DE, KEY_CHK
03FF: CD5C04  	    CALL    COMPARE8
0402: 2021    	    JR      NZ, KP_NONE         ; ainda instável, tenta depois
              	
              	    ; --- Estado estável novo: procura tecla recém-pressionada ---
0404: CD6604  	    CALL    FIND_EDGE           ; Carry=1 se achou (KEY_PRESS)
0407: F5      	    PUSH    AF
              	
              	    ; KEY_PREV <- KEY_CUR
0408: 21A5FB  	    LD      HL, KEY_CUR
040B: 11B5FB  	    LD      DE, KEY_PREV
040E: 010800  	    LD      BC, 8
0411: EDB0    	    LDIR
              	
              	    ; KEY_HELD <- OR de todas as colunas (0 = nada pressionado)
0413: 21A5FB  	    LD      HL, KEY_CUR
0416: 0608    	    LD      B, 8
0418: AF      	    XOR     A
0419:         	KP_OR:
0419: B6      	    OR      (HL)
041A: 23      	    INC     HL
041B: 10FC    	    DJNZ    KP_OR
041D: 32A4FB  	    LD      (KEY_HELD), A
              	
0420: F1      	    POP     AF                  ; recupera Carry do FIND_EDGE
0421: 3AA2FB  	    LD      A, (KEY_PRESS)      ; LD não altera flags
0424: C9      	    RET
              	
0425:         	KP_NONE:
0425: B7      	    OR      A                   ; Carry=0
0426: C9      	    RET
              	
              	
              	; ============================================================
              	; ANY_KEY
              	;   Ativa TODAS as colunas de uma vez (seguro graças aos diodos)
              	;   e lê as linhas numa única leitura.
              	;   Saída: Z=1 se nenhuma tecla pressionada.
              	; ============================================================
0427:         	ANY_KEY:
0427: AF      	    XOR     A
0428: D340    	    OUT     (KEYBOARD), A       ; todas as colunas ativas
042A: 00      	    NOP
042B: 00      	    NOP
042C: 00      	    NOP
042D: 00      	    NOP
042E: DB40    	    IN      A, (KEYBOARD)
0430: 2F      	    CPL
0431: 4F      	    LD      C, A
0432: CD4F04  	    CALL    KBD_IDLE            ; volta ao repouso (LED conforme Capslock)
0435: 79      	    LD      A, C
0436: B7      	    OR      A
0437: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_ALL
              	;   Entrada: HL = buffer de 8 bytes
              	;   Saída:   buffer[col] = bits das linhas pressionadas (1 = pressionada)
              	; ============================================================
0438:         	SCAN_ALL:
0438: 16FE    	    LD      D, $FE              ; coluna 0 ativa
043A: 0608    	    LD      B, 8
043C:         	SA_COL:
043C: 7A      	    LD      A, D
043D: D340    	    OUT     (KEYBOARD), A
043F: 00      	    NOP                         ; estabilização
0440: 00      	    NOP
0441: 00      	    NOP
0442: 00      	    NOP
0443: DB40    	    IN      A, (KEYBOARD)
0445: 2F      	    CPL                         ; pull-up: pressionado = 1
0446: 77      	    LD      (HL), A
0447: 23      	    INC     HL
0448: CB02    	    RLC     D                   ; $FE -> $FD -> $FB ... -> $7F
044A: 10F0    	    DJNZ    SA_COL
044C: C34F04  	    JP      KBD_IDLE            ; volta ao repouso (LED conforme Capslock)
              	
              	
              	; ============================================================
              	; KBD_IDLE  -  valor de repouso da porta do teclado
              	;   Circuito do LED: acende só com b0=b1=b2=0 e b4=b5=1.
              	;   Na varredura só uma coluna fica em 0, então o LED nunca
              	;   acende por engano. No repouso deixamos:
              	;     Capslock ligado    -> $F8  (LED aceso fixo)
              	;     Capslock desligado -> $FF  (tudo inativo, LED apagado)
              	;   Altera só A.
              	; ============================================================
044F:         	KBD_IDLE:
044F: 3AA3FB  	    LD      A, (CAPS_ON)
0452: B7      	    OR      A
0453: 3EFF    	    LD      A, $FF              ; LD não altera flags
0455: 2802    	    JR      Z, KI_OUT
0457: 3EF8    	    LD      A, $F8
0459:         	KI_OUT:
0459: D340    	    OUT     (KEYBOARD), A
045B: C9      	    RET
              	
              	
              	; ============================================================
              	; COMPARE8
              	;   Compara 8 bytes em (HL) e (DE).  Z=1 se iguais.
              	; ============================================================
045C:         	COMPARE8:
045C: 0608    	    LD      B, 8
045E:         	C8_LOOP:
045E: 1A      	    LD      A, (DE)
045F: BE      	    CP      (HL)
0460: C0      	    RET     NZ
0461: 23      	    INC     HL
0462: 13      	    INC     DE
0463: 10F9    	    DJNZ    C8_LOOP
0465: C9      	    RET                         ; Z=1
              	
              	
              	; ============================================================
              	; FIND_EDGE
              	;   Procura a primeira tecla que está em KEY_CUR mas não em
              	;   KEY_PREV e que gere um caractere válido.
              	;   Saída: Carry=1 e KEY_PRESS preenchido se achou.
              	; ============================================================
0466:         	FIND_EDGE:
0466: 21A5FB  	    LD      HL, KEY_CUR
0469: 11B5FB  	    LD      DE, KEY_PREV
046C: 0600    	    LD      B, 0                ; B = coluna
046E:         	FE_COL:
046E: 1A      	    LD      A, (DE)
046F: 2F      	    CPL
0470: A6      	    AND     (HL)                ; recém-pressionadas = cur AND NOT prev
0471: 2817    	    JR      Z, FE_NEXT
0473: 0E00    	    LD      C, 0                ; C = linha
0475:         	FE_ROW:
0475: CB3F    	    SRL     A                   ; bit 0 -> Carry, 0 entra no bit 7
0477: 300D    	    JR      NC, FE_SKIP
0479: F5      	    PUSH    AF
047A: E5      	    PUSH    HL
047B: D5      	    PUSH    DE
047C: C5      	    PUSH    BC
047D: CD9704  	    CALL    KEY_TO_ASCII        ; Carry=1 se caractere válido
0480: C1      	    POP     BC
0481: D1      	    POP     DE
0482: E1      	    POP     HL
0483: 380F    	    JR      C, FE_FOUND
0485: F1      	    POP     AF
0486:         	FE_SKIP:
0486: 0C      	    INC     C
0487: B7      	    OR      A
0488: 20EB    	    JR      NZ, FE_ROW
048A:         	FE_NEXT:
048A: 23      	    INC     HL
048B: 13      	    INC     DE
048C: 04      	    INC     B
048D: 78      	    LD      A, B
048E: FE08    	    CP      8
0490: 20DC    	    JR      NZ, FE_COL
0492: B7      	    OR      A                   ; Carry=0: nada novo
0493: C9      	    RET
0494:         	FE_FOUND:
0494: F1      	    POP     AF                  ; descarta
0495: 37      	    SCF
0496: C9      	    RET
              	
              	
              	; ============================================================
              	; KEY_TO_ASCII
              	;   Entrada: B = coluna, C = linha
              	;   Saída:   Carry=1 e KEY_PRESS = caractere, ou Carry=0 se for
              	;            modificador (Capslock alterna aqui).
              	;   Shift left = col 0 / linha 3   Ctrl left = col 0 / linha 4
              	; ============================================================
0497:         	KEY_TO_ASCII:
0497: 78      	    LD      A, B
0498: 87      	    ADD     A, A
0499: 87      	    ADD     A, A
049A: 87      	    ADD     A, A
049B: 81      	    ADD     A, C                ; índice = col*8 + linha
049C: 5F      	    LD      E, A
049D: 1600    	    LD      D, 0
              	
049F: 21B601  	    LD      HL, KEYMAP_NORMAL
04A2: 19      	    ADD     HL, DE
04A3: 7E      	    LD      A, (HL)
04A4: FEFF    	    CP      $FF
04A6: 2836    	    JR      Z, KTA_CAPS         ; Capslock
04A8: FEF6    	    CP      $F6
04AA: 283D    	    JR      Z, KTA_NONE         ; Fn
04AC: FEFB    	    CP      $FB
04AE: 3039    	    JR      NC, KTA_NONE        ; $FB-$FE: Alt, Win, Ctrl, Shift
              	
              	    ; --- Escolhe a tabela ---
04B0: 21F601  	    LD      HL, KEYMAP_SHIFT
04B3: 3AA5FB  	    LD      A, (KEY_CUR)
04B6: CB5F    	    BIT     3, A                ; Shift esquerdo pressionado?
04B8: 200C    	    JR      NZ, KTA_LOOK
04BA: 213602  	    LD      HL, KEYMAP_CAPSLOCK
04BD: 3AA3FB  	    LD      A, (CAPS_ON)
04C0: B7      	    OR      A
04C1: 2003    	    JR      NZ, KTA_LOOK
04C3: 21B601  	    LD      HL, KEYMAP_NORMAL
04C6:         	KTA_LOOK:
04C6: 19      	    ADD     HL, DE
04C7: 7E      	    LD      A, (HL)
              	
              	    ; --- Ctrl esquerdo: gera código de controle ($40-$7F) ---
04C8: 21A5FB  	    LD      HL, KEY_CUR
04CB: CB66    	    BIT     4, (HL)
04CD: 280A    	    JR      Z, KTA_OK
04CF: FE40    	    CP      $40
04D1: 3806    	    JR      C, KTA_OK
04D3: FE80    	    CP      $80
04D5: 3002    	    JR      NC, KTA_OK
04D7: E61F    	    AND     $1F                 ; Ctrl+C = $03, Ctrl+Z = $1A ...
04D9:         	KTA_OK:
04D9: 32A2FB  	    LD      (KEY_PRESS), A
04DC: 37      	    SCF
04DD: C9      	    RET
              	
04DE:         	KTA_CAPS:
04DE: 3AA3FB  	    LD      A, (CAPS_ON)
04E1: EE01    	    XOR     1
04E3: 32A3FB  	    LD      (CAPS_ON), A
04E6: CD4F04  	    CALL    KBD_IDLE            ; atualiza o LED na hora
04E9:         	KTA_NONE:
04E9: B7      	    OR      A                   ; Carry=0
04EA: C9      	    RET
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  ~10 ms @ 7.3728 MHz, preserva BC
              	; ============================================================
04EB:         	DEBOUNCE:
04EB: C5      	    PUSH    BC
