              	#include "IHEX.asm"
              	
              	
1618:         	loadInit:
1618: 3EFF    	    LD A, $FF
161A: 32FFFB  	    LD (LOAD_FIRST_FLAG), A
              	
161D: 21DC17  	    LD HL, MSG_LOAD_HELP
1620: CD7D17  	    CALL SERIAL_A_PRINT_STRING
              	
1623: 11DE17  	    LD DE, MSG_LOAD_HELP_LCD
1626: CD0E08  	    CALL sendStringToLCD
              	
1629:         	loopHexLoad:
1629: CD5D10  	    CALL RXDATA
              	
162C: FE3A    	    CP   ':'	; ":"?
162E: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
1630: 3AFFFB  		LD   A, (LOAD_FIRST_FLAG)
1633: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
1635: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
1637: 3E01    		LD   A, $01
1639: 32FFFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
163C:         	monitor_do_load:
163C: CD4D16  		CALL    LOAD
163F: CD8617  		CALL SERIAL_A_TXCRLF
1642: C32916  	    JP loopHexLoad
              	
              	
1645:         	CALL_IHEX:
1645: 21B402  		LD HL, MAIN_LOOP
1648: E5      		PUSH HL
1649: CD1816  		CALL loadInit
164C: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
164D:         	LOAD:
164D: 1E00    			LD   E,0	        ; Zera checksum
164F: CD2B17  			CALL GET2	        ; Record Length -> D
1652: 57      			LD   D,A
1653: CD2B17  			CALL GET2	        ; Endereco High -> H
1656: 67      			LD   H,A
1657: CD2B17  			CALL GET2	        ; Endereco Low -> L
165A: 6F      			LD   L,A
165B: CD2B17  			CALL GET2	        ; Record Type -> A
165E: FE01    			CP   $01	        ; EOF record?
1660: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
1662: CD2B17  			CALL GET2	        ; Consome checksum do EOF
1665: 7B      			LD   A,E
1666: A7      			AND  A
1667: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
1669: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
166B:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
166B: 3AFFFB  			LD   A, (LOAD_FIRST_FLAG)
166E: FE01    			CP   $01                    ; e a primeira linha?
1670: 2008    			JR   NZ, LOAD2_SKIP
1672: 3E00    			LD   A, $00
1674: 32FFFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
1677: 2200FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
167A:         	LOAD2_SKIP:
167A: 7A      			LD   A,D	        ; Contador de bytes da linha
167B: A7      			AND  A
167C: 280D    			JR   Z,LOAD3
              	
167E: CD2B17  			CALL GET2	        ; Le proximo byte
1681: 77      			LD   (HL),A	        ; Grava na memoria
1682: 23      			INC  HL
1683: 3E2E    			LD   A,'.'
1685: CD3010  			CALL OUTCH
1688: 15      			DEC  D
1689: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
168B:         	LOAD3:
168B: 2202FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
168E: CD2B17  			CALL GET2	                ; Consome checksum da linha
1691: 7B      			LD   A,E
1692: A7      			AND  A
1693: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
1694:         	LOADERR:
1694: 219117  			LD   HL,CKSUMERR
1697: CD7D17  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
169A: 119117  	        LD   DE, CKSUMERR
169D: CD0E08  	        CALL sendStringToLCD
              	
16A0: E1      	        POP HL
              	
16A1: C9      			RET
              	
16A2:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
16A2: 21A217  			LD   HL, LDETXT
16A5: CD7D17  			CALL SERIAL_A_PRINT_STRING
              	
16A8: 21C117  			LD   HL, msg_load_start
16AB: CD7D17  			CALL SERIAL_A_PRINT_STRING
16AE: 2A00FC  			LD   HL, (LOAD_START_ADDR)
16B1: CD5517  			CALL SERIAL_A_PRINT_HL_HEX
16B4: CD8617  			CALL SERIAL_A_TXCRLF
              	
16B7: 21CA17  			LD   HL, msg_load_end
16BA: CD7D17  			CALL SERIAL_A_PRINT_STRING
16BD: 2A02FC  			LD   HL, (LOAD_END_ADDR)
16C0: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
16C1: CD5517  			CALL SERIAL_A_PRINT_HL_HEX
16C4: CD8617  			CALL SERIAL_A_TXCRLF
              	
16C7: 21D317  			LD   HL, msg_load_total
16CA: CD7D17  			CALL SERIAL_A_PRINT_STRING
16CD: ED5B00FC			LD   DE, (LOAD_START_ADDR)
16D1: 2A02FC  			LD   HL, (LOAD_END_ADDR)
16D4: B7      			OR   A                      ; limpa carry flag
16D5: ED52    			SBC  HL, DE                 ; HL = total de bytes
16D7: CD5517  			CALL SERIAL_A_PRINT_HL_HEX
16DA: CD8617  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
16DD: 11BB17  	        LD   DE, LDETXTLCD
16E0: CD0E08  	        CALL sendStringToLCD
              	
