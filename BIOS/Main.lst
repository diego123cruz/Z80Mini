015A: C3A906  	    JP fillCircle
015D: C31607  	    JP plotToLCD
0160: C34907  	    JP printString
0163: C36A07  	    JP printChars
0166: C3A501  	    JP SET_INT38
0169: C3A901  	    JP SET_INT66
016C: C39107  	    JP setBufClear
016F: C39907  	    JP setBufNoClear
0172: C3D406  	    JP clearPixel
0175: C3E606  	    JP flipPixel
0178: C36809  	    JP drawGraphic
017B: C35009  	    JP invGraphic
017E: C39E07  	    JP initTerminal
0181: C3CB07  	    JP sendCharToLCD
0184: C33B08  	    JP sendStringToLCD
0187: C36208  	    JP sendRegToLCD
018A: C37F08  	    JP sendHLToLCD
018D: C38B08  	    JP setCursor
