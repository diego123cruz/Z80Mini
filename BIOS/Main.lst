105B: D302    		OUT	(SIOA_C),A
              	
105D: 3E03    		LD	A,$03
105F: D302    		OUT	(SIOA_C),A
1061: 3EE1    		LD	A,$E1
1063: D302    		OUT	(SIOA_C),A
              	
1065: 3E05    		LD	A,$05
1067: D302    		OUT	(SIOA_C),A
1069: 3E68    		LD	A, $68
106B: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
106D: 3E04    		LD	A,$04
106F: D303    		OUT	(SIOB_C),A
1071: 3EC4    		LD	A,$C4
1073: D303    		OUT	(SIOB_C),A
              	
1075: 3E03    		LD	A,$03
1077: D303    		OUT	(SIOB_C),A
1079: 3EE1    		LD	A,$E1
107B: D303    		OUT	(SIOB_C),A
              	
107D: 3E05    		LD	A,$05
107F: D303    		OUT	(SIOB_C),A
1081: 3E68    		LD	A, $68
1083: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
1085: 212F27  	    LD HL, WELLCOME
1088: CD9810  	    CALL SNDSTR
              	
108B: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
108C: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
1090: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
1092: DD2AA0FB	INCH:  LD   IX,(GETCH)
1096: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
1098: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
109A: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
109B: FE00    	       CP    00H          ;ZERO TERMINATOR?
109D: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
109F: CD8C10  	       CALL  OUTCH         ;TRANSMIT THE CHAR
10A2: 23      	       INC   HL
10A3: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
10A5: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10A6:         	TXDATA:		
10A6: F5      			PUSH	AF		; Store character
10A7: CDB010  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
10AA: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
10AC: F1      			POP	AF		; RETrieve character
10AD: D300    			OUT	(SIOA_D),A	; OUTput the character
10AF: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10B0:         	CKSIOA
10B0: 97      			SUB	A
10B1: D302    			OUT 	(SIOA_C),A
10B3: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10B5: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10B6: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10B8: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10B9:         	RXDATA:	
10B9:         	waitForChar:
              	        ; Check if there is a char in channel A
10B9: 97      			SUB	A
10BA: D302    			OUT 	(SIOA_C),A
10BC: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10BE: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10BF: 30F8    			JR	NC, waitForChar
10C1: DB00    			IN	A,(SIOA_D)
10C3: B7      			OR A ; clear carry
10C4: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10C5:         	TXDATA_B:		
10C5: F5      			PUSH	AF		; Store character
10C6: CDCF10  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
10C9: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
10CB: F1      			POP	AF		; RETrieve character
10CC: D301    			OUT	(SIOB_D),A	; OUTput the character
10CE: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10CF:         	CKSIOB
10CF: 97      			SUB	A
10D0: D303    			OUT 	(SIOB_C),A
10D2: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10D4: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10D5: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10D7: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10D8:         	RXDATA_B:	
10D8:         	waitForCharB:
              	        ; Check if there is a char in channel A
10D8: 97      			SUB	A
10D9: D303    			OUT 	(SIOB_C),A
10DB: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10DD: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10DE: 30F8    			JR	NC, waitForCharB
10E0: DB01    			IN	A,(SIOB_D)
10E2: B7      			OR A ; clear carry
10E3: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
10E4:         	PARSE_CMD:
10E4: 21A7FB  	            LD   HL, LINEBUF
10E7: CD9C14  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
10EA: 7E      	            LD   A, (HL)
10EB: FE0D    	            CP   CR
10ED: C8      	            RET  Z
10EE: FE00    	            CP   NUL
10F0: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
10F1: CD0815  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
10F4: 212D11  	            LD   HL, CMD_TABLE
10F7:         	CMD_SCAN:
10F7: 7E      	            LD   A, (HL)
10F8: FE00    	            CP   NUL
10FA: CA2611  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
10FD: E5      	            PUSH HL
10FE: 11F7FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
1101: CD2D15  	            CALL STRCMP
1104: E1      	            POP  HL
1105: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
1107:         	SKIP_ENTRY:
1107: 7E      	            LD   A, (HL)
1108: 23      	            INC  HL
1109: FE00    	            CP   NUL
110B: 20FA    	            JR   NZ, SKIP_ENTRY
110D: 23      	            INC  HL                  ; pula high byte do endereço
110E: 23      	            INC  HL                  ; pula low  byte do endereço
110F: C3F710  	            JP   CMD_SCAN
              	
1112:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
1112: 7E      	            LD   A, (HL)
1113: 23      	            INC  HL
1114: FE00    	            CP   NUL
1116: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
1118: 7E      	            LD   A, (HL)
1119: 23      	            INC  HL
111A: 66      	            LD   H, (HL)
111B: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
111C: 11A7FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
111F: CD9514  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
1122: CDA314  	            CALL SKIP_SPACES_DE      ; DE aponta para args
1125: E9      	            JP   (HL)                ; chama handler
              	
1126:         	CMD_UNKNOWN:
1126: 213616  	            LD   HL, MSG_UNKNOWN
1129: CD9304  	            CALL PUTS
112C: C9      	            RET
              	
              	; -------- Tabela de comandos --------
112D:         	CMD_TABLE:
112D: 434C5300	            DB   "CLS",  NUL
1131: 5412    	            DW   CLS_CMD
1133: 44554D50	            DB   "DUMP", NUL
1137: 00      	
1138: 5A12    	            DW   DUMP_CMD
113A: 57524954	            DB   "WRITE", NUL
113E: 4500    	
1140: 9C12    	            DW   LOAD_CMD
1142: 45444954	            DB   "EDIT", NUL
1146: 00      	
1147: F012    	            DW   EDIT_CMD
1149: 4F555400	            DB   "OUT",  NUL
