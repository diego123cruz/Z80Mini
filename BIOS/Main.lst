13FF: 78      	            LD   A, B
1400: FE4F    	            CP   79
1402: 28BE    	            JR   Z, GETLINE_LOOP    ; Início: ignora BS
1404: 2B      	            DEC  HL
1405: 04      	            INC  B
1406: 3E08    	            LD   A, BkS
1408: CD5804  	            CALL PUTCHAR
              	            ;LD   A, SPACE
              	            ;CALL PUTCHAR
