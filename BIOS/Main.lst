              	; **********************************************************************
              	; FS_LOAD_CMD name
              	; **********************************************************************
1F9D:         	FS_LOAD_CMD:
1F9D: CD1023  	    CALL FS_COPY_NAME_FROM_BUFFER
1FA0: DAD325  	    JP C, FS_ABORT
1FA3: CD1305  	    CALL CRLF
1FA6: CD3A25  	    CALL FS_FIND_NAME
1FA9: CAB31F  	    JP Z, FS_LOAD_DO
1FAC: 213C26  	    LD HL, str_notfound
1FAF: CD0305  	    CALL PUTS
1FB2: C9      	    RET
              	
1FB3:         	FS_LOAD_DO:
1FB3: CDD21F  	    CALL FS_DO_LOAD
1FB6: C2B625  	    JP NZ, FS_ERR_I2C
1FB9: 21BB26  	    LD HL, str_loadat
1FBC: CD0305  	    CALL PUTS
1FBF: 3A34FC  	    LD A, (FS_WRKBUF + FS_O_RADRH)
1FC2: CDBE1D  	    CALL HexOut
1FC5: 3A35FC  	    LD A, (FS_WRKBUF + FS_O_RADRL)
1FC8: CDBE1D  	    CALL HexOut
1FCB: 3E68    	    LD A, 'h'
1FCD: CF      	    RST $08
1FCE: CD1305  	    CALL CRLF
1FD1: C9      	    RET
              	
              	; FS_DO_LOAD - carrega arquivo (FS_WRKBUF preenchido)
              	;   On exit: Z=OK  NZ=erro
1FD2:         	FS_DO_LOAD:
1FD2: 3A34FC  	    LD A, (FS_WRKBUF + FS_O_RADRH)
1FD5: 67      	    LD H, A
1FD6: 3A35FC  	    LD A, (FS_WRKBUF + FS_O_RADRL)
1FD9: 6F      	    LD L, A
1FDA: 2253FC  	    LD (FS_TMPRAM), HL      ; destino RAM
1FDD: 3A32FC  	    LD A, (FS_WRKBUF + FS_O_SIZEH)
1FE0: 67      	    LD H, A
1FE1: 3A33FC  	    LD A, (FS_WRKBUF + FS_O_SIZEL)
1FE4: 6F      	    LD L, A
1FE5: 2251FC  	    LD (FS_TMPSZ), HL       ; bytes restantes
1FE8: 3A31FC  	    LD A, (FS_WRKBUF + FS_O_FSTPG)
1FEB: 3255FC  	    LD (FS_CURPG), A
              	
1FEE:         	FS_DL_PG:
1FEE: 3A55FC  	    LD A, (FS_CURPG)
1FF1: B7      	    OR A
1FF2: 2848    	    JR Z, FS_DL_DONE
              	
              	    ; Le byte 0 (next page)
1FF4: 57      	    LD D, A
1FF5: 1E00    	    LD E, 0
1FF7: 2150FC  	    LD HL, FS_TMP1
1FFA: 010100  	    LD BC, 1
1FFD: CD4F1D  	    CALL I2C_MemRd
2000: C0      	    RET NZ
              	
              	    ; min(FS_TMPSZ, 255) bytes a ler
2001: 2A51FC  	    LD HL, (FS_TMPSZ)
2004: 7C      	    LD A, H
2005: B7      	    OR A
2006: 2005    	    JR NZ, FS_DL_255
2008: 7D      	    LD A, L
2009: FEFF    	    CP FS_DATAPG
200B: 3805    	    JR C, FS_DL_LT
200D:         	FS_DL_255:
200D: 01FF00  	    LD BC, FS_DATAPG
2010: 1803    	    JR FS_DL_RD
2012:         	FS_DL_LT:
2012: 0600    	    LD B, 0
2014: 4D      	    LD C, L
              	
2015:         	FS_DL_RD:
              	    ; BC=bytes, DE=pag*256+1, HL=destino
2015: C5      	    PUSH BC
2016: 3A55FC  	    LD A, (FS_CURPG)
2019: 57      	    LD D, A
201A: 1E01    	    LD E, 1
201C: 2A53FC  	    LD HL, (FS_TMPRAM)
201F: CD4F1D  	    CALL I2C_MemRd
2022: C1      	    POP BC
2023: C0      	    RET NZ
              	
              	    ; Atualiza ponteiros
2024: 2A53FC  	    LD HL, (FS_TMPRAM)
2027: 09      	    ADD HL, BC
2028: 2253FC  	    LD (FS_TMPRAM), HL
202B: 2A51FC  	    LD HL, (FS_TMPSZ)
202E: B7      	    OR A                    ; limpa carry
202F: ED42    	    SBC HL, BC
2031: 2251FC  	    LD (FS_TMPSZ), HL
              	
              	    ; Proxima pagina
2034: 3A50FC  	    LD A, (FS_TMP1)
2037: 3255FC  	    LD (FS_CURPG), A
203A: 18B2    	    JR FS_DL_PG
              	
203C:         	FS_DL_DONE:
203C: AF      	    XOR A
203D: C9      	    RET
              	
              	 
              	
              	; **********************************************************************
              	; FS_MKDIR
              	; 
              	; mkdir name
              	; **********************************************************************
203E:         	FS_MKDIR:
203E: CD1023  	    CALL FS_COPY_NAME_FROM_BUFFER
2041: DAD325  	    JP C, FS_ABORT
              	    
2044: CD1305  	    CALL CRLF
              	
              	    ; Nome ja existe?
2047: CD3A25  	    CALL FS_FIND_NAME
204A: CA5620  	    JP Z, FS_EXISTS_F
204D: CD6623  	    CALL FS_FIND_FREE
2050: C2C525  	    JP NZ, FS_ERR_FULL
2053: C35A20  	    JP FS_MKD_DO
              	
2056:         	FS_EXISTS_F:
2056: CDDA25  	    CALL FS_ERR_FOLDER_EXIST
2059: C9      	    RET
              	
205A:         	FS_MKD_DO:
205A: 3A20FC  	    LD A, (FS_CUR)
205D: 3256FC  	    LD (FS_SLOTBK), A
              	
              	    ; Zera e monta FS_WRKBUF
2060: 2121FC  	    LD HL, FS_WRKBUF
2063: 0620    	    LD B, FS_ENTRY_SZ
2065: AF      	    XOR A
2066:         	FS_MKD_CLR:
2066: 77      	    LD (HL), A
2067: 23      	    INC HL
2068: 10FC    	    DJNZ FS_MKD_CLR
              	    ; Monta nome FS_NAMBUF -> FS_WRKBUF
206A: 2141FC  	    LD HL, FS_NAMBUF
206D: DD2121FC	    LD IX, FS_WRKBUF
2071: 0610    	    LD B, FS_NAME_SZ
2073:         	FS_MKD_NM:
2073: 7E      	    LD A, (HL)
2074: DD7700  	    LD (IX+0), A
2077: DD23    	    INC IX
2079: 23      	    INC HL
207A: 10F7    	    DJNZ FS_MKD_NM
              	
207C: 21FF00  	    LD HL, $00FF ; Size 256 (Tamanho da pasta sempre eh 256)
207F: 7C      	    LD A, H
2080: 3232FC  	    LD (FS_WRKBUF + FS_O_SIZEH), A
2083: 7D      	    LD A, L
2084: 3233FC  	    LD (FS_WRKBUF + FS_O_SIZEL), A
2087: 210000  	    LD HL, $0000 ; Ram nao precisa entao 0000
208A: 7C      	    LD A, H
208B: 3234FC  	    LD (FS_WRKBUF + FS_O_RADRH), A
208E: 7D      	    LD A, L
208F: 3235FC  	    LD (FS_WRKBUF + FS_O_RADRL), A
2092: 3E02    	    LD A, FS_FLAG_USED_FOLDER   ; Flag de uso para pasta
2094: 3236FC  	    LD (FS_WRKBUF + FS_O_FLAGS), A
              	
              	    ; Aloca primeira pagina
2097: CD9123  	    CALL FS_ALLOC_PG
209A: CACC25  	    JP Z, FS_ERR_NOSPACE
209D: 3231FC  	    LD (FS_WRKBUF + FS_O_FSTPG), A
20A0: 3255FC  	    LD (FS_CURPG), A
              	
20A3: 2EFF    	    LD L, $FF ; fill byte
20A5: 01FF00  	    LD BC, $00FF ; size bytes
20A8: 3A55FC  	    LD A, (FS_CURPG)
20AB: 1E00    	    LD E, 0
20AD: 57      	    LD D, A
20AE: CD191D  	    CALL I2C_MemFill
              	
              	    ; fix del pasta vazia quando nao criou nenhum arquivo
20B1: 2E00    	    LD L, $00 ; fill byte - zera primeiro byte do nome
20B3: 010100  	    LD BC, $0001 ; size bytes
20B6: 3A55FC  	    LD A, (FS_CURPG)
20B9: 1E00    	    LD E, 0
20BB: 57      	    LD D, A
20BC: CD191D  	    CALL I2C_MemFill
              	
20BF: C2B625  	    JP NZ, FS_ERR_I2C
20C2:         	FS_MKD_DONE:
