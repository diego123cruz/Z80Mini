14F9: FE4F    	            CP   79
14FB: 28BE    	            JR   Z, GETLINE_LOOP    ; Início: ignora BS
14FD: 2B      	            DEC  HL
14FE: 04      	            INC  B
14FF: 3E08    	            LD   A, BkS
1501: CDF704  	            CALL PUTCHAR
              	            ;LD   A, SPACE
              	            ;CALL PUTCHAR
              	            ;LD   A, BkS
              	            ;CALL PUTCHAR
1504: 18B5    	            JR   GETLINE_LOOP
