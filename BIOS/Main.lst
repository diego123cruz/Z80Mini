105A: 01      	        .db 00000001b   ;      #
              	#include "SERIAL.asm"
              	; Inicializa SIO/2 Serial 115200
105B:         	initSerial:
105B: 21B810  	    LD    HL,TXDATA
105E: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
1061: 21CB10  	    LD    HL,RXDATA
1064: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
              	
              	
              	    ;	Initialise SIO/2 A - Onboard USB
1067: 3E04    		LD	A,$04
1069: D302    		OUT	(SIOA_C),A
106B: 3EC4    		LD	A,$C4
106D: D302    		OUT	(SIOA_C),A
              	
106F: 3E03    		LD	A,$03
1071: D302    		OUT	(SIOA_C),A
1073: 3EE1    		LD	A,$E1
1075: D302    		OUT	(SIOA_C),A
              	
1077: 3E05    		LD	A,$05
1079: D302    		OUT	(SIOA_C),A
107B: 3E68    		LD	A, $68
107D: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
107F: 3E04    		LD	A,$04
1081: D303    		OUT	(SIOB_C),A
1083: 3EC4    		LD	A,$C4
1085: D303    		OUT	(SIOB_C),A
              	
1087: 3E03    		LD	A,$03
1089: D303    		OUT	(SIOB_C),A
108B: 3EE1    		LD	A,$E1
108D: D303    		OUT	(SIOB_C),A
              	
108F: 3E05    		LD	A,$05
1091: D303    		OUT	(SIOB_C),A
1093: 3E68    		LD	A, $68
1095: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
1097: 215B27  	    LD HL, WELLCOME
109A: CDAA10  	    CALL SNDSTR
              	
109D: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
109E: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
10A2: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
10A4: DD2AA0FB	INCH:  LD   IX,(GETCH)
10A8: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
10AA: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
10AC: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
10AD: FE00    	       CP    00H          ;ZERO TERMINATOR?
10AF: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
10B1: CD9E10  	       CALL  OUTCH         ;TRANSMIT THE CHAR
10B4: 23      	       INC   HL
10B5: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
10B7: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10B8:         	TXDATA:		
10B8: F5      			PUSH	AF		; Store character
10B9: CDC210  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
10BC: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
10BE: F1      			POP	AF		; RETrieve character
10BF: D300    			OUT	(SIOA_D),A	; OUTput the character
10C1: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10C2:         	CKSIOA
10C2: 97      			SUB	A
10C3: D302    			OUT 	(SIOA_C),A
10C5: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10C7: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10C8: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10CA: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10CB:         	RXDATA:	
10CB:         	waitForChar:
              	        ; Check if there is a char in channel A
10CB: 97      			SUB	A
10CC: D302    			OUT 	(SIOA_C),A
10CE: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10D0: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10D1: 30F8    			JR	NC, waitForChar
10D3: DB00    			IN	A,(SIOA_D)
10D5: B7      			OR A ; clear carry
10D6: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10D7:         	TXDATA_B:		
10D7: F5      			PUSH	AF		; Store character
10D8: CDE110  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
10DB: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
10DD: F1      			POP	AF		; RETrieve character
10DE: D301    			OUT	(SIOB_D),A	; OUTput the character
10E0: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10E1:         	CKSIOB
10E1: 97      			SUB	A
10E2: D303    			OUT 	(SIOB_C),A
10E4: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10E6: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10E7: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10E9: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10EA:         	RXDATA_B:	
10EA:         	waitForCharB:
              	        ; Check if there is a char in channel A
10EA: 97      			SUB	A
10EB: D303    			OUT 	(SIOB_C),A
10ED: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10EF: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10F0: 30F8    			JR	NC, waitForCharB
10F2: DB01    			IN	A,(SIOB_D)
10F4: B7      			OR A ; clear carry
10F5: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
10F6:         	PARSE_CMD:
10F6: 21A7FB  	            LD   HL, LINEBUF
10F9: CDB614  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
10FC: 7E      	            LD   A, (HL)
10FD: FE0D    	            CP   CR
10FF: C8      	            RET  Z
1100: FE00    	            CP   NUL
1102: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
1103: CD2215  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
1106: 213F11  	            LD   HL, CMD_TABLE
1109:         	CMD_SCAN:
1109: 7E      	            LD   A, (HL)
110A: FE00    	            CP   NUL
110C: CA3811  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
110F: E5      	            PUSH HL
1110: 11F7FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
1113: CD4715  	            CALL STRCMP
1116: E1      	            POP  HL
1117: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
1119:         	SKIP_ENTRY:
1119: 7E      	            LD   A, (HL)
111A: 23      	            INC  HL
111B: FE00    	            CP   NUL
111D: 20FA    	            JR   NZ, SKIP_ENTRY
111F: 23      	            INC  HL                  ; pula high byte do endereço
1120: 23      	            INC  HL                  ; pula low  byte do endereço
1121: C30911  	            JP   CMD_SCAN
              	
1124:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
1124: 7E      	            LD   A, (HL)
1125: 23      	            INC  HL
1126: FE00    	            CP   NUL
1128: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
112A: 7E      	            LD   A, (HL)
112B: 23      	            INC  HL
112C: 66      	            LD   H, (HL)
112D: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
112E: 11A7FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
1131: CDAF14  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
1134: CDBD14  	            CALL SKIP_SPACES_DE      ; DE aponta para args
1137: E9      	            JP   (HL)                ; chama handler
              	
1138:         	CMD_UNKNOWN:
1138: 215016  	            LD   HL, MSG_UNKNOWN
113B: CDA504  	            CALL PUTS
113E: C9      	            RET
              	
              	; -------- Tabela de comandos --------
