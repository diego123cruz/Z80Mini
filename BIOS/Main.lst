15EE: CD671A  	    CALL I2C_Close               ; garante que o barramento nao trava
15F1: AF      	    XOR A
15F2: 3243FD  	    LD  (I2C_STATE), A
15F5: F1      	    POP AF
15F6: 211816  	    LD  HL, MSG_I2C_NOACK
15F9: CD9304  	    CALL PUTS
15FC: C9      	    RET
              	
