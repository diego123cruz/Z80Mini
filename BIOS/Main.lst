              	; Fill a block I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             L = BYTE to Fill
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; pages.
1C9E: C5      	I2C_MemFill:  PUSH BC
1C9F: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CA2:         	I2C_MemFillRepeat:    
1CA2: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CA5: CD601A  	            CALL I2C_Open       ;Open for write
1CA8: 280A    	            JR   Z,I2C_MemFillReady       ;If open okay then skip on
1CAA: 0B      	            DEC  BC
1CAB: 78      	            LD   A,B
1CAC: B1      	            OR   C              ;Timeout?
1CAD: 20F3    	            JR   NZ,I2C_MemFillRepeat     ;No, so go try again
1CAF: C1      	            POP  BC
1CB0: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CB2: B7      	            OR   A              ;Error, so NZ flagged
1CB3: C9      	            RET                 ;Return with error
              	; Device opened okay
1CB4: C1      	I2C_MemFillReady:     POP  BC             ;Restore byte counter
1CB5: 7A      	I2C_MemFillBlock:     LD   A,D            ;Address (hi) in I2C memory
1CB6: CD741A  	            CALL I2C_Write      ;Write address
1CB9: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CBA: CD741A  	            CALL I2C_Write      ;Write address
1CBD: 7D      	I2C_MemFillWrite:     LD   A, L         ;Get data byte to fill
1CBE: CD741A  	            CALL I2C_Write      ;Read byte from I2C memory
1CC1: 13      	            INC  DE             ;Increment I2C memory pointer
1CC2: 0B      	            DEC  BC             ;Decrement byte counter
1CC3: 78      	            LD   A,B
1CC4: B1      	            OR   C              ;Finished?
1CC5: 2805    	            JR   Z,I2C_MemFillStore       ;Yes, so go store this page
1CC7: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1CC8: E63F    	            AND  63             ;64 byte page boundary?
1CCA: 20F1    	            JR   NZ,I2C_MemFillWrite      ;No, so go write another byte
1CCC: CDE91A  	I2C_MemFillStore:     CALL I2C_Stop       ;Generate I2C stop
1CCF: 78      	            LD   A,B
1CD0: B1      	            OR   C              ;Finished?
1CD1: 20CB    	            JR   NZ,I2C_MemFill   ;No, so go write some more
1CD3: C9      	            RET  
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1CD4: C5      	I2C_MemRd:  PUSH BC
1CD5: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CD8:         	I2C_MemRdRepeat:    
1CD8: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CDB: CD601A  	            CALL I2C_Open       ;Open for write
1CDE: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
1CE0: 0B      	            DEC  BC
1CE1: 78      	            LD   A,B
1CE2: B1      	            OR   C              ;Timeout?
1CE3: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1CE5: C1      	            POP  BC
1CE6: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CE8: B7      	            OR   A              ;Error, so NZ flagged
1CE9: C9      	            RET                 ;Return with error
              	; Device opened okay
1CEA: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1CEB: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1CEC: CD741A  	            CALL I2C_Write      ;Write address
1CEF: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CF0: CD741A  	            CALL I2C_Write      ;Write address
1CF3: 3A04FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1CF6: 3C      	            INC  A              ; Device read equal DeviceId+1
1CF7: CD601A  	            CALL I2C_Open       ;Open for read
1CFA: C0      	            RET  NZ             ;Abort if error
1CFB: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1CFC: 78      	            LD   A,B
1CFD: B1      	            OR   C              ;Last byte to be read?
1CFE: CDB11A  	            CALL I2C_Read       ;Read byte with no ack on last byte
1D01: 77      	            LD   (HL),A         ;Write byte in CPU memory
1D02: 23      	            INC  HL             ;Increment CPU memory pointer
1D03: 78      	            LD   A,B
1D04: B1      	            OR   C              ;Finished?
1D05: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1D07: CDE91A  	            CALL I2C_Stop       ;Generate I2C stop
1D0A: AF      	            XOR  A              ;Return with success (Z flagged)
1D0B: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1D0C: C5      	I2C_MemWr:  PUSH BC
1D0D: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D10:         	I2C_MemWrRepeat:    
1D10: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D13: CD601A  	            CALL I2C_Open       ;Open for write
1D16: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1D18: 0B      	            DEC  BC
1D19: 78      	            LD   A,B
1D1A: B1      	            OR   C              ;Timeout?
1D1B: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1D1D: C1      	            POP  BC
1D1E: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D20: B7      	            OR   A              ;Error, so NZ flagged
1D21: C9      	            RET                 ;Return with error
              	; Device opened okay
1D22: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1D23: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1D24: CD741A  	            CALL I2C_Write      ;Write address
1D27: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D28: CD741A  	            CALL I2C_Write      ;Write address
1D2B: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1D2C: CD741A  	            CALL I2C_Write      ;Read byte from I2C memory
1D2F: 23      	            INC  HL             ;Increment CPU memory pointer
1D30: 13      	            INC  DE             ;Increment I2C memory pointer
1D31: 0B      	            DEC  BC             ;Decrement byte counter
1D32: 78      	            LD   A,B
1D33: B1      	            OR   C              ;Finished?
1D34: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1D36: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1D37: E63F    	            AND  63             ;64 byte page boundary?
1D39: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1D3B: CDE91A  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1D3E: 78      	            LD   A,B
1D3F: B1      	            OR   C              ;Finished?
1D40: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1D42: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1D43: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1D44: 1F      	            RRA                 ;Shift top nibble to
1D45: 1F      	            RRA                 ;  botom four bits..
1D46: 1F      	            RRA
1D47: 1F      	            RRA
1D48: E60F    	            AND  $0F           ;Mask off unwanted bits
1D4A: CD501D  	            CALL HexOutHex           ;Output hi nibble
1D4D: F1      	            POP  AF             ;Restore byte to be output
1D4E: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1D50: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1D52: 3802    	            JR   C,HexOutSkip        ;No, so skip
1D54: C607    	            ADD  A,7            ;Yes, so add 7
1D56: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1D58: CD8704  	            CALL CONOUT       ;Write character
1D5B: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5        ; Assinatura da EEPROM formatada
0000:         	FS_PG_BMP:  .EQU $00        ; Número da página do bitmap
0001:         	FS_PG_DIR:  .EQU $01        ; Número da página do diretório
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8          ; Máximo de arquivos
0020:         	FS_ENTRY_SZ:.EQU 32         ; Bytes por entrada do diretório
0010:         	FS_NAME_SZ: .EQU 16         ; Bytes do nome
00FF:         	FS_DATAPG:  .EQU 255        ; Bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF      ; Slot do diretório livre
0001:         	FS_FLAG_USED: .EQU $01      ; Slot do diretório usado - File
0002:         	FS_FLAG_USED_FOLDER: .EQU $02      ; Slot do diretório usado - Folder
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0          ; Nome (16 bytes)
0010:         	FS_O_FSTPG: .EQU 16         ; Primeira página de dados
0011:         	FS_O_SIZEH: .EQU 17         ; Tamanho hi
0012:         	FS_O_SIZEL: .EQU 18         ; Tamanho lo
0013:         	FS_O_RADRH: .EQU 19         ; Load RAM hi
0014:         	FS_O_RADRL: .EQU 20         ; Load RAM lo
0015:         	FS_O_FLAGS: .EQU 21         ; Flags ($FF=livre, $01=usado por arquivo, $02=usado por pasta)
              	
              	
              	
              	
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; FS_INFO - Espaco usado/livre da EEPROM
              	;   Le bitmap, conta paginas, imprime barra e valores
              	; **********************************************************************
1D5C:         	FS_INFO:
1D5C: CDA304  	    CALL CRLF
1D5F: 21B226  	    LD HL, str_info_hdr
1D62: CD9304  	    CALL PUTS
              	
              	    ; Le 16 bytes do bitmap (bytes 1..16 da pagina 0)
1D65: 110100  	    LD DE, $0001
1D68: 2142FC  	    LD HL, PG_BUF
1D6B: 011000  	    LD BC, 16
1D6E: CDD41C  	    CALL I2C_MemRd
1D71: C22D25  	    JP NZ, FS_ERR_I2C
              	
              	    ; Conta paginas livres (bits=1) → C
1D74: 2142FC  	    LD HL, PG_BUF
1D77: 0610    	    LD B, 16
1D79: 0E00    	    LD C, 0
1D7B:         	FS_INF_CNT:
1D7B: 7E      	    LD A, (HL)
1D7C: 23      	    INC HL
1D7D: 1608    	    LD D, 8
1D7F:         	FS_INF_BIT:
1D7F: 0F      	    RRCA
1D80: 3001    	    JR NC, FS_INF_NB
1D82: 0C      	    INC C
1D83:         	FS_INF_NB:
1D83: 15      	    DEC D
1D84: 20F9    	    JR NZ, FS_INF_BIT
1D86: 10F3    	    DJNZ FS_INF_CNT
              	
              	    ; C = pags livres (0..126)
              	    ; paginas usadas = 126 - C → salva em E
1D88: 3E7E    	    LD A, 126
1D8A: 91      	    SUB C
1D8B: 5F      	    LD E, A                 ; E = paginas usadas
              	
              	    ; === Linha 1: barra visual ===
              	    ; Formato: "[##########..........] UUh/7Eh pags"
              	    ; Barra de 19 chars: cada char = ~6.6 pags
              	    ; chars_usados = E * 19 / 126
              	    ;   = E / 6  (aproximacao boa o suficiente para barra)
1D8C: 7B      	    LD A, E
1D8D: 0600    	    LD B, 0                 ; B = chars usados
1D8F:         	FS_INF_DIV6:
1D8F: FE06    	    CP 6
1D91: 3805    	    JR C, FS_INF_DIV6_DONE
1D93: D606    	    SUB 6
1D95: 04      	    INC B
1D96: 18F7    	    JR FS_INF_DIV6
1D98:         	FS_INF_DIV6_DONE:
              	    ; B = chars usados (0..21, clamp a 20)
1D98: 78      	    LD A, B
1D99: FE15    	    CP 21
1D9B: 3802    	    JR C, FS_INF_CLAMP
1D9D: 0613    	    LD B, 19
1D9F:         	FS_INF_CLAMP:
              	
1D9F: 3E5B    	    LD A, '['
1DA1: CF      	    RST $08
              	
              	    ; Imprime B x '#' (usado)
1DA2: 78      	    LD A, B
1DA3: B7      	    OR A
1DA4: 2808    	    JR Z, FS_INF_NO_HASH
1DA6: C5      	    PUSH BC
1DA7: 47      	    LD B, A
1DA8:         	FS_INF_HASH:
1DA8: 3E23    	    LD A, '#'
1DAA: CF      	    RST $08
1DAB: 10FB    	    DJNZ FS_INF_HASH
1DAD: C1      	    POP BC
              	
1DAE:         	FS_INF_NO_HASH:
              	    ; Imprime (20-B) x '.' (livre)
1DAE: 3E13    	    LD A, 19
1DB0: 90      	    SUB B
1DB1: 2806    	    JR Z, FS_INF_NO_DOT
1DB3: 47      	    LD B, A
1DB4:         	FS_INF_DOT:
1DB4: 3E2E    	    LD A, '.'
1DB6: CF      	    RST $08
1DB7: 10FB    	    DJNZ FS_INF_DOT
1DB9:         	FS_INF_NO_DOT:
              	
1DB9: 3E5D    	    LD A, ']'
1DBB: CF      	    RST $08
1DBC: 3E20    	    LD A, ' '
1DBE: CF      	    RST $08
              	
              	    ; Imprime "UUh/7Eh pags"
1DBF: 7B      	    LD A, E                 ; A = usadas
1DC0: CD431D  	    CALL HexOut
1DC3: 3E68    	    LD A, 'h'
1DC5: CF      	    RST $08
1DC6: 3E2F    	    LD A, '/'
1DC8: CF      	    RST $08
1DC9: 3E7E    	    LD A, $7E               ; 126
1DCB: CD431D  	    CALL HexOut
1DCE: 3E68    	    LD A, 'h'
1DD0: CF      	    RST $08
1DD1: 21C926  	    LD HL, str_inf_pags
1DD4: CD9304  	    CALL PUTS
              	
              	    ; === Linha 2: Usadas ===
1DD7: 21D126  	    LD HL, str_inf_used
1DDA: CD9304  	    CALL PUTS
1DDD: 7B      	    LD A, E
1DDE: CD431D  	    CALL HexOut
1DE1: 3E68    	    LD A, 'h'
1DE3: CF      	    RST $08
1DE4: 21E126  	    LD HL, str_inf_pags_nl
1DE7: CD9304  	    CALL PUTS
1DEA: CDA304  	    CALL CRLF
1DED: 3E20    	    LD A, ' '
1DEF: CF      	    RST $08
              	
              	    ; Bytes usados aprox: E * 255  (E = paginas usadas)
              	    ; Salva C (paginas livres) em RAM antes do loop destruir C
1DF0: 79      	    LD A, C
1DF1: 3241FC  	    LD (FS_INFOTMP), A      ; salva pags livres
              	
1DF4: 210000  	    LD HL, 0
1DF7: 7B      	    LD A, E
1DF8: B7      	    OR A
1DF9: 2807    	    JR Z, FS_INF_BYTES_DONE_U
1DFB:         	FS_INF_BYTES_USED:
1DFB: 01FF00  	    LD BC, FS_DATAPG        ; C destruido aqui - mas ja salvamos
1DFE: 09      	    ADD HL, BC
1DFF: 1D      	    DEC E
1E00: 20F9    	    JR NZ, FS_INF_BYTES_USED
1E02:         	FS_INF_BYTES_DONE_U:
1E02: 7C      	    LD A, H
1E03: CD431D  	    CALL HexOut
1E06: 7D      	    LD A, L
1E07: CD431D  	    CALL HexOut
1E0A: 3E68    	    LD A, 'h'
1E0C: CF      	    RST $08
1E0D: 21E826  	    LD HL, str_inf_bytes_nl
1E10: CD9304  	    CALL PUTS
              	
              	    ; Recupera paginas livres
1E13: 3A41FC  	    LD A, (FS_INFOTMP)
1E16: 4F      	    LD C, A                 ; C = paginas livres restaurado
              	
              	    ; === Linha 3: Livres ===
1E17: 21D926  	    LD HL, str_inf_free
1E1A: CD9304  	    CALL PUTS
1E1D: 79      	    LD A, C
1E1E: CD431D  	    CALL HexOut
1E21: 3E68    	    LD A, 'h'
1E23: CF      	    RST $08
1E24: 21E126  	    LD HL, str_inf_pags_nl
1E27: CD9304  	    CALL PUTS
1E2A: CDA304  	    CALL CRLF
1E2D: 3E20    	    LD A, ' '
1E2F: CF      	    RST $08
              	
              	    ; Bytes livres aprox: C * 255
1E30: 210000  	    LD HL, 0
1E33: 79      	    LD A, C
1E34: B7      	    OR A
1E35: 2808    	    JR Z, FS_INF_BYTES_DONE_F
1E37: 59      	    LD E, C
1E38:         	FS_INF_BYTES_FREE:
1E38: 01FF00  	    LD BC, FS_DATAPG
1E3B: 09      	    ADD HL, BC
1E3C: 1D      	    DEC E
1E3D: 20F9    	    JR NZ, FS_INF_BYTES_FREE
1E3F:         	FS_INF_BYTES_DONE_F:
1E3F: 7C      	    LD A, H
1E40: CD431D  	    CALL HexOut
1E43: 7D      	    LD A, L
1E44: CD431D  	    CALL HexOut
1E47: 3E68    	    LD A, 'h'
1E49: CF      	    RST $08
1E4A: 21E826  	    LD HL, str_inf_bytes_nl
1E4D: CD9304  	    CALL PUTS
1E50: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; FS_DIR
              	; **********************************************************************
1E51:         	FS_DIR:
1E51: CDA304  	    CALL CRLF
1E54: 3E5B    	    LD A, '['
1E56: CF      	    RST $08
1E57: 0611    	    LD B, FS_NAME_SZ + 1
1E59: 2145FD  	    LD HL, FS_DIR_NAME
1E5C:         	FS_S_DIR:
1E5C: 7E      	    LD A, (HL)
1E5D: FE00    	    CP 0
1E5F: CA661E  	    JP Z, FS_S_DIR_F
1E62: 23      	    INC HL
1E63: CF      	    RST $08
1E64: 10F6    	    djnz FS_S_DIR
1E66:         	FS_S_DIR_F:
1E66: 3E5D    	    LD A, ']'
1E68: CF      	    RST $08
              	
1E69: 3E01    	    LD A, 1
1E6B: CD9309  	    CALL plotAlways
              	
1E6E: CDA304  	    CALL CRLF
              	    ;LD HL, str_dir_hdr
              	    ;CALL PUTS
1E71: AF      	    XOR A
1E72: 3209FC  	    LD (FS_CUR), A
1E75: 0608    	    LD B, FS_MAXFILES
1E77: 0E00    	    LD C, 0
1E79:         	FS_DIR_LOOP:
1E79: C5      	    PUSH BC
1E7A: CDA322  	    CALL FS_RD_ENTRY
1E7D: C23425  	    JP NZ, FS_ERR_I2C_POP
1E80: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
1E83: FEFF    	    CP FS_FLAG_FREE
1E85: 2827    	    JR Z, FS_DIR_SKIP
