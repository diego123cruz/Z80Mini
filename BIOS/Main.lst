1053: 00      	        .db 00000000b   ; 
              	        ;255
1054: 00      	        .db 00000000b   ; 
1055: 00      	        .db 00000000b   ; 
1056: 00      	        .db 00000000b   ; 
1057: 00      	        .db 00000000b   ; 
1058: 00      	        .db 00000000b   ; 
1059: 00      	        .db 00000000b   ; 
              	        ;256
105A: 00      	        .db 00000000b   ; 
105B: 00      	        .db 00000000b   ; 
105C: 00      	        .db 00000000b   ; 
105D: 00      	        .db 00000000b   ; 
105E: 00      	        .db 00000000b   ; 
105F: 01      	        .db 00000001b   ;      #
              	#include "SERIAL.asm"
              	; Inicializa SIO/2 Serial 115200
1060:         	initSerial:
1060: 21BD10  	    LD    HL,TXDATA
1063: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
1066: 21D010  	    LD    HL,RXDATA
1069: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
              	
              	
              	    ;	Initialise SIO/2 A - Onboard USB
106C: 3E04    		LD	A,$04
106E: D302    		OUT	(SIOA_C),A
1070: 3EC4    		LD	A,$C4
1072: D302    		OUT	(SIOA_C),A
              	
1074: 3E03    		LD	A,$03
1076: D302    		OUT	(SIOA_C),A
1078: 3EE1    		LD	A,$E1
107A: D302    		OUT	(SIOA_C),A
              	
107C: 3E05    		LD	A,$05
107E: D302    		OUT	(SIOA_C),A
1080: 3E68    		LD	A, $68
1082: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
1084: 3E04    		LD	A,$04
1086: D303    		OUT	(SIOB_C),A
1088: 3EC4    		LD	A,$C4
108A: D303    		OUT	(SIOB_C),A
              	
108C: 3E03    		LD	A,$03
108E: D303    		OUT	(SIOB_C),A
1090: 3EE1    		LD	A,$E1
1092: D303    		OUT	(SIOB_C),A
              	
1094: 3E05    		LD	A,$05
1096: D303    		OUT	(SIOB_C),A
1098: 3E68    		LD	A, $68
109A: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
109C: 216027  	    LD HL, WELLCOME
109F: CDAF10  	    CALL SNDSTR
              	
10A2: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
10A3: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
10A7: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
10A9: DD2AA0FB	INCH:  LD   IX,(GETCH)
10AD: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
10AF: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
10B1: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
10B2: FE00    	       CP    00H          ;ZERO TERMINATOR?
10B4: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
10B6: CDA310  	       CALL  OUTCH         ;TRANSMIT THE CHAR
10B9: 23      	       INC   HL
10BA: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
10BC: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10BD:         	TXDATA:		
10BD: F5      			PUSH	AF		; Store character
10BE: CDC710  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
10C1: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
10C3: F1      			POP	AF		; RETrieve character
10C4: D300    			OUT	(SIOA_D),A	; OUTput the character
10C6: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10C7:         	CKSIOA
10C7: 97      			SUB	A
10C8: D302    			OUT 	(SIOA_C),A
10CA: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10CC: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10CD: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10CF: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10D0:         	RXDATA:	
10D0:         	waitForChar:
              	        ; Check if there is a char in channel A
10D0: 97      			SUB	A
10D1: D302    			OUT 	(SIOA_C),A
10D3: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10D5: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10D6: 30F8    			JR	NC, waitForChar
10D8: DB00    			IN	A,(SIOA_D)
10DA: B7      			OR A ; clear carry
10DB: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10DC:         	TXDATA_B:		
10DC: F5      			PUSH	AF		; Store character
10DD: CDE610  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
10E0: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
10E2: F1      			POP	AF		; RETrieve character
10E3: D301    			OUT	(SIOB_D),A	; OUTput the character
10E5: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10E6:         	CKSIOB
10E6: 97      			SUB	A
10E7: D303    			OUT 	(SIOB_C),A
10E9: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10EB: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10EC: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10EE: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10EF:         	RXDATA_B:	
10EF:         	waitForCharB:
              	        ; Check if there is a char in channel A
10EF: 97      			SUB	A
10F0: D303    			OUT 	(SIOB_C),A
10F2: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10F4: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10F5: 30F8    			JR	NC, waitForCharB
10F7: DB01    			IN	A,(SIOB_D)
10F9: B7      			OR A ; clear carry
10FA: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
10FB:         	PARSE_CMD:
10FB: 21A5FB  	            LD   HL, LINEBUF
10FE: CDBB14  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
1101: 7E      	            LD   A, (HL)
1102: FE0D    	            CP   CR
1104: C8      	            RET  Z
1105: FE00    	            CP   NUL
1107: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
1108: CD2715  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
110B: 214411  	            LD   HL, CMD_TABLE
110E:         	CMD_SCAN:
110E: 7E      	            LD   A, (HL)
110F: FE00    	            CP   NUL
1111: CA3D11  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
1114: E5      	            PUSH HL
1115: 11F5FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
1118: CD4C15  	            CALL STRCMP
111B: E1      	            POP  HL
111C: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
111E:         	SKIP_ENTRY:
111E: 7E      	            LD   A, (HL)
111F: 23      	            INC  HL
1120: FE00    	            CP   NUL
1122: 20FA    	            JR   NZ, SKIP_ENTRY
1124: 23      	            INC  HL                  ; pula high byte do endereço
1125: 23      	            INC  HL                  ; pula low  byte do endereço
1126: C30E11  	            JP   CMD_SCAN
              	
1129:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
1129: 7E      	            LD   A, (HL)
112A: 23      	            INC  HL
112B: FE00    	            CP   NUL
112D: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
112F: 7E      	            LD   A, (HL)
1130: 23      	            INC  HL
1131: 66      	            LD   H, (HL)
1132: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
1133: 11A5FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
1136: CDB414  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
1139: CDC214  	            CALL SKIP_SPACES_DE      ; DE aponta para args
113C: E9      	            JP   (HL)                ; chama handler
              	
113D:         	CMD_UNKNOWN:
113D: 215516  	            LD   HL, MSG_UNKNOWN
1140: CDAB04  	            CALL PUTS
1143: C9      	            RET
              	
              	; -------- Tabela de comandos --------
