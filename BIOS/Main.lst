              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
2468: DD2A3CFC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
246C: 5A      	    LD E, D                 ; E = contador de copia
246D:         	FS_WP_CPLOOP:
246D: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
2470: 77      	    LD (HL), A              ; grava no PG_BUF
2471: DD23    	    INC IX
2473: 23      	    INC HL
2474: 1D      	    DEC E
2475: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
2477: 3EFF    	    LD A, FS_DATAPG         ; 255
2479: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
247A: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
247C: 5F      	    LD E, A
247D:         	FS_WP_PADLOOP:
247D: 36FF    	    LD (HL), $FF
247F: 23      	    INC HL
2480: 1D      	    DEC E
2481: 20FA    	    JR NZ, FS_WP_PADLOOP
2483:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
2483: F1      	    POP AF                  ; A = numero da pagina
2484: F5      	    PUSH AF
2485: 57      	    LD D, A
2486: 1E00    	    LD E, 0
2488: 2142FC  	    LD HL, PG_BUF
248B: 010001  	    LD BC, 256
248E: CD2A1D  	    CALL I2C_MemWr
2491: C2BE24  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
2494: F1      	    POP AF                  ; A = pagina (descarta)
2495: E1      	    POP HL                  ; restaura HL original
2496: D1      	    POP DE                  ; restaura DE original
2497: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
2498: 2A3AFC  	    LD HL, (FS_TMPSZ)
249B: 7C      	    LD A, H
249C: B7      	    OR A
249D: 2005    	    JR NZ, FS_WP_UPD255
249F: 7D      	    LD A, L
24A0: FEFF    	    CP FS_DATAPG
24A2: 3805    	    JR C, FS_WP_UPDLT
24A4:         	FS_WP_UPD255:
24A4: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
24A7: 1803    	    JR FS_WP_UPDATE
24A9:         	FS_WP_UPDLT:
24A9: 0600    	    LD B, 0
24AB: 4D      	    LD C, L                 ; bytes gravados = L
              	
24AC:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
24AC: 2A3CFC  	    LD HL, (FS_TMPRAM)
24AF: 09      	    ADD HL, BC
24B0: 223CFC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
24B3: 2A3AFC  	    LD HL, (FS_TMPSZ)
24B6: B7      	    OR A                    ; limpa carry
24B7: ED42    	    SBC HL, BC
24B9: 223AFC  	    LD (FS_TMPSZ), HL
24BC: AF      	    XOR A                   ; Z = sucesso
24BD: C9      	    RET
              	
24BE:         	FS_WP_ERR:
24BE: F1      	    POP AF
24BF: E1      	    POP HL
24C0: D1      	    POP DE
24C1: C1      	    POP BC
24C2: 3E01    	    LD A, 1
24C4: B7      	    OR A
24C5: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
24C6:         	FS_SET_NEXT:
24C6: C5      	    PUSH BC
24C7: D5      	    PUSH DE
24C8: E5      	    PUSH HL
24C9: 57      	    LD D, A
24CA: 1E00    	    LD E, 0
24CC: 78      	    LD A, B
24CD: 3239FC  	    LD (FS_TMP1), A
24D0: 2139FC  	    LD HL, FS_TMP1
24D3: 010100  	    LD BC, 1
24D6: CD2A1D  	    CALL I2C_MemWr
24D9: E1      	    POP HL
24DA: D1      	    POP DE
24DB: C1      	    POP BC
24DC: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
24DD:         	FS_FIND_NAME:
24DD: AF      	    XOR A
24DE: 3209FC  	    LD (FS_CUR), A
24E1: 0608    	    LD B, FS_MAXFILES
24E3:         	FS_FN_LP:
24E3: C5      	    PUSH BC
24E4: CDCF22  	    CALL FS_RD_ENTRY
24E7: C21625  	    JP NZ, FS_FN_ERR
24EA: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
24ED: FE01    	    CP FS_FLAG_USED
24EF: 2017    	    JR NZ, FS_FN_NXT
24F1: 212AFC  	    LD HL, FS_NAMBUF
24F4: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
24F7: 0E10    	    LD C, FS_NAME_SZ
24F9:         	FS_FN_CMP:
24F9: 7E      	    LD   A, (HL)
24FA: 47      	    LD   B, A
24FB: 1A      	    LD   A, (DE)
24FC: B8      	    CP   B
24FD: C20825  	    JP  NZ, FS_FN_NXT
2500: 23      	    INC HL
2501: 13      	    INC DE
2502: 0D      	    DEC C
2503: 20F4    	    JR NZ, FS_FN_CMP
2505: C1      	    POP BC
2506: AF      	    XOR A
2507: C9      	    RET
2508:         	FS_FN_NXT:
2508: 3A09FC  	    LD A, (FS_CUR)
250B: 3C      	    INC A
250C: 3209FC  	    LD (FS_CUR), A
250F: C1      	    POP BC
2510: 10D1    	    DJNZ FS_FN_LP
2512: 3E01    	    LD A, 1
2514: B7      	    OR A
2515: C9      	    RET
2516:         	FS_FN_ERR:
2516: C1      	    POP BC
2517: 3E03    	    LD A, ERR_TOUT
2519: B7      	    OR A
251A: C9      	    RET
              	
              	
              	
              	
              	; FS_FIND_FOLDER_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
251B:         	FS_FIND_FOLDER_NAME:
