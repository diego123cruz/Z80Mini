              	; ============================================================
              	;  CHANGE_DRIVE_A  -  Altera drive para device A - EEDRIVE_A
              	; ============================================================
121B:         	CHANGE_DRIVE_A:
121B: 3EA0    	    LD A, EEDRIVE_A
121D: 3204FC  	    LD (I2CA_BLOCK), A
1220: CD8F22  	    CALL CHECK_DISK_FORMAT
1223: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_B  -  Altera drive para device B - EEDRIVE_B
              	; ============================================================
