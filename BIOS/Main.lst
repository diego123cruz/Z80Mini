              	#include "I2C.asm"
              	; **********************************************************************
              	; I2C support functions
              	
              	; I2C bus open device
              	;   On entry: A = Device address (bit zero is read flag)
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A5A: F5      	I2C_Open:   PUSH AF
1A5B: CDD81A  	            CALL I2C_Start      ;Output start condition
1A5E: F1      	            POP  AF
1A5F: 180D    	            JR   I2C_Write      ;Write data byte
              	
              	
              	; I2C bus close device
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A=0 and Z flagged
              	;             If unsuccessfully A=Error and NZ flagged
              	;             SCL = hi, SDA = hi
              	;             BC DE HL IX IY preserved
1A61: C3E31A  	I2C_Close:  JP   I2C_Stop       ;Output stop condition
              	
              	
              	; I2C bus open read device
              	;   On entry: A = Device address
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A64:         	I2C_OpenRead:   
1A64: CB37    	            SLL A
1A66: C35A1A  	            JP I2C_Open
              	
              	
              	; I2C bus open write device
              	;   On entry: A = Device address 
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             BC DE HL IX IY preserved
1A69:         	I2C_OpenWrite:   
1A69: CB27    	            SLA     A
1A6B: C35A1A  	            JP I2C_Open
              	
              	; **********************************************************************
              	; **********************************************************************
              	; I2C bus master driver
              	; **********************************************************************
              	; **********************************************************************
              	
              	; Functions provided are:
              	;     I2C_Start
              	;     I2C_Stop
              	;     I2C_Read
              	;     I2C_Write
              	;
              	; This code has delays between all I/O operations to ensure it works
              	; with the slowest I2C devices
              	;
              	; I2C transfer sequence
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;   | Start |  | Address |  | Data    | ... | Data    |  | Stop  |
              	;   |       |  | frame   |  | frame 1 |     | frame N |  |       |
              	;   +-------+  +---------+  +---------+     +---------+  +-------+
              	;
              	;
              	; Start condition                     Stop condition
              	; Output by master device             Output by master device
              	;       ----+                                      +----
              	; SDA       |                         SDA          |
              	;           +-------                        -------+
              	;       -------+                                +-------
              	; SCL          |                      SCL       |
              	;              +----                        ----+
              	;
              	;
              	; Address frame
              	; Clock and data output from master device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | A 7 | A 6 | A 5 | A 4 | A 3 | A 2 | A 1 | R/W | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	;
              	; Data frame 
              	; Clock output by master device
              	; Data output by transmitting device
              	; Receiving device outputs acknowledge 
              	;        +-----+-----+-----+-----+-----+-----+-----+-----+     +---+
              	; SDA    | D 7 | D 6 | D 5 | D 4 | D 3 | D 2 | D 1 | D 0 | ACK |   |
              	;     ---+-----+-----+-----+-----+-----+-----+-----+-----+-----+   +---
              	;          +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+   +-+
              	; SCL      | |   | |   | |   | |   | |   | |   | |   | |   | |
              	;     -----+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---+ +---------
              	;
              	
              	
              	; **********************************************************************
              	; I2C constants
              	
              	
              	; I2C bus master interface
              	; The default device option is for SC126 or compatible
              	
0021:         	I2C_PORT:   .EQU $21           ;Host I2C port address
0007:         	I2C_SDA_WR: .EQU 7              ;Host I2C write SDA bit number
0007:         	I2C_SDA_RD: .EQU 7              ;Host I2C read SDA bit number
0000:         	I2C_SCL_WR: .EQU 0              ;Host I2C write SCL bit number
0000:         	I2C_SCL_RD: .EQU 0              ;Host I2C read SCL bit number 
0081:         	I2C_QUIES:  .EQU 0b10000001     ;Host I2C output port quiescent value
              	
              	
              	; I2C support constants
0000:         	ERR_NONE:   .EQU 0              ;Error = None
0001:         	ERR_JAM:    .EQU 1              ;Error = Bus jammed [not used]
0002:         	ERR_NOACK:  .EQU 2              ;Error = No ackonowledge
0003:         	ERR_TOUT:   .EQU 3              ;Error = Timeout
              	
              	
              	; **********************************************************************
              	; Hardware dependent I2C bus functions
              	
              	
              	; I2C bus transmit frame (address or data)
              	;   On entry: A = Data byte, or
              	;                 Address byte (bit zero is read flag)
              	;             SCL = low, SDA = low
              	;   On exit:  If successful A=0 and Z flagged
              	;                SCL = lo, SDA = lo
              	;             If unsuccessful A=Error and NZ flagged
              	;                SCL = high, SDA = high, I2C closed
              	;             BC DE HL IX IY preserved
1A6E: C5      	I2C_Write:  PUSH BC             ;Preserve registers
1A6F: D5      	            PUSH DE
1A70: 57      	            LD   D,A            ;Store byte to be written
1A71: 0608    	            LD   B,8            ;8 data bits, bit 7 first
1A73: CB12    	I2C_WriteWr_Loop:   RL   D              ;Test M.S.Bit
1A75: 3805    	            JR   C,I2C_WriteBit_Hi      ;High, so skip
1A77: CD0A1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = data bit)
1A7A: 1803    	            JR   I2C_WriteBit_Clk
1A7C: CD031B  	I2C_WriteBit_Hi:    CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA = data bit)
1A7F: CDF51A  	I2C_WriteBit_Clk:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = data bit)
1A82: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = data bit)
1A85: 10EC    	            DJNZ I2C_WriteWr_Loop
              	; Test for acknowledge from slave (receiver)
              	; On arriving here, SCL = lo, SDA = data bit
1A87: CD031B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/ack)
1A8A: CDF51A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/ack)
1A8D: CD1B1B  	            CALL I2C_RdPort     ;Read SDA input
1A90: 47      	            LD   B,A
1A91: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA = hi)
1A94: CB78    	            BIT  I2C_SDA_RD,B
1A96: 2004    	            JR   NZ,I2C_WriteNoAck      ;Skip if no acknowledge
1A98: D1      	            POP  DE             ;Restore registers
1A99: C1      	            POP  BC
1A9A: AF      	            XOR  A              ;Return success A=0 and Z flagged
1A9B: C9      	            RET
              	; I2C STOP required as no acknowledge
              	; On arriving here, SCL = lo, SDA = hi
1A9C: CD0A1B  	I2C_WriteNoAck:     CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA = lo)
1A9F: CDF51A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA = lo)
1AA2: CD031B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA = hi)
1AA5: D1      	            POP  DE             ;Restore registers
1AA6: C1      	            POP  BC
1AA7: 3E02    	            LD   A,ERR_NOACK    ;Return error = No Acknowledge
1AA9: B7      	            OR   A              ;  and NZ flagged
1AAA: C9      	            RET
              	
              	
              	; I2C bus receive frame (data)
              	;   On entry: A = Acknowledge flag
              	;               If A != 0 the read is acknowledged
              	;             SCL low, SDA low
              	;   On exit:  If successful A = data byte and Z flagged
              	;               SCL = low, SDA = low
              	;             If unsuccessul* A = Error and NZ flagged
              	;               SCL = low, SDA = low
              	;             BC DE HL IX IY preserved
              	; *This function always returns successful
1AAB: C5      	I2C_Read:   PUSH BC             ;Preserve registers
1AAC: D5      	            PUSH DE
1AAD: 5F      	            LD   E,A            ;Store acknowledge flag
1AAE: 0608    	            LD   B,8            ;8 data bits, 7 first
1AB0: CD031B  	            CALL I2C_SDA_HI     ;SDA high  (SCL lo, SDA hi/input)
1AB3: CDF51A  	I2C_ReadRd_Loop:   CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA hi/input)
1AB6: CD1B1B  	            CALL I2C_RdPort     ;Read SDA input bit
1AB9: 37      	            SCF                 ;Set carry flag
1ABA: CB7F    	            BIT  I2C_SDA_RD,A   ;SDA input high?
1ABC: 2001    	            JR   NZ, I2C_ReadRotate     ;Yes, skip with carry flag set
1ABE: 3F      	            CCF                 ;Clear carry flag
1ABF: CB12    	I2C_ReadRotate:    RL   D              ;Rotate result into D
1AC1: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA hi/input)
1AC4: 10ED    	            DJNZ  I2C_ReadRd_Loop       ;Repeat for all 8 bits
              	; Acknowledge input byte
              	; On arriving here, SCL = lo, SDA = hi/input
1AC6: 7B      	            LD   A,E            ;Get acknowledge flag
1AC7: B7      	            OR   A              ;A = 0? (indicates no acknowledge)
1AC8: 2803    	            JR   Z, I2C_ReadNoAck       ;Yes, so skip acknowledge
1ACA: CD0A1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL lo, SDA lo)
1ACD: CDF51A  	I2C_ReadNoAck:     CALL I2C_SCL_HI     ;SCL hi    (SCL hi, SDA lo)
1AD0: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1AD3: 7A      	            LD   A,D            ;Get data byte received
1AD4: D1      	            POP  DE             ;Restore registers
1AD5: C1      	            POP  BC
1AD6: BF      	            CP   A              ;Return success Z flagged
1AD7: C9      	            RET
              	
              	
              	; I2C bus start
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = low, SDA = low
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are high
1AD8: CDF11A  	I2C_Start:  CALL I2C_INIT       ;Initialise I2C control port
              	;           CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA ??)
              	;           CALL I2C_SDA_HI     ;SDA high  (SCL hi, SDA hi)
              	; Generate I2C start condition
1ADB: CD0A1B  	            CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1ADE: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
1AE1: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AE2: C9      	            RET
              	
              	
              	; I2C bus stop 
              	;   On entry: SCL = unknown, SDA = unknown
              	;   On exit:  SCL = high, SDA = high
              	;             A = 0 and Z flagged as we always succeed
              	;             BC DE HL IX IY preserved
              	; First ensure SDA and SCL are low
1AE3: CD0A1B  	I2C_Stop:   CALL I2C_SDA_LO     ;SDA low   (SCL hi, SDA lo)
1AE6: CDFC1A  	            CALL I2C_SCL_LO     ;SCL low   (SCL lo, SDA lo)
              	; Generate stop condition
1AE9: CDF51A  	            CALL I2C_SCL_HI     ;SCL high  (SCL hi, SDA lo)
1AEC: CD031B  	            CALL I2C_SDA_HI     ;SDA low   (SCL hi, SDA hi)
1AEF: AF      	            XOR  A              ;Return success A=0 and Z flagged
1AF0: C9      	            RET
              	
              	
              	; **********************************************************************
              	; I2C bus simple I/O functions
              	;   On entry: No parameters required
              	;   On exit:  BC DE HL IX IY preserved
              	
1AF1: 3E81    	I2C_INIT:   LD   A,I2C_QUIES    ;I2C control port quiescent value
1AF3: 181A    	            JR   I2C_WrPort
              	
1AF5: 3A05FC  	I2C_SCL_HI: LD   A,(I2C_RAMCPY)
1AF8: CBC7    	            SET  I2C_SCL_WR,A
1AFA: 1813    	            JR   I2C_WrPort
              	
1AFC: 3A05FC  	I2C_SCL_LO: LD   A,(I2C_RAMCPY)
1AFF: CB87    	            RES  I2C_SCL_WR,A
1B01: 180C    	            JR   I2C_WrPort
              	
1B03: 3A05FC  	I2C_SDA_HI: LD   A,(I2C_RAMCPY)
1B06: CBFF    	            SET  I2C_SDA_WR,A
1B08: 1805    	            JR   I2C_WrPort
              	
1B0A: 3A05FC  	I2C_SDA_LO: LD   A,(I2C_RAMCPY)
1B0D: CBBF    	            RES  I2C_SDA_WR,A
              	
1B0F: C5      	I2C_WrPort: PUSH BC             ;Preserve registers
1B10: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B12: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B14: ED79    	            OUT  (C),A          ;Write A to I2C I/O port
1B16: 3205FC  	            LD   (I2C_RAMCPY),A ;Write A to RAM copy
1B19: C1      	            POP  BC             ;Restore registers
1B1A: C9      	            RET
              	
1B1B: C5      	I2C_RdPort: PUSH BC             ;Preserve registers
1B1C: 0600    	            LD   B,0            ;Set up BC for 16-bit
1B1E: 0E21    	            LD   C,I2C_PORT     ;  I/O address of I2C port
1B20: ED78    	            IN   A,(C)          ;Read A from I/O port
1B22: C1      	            POP  BC             ;Restore registers
1B23: C9      	            RET
              	
              	
