15EB: AF      	    XOR A
15EC: 3243FD  	    LD  (I2C_STATE), A
15EF: F1      	    POP AF
15F0: 211216  	    LD  HL, MSG_I2C_NOACK
15F3: CD8D04  	    CALL PUTS
15F6: C9      	    RET
              	
