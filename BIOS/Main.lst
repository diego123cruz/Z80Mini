              	; Fill a block I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             L = BYTE to Fill
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; pages.
1CBC: C5      	I2C_MemFill:  PUSH BC
1CBD: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CC0:         	I2C_MemFillRepeat:    
1CC0: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CC3: CD7E1A  	            CALL I2C_Open       ;Open for write
1CC6: 280A    	            JR   Z,I2C_MemFillReady       ;If open okay then skip on
1CC8: 0B      	            DEC  BC
1CC9: 78      	            LD   A,B
1CCA: B1      	            OR   C              ;Timeout?
1CCB: 20F3    	            JR   NZ,I2C_MemFillRepeat     ;No, so go try again
1CCD: C1      	            POP  BC
1CCE: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CD0: B7      	            OR   A              ;Error, so NZ flagged
1CD1: C9      	            RET                 ;Return with error
              	; Device opened okay
1CD2: C1      	I2C_MemFillReady:     POP  BC             ;Restore byte counter
1CD3: 7A      	I2C_MemFillBlock:     LD   A,D            ;Address (hi) in I2C memory
1CD4: CD921A  	            CALL I2C_Write      ;Write address
1CD7: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CD8: CD921A  	            CALL I2C_Write      ;Write address
1CDB: 7D      	I2C_MemFillWrite:     LD   A, L         ;Get data byte to fill
1CDC: CD921A  	            CALL I2C_Write      ;Read byte from I2C memory
1CDF: 13      	            INC  DE             ;Increment I2C memory pointer
1CE0: 0B      	            DEC  BC             ;Decrement byte counter
1CE1: 78      	            LD   A,B
1CE2: B1      	            OR   C              ;Finished?
1CE3: 2805    	            JR   Z,I2C_MemFillStore       ;Yes, so go store this page
1CE5: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1CE6: E63F    	            AND  63             ;64 byte page boundary?
1CE8: 20F1    	            JR   NZ,I2C_MemFillWrite      ;No, so go write another byte
1CEA: CD071B  	I2C_MemFillStore:     CALL I2C_Stop       ;Generate I2C stop
1CED: 78      	            LD   A,B
1CEE: B1      	            OR   C              ;Finished?
1CEF: 20CB    	            JR   NZ,I2C_MemFill   ;No, so go write some more
1CF1: C9      	            RET  
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1CF2: C5      	I2C_MemRd:  PUSH BC
1CF3: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CF6:         	I2C_MemRdRepeat:    
1CF6: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CF9: CD7E1A  	            CALL I2C_Open       ;Open for write
1CFC: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
1CFE: 0B      	            DEC  BC
1CFF: 78      	            LD   A,B
1D00: B1      	            OR   C              ;Timeout?
1D01: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1D03: C1      	            POP  BC
1D04: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D06: B7      	            OR   A              ;Error, so NZ flagged
1D07: C9      	            RET                 ;Return with error
              	; Device opened okay
1D08: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1D09: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1D0A: CD921A  	            CALL I2C_Write      ;Write address
1D0D: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D0E: CD921A  	            CALL I2C_Write      ;Write address
1D11: 3A04FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1D14: 3C      	            INC  A              ; Device read equal DeviceId+1
1D15: CD7E1A  	            CALL I2C_Open       ;Open for read
1D18: C0      	            RET  NZ             ;Abort if error
1D19: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1D1A: 78      	            LD   A,B
1D1B: B1      	            OR   C              ;Last byte to be read?
1D1C: CDCF1A  	            CALL I2C_Read       ;Read byte with no ack on last byte
1D1F: 77      	            LD   (HL),A         ;Write byte in CPU memory
1D20: 23      	            INC  HL             ;Increment CPU memory pointer
1D21: 78      	            LD   A,B
1D22: B1      	            OR   C              ;Finished?
1D23: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1D25: CD071B  	            CALL I2C_Stop       ;Generate I2C stop
1D28: AF      	            XOR  A              ;Return with success (Z flagged)
1D29: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1D2A: C5      	I2C_MemWr:  PUSH BC
1D2B: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D2E:         	I2C_MemWrRepeat:    
1D2E: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D31: CD7E1A  	            CALL I2C_Open       ;Open for write
1D34: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1D36: 0B      	            DEC  BC
1D37: 78      	            LD   A,B
1D38: B1      	            OR   C              ;Timeout?
1D39: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1D3B: C1      	            POP  BC
1D3C: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D3E: B7      	            OR   A              ;Error, so NZ flagged
1D3F: C9      	            RET                 ;Return with error
              	; Device opened okay
1D40: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1D41: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1D42: CD921A  	            CALL I2C_Write      ;Write address
1D45: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D46: CD921A  	            CALL I2C_Write      ;Write address
1D49: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1D4A: CD921A  	            CALL I2C_Write      ;Read byte from I2C memory
1D4D: 23      	            INC  HL             ;Increment CPU memory pointer
1D4E: 13      	            INC  DE             ;Increment I2C memory pointer
1D4F: 0B      	            DEC  BC             ;Decrement byte counter
1D50: 78      	            LD   A,B
1D51: B1      	            OR   C              ;Finished?
1D52: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1D54: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1D55: E63F    	            AND  63             ;64 byte page boundary?
1D57: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1D59: CD071B  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1D5C: 78      	            LD   A,B
1D5D: B1      	            OR   C              ;Finished?
1D5E: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1D60: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1D61: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1D62: 1F      	            RRA                 ;Shift top nibble to
1D63: 1F      	            RRA                 ;  botom four bits..
1D64: 1F      	            RRA
1D65: 1F      	            RRA
1D66: E60F    	            AND  $0F           ;Mask off unwanted bits
1D68: CD6E1D  	            CALL HexOutHex           ;Output hi nibble
1D6B: F1      	            POP  AF             ;Restore byte to be output
1D6C: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1D6E: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1D70: 3802    	            JR   C,HexOutSkip        ;No, so skip
1D72: C607    	            ADD  A,7            ;Yes, so add 7
1D74: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1D76: CD9904  	            CALL CONOUT       ;Write character
1D79: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5        ; Assinatura da EEPROM formatada
0000:         	FS_PG_BMP:  .EQU $00        ; Número da página do bitmap
0001:         	FS_PG_DIR:  .EQU $01        ; Número da página do diretório
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8          ; Máximo de arquivos
0020:         	FS_ENTRY_SZ:.EQU 32         ; Bytes por entrada do diretório
0010:         	FS_NAME_SZ: .EQU 16         ; Bytes do nome
00FF:         	FS_DATAPG:  .EQU 255        ; Bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF      ; Slot do diretório livre
0001:         	FS_FLAG_USED: .EQU $01      ; Slot do diretório usado - File
0002:         	FS_FLAG_USED_FOLDER: .EQU $02      ; Slot do diretório usado - Folder
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0          ; Nome (16 bytes)
0010:         	FS_O_FSTPG: .EQU 16         ; Primeira página de dados
0011:         	FS_O_SIZEH: .EQU 17         ; Tamanho hi
0012:         	FS_O_SIZEL: .EQU 18         ; Tamanho lo
0013:         	FS_O_RADRH: .EQU 19         ; Load RAM hi
0014:         	FS_O_RADRL: .EQU 20         ; Load RAM lo
0015:         	FS_O_FLAGS: .EQU 21         ; Flags ($FF=livre, $01=usado por arquivo, $02=usado por pasta)
              	
              	
              	
              	
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; FS_INFO - Espaco usado/livre da EEPROM
              	;   Le bitmap, conta paginas, imprime barra e valores
              	; **********************************************************************
1D7A:         	FS_INFO:
1D7A: CDB504  	    CALL CRLF
1D7D: 21DE26  	    LD HL, str_info_hdr
1D80: CDA504  	    CALL PUTS
              	
              	    ; Le 16 bytes do bitmap (bytes 1..16 da pagina 0)
1D83: 110100  	    LD DE, $0001
1D86: 2142FC  	    LD HL, PG_BUF
1D89: 011000  	    LD BC, 16
1D8C: CDF21C  	    CALL I2C_MemRd
1D8F: C25925  	    JP NZ, FS_ERR_I2C
              	
              	    ; Conta paginas livres (bits=1) → C
1D92: 2142FC  	    LD HL, PG_BUF
1D95: 0610    	    LD B, 16
1D97: 0E00    	    LD C, 0
1D99:         	FS_INF_CNT:
1D99: 7E      	    LD A, (HL)
1D9A: 23      	    INC HL
1D9B: 1608    	    LD D, 8
1D9D:         	FS_INF_BIT:
1D9D: 0F      	    RRCA
1D9E: 3001    	    JR NC, FS_INF_NB
1DA0: 0C      	    INC C
1DA1:         	FS_INF_NB:
1DA1: 15      	    DEC D
1DA2: 20F9    	    JR NZ, FS_INF_BIT
1DA4: 10F3    	    DJNZ FS_INF_CNT
              	
              	    ; C = pags livres (0..126)
              	    ; paginas usadas = 126 - C → salva em E
1DA6: 3E7E    	    LD A, 126
1DA8: 91      	    SUB C
1DA9: 5F      	    LD E, A                 ; E = paginas usadas
              	
              	    ; === Linha 1: barra visual ===
              	    ; Formato: "[##########..........] UUh/7Eh pags"
              	    ; Barra de 19 chars: cada char = ~6.6 pags
              	    ; chars_usados = E * 19 / 126
              	    ;   = E / 6  (aproximacao boa o suficiente para barra)
1DAA: 7B      	    LD A, E
1DAB: 0600    	    LD B, 0                 ; B = chars usados
1DAD:         	FS_INF_DIV6:
1DAD: FE06    	    CP 6
1DAF: 3805    	    JR C, FS_INF_DIV6_DONE
1DB1: D606    	    SUB 6
1DB3: 04      	    INC B
1DB4: 18F7    	    JR FS_INF_DIV6
1DB6:         	FS_INF_DIV6_DONE:
              	    ; B = chars usados (0..21, clamp a 20)
1DB6: 78      	    LD A, B
1DB7: FE15    	    CP 21
1DB9: 3802    	    JR C, FS_INF_CLAMP
1DBB: 0613    	    LD B, 19
1DBD:         	FS_INF_CLAMP:
              	
1DBD: 3E5B    	    LD A, '['
1DBF: CF      	    RST $08
              	
              	    ; Imprime B x '#' (usado)
1DC0: 78      	    LD A, B
1DC1: B7      	    OR A
1DC2: 2808    	    JR Z, FS_INF_NO_HASH
1DC4: C5      	    PUSH BC
1DC5: 47      	    LD B, A
1DC6:         	FS_INF_HASH:
1DC6: 3E23    	    LD A, '#'
1DC8: CF      	    RST $08
1DC9: 10FB    	    DJNZ FS_INF_HASH
1DCB: C1      	    POP BC
              	
1DCC:         	FS_INF_NO_HASH:
              	    ; Imprime (20-B) x '.' (livre)
1DCC: 3E13    	    LD A, 19
1DCE: 90      	    SUB B
1DCF: 2806    	    JR Z, FS_INF_NO_DOT
1DD1: 47      	    LD B, A
1DD2:         	FS_INF_DOT:
1DD2: 3E2E    	    LD A, '.'
1DD4: CF      	    RST $08
1DD5: 10FB    	    DJNZ FS_INF_DOT
1DD7:         	FS_INF_NO_DOT:
              	
1DD7: 3E5D    	    LD A, ']'
1DD9: CF      	    RST $08
1DDA: 3E20    	    LD A, ' '
1DDC: CF      	    RST $08
              	
              	    ; Imprime "UUh/7Eh pags"
1DDD: 7B      	    LD A, E                 ; A = usadas
1DDE: CD611D  	    CALL HexOut
1DE1: 3E68    	    LD A, 'h'
1DE3: CF      	    RST $08
1DE4: 3E2F    	    LD A, '/'
1DE6: CF      	    RST $08
1DE7: 3E7E    	    LD A, $7E               ; 126
1DE9: CD611D  	    CALL HexOut
1DEC: 3E68    	    LD A, 'h'
1DEE: CF      	    RST $08
1DEF: 21F526  	    LD HL, str_inf_pags
1DF2: CDA504  	    CALL PUTS
              	
              	    ; === Linha 2: Usadas ===
1DF5: 21FD26  	    LD HL, str_inf_used
1DF8: CDA504  	    CALL PUTS
1DFB: 7B      	    LD A, E
1DFC: CD611D  	    CALL HexOut
1DFF: 3E68    	    LD A, 'h'
1E01: CF      	    RST $08
1E02: 210D27  	    LD HL, str_inf_pags_nl
1E05: CDA504  	    CALL PUTS
1E08: CDB504  	    CALL CRLF
1E0B: 3E20    	    LD A, ' '
1E0D: CF      	    RST $08
              	
              	    ; Bytes usados aprox: E * 255  (E = paginas usadas)
              	    ; Salva C (paginas livres) em RAM antes do loop destruir C
1E0E: 79      	    LD A, C
1E0F: 3241FC  	    LD (FS_INFOTMP), A      ; salva pags livres
              	
1E12: 210000  	    LD HL, 0
1E15: 7B      	    LD A, E
1E16: B7      	    OR A
1E17: 2807    	    JR Z, FS_INF_BYTES_DONE_U
1E19:         	FS_INF_BYTES_USED:
1E19: 01FF00  	    LD BC, FS_DATAPG        ; C destruido aqui - mas ja salvamos
1E1C: 09      	    ADD HL, BC
1E1D: 1D      	    DEC E
1E1E: 20F9    	    JR NZ, FS_INF_BYTES_USED
1E20:         	FS_INF_BYTES_DONE_U:
1E20: 7C      	    LD A, H
1E21: CD611D  	    CALL HexOut
1E24: 7D      	    LD A, L
1E25: CD611D  	    CALL HexOut
1E28: 3E68    	    LD A, 'h'
1E2A: CF      	    RST $08
1E2B: 211427  	    LD HL, str_inf_bytes_nl
1E2E: CDA504  	    CALL PUTS
              	
              	    ; Recupera paginas livres
1E31: 3A41FC  	    LD A, (FS_INFOTMP)
1E34: 4F      	    LD C, A                 ; C = paginas livres restaurado
              	
              	    ; === Linha 3: Livres ===
1E35: 210527  	    LD HL, str_inf_free
1E38: CDA504  	    CALL PUTS
1E3B: 79      	    LD A, C
1E3C: CD611D  	    CALL HexOut
1E3F: 3E68    	    LD A, 'h'
1E41: CF      	    RST $08
1E42: 210D27  	    LD HL, str_inf_pags_nl
1E45: CDA504  	    CALL PUTS
1E48: CDB504  	    CALL CRLF
1E4B: 3E20    	    LD A, ' '
1E4D: CF      	    RST $08
              	
              	    ; Bytes livres aprox: C * 255
1E4E: 210000  	    LD HL, 0
1E51: 79      	    LD A, C
1E52: B7      	    OR A
1E53: 2808    	    JR Z, FS_INF_BYTES_DONE_F
1E55: 59      	    LD E, C
1E56:         	FS_INF_BYTES_FREE:
1E56: 01FF00  	    LD BC, FS_DATAPG
1E59: 09      	    ADD HL, BC
1E5A: 1D      	    DEC E
1E5B: 20F9    	    JR NZ, FS_INF_BYTES_FREE
1E5D:         	FS_INF_BYTES_DONE_F:
1E5D: 7C      	    LD A, H
1E5E: CD611D  	    CALL HexOut
1E61: 7D      	    LD A, L
1E62: CD611D  	    CALL HexOut
1E65: 3E68    	    LD A, 'h'
1E67: CF      	    RST $08
1E68: 211427  	    LD HL, str_inf_bytes_nl
1E6B: CDA504  	    CALL PUTS
1E6E: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; FS_DIR
              	; **********************************************************************
1E6F:         	FS_DIR:
1E6F: CDB504  	    CALL CRLF
1E72: 3E5B    	    LD A, '['
1E74: CF      	    RST $08
1E75: 0611    	    LD B, FS_NAME_SZ + 1
1E77: 2145FD  	    LD HL, FS_DIR_NAME
1E7A:         	FS_S_DIR:
1E7A: 7E      	    LD A, (HL)
1E7B: FE00    	    CP 0
1E7D: CA841E  	    JP Z, FS_S_DIR_F
1E80: 23      	    INC HL
