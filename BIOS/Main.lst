0276:         	INICIO:
0276: 21B301  	    LD HL, INT_DEFAULT
0279: 2200F0  	    LD (RST38), HL
027C: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
027F: 3EA0    	    LD A, EEDRIVE_A
0281: 3202FC  	    LD (I2CA_BLOCK), A     
              	
0284: 3E01    	    LD A, 1 ;capslock OFF
0286: 32A3FB  	    LD (MEN_CAPSL), A
              	
0289: 3E01    	    LD A, $01
028B: 3242FD  	    LD (FS_DIR_CUR), A ; default folder - HOME
              	
028E: CDD302  	    CALL M_C_DIR_C
              	
0291: CD9F22  	    CALL FS_CHK_SIG
0294: CA9D02  	    JP Z, INICIO1
0297: 217326  	    LD HL, str_notfmt
029A: CDAB04  	    CALL PUTS
029D:         	INICIO1:
              	
029D: 31F0FF  	    LD SP, SYSTEM_SP
              	
02A0: 116400  	    LD DE, $0064 ; 100ms
02A3: CD3F03  	    CALL H_Delay
              	
              	    ;Init Serial
02A6: CD6010  	    CALL initSerial
              	
              	    ;Init Teclado
02A9: 3EFF    	    LD      A, 0xFF
02AB: D340    	    OUT     (KEYBOARD), A           ; Todas as colunas desativadas
              	
              	    ; Init LCD
02AD: CDE507  	    CALL initTerminal
02B0: CD2E05  	    CALL setGrMode
02B3: CDE007  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02B6: 010000  	    LD BC, $0000
02B9: CDD208  	    CALL setCursor
02BC: 117627  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02BF: 3E00    	    LD A, 0
02C1: 3298FB  	    LD (CURSOR_ON), A
              	    ; send cursor
02C4: CD8208  	    CALL sendStringToLCD
              	
              	
02C7:         	MAIN_LOOP:
02C7: CDE802  	    CALL showCurrentDriver
              	
02CA: CD5E14  	    CALL GETLINE             ; Lê linha em LINEBUF
02CD: CDFB10  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02D0: C3C702  	    JP      MAIN_LOOP
              	
              	
02D3:         	M_C_DIR_C:
02D3: 0611    	    LD B, FS_NAME_SZ + 1
02D5: 2143FD  	    LD HL, FS_DIR_NAME
02D8: 118B27  	    LD DE, FOLDER_HOME
02DB:         	M_C_DIR:
02DB: 1A      	    LD A, (DE)
02DC: FE00    	    CP 0
02DE: 2805    	    JR Z, M_C_DIR_F
02E0: 77      	    LD (HL), A
02E1: 23      	    INC HL
02E2: 13      	    INC DE
02E3: 10F6    	    djnz M_C_DIR
02E5:         	M_C_DIR_F:
02E5: AF      	    XOR A
02E6: 77      	    LD (HL), A
02E7: C9      	    RET
              	
              	
02E8:         	showCurrentDriver:
02E8: 3A02FC  	    LD A, (I2CA_BLOCK)
02EB: FEA0    	    CP EEDRIVE_A  ; Drive A
02ED: 281D    	    JR Z, showDriveA
02EF: FEA2    	    CP EEDRIVE_B  ; Drive B
02F1: 281D    	    JR Z, showDriveB
02F3: FEA4    	    CP EEDRIVE_C  ; Drive C
02F5: 281D    	    JR Z, showDriveC
02F7: FEA6    	    CP EEDRIVE_D  ; Drive D
02F9: 281D    	    JR Z, showDriveD
02FB: FEA8    	    CP EEDRIVE_E  ; Drive E
02FD: 281D    	    JR Z, showDriveE
02FF: FEAC    	    CP EEDRIVE_F  ; Drive F
0301: 281D    	    JR Z, showDriveF
0303: FEAE    	    CP EEDRIVE_G  ; Drive G
0305: 281D    	    JR Z, showDriveG
0307: FEAA    	    CP EEDRIVE_Z  ; Drive Z
0309: 281D    	    JR Z, showDriveZ
030B: C9      	    RET
              	
030C:         	showDriveA:
030C: 3E41    	    LD A, 'A'
030E: 181C    	    JR showCursor
0310:         	showDriveB:
0310: 3E42    	    LD A, 'B'
0312: 1818    	    JR showCursor
0314:         	showDriveC:
0314: 3E43    	    LD A, 'C'
0316: 1814    	    JR showCursor
0318:         	showDriveD:
0318: 3E44    	    LD A, 'D'
031A: 1810    	    JR showCursor
031C:         	showDriveE:
031C: 3E45    	    LD A, 'E'
031E: 180C    	    JR showCursor
0320:         	showDriveF:
0320: 3E46    	    LD A, 'F'
0322: 1808    	    JR showCursor
0324:         	showDriveG:
0324: 3E47    	    LD A, 'G'
0326: 1804    	    JR showCursor
0328:         	showDriveZ:
0328: 3E5A    	    LD A, 'Z'
032A: 1800    	    JR showCursor
032C:         	showCursor:
032C: CD1208  	    CALL sendCharToLCD
032F: 3E3A    	    LD A, ':'
0331: CD1208  	    CALL sendCharToLCD
0334: C9      	    RET
              	
              	
              	
0335:         	resetCollisionPixel:
0335: AF      	    XOR A
0336: 323FFD  	    LD (DRAW_PIXEL_COLLISION), A
0339: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
033A:         	checkCollisionPixel:
033A: 3A3FFD  	    LD A, (DRAW_PIXEL_COLLISION)
033D: B7      	    OR A
033E: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
033F: F5      	H_Delay:    PUSH AF
0340: C5      	            PUSH BC
0341: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
0342: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
0345: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
0346: 79      	            LD   A,C            ;[4]     [4]
0347: B0      	            OR   B              ;[4]     [4]
0348: C24503  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
034B: 1B      	            DEC  DE             ;[6]     [4]
034C: 7B      	            LD   A,E            ;[4]     [4]
034D: B2      	            OR   D              ;[4]     [4]
034E: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
0350: D1      	            POP  DE
0351: C1      	            POP  BC
0352: F1      	            POP  AF
0353: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       On exit: If press A = CTRLC and NZ flagged
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
0354:         	CHKKEY:
0354: 3EFE    	    LD      A, 0xFE             ; Máscara: bit 0 baixo = col 0
0356: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0358: 00      	    NOP                         ; ~270 ns de estabilização
0359: 00      	    NOP
035A: 00      	    NOP
035B: 00      	    NOP
035C: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
035E: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
035F: FE01    	    CP 1
0361: C26903  	    jp nz, GRET
0364: 3E03    		LD  A, CTRLC
0366: FE00    		CP	0
0368: C9      		RET
0369:         	GRET:
0369: 3E00    		LD  A, 0
036B: FE00    		CP 0
036D: C9      		RET
              	
              	
              	
036E:         	LCD_SCROLL_CONIN:
036E: CD9F04  	    CALL PUTCHAR
0371: C37703  	    JP CONIN_K
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
0374:         	CONIN:
0374: C5      	    PUSH BC
0375: D5      	    PUSH DE
0376: E5      	    PUSH HL
0377:         	CONIN_K:
0377: CD0204  	    CALL readKeyboarWaitPressA
037A: FEF8    	    CP   $F8    ; ignora scroll up - GLCD
037C: 28F0    	    JR   Z, LCD_SCROLL_CONIN
037E: FEF7    	    CP   $F7    ; ignora scroll down - GLCD
0380: 28EC    	    JR   Z, LCD_SCROLL_CONIN
0382: FE0A    	    CP   LF
0384: 28F1    	    JR   Z, CONIN_K    ; Ignora LF
0386: FE1B    	    CP   ESC
0388: 28ED    	    JR   Z, CONIN_K    ; Ignora
038A: FEFF    	    CP   $FF ;capslock Ignora
038C: CA7703  	    JP   Z, CONIN_K
038F: E1      	    POP HL
0390: D1      	    POP DE
0391: C1      	    POP BC
0392: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
0393:         	CONIN_NOT_LOOP:
0393: C5      	    PUSH BC
0394: D5      	    PUSH DE
0395: E5      	    PUSH HL
0396: CD9D03  	    CALL readKeyboarPressA
0399: E1      	    POP HL
039A: D1      	    POP DE
039B: C1      	    POP BC
039C: C9      	    RET
              	
              	
039D:         	readKeyboarPressA;
039D: AF      	    XOR A
039E: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
03A1: CD4004  	    CALL    SCAN_MATRIX
03A4: D0      	    RET      NC
03A5: CDB003  	    CALl GetKeycode
03A8: CDB603  	    CALL checkShiftKey
03AB: 3AA4FB  	    LD A, (KEY_PRESS)
03AE: 37      	    SCF  ; Carry = 1
03AF: C9      	    RET
              	
              	
              	
              	; A = col*8 + row  (0x00 – 0x3F)
03B0:         	GetKeycode:
              	    ; --- Tecla confirmada: calcula keycode ---
              	    ; col*8 + row  (0x00 – 0x3F)
03B0: 78      	    LD      A, B                ; B = coluna
03B1: 87      	    ADD     A, A                ; ×2
03B2: 87      	    ADD     A, A                ; ×4
03B3: 87      	    ADD     A, A                ; ×8
03B4: 81      	    ADD     A, C                ; + linha (C) = keycode
03B5: C9      	    RET
              	
              	
              	; Verifica se shift e recupera ascii
              	;   Salva tecla em KEY_PRESS
03B6:         	checkShiftKey:
              	    ; Verifica Shift
03B6: 5F      	    LD E, A
03B7: 21B601  	    LD HL, KEYMAP_NORMAL
03BA: 3AA2FB  	    LD A, (MEN_SHIFT)
03BD: FE01    	    CP 1
03BF: C2CC03  	    JP NZ, NO_SHIFT
03C2: 21F601  	    LD HL, KEYMAP_SHIFT
03C5: CD3B04  	    CALL DO_LOOKUP
03C8: 32A4FB  	    LD (KEY_PRESS), A
03CB: C9      	    RET
03CC:         	NO_SHIFT:
03CC: CD3B04  	    CALL 	DO_LOOKUP	; pega tecla
03CF: 32A4FB  	    LD (KEY_PRESS), A
03D2: FEFF    	    CP $FF ;capslook?
03D4: CAE703  	    JP Z, CAPSLOCK
03D7: 3AA3FB  	    LD A, (MEN_CAPSL)
03DA: FE00    	    CP 0
03DC: C0      	    RET NZ
03DD: 213602  	    LD HL, KEYMAP_CAPSLOCK
03E0: CD3B04  	    CALL DO_LOOKUP
03E3: 32A4FB  	    LD (KEY_PRESS), A
03E6: C9      	    RET
              	
              	
              	
              	
              	
03E7:         	CAPSLOCK:
03E7: 3AA3FB  	    LD A, (MEN_CAPSL)
03EA: FE00    	    CP 0
03EC: CAF603  	    JP Z, CAPSLOCK_OFF
03EF: AF      	    XOR A
03F0: 32A3FB  	    LD (MEN_CAPSL), A
03F3: C3FB03  	    JP CAPSLOCK_OK
03F6:         	CAPSLOCK_OFF:
03F6: 3E01    	    LD A, 1
03F8: 32A3FB  	    LD (MEN_CAPSL), A
03FB:         	CAPSLOCK_OK:
03FB: 116400  	    LD DE, $0064 ; 100ms
03FE: CD3F03  	    CALL H_Delay
0401: C9      	    RET
              	
              	
              	
              	
              	; LER TECLADO
              	; Aguarda até uma teclad for pressionada e retorna em A
0402:         	readKeyboarWaitPressA:
0402: CD4004  	    CALL    SCAN_MATRIX
0405: D20204  	    JP      NC, readKeyboarWaitPressA       ; Nenhuma tecla, continua
              	
              	    ; --- Primeira leitura positiva: aguarda debounce ---
0408: CD2F04  	    CALL    DEBOUNCE
              	
              	    ; --- Confirma que a tecla ainda está pressionada ---
040B: AF      	    XOR A
040C: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
040F: CD4004  	    CALL    SCAN_MATRIX
0412: D20204  	    JP      NC, readKeyboarWaitPressA       ; Foi ruído, descarta
              	
0415: CDB003  	    CALL GetKeycode
              	    
0418: CDB603  	    CALL checkShiftKey
              	    
              	    ; --- Aguarda soltar + debounce de release ---
041B:         	WAIT_RELEASE:
041B: CD4004  	    CALL    SCAN_MATRIX
041E: DA1B04  	    JP      C, WAIT_RELEASE     ; Ainda pressionada
0421: CD2F04  	    CALL    DEBOUNCE            ; Debounce do soltar
0424: CD4004  	    CALL    SCAN_MATRIX
0427: DA1B04  	    JP      C, WAIT_RELEASE     ; Bounce no release, volta a esperar
              	
042A: 3AA4FB  	    LD A, (KEY_PRESS)
042D: B7      	    OR A
042E: C9      	    RET
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  espera ~10 ms (calibrado para 7.3728 MHz)
              	;   Usa DE como contador, preserva BC
              	;   T-states totais ≈ 69.080  →  ~9.36 ms
              	; ============================================================
042F:         	DEBOUNCE:
042F: C5      	    PUSH    BC
0430: 0616    	    LD      B, DB_OUTER         ; B = contador externo
0432:         	DB_OUTER_LOOP:
0432: 0EF0    	    LD      C, DB_INNER         ; C = contador interno
0434:         	DB_INNER_LOOP:
0434: 0D      	    DEC     C                   ; 4 T
0435: 20FD    	    JR      NZ, DB_INNER_LOOP   ; 12 T (não salta) / 7 T (salta)
0437: 10F9    	    DJNZ    DB_OUTER_LOOP       ; 13 T (não salta) / 8 T (salta)
0439: C1      	    POP     BC
043A: C9      	    RET
              	
              	
              	; Pega char in table
043B:         	DO_LOOKUP:
043B: 1600    	    LD      D, 0
043D: 19      	    ADD     HL, DE
043E: 7E      	    LD      A, (HL)
043F: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_MATRIX
              	;   Varre 8 colunas, uma por vez (bit baixo = ativo)
              	;   Saída: B = col (0-7), C = row (0-7), Carry=1 se tecla
              	; ============================================================
0440:         	SCAN_MATRIX:
0440: 0600    	    LD      B, 0                ; Coluna atual
0442: 16FE    	    LD      D, 0xFE             ; Máscara: bit 0 baixo = col 0
0444:         	SCAN_COL:
0444: 7A      	    LD      A, D
0445: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0447: 00      	    NOP                         ; ~270 ns de estabilização
0448: 00      	    NOP
0449: 00      	    NOP
044A: 00      	    NOP
044B: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
044D: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
              	    
              	    ; LED CAPSLOCK
044E: F5      	    PUSH AF
044F: 3AA3FB  	    LD A, (MEN_CAPSL)
0452: FE00    	    CP 0 ; capslock 0=ON
0454: 2006    	    JR NZ, SCAN_COLSHIFT
0456: 3EF0    	    LD A, $F0
0458: D340    	    OUT     (KEYBOARD), A
045A: 00      	    NOP
045B: 00      	    NOP
045C:         	SCAN_COLSHIFT:
045C: AF      	    XOR A
045D: D340    	    OUT     (KEYBOARD), A
045F: F1      	    POP AF
              	    ; LED CAPSLOCK FIM
              	
              	    ; SHIFT
0460: F5      	    PUSH AF
0461: 7A      	    LD A, D
0462: FEFE    	    CP $FE
0464: C27704  	    JP NZ, FIM
0467: F1      	    POP AF
0468: F5      	    PUSH AF
0469: FE08    	    CP $08
046B: C27704  	    JP NZ, FIM
046E: 3E01    	    LD A, 1
0470: 32A2FB  	    LD (MEN_SHIFT), A
0473: F1      	    POP AF
0474: 3E00    	    LD A, 0
0476: F5      	    PUSH AF
              	    
0477:         	FIM:
0477: F1      		POP AF
              	    
0478: E6FF    	    AND     0xFF
047A: 280E    	    JR      Z, NEXT_COL         ; Nenhuma linha nesta coluna
              	    
              	    ; Encontrou linha — identifica bit
047C: 0E00    	    LD      C, 0
047E:         	FIND_ROW:
047E: 1F      	    RRA
047F: 3803    	    JR      C, ROW_FOUND
0481: 0C      	    INC     C
0482: 18FA    	    JR      FIND_ROW
              	
0484:         	ROW_FOUND:
0484: 3EFF    	    LD      A, 0xFF
0486: D340    	    OUT     (KEYBOARD), A           ; Desativa colunas
0488: 37      	    SCF                         ; Carry = 1
0489: C9      	    RET
              	
048A:         	NEXT_COL:
048A: 04      	    INC     B
048B: 78      	    LD      A, B
048C: FE08    	    CP      8
048E: 2809    	    JR      Z, SCAN_NONE        ; Todas varridas, nada encontrado
              	
              	    ; Rotaciona máscara para próxima coluna
0490: 7A      	    LD      A, D
0491: 37      	    SCF
0492: CB17    	    RL      A                   ; Desloca bit baixo para esquerda
0494: F601    	    OR      0x01                ; Garante que o bit 0 volta alto (inativo)
0496: 57      	    LD      D, A
0497: 18AB    	    JR      SCAN_COL
              	
0499:         	SCAN_NONE:
0499: 3EFF    	    LD      A, 0xFF
049B: D340    	    OUT     (KEYBOARD), A
049D: B7      	    OR      A                   ; Limpa Carry
049E: C9      	    RET
              	
              	
              	    
              	    
              	    
              	#include "GLCD.asm"
              	; Graphical LCD 128 x 64 Library
              	; ------------------------------
              	; By B. Chiha May-2023
              	; Modificações para funcionar no Z80 Mini - 2026
              	;
              	; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
              	;
              	; There are a few variants of these LCD screens, but they must all must use the ST7920
              	; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
              	; ST7921 Panels (128 x 32) stacked one above the other.
              	;
              	; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can 
              	; be displayed at the same time.
              	;
              	; The Pinout for the QC12864B board is as follows:
              	;
              	; Pin	Name	Desc                    Serial  Parallel
              	; ---   ----    -------------           ------  -------------
              	; 1     VSS     Ground                  GND     GND
              	; 2     VDD     Power                   5v      5v
              	; 3     V0      Contrast                N/A     N/A
              	; 4     D/I     IR/DR (CS)              5v      A7
              	; 5     R/W     R/W (SID)               D0      RD (inverted)
              	; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
              	; 7     DB0     Data                    N/A     D0
              	; 8     DB1     Data                    N/A     D1
              	; 9     DB2     Data                    N/A     D2
              	; 10    DB3     Data                    N/A     D3
              	; 11    DB4     Data                    N/A     D4
              	; 12    DB5     Data                    N/A     D5
              	; 13    DB6     Data                    N/A     D6
              	; 14    DB7     Data                    N/A     D7
              	; 15    PSB     Serial/Para             GND     5v
              	; 16    NC
              	; 17    RST     Reset                   RST     RST
              	; 18    VEE     LCD Drive               N/A     N/A
              	; 19    A       Backlight               5v/NC   5v/NC
              	; 20    K       Backlight               GND/NC  GND/NC
              	;
              	;
              	        
              	        
              	; Modifiable values.  Thse three values can be modified to suit your own set up
              	; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
              	; V_DELAY_US is the minimum delay needed for a command to be processed by the
              	; LCD board.  If only some of the data is being sent, make this value larger
              	        
              	;Port 7 on TEC is connected to LCD Enable (Pin 6)
              	;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
0010:         	V_DELAY_US: .equ $0010   ;Delay for 76us on your system
              	
              	; Dont need to modify anything else below.
00F8:         	UP:     .equ $F8                 ; Up Arrow
00F7:         	DN:     .equ $F7                 ; Down Arrow
000C:         	FF:     .equ 0CH                 ; Form Feed
008F:         	CURSOR: .equ 8FH                 ; Cursor
              	        
              	
              	
              	
              	
              	; --- CONOUT: Envia byte em A ---
049F:         	PUTCHAR:
049F:         	CONOUT:
049F: F5      	        PUSH AF
04A0: C5      	        PUSH BC
04A1: D5      	        PUSH DE
04A2: E5      	        PUSH HL
04A3: CD1208  	        CALL sendCharToLCD
04A6: E1      	        POP HL
04A7: D1      	        POP DE
04A8: C1      	        POP BC
04A9: F1      	        POP AF
04AA: C9      	        RET
              	
              	
              	; --- PUTS: Envia string terminada em NUL apontada por HL ---
04AB:         	PUTS:
04AB: F5      	        PUSH AF
04AC: C5      	        PUSH BC
04AD: D5      	        PUSH DE
04AE: E5      	        PUSH HL
04AF: 545D    	        LD DE, HL
04B1: 3E00    	        LD A, NUL
04B3: CD8208  	        CALL sendStringToLCD
04B6: E1      	        POP HL
04B7: D1      	        POP DE
04B8: C1      	        POP BC
04B9: F1      	        POP AF
04BA: C9      	        RET
              	
              	; --- CRLF: Envia CR+LF ---
04BB:         	CRLF:
04BB: 3E0D    	        LD   A, CR
04BD: CD9F04  	        CALL PUTCHAR
04C0: C9      	        RET
              	
              	
              	
              	; Initialise LCD
04C1:         	initLCD:
04C1: 215C0A  	        LD HL, INIT_BASIC       ;POINT HL TO LCD INITIALIZE TABLE
04C4: 0604    	        LD B, 04H               ;B=4 BYTES
04C6:         	NEXT_CMD:
04C6: 7E      	        LD A, (HL)
04C7: D370    	        OUT (GLCD_INST), A
04C9: CDCF07  	        CALL delayUS
04CC: 23      	        INC HL
04CD: 10F7    	        DJNZ NEXT_CMD
04CF: 114001  	        LD DE, 0140H            ;1.6 ms
04D2: CDD207  	        CALL delayMS
              	        
04D5: 2184F7  	        LD HL,GBUF              ;Set viewport
04D8: 2284FB  	        LD (VPORT),HL           ;to GBUF
              	
04DB: CDEE04  	        CALL clearGrLCD
              	        
              	; Clears the Graphics Memory Buffer
04DE:         	clearGBUF:
04DE: 2A84FB  	        LD HL, (VPORT)
04E1: ED5B84FB	        LD DE, (VPORT)
04E5: 13      	        INC DE
04E6: AF      	        XOR A
04E7: 77      	        LD (HL), A
04E8: 01FF03  	        LD BC, 03FFH
04EB: EDB0    	        LDIR
04ED: C9      	        RET
              	        
              	; Clears the Graphics LCD Buffer
