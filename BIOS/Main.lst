12CD: CD6A08  	            CALL sendCharToLCD
12D0: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
12D1:         	DUMP_CMD:
              	            ; DE aponta para argumentos
12D1: CD7415  	            CALL PARSE_HEX16_DE      ; HL = endereço
12D4: 3836    	            JR   C, DUMP_BAD_ADDR
12D6: 2214FC  	            LD   (ADDR_TMP), HL
              	
12D9: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
12DB:         	DUMP_LINE:
12DB: C5      	            PUSH BC
              	            ; Exibe endereço
12DC: 2A14FC  	            LD   HL, (ADDR_TMP)
12DF: CDCB15  	            CALL PRINT_HEX16
12E2: 3E3A    	            LD   A, ':'
12E4: CDF704  	            CALL PUTCHAR
12E7: 3E20    	            LD   A, SPACE
12E9: CDF704  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
12EC: 2A14FC  	            LD   HL, (ADDR_TMP)
12EF: 0E05    	            LD   C, 5
12F1:         	DUMP_HEX:
12F1: 7E      	            LD   A, (HL)
12F2: CDB015  	            CALL PRINT_HEX8
12F5: 3E20    	            LD   A, SPACE
12F7: CDF704  	            CALL PUTCHAR
12FA: 23      	            INC  HL
12FB: 0D      	            DEC  C
12FC: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
12FE: 2A14FC  	            LD   HL, (ADDR_TMP)
1301: 110500  	            LD   DE, 5
1304: 19      	            ADD  HL, DE
1305: 2214FC  	            LD   (ADDR_TMP), HL
1308: C1      	            POP  BC
1309: 10D0    	            DJNZ DUMP_LINE
130B: C9      	            RET
              	
130C:         	DUMP_BAD_ADDR:
