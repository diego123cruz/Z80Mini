2796:         	SET_DEFAULT_SERIAL_B:
2796: 213411  	    LD    HL,TXDATA_B
2799: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
279C: 214711  	    LD    HL,RXDATA_B
279F: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
