13C5: FE0D    	            CP   CR
13C7: 2844    	            JR   Z, GETLINE_DONE
13C9: FEF8    	            CP   $F8    ; ignora scroll up - GLCD
13CB: 28EB    	            JR   Z, LCD_SCROLL
13CD: FEF7    	            CP   $F7    ; ignora scroll down - GLCD
13CF: 28E7    	            JR   Z, LCD_SCROLL
