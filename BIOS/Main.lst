1248: C9      	    RET
              	
              	
              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
1249:         	LOAD_HEX_CMD;
1249: CD5A18  	    CALL loadInit
124C: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
124D:         	CALL_8000:
124D: 11CE02  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
1250: D5      	    PUSH DE
1251: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
1254:         	CLS_CMD:
1254: 3E0C    	            LD A, 0CH ; FF
1256: CDFA07  	            CALL sendCharToLCD
1259: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
125A:         	DUMP_CMD:
              	            ; DE aponta para argumentos
125A: CDFD14  	            CALL PARSE_HEX16_DE      ; HL = endereço
125D: 3836    	            JR   C, DUMP_BAD_ADDR
125F: 22FDFB  	            LD   (ADDR_TMP), HL
              	
1262: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
1264:         	DUMP_LINE:
1264: C5      	            PUSH BC
              	            ; Exibe endereço
1265: 2AFDFB  	            LD   HL, (ADDR_TMP)
1268: CD5415  	            CALL PRINT_HEX16
126B: 3E3A    	            LD   A, ':'
126D: CD8704  	            CALL PUTCHAR
1270: 3E20    	            LD   A, SPACE
1272: CD8704  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
1275: 2AFDFB  	            LD   HL, (ADDR_TMP)
1278: 0E05    	            LD   C, 5
127A:         	DUMP_HEX:
127A: 7E      	            LD   A, (HL)
127B: CD3915  	            CALL PRINT_HEX8
127E: 3E20    	            LD   A, SPACE
1280: CD8704  	            CALL PUTCHAR
1283: 23      	            INC  HL
1284: 0D      	            DEC  C
1285: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
1287: 2AFDFB  	            LD   HL, (ADDR_TMP)
128A: 110500  	            LD   DE, 5
128D: 19      	            ADD  HL, DE
128E: 22FDFB  	            LD   (ADDR_TMP), HL
1291: C1      	            POP  BC
1292: 10D0    	            DJNZ DUMP_LINE
1294: C9      	            RET
              	
1295:         	DUMP_BAD_ADDR:
1295: 215716  	            LD   HL, MSG_BAD_ADDR
1298: CD9304  	            CALL PUTS
129B: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
129C:         	LOAD_CMD:
129C: CDFD14  	            CALL PARSE_HEX16_DE
129F: 3848    	            JR   C, LOAD_BAD
12A1: 22FDFB  	            LD   (ADDR_TMP), HL
12A4: 218116  	            LD   HL, MSG_LOAD_HINT
12A7: CD9304  	            CALL PUTS
              	
12AA:         	LOAD_LOOP:
              	            ; Exibe endereço atual
12AA: 2AFDFB  	            LD   HL, (ADDR_TMP)
12AD: CD5415  	            CALL PRINT_HEX16
12B0: 3E3A    	            LD   A, ':'
12B2: CD8704  	            CALL PUTCHAR
12B5: 3E20    	            LD   A, SPACE
12B7: CD8704  	            CALL PUTCHAR
              	
12BA: CD3F14  	            CALL GETLINE             ; Lê linha
12BD: 21A7FB  	            LD   HL, LINEBUF
12C0: CD9C14  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
12C3: 7E      	            LD   A, (HL)
12C4: FE0D    	            CP   CR
12C6: C8      	            RET  Z
12C7: FE00    	            CP   NUL
12C9: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
12CA:         	LOAD_BYTE:
12CA: CDCB14  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
12CD: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
12CF: ED5BFDFB	            LD   DE, (ADDR_TMP)
12D3: 12      	            LD   (DE), A
12D4: 13      	            INC  DE
12D5: ED53FDFB	            LD   (ADDR_TMP), DE
12D9: CDAA14  	            CALL SKIP_SPACES_HL
12DC: 7E      	            LD   A, (HL)
12DD: FE0D    	            CP   CR
12DF: 28C9    	            JR   Z, LOAD_LOOP
12E1: FE00    	            CP   NUL
12E3: 28C5    	            JR   Z, LOAD_LOOP
12E5: 18E3    	            JR   LOAD_BYTE
              	
12E7:         	LOAD_NEXT_LINE:
12E7: 18C1    	            JR   LOAD_LOOP
              	
12E9:         	LOAD_BAD:
12E9: 215716  	            LD   HL, MSG_BAD_ADDR
12EC: CD9304  	            CALL PUTS
12EF: C9      	            RET
              	
              	; ============================================================
              	;  EDIT_CMD  -  Edita memória byte a byte
              	;  Sintaxe: EDIT xxxx
              	;  Exibe: XXXX: AA  _  (digitar novo valor ou Enter p/ manter)
              	;  '.' encerra
              	; ============================================================
12F0:         	EDIT_CMD:
12F0: CDFD14  	            CALL PARSE_HEX16_DE
12F3: 3849    	            JR   C, EDIT_BAD
12F5: 22FDFB  	            LD   (ADDR_TMP), HL
              	
12F8:         	EDIT_LOOP:
12F8: 2AFDFB  	            LD   HL, (ADDR_TMP)
