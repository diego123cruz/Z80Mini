2450: 2A3AFC  	    LD HL, (FS_TMPSZ)
2453: 7C      	    LD A, H
2454: B7      	    OR A
2455: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
2457: 7D      	    LD A, L
2458: FEFF    	    CP FS_DATAPG            ; L < 255?
245A: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
245C:         	FS_WP_USE255:
