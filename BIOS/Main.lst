134E: FE1B    	            CP   ESC
1350: 28E9    	            JR   Z, GETLINE_LOOP    ; Ignora
1352: FEFF    	            CP   $FF ;capslock Ignora
1354: CA3B13  	            JP   Z, GETLINE_LOOP
1357: FE08    	            CP   BkS
1359: 281D    	            JR   Z, GETLINE_BS
135B: FE7F    	            CP   DEL
135D: 2819    	            JR   Z, GETLINE_BS
135F: FEFA    	            CP   $FA ; AltGr
1361: CA4516  	            JP   Z, CALL_IHEX
1364: FEF9    	            CP   $F9 ; LUZ
1366: CA7411  	            JP   Z, CALL_8000
1369: 4F      	            LD   C, A
136A: 78      	            LD   A, B
136B: FE00    	            CP   0
136D: 28CC    	            JR   Z, GETLINE_LOOP    ; Buffer cheio
136F: 79      	            LD   A, C
1370: 77      	            LD   (HL), A
1371: 23      	            INC  HL
