02B7: CD1605  	    CALL setGrMode
02BA: CDC807  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02BD: 010000  	    LD BC, $0000
02C0: CDBA08  	    CALL setCursor
02C3: 114527  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02C6: 3E00    	    LD A, 0
02C8: 3298FB  	    LD (CURSOR_ON), A
              	    ; send cursor
02CB: CD6A08  	    CALL sendStringToLCD
              	
              	
02CE:         	MAIN_LOOP:
02CE: CDEF02  	    CALL showCurrentDriver
              	
02D1: CD3F14  	    CALL GETLINE             ; Lê linha em LINEBUF
02D4: CDE410  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02D7: C3CE02  	    JP      MAIN_LOOP
              	
              	
02DA:         	M_C_DIR_C:
02DA: 0611    	    LD B, FS_NAME_SZ + 1
02DC: 2145FD  	    LD HL, FS_DIR_NAME
02DF: 115A27  	    LD DE, FOLDER_HOME
02E2:         	M_C_DIR:
02E2: 1A      	    LD A, (DE)
02E3: FE00    	    CP 0
02E5: 2805    	    JR Z, M_C_DIR_F
02E7: 77      	    LD (HL), A
02E8: 23      	    INC HL
02E9: 13      	    INC DE
02EA: 10F6    	    djnz M_C_DIR
02EC:         	M_C_DIR_F:
02EC: AF      	    XOR A
02ED: 77      	    LD (HL), A
02EE: C9      	    RET
              	
              	
02EF:         	showCurrentDriver:
02EF: 3A04FC  	    LD A, (I2CA_BLOCK)
02F2: FEA0    	    CP EEDRIVE_A  ; Drive A
02F4: 281D    	    JR Z, showDriveA
02F6: FEA2    	    CP EEDRIVE_B  ; Drive B
02F8: 281D    	    JR Z, showDriveB
02FA: FEA4    	    CP EEDRIVE_C  ; Drive C
02FC: 281D    	    JR Z, showDriveC
02FE: FEA6    	    CP EEDRIVE_D  ; Drive D
0300: 281D    	    JR Z, showDriveD
0302: FEA8    	    CP EEDRIVE_E  ; Drive E
0304: 281D    	    JR Z, showDriveE
0306: FEAC    	    CP EEDRIVE_F  ; Drive F
0308: 281D    	    JR Z, showDriveF
030A: FEAE    	    CP EEDRIVE_G  ; Drive G
030C: 281D    	    JR Z, showDriveG
030E: FEAA    	    CP EEDRIVE_Z  ; Drive Z
0310: 281D    	    JR Z, showDriveZ
0312: C9      	    RET
              	
0313:         	showDriveA:
0313: 3E41    	    LD A, 'A'
0315: 181C    	    JR showCursor
0317:         	showDriveB:
0317: 3E42    	    LD A, 'B'
0319: 1818    	    JR showCursor
031B:         	showDriveC:
031B: 3E43    	    LD A, 'C'
031D: 1814    	    JR showCursor
031F:         	showDriveD:
031F: 3E44    	    LD A, 'D'
0321: 1810    	    JR showCursor
0323:         	showDriveE:
0323: 3E45    	    LD A, 'E'
0325: 180C    	    JR showCursor
0327:         	showDriveF:
0327: 3E46    	    LD A, 'F'
0329: 1808    	    JR showCursor
032B:         	showDriveG:
032B: 3E47    	    LD A, 'G'
032D: 1804    	    JR showCursor
032F:         	showDriveZ:
032F: 3E5A    	    LD A, 'Z'
0331: 1800    	    JR showCursor
0333:         	showCursor:
0333: CDFA07  	    CALL sendCharToLCD
0336: 3E3A    	    LD A, ':'
0338: CDFA07  	    CALL sendCharToLCD
033B: C9      	    RET
              	
              	
              	
033C:         	resetCollisionPixel:
033C: AF      	    XOR A
033D: 3241FD  	    LD (DRAW_PIXEL_COLLISION), A
0340: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
0341:         	checkCollisionPixel:
0341: 3A41FD  	    LD A, (DRAW_PIXEL_COLLISION)
0344: B7      	    OR A
0345: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
0346: F5      	H_Delay:    PUSH AF
0347: C5      	            PUSH BC
0348: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
0349: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
034C: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
034D: 79      	            LD   A,C            ;[4]     [4]
034E: B0      	            OR   B              ;[4]     [4]
034F: C24C03  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
0352: 1B      	            DEC  DE             ;[6]     [4]
0353: 7B      	            LD   A,E            ;[4]     [4]
0354: B2      	            OR   D              ;[4]     [4]
0355: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
0357: D1      	            POP  DE
0358: C1      	            POP  BC
0359: F1      	            POP  AF
035A: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       On exit: If press A = CTRLC and NZ flagged
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
035B:         	CHKKEY:
035B: 3EFE    	    LD      A, 0xFE             ; Máscara: bit 0 baixo = col 0
035D: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
035F: 00      	    NOP                         ; ~270 ns de estabilização
0360: 00      	    NOP
0361: 00      	    NOP
0362: 00      	    NOP
0363: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0365: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
0366: FE01    	    CP 1
0368: C27003  	    jp nz, GRET
036B: 3E03    		LD  A, CTRLC
036D: FE00    		CP	0
036F: C9      		RET
0370:         	GRET:
0370: 3E00    		LD  A, 0
0372: FE00    		CP 0
0374: C9      		RET
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
0375:         	CONIN:
0375: C5      	    PUSH BC
0376: D5      	    PUSH DE
0377: E5      	    PUSH HL
0378: CDFC03  	    CALL readKeyboarWaitPressA
037B: E1      	    POP HL
037C: D1      	    POP DE
037D: C1      	    POP BC
037E: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
037F:         	CONIN_NOT_LOOP:
037F: C5      	    PUSH BC
0380: D5      	    PUSH DE
0381: E5      	    PUSH HL
0382: CD8903  	    CALL readKeyboarPressA
0385: E1      	    POP HL
0386: D1      	    POP DE
0387: C1      	    POP BC
0388: C9      	    RET
              	
              	
0389:         	readKeyboarPressA;
0389: AF      	    XOR A
038A: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
038D: CD3A04  	    CALL    SCAN_MATRIX
0390: D0      	    RET      NC
0391: CD9C03  	    CALl GetKeycode
0394: CDA203  	    CALL checkShiftKey
0397: 3AA4FB  	    LD A, (KEY_PRESS)
039A: 37      	    SCF  ; Carry = 1
039B: C9      	    RET
              	
              	
              	
              	; A = col*8 + row  (0x00 – 0x3F)
039C:         	GetKeycode:
              	    ; --- Tecla confirmada: calcula keycode ---
              	    ; col*8 + row  (0x00 – 0x3F)
039C: 78      	    LD      A, B                ; B = coluna
039D: 87      	    ADD     A, A                ; ×2
039E: 87      	    ADD     A, A                ; ×4
039F: 87      	    ADD     A, A                ; ×8
03A0: 81      	    ADD     A, C                ; + linha (C) = keycode
03A1: C9      	    RET
              	
              	
              	; Verifica se shift e recupera ascii
              	;   Salva tecla em KEY_PRESS
03A2:         	checkShiftKey:
              	    ; Verifica Shift
03A2: 5F      	    LD E, A
03A3: 21B601  	    LD HL, KEYMAP_NORMAL
03A6: 3AA2FB  	    LD A, (MEN_SHIFT)
03A9: FE01    	    CP 1
03AB: C2B803  	    JP NZ, NO_SHIFT
03AE: 21F601  	    LD HL, KEYMAP_SHIFT
03B1: CD3504  	    CALL DO_LOOKUP
03B4: 32A4FB  	    LD (KEY_PRESS), A
03B7: C9      	    RET
03B8:         	NO_SHIFT:
03B8: CD3504  	    CALL 	DO_LOOKUP	; pega tecla
03BB: 32A4FB  	    LD (KEY_PRESS), A
03BE: FEFF    	    CP $FF ;capslook?
03C0: CAD303  	    JP Z, CAPSLOCK
03C3: 3AA3FB  	    LD A, (MEN_CAPSL)
03C6: FE00    	    CP 0
03C8: C0      	    RET NZ
03C9: 213602  	    LD HL, KEYMAP_CAPSLOCK
03CC: CD3504  	    CALL DO_LOOKUP
03CF: 32A4FB  	    LD (KEY_PRESS), A
03D2: C9      	    RET
              	
              	
              	
              	
              	
03D3:         	CAPSLOCK:
03D3: 3AA3FB  	    LD A, (MEN_CAPSL)
03D6: FE00    	    CP 0
03D8: CAE903  	    JP Z, CAPSLOCK_OFF
03DB: AF      	    XOR A
03DC: 32A3FB  	    LD (MEN_CAPSL), A
03DF: 010306  	    LD BC, $0603
03E2: ED43A5FB	    LD (MEN_CURSR), BC
03E6: C3F503  	    JP CAPSLOCK_OK
03E9:         	CAPSLOCK_OFF:
03E9: 3E01    	    LD A, 1
03EB: 32A3FB  	    LD (MEN_CAPSL), A
03EE: 010606  	    LD BC, $0606
03F1: ED43A5FB	    LD (MEN_CURSR), BC
03F5:         	CAPSLOCK_OK:
03F5: 116400  	    LD DE, $0064 ; 100ms
03F8: CD4603  	    CALL H_Delay
03FB: C9      	    RET
              	
              	
              	
              	
              	; LER TECLADO
              	; Aguarda até uma teclad for pressionada e retorna em A
03FC:         	readKeyboarWaitPressA:
03FC: CD3A04  	    CALL    SCAN_MATRIX
03FF: D2FC03  	    JP      NC, readKeyboarWaitPressA       ; Nenhuma tecla, continua
              	
              	    ; --- Primeira leitura positiva: aguarda debounce ---
0402: CD2904  	    CALL    DEBOUNCE
              	
              	    ; --- Confirma que a tecla ainda está pressionada ---
0405: AF      	    XOR A
0406: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
0409: CD3A04  	    CALL    SCAN_MATRIX
040C: D2FC03  	    JP      NC, readKeyboarWaitPressA       ; Foi ruído, descarta
              	
040F: CD9C03  	    CALL GetKeycode
              	    
0412: CDA203  	    CALL checkShiftKey
              	    
              	    ; --- Aguarda soltar + debounce de release ---
0415:         	WAIT_RELEASE:
0415: CD3A04  	    CALL    SCAN_MATRIX
0418: DA1504  	    JP      C, WAIT_RELEASE     ; Ainda pressionada
041B: CD2904  	    CALL    DEBOUNCE            ; Debounce do soltar
041E: CD3A04  	    CALL    SCAN_MATRIX
0421: DA1504  	    JP      C, WAIT_RELEASE     ; Bounce no release, volta a esperar
              	
0424: 3AA4FB  	    LD A, (KEY_PRESS)
0427: B7      	    OR A
0428: C9      	    RET
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  espera ~10 ms (calibrado para 7.3728 MHz)
              	;   Usa DE como contador, preserva BC
              	;   T-states totais ≈ 69.080  →  ~9.36 ms
              	; ============================================================
0429:         	DEBOUNCE:
0429: C5      	    PUSH    BC
042A: 0616    	    LD      B, DB_OUTER         ; B = contador externo
042C:         	DB_OUTER_LOOP:
042C: 0EF0    	    LD      C, DB_INNER         ; C = contador interno
042E:         	DB_INNER_LOOP:
042E: 0D      	    DEC     C                   ; 4 T
042F: 20FD    	    JR      NZ, DB_INNER_LOOP   ; 12 T (não salta) / 7 T (salta)
0431: 10F9    	    DJNZ    DB_OUTER_LOOP       ; 13 T (não salta) / 8 T (salta)
0433: C1      	    POP     BC
0434: C9      	    RET
              	
              	
              	; Pega char in table
0435:         	DO_LOOKUP:
0435: 1600    	    LD      D, 0
0437: 19      	    ADD     HL, DE
0438: 7E      	    LD      A, (HL)
0439: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_MATRIX
              	;   Varre 8 colunas, uma por vez (bit baixo = ativo)
              	;   Saída: B = col (0-7), C = row (0-7), Carry=1 se tecla
              	; ============================================================
043A:         	SCAN_MATRIX:
043A: 0600    	    LD      B, 0                ; Coluna atual
043C: 16FE    	    LD      D, 0xFE             ; Máscara: bit 0 baixo = col 0
043E:         	SCAN_COL:
043E: 7A      	    LD      A, D
043F: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0441: 00      	    NOP                         ; ~270 ns de estabilização
0442: 00      	    NOP
0443: 00      	    NOP
0444: 00      	    NOP
0445: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0447: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
              	    
              	    ; SHIFT
0448: F5      	    PUSH AF
0449: 7A      	    LD A, D
044A: FEFE    	    CP $FE
044C: C25F04  	    JP NZ, FIM
044F: F1      	    POP AF
0450: F5      	    PUSH AF
0451: FE08    	    CP $08
0453: C25F04  	    JP NZ, FIM
0456: 3E01    	    LD A, 1
0458: 32A2FB  	    LD (MEN_SHIFT), A
045B: F1      	    POP AF
045C: 3E00    	    LD A, 0
045E: F5      	    PUSH AF
              	    
045F:         	FIM:
045F: F1      		POP AF
              	    
0460: E6FF    	    AND     0xFF
0462: 280E    	    JR      Z, NEXT_COL         ; Nenhuma linha nesta coluna
              	    
              	    ; Encontrou linha — identifica bit
0464: 0E00    	    LD      C, 0
0466:         	FIND_ROW:
0466: 1F      	    RRA
0467: 3803    	    JR      C, ROW_FOUND
0469: 0C      	    INC     C
046A: 18FA    	    JR      FIND_ROW
              	
046C:         	ROW_FOUND:
046C: 3EFF    	    LD      A, 0xFF
046E: D340    	    OUT     (KEYBOARD), A           ; Desativa colunas
0470: 37      	    SCF                         ; Carry = 1
0471: C9      	    RET
              	
0472:         	NEXT_COL:
0472: 04      	    INC     B
0473: 78      	    LD      A, B
0474: FE08    	    CP      8
0476: 2809    	    JR      Z, SCAN_NONE        ; Todas varridas, nada encontrado
              	
              	    ; Rotaciona máscara para próxima coluna
0478: 7A      	    LD      A, D
0479: 37      	    SCF
047A: CB17    	    RL      A                   ; Desloca bit baixo para esquerda
047C: F601    	    OR      0x01                ; Garante que o bit 0 volta alto (inativo)
047E: 57      	    LD      D, A
047F: 18BD    	    JR      SCAN_COL
              	
0481:         	SCAN_NONE:
0481: 3EFF    	    LD      A, 0xFF
0483: D340    	    OUT     (KEYBOARD), A
0485: B7      	    OR      A                   ; Limpa Carry
0486: C9      	    RET
              	
              	
              	    
              	    
              	    
              	#include "GLCD.asm"
              	; Graphical LCD 128 x 64 Library
              	; ------------------------------
              	; By B. Chiha May-2023
              	; Modificações para funcionar no Z80 Mini - 2026
              	;
              	; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
              	;
              	; There are a few variants of these LCD screens, but they must all must use the ST7920
              	; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
              	; ST7921 Panels (128 x 32) stacked one above the other.
              	;
              	; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can 
              	; be displayed at the same time.
              	;
              	; The Pinout for the QC12864B board is as follows:
              	;
              	; Pin	Name	Desc                    Serial  Parallel
              	; ---   ----    -------------           ------  -------------
              	; 1     VSS     Ground                  GND     GND
              	; 2     VDD     Power                   5v      5v
              	; 3     V0      Contrast                N/A     N/A
              	; 4     D/I     IR/DR (CS)              5v      A7
              	; 5     R/W     R/W (SID)               D0      RD (inverted)
              	; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
              	; 7     DB0     Data                    N/A     D0
              	; 8     DB1     Data                    N/A     D1
              	; 9     DB2     Data                    N/A     D2
              	; 10    DB3     Data                    N/A     D3
              	; 11    DB4     Data                    N/A     D4
              	; 12    DB5     Data                    N/A     D5
              	; 13    DB6     Data                    N/A     D6
              	; 14    DB7     Data                    N/A     D7
              	; 15    PSB     Serial/Para             GND     5v
              	; 16    NC
              	; 17    RST     Reset                   RST     RST
              	; 18    VEE     LCD Drive               N/A     N/A
              	; 19    A       Backlight               5v/NC   5v/NC
              	; 20    K       Backlight               GND/NC  GND/NC
              	;
              	;
              	        
              	        
              	; Modifiable values.  Thse three values can be modified to suit your own set up
              	; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
              	; V_DELAY_US is the minimum delay needed for a command to be processed by the
              	; LCD board.  If only some of the data is being sent, make this value larger
              	        
              	;Port 7 on TEC is connected to LCD Enable (Pin 6)
              	;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
0010:         	V_DELAY_US: .equ $0010   ;Delay for 76us on your system
              	
              	; Dont need to modify anything else below.
00F8:         	UP:     .equ $F8                 ; Up Arrow
00F7:         	DN:     .equ $F7                 ; Down Arrow
000C:         	FF:     .equ 0CH                 ; Form Feed
008F:         	CURSOR: .equ 8FH                 ; Cursor
              	        
              	
              	
              	
              	
              	; --- CONOUT: Envia byte em A ---
0487:         	PUTCHAR:
0487:         	CONOUT:
0487: F5      	        PUSH AF
0488: C5      	        PUSH BC
0489: D5      	        PUSH DE
048A: E5      	        PUSH HL
048B: CDFA07  	        CALL sendCharToLCD
048E: E1      	        POP HL
048F: D1      	        POP DE
0490: C1      	        POP BC
0491: F1      	        POP AF
0492: C9      	        RET
              	
              	
              	; --- PUTS: Envia string terminada em NUL apontada por HL ---
0493:         	PUTS:
0493: F5      	        PUSH AF
0494: C5      	        PUSH BC
0495: D5      	        PUSH DE
0496: E5      	        PUSH HL
0497: 545D    	        LD DE, HL
0499: 3E00    	        LD A, NUL
049B: CD6A08  	        CALL sendStringToLCD
049E: E1      	        POP HL
049F: D1      	        POP DE
04A0: C1      	        POP BC
04A1: F1      	        POP AF
04A2: C9      	        RET
              	
              	; --- CRLF: Envia CR+LF ---
04A3:         	CRLF:
04A3: 3E0D    	        LD   A, CR
04A5: CD8704  	        CALL PUTCHAR
04A8: C9      	        RET
              	
              	
              	
              	; Initialise LCD
04A9:         	initLCD:
04A9: 21450A  	        LD HL, INIT_BASIC       ;POINT HL TO LCD INITIALIZE TABLE
04AC: 0604    	        LD B, 04H               ;B=4 BYTES
04AE:         	NEXT_CMD:
04AE: 7E      	        LD A, (HL)
04AF: D370    	        OUT (GLCD_INST), A
04B1: CDB707  	        CALL delayUS
04B4: 23      	        INC HL
04B5: 10F7    	        DJNZ NEXT_CMD
04B7: 114001  	        LD DE, 0140H            ;1.6 ms
04BA: CDBA07  	        CALL delayMS
              	        
04BD: 2184F7  	        LD HL,GBUF              ;Set viewport
04C0: 2284FB  	        LD (VPORT),HL           ;to GBUF
              	
04C3: CDD604  	        CALL clearGrLCD
              	        
              	; Clears the Graphics Memory Buffer
04C6:         	clearGBUF:
04C6: 2A84FB  	        LD HL, (VPORT)
04C9: ED5B84FB	        LD DE, (VPORT)
04CD: 13      	        INC DE
04CE: AF      	        XOR A
04CF: 77      	        LD (HL), A
04D0: 01FF03  	        LD BC, 03FFH
04D3: EDB0    	        LDIR
04D5: C9      	        RET
              	        
              	; Clears the Graphics LCD Buffer
04D6:         	clearGrLCD:
04D6: CD1605  	        CALL setGrMode
04D9: 0E00    	        LD C, 00H
04DB:         	CLR_X:
04DB: 3E80    	        LD A, 80H
04DD: B1      	        OR C
04DE: D370    	        OUT (GLCD_INST), A
04E0: CDB707  	        CALL delayUS
04E3: 3E80    	        LD A, 80H
04E5: D370    	        OUT (GLCD_INST), A
04E7: CDB707  	        CALL delayUS
04EA: AF      	        XOR A                   ;Clear Byte
04EB: 0610    	        LD B, 10H
04ED:         	CLR_Y:
04ED: D371    	        OUT (GLCD_DATA), A
04EF: CDB707  	        CALL delayUS
04F2: D371    	        OUT (GLCD_DATA), A
04F4: CDB707  	        CALL delayUS
04F7: 10F4    	        DJNZ CLR_Y
04F9: 0C      	        INC C
04FA: 79      	        LD A, C
04FB: FE20    	        CP 20H
04FD: 20DC    	        JR NZ, CLR_X        
04FF: C9      	        RET
              	
              	; Clears the ASCII Text LCD
0500:         	clearTxtLCD:
