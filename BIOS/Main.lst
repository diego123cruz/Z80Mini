232B: C9      	    RET
              	
              	; FS_RD_ENTRY: Le entrada FS_CUR → FS_WRKBUF
              	;   EEPROM addr = $0100 + FS_CUR*32
              	;   On exit: Z=OK  NZ=erro
232C:         	FS_RD_ENTRY:
232C: C5      	    PUSH BC
232D: D5      	    PUSH DE
232E: E5      	    PUSH HL
232F: 3A20FC  	    LD A, (FS_CUR)
2332: 07      	    RLCA
2333: 07      	    RLCA
2334: 07      	    RLCA
2335: 07      	    RLCA
2336: 07      	    RLCA                    ; A = FS_CUR * 32
2337: 5F      	    LD E, A
2338: 3A5BFD  	    LD A, (FS_DIR_CUR)
233B: 57      	    LD D, A ; $01
233C: 2121FC  	    LD HL, FS_WRKBUF
233F: 012000  	    LD BC, FS_ENTRY_SZ
2342: CD4F1D  	    CALL I2C_MemRd
2345: E1      	    POP HL
2346: D1      	    POP DE
2347: C1      	    POP BC
2348: C9      	    RET
              	
              	
