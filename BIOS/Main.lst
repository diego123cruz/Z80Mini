1EBB: CDBE1D  	    CALL HexOut
1EBE: 7D      	    LD A, L
1EBF: CDBE1D  	    CALL HexOut
1EC2: 3E68    	    LD A, 'h'
1EC4: CF      	    RST $08
1EC5: 217127  	    LD HL, str_inf_bytes_nl
1EC8: CD0305  	    CALL PUTS
1ECB: C9      	    RET
              	
              	
              	
              	; **********************************************************************
