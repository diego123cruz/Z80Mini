2466: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
2467: 2140FC  	    LD HL, PG_BUF
246A: 3600    	    LD (HL), $00            ; byte 0 = next = $00
246C: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
246D: DD2A3AFC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
2471: 5A      	    LD E, D                 ; E = contador de copia
2472:         	FS_WP_CPLOOP:
2472: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
2475: 77      	    LD (HL), A              ; grava no PG_BUF
2476: DD23    	    INC IX
2478: 23      	    INC HL
2479: 1D      	    DEC E
247A: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
247C: 3EFF    	    LD A, FS_DATAPG         ; 255
247E: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
247F: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
2481: 5F      	    LD E, A
2482:         	FS_WP_PADLOOP:
2482: 36FF    	    LD (HL), $FF
2484: 23      	    INC HL
2485: 1D      	    DEC E
2486: 20FA    	    JR NZ, FS_WP_PADLOOP
2488:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
2488: F1      	    POP AF                  ; A = numero da pagina
2489: F5      	    PUSH AF
248A: 57      	    LD D, A
248B: 1E00    	    LD E, 0
248D: 2140FC  	    LD HL, PG_BUF
2490: 010001  	    LD BC, 256
2493: CD2F1D  	    CALL I2C_MemWr
2496: C2C324  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
2499: F1      	    POP AF                  ; A = pagina (descarta)
249A: E1      	    POP HL                  ; restaura HL original
249B: D1      	    POP DE                  ; restaura DE original
249C: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
249D: 2A38FC  	    LD HL, (FS_TMPSZ)
24A0: 7C      	    LD A, H
24A1: B7      	    OR A
24A2: 2005    	    JR NZ, FS_WP_UPD255
24A4: 7D      	    LD A, L
24A5: FEFF    	    CP FS_DATAPG
24A7: 3805    	    JR C, FS_WP_UPDLT
24A9:         	FS_WP_UPD255:
24A9: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
24AC: 1803    	    JR FS_WP_UPDATE
24AE:         	FS_WP_UPDLT:
24AE: 0600    	    LD B, 0
24B0: 4D      	    LD C, L                 ; bytes gravados = L
              	
24B1:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
24B1: 2A3AFC  	    LD HL, (FS_TMPRAM)
24B4: 09      	    ADD HL, BC
24B5: 223AFC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
24B8: 2A38FC  	    LD HL, (FS_TMPSZ)
24BB: B7      	    OR A                    ; limpa carry
24BC: ED42    	    SBC HL, BC
24BE: 2238FC  	    LD (FS_TMPSZ), HL
24C1: AF      	    XOR A                   ; Z = sucesso
24C2: C9      	    RET
              	
24C3:         	FS_WP_ERR:
24C3: F1      	    POP AF
24C4: E1      	    POP HL
24C5: D1      	    POP DE
24C6: C1      	    POP BC
24C7: 3E01    	    LD A, 1
24C9: B7      	    OR A
24CA: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
24CB:         	FS_SET_NEXT:
24CB: C5      	    PUSH BC
24CC: D5      	    PUSH DE
24CD: E5      	    PUSH HL
24CE: 57      	    LD D, A
24CF: 1E00    	    LD E, 0
24D1: 78      	    LD A, B
24D2: 3237FC  	    LD (FS_TMP1), A
24D5: 2137FC  	    LD HL, FS_TMP1
24D8: 010100  	    LD BC, 1
24DB: CD2F1D  	    CALL I2C_MemWr
24DE: E1      	    POP HL
24DF: D1      	    POP DE
24E0: C1      	    POP BC
24E1: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
24E2:         	FS_FIND_NAME:
24E2: AF      	    XOR A
24E3: 3207FC  	    LD (FS_CUR), A
24E6: 0608    	    LD B, FS_MAXFILES
24E8:         	FS_FN_LP:
24E8: C5      	    PUSH BC
24E9: CDD422  	    CALL FS_RD_ENTRY
24EC: C21B25  	    JP NZ, FS_FN_ERR
24EF: 3A1DFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
24F2: FE01    	    CP FS_FLAG_USED
24F4: 2017    	    JR NZ, FS_FN_NXT
24F6: 2128FC  	    LD HL, FS_NAMBUF
24F9: 1108FC  	    LD DE, FS_WRKBUF + FS_O_NAME
24FC: 0E10    	    LD C, FS_NAME_SZ
24FE:         	FS_FN_CMP:
24FE: 7E      	    LD   A, (HL)
24FF: 47      	    LD   B, A
2500: 1A      	    LD   A, (DE)
2501: B8      	    CP   B
2502: C20D25  	    JP  NZ, FS_FN_NXT
2505: 23      	    INC HL
2506: 13      	    INC DE
2507: 0D      	    DEC C
2508: 20F4    	    JR NZ, FS_FN_CMP
250A: C1      	    POP BC
250B: AF      	    XOR A
250C: C9      	    RET
250D:         	FS_FN_NXT:
250D: 3A07FC  	    LD A, (FS_CUR)
2510: 3C      	    INC A
2511: 3207FC  	    LD (FS_CUR), A
2514: C1      	    POP BC
2515: 10D1    	    DJNZ FS_FN_LP
2517: 3E01    	    LD A, 1
2519: B7      	    OR A
251A: C9      	    RET
251B:         	FS_FN_ERR:
251B: C1      	    POP BC
251C: 3E03    	    LD A, ERR_TOUT
251E: B7      	    OR A
251F: C9      	    RET
              	
              	
              	
              	
              	; FS_FIND_FOLDER_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
2520:         	FS_FIND_FOLDER_NAME:
2520: AF      	    XOR A
2521: 3207FC  	    LD (FS_CUR), A
2524: 0608    	    LD B, FS_MAXFILES
2526:         	FS_FFN_LP:
2526: C5      	    PUSH BC
2527: CDD422  	    CALL FS_RD_ENTRY
252A: C25925  	    JP NZ, FS_FFN_ERR
252D: 3A1DFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
2530: FE02    	    CP FS_FLAG_USED_FOLDER
2532: 2017    	    JR NZ, FS_FFN_NXT
2534: 2128FC  	    LD HL, FS_NAMBUF
2537: 1108FC  	    LD DE, FS_WRKBUF + FS_O_NAME
253A: 0E10    	    LD C, FS_NAME_SZ
253C:         	FS_FFN_CMP:
253C: 7E      	    LD   A, (HL)
253D: 47      	    LD   B, A
253E: 1A      	    LD   A, (DE)
253F: B8      	    CP   B
2540: C24B25  	    JP  NZ, FS_FFN_NXT
2543: 23      	    INC HL
2544: 13      	    INC DE
2545: 0D      	    DEC C
2546: 20F4    	    JR NZ, FS_FFN_CMP
2548: C1      	    POP BC
2549: AF      	    XOR A
254A: C9      	    RET
254B:         	FS_FFN_NXT:
254B: 3A07FC  	    LD A, (FS_CUR)
254E: 3C      	    INC A
254F: 3207FC  	    LD (FS_CUR), A
2552: C1      	    POP BC
2553: 10D1    	    DJNZ FS_FFN_LP
2555: 3E01    	    LD A, 1
2557: B7      	    OR A
2558: C9      	    RET
2559:         	FS_FFN_ERR:
2559: C1      	    POP BC
255A: 3E03    	    LD A, ERR_TOUT
255C: B7      	    OR A
255D: C9      	    RET
              	
              	
              	
              	
              	
