0109: C3611A  	    JP I2C_Close
010C: C3AB1A  	    JP I2C_Read
010F: C36E1A  	    JP I2C_Write
              	    ;   Keyboard
0112: C35503  	    JP CHKKEY
0115: C36F03  	    JP CONIN
0118: C37903  	    JP CONIN_NOT_LOOP
              	    ;   Serial
