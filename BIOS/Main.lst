              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
1E2A:         	FS_WRITE_PG:
1E2A: C5      	    PUSH BC
1E2B: D5      	    PUSH DE
1E2C: E5      	    PUSH HL
1E2D: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
1E2E: 2A35FC  	    LD HL, (FS_TMPSZ)
1E31: 7C      	    LD A, H
1E32: B7      	    OR A
1E33: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
1E35: 7D      	    LD A, L
1E36: FEFF    	    CP FS_DATAPG            ; L < 255?
1E38: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
