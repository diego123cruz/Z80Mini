0270:         	INICIO:
0270: 21AD01  	    LD HL, INT_DEFAULT
0273: 2200F0  	    LD (RST38), HL
0276: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
0279: 3EA0    	    LD A, EEDRIVE_A
027B: 3204FC  	    LD (I2CA_BLOCK), A     
              	
027E: 3E01    	    LD A, 1 ;capslock OFF
0280: 32A3FB  	    LD (MEN_CAPSL), A
0283: 010606  	    LD BC, $0606
0286: ED43A5FB	    LD (MEN_CURSR), BC   
              	
              	    ;CALL FS_CHK_SIG
              	    ;JP Z, INICIO1
              	    ;LD HL, str_notfmt
              	    ;CALL PUTS
028A:         	INICIO1:
              	
028A: 31F0FF  	    LD SP, SYSTEM_SP
              	
028D: 116400  	    LD DE, $0064 ; 100ms
0290: CD1703  	    CALL H_Delay
              	
              	    ;Init Serial
0293: CD1A10  	    CALL initSerial
              	
              	    ;Init Teclado
0296: 3EFF    	    LD      A, 0xFF
0298: D340    	    OUT     (KEYBOARD), A           ; Todas as colunas desativadas
              	
              	    ; Init LCD
029A: CD9E07  	    CALL initTerminal
029D: CDE704  	    CALL setGrMode
02A0: CD9907  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02A3: 010000  	    LD BC, $0000
02A6: CD8B08  	    CALL setCursor
02A9: 114023  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02AC: 3E00    	    LD A, 0
02AE: 3298FB  	    LD (CURSOR_ON), A
              	    ; send cursor
02B1: CD3B08  	    CALL sendStringToLCD
              	
              	
02B4:         	MAIN_LOOP:
02B4: CDC002  	    CALL showCurrentDriver
              	
02B7: CDBD13  	    CALL GETLINE             ; Lê linha em LINEBUF
02BA: CDB510  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02BD: C3B402  	    JP      MAIN_LOOP
              	
              	
02C0:         	showCurrentDriver:
02C0: 3A04FC  	    LD A, (I2CA_BLOCK)
02C3: FEA0    	    CP EEDRIVE_A  ; Drive A
02C5: 281D    	    JR Z, showDriveA
02C7: FEA2    	    CP EEDRIVE_B  ; Drive B
02C9: 281D    	    JR Z, showDriveB
02CB: FEA4    	    CP EEDRIVE_C  ; Drive C
02CD: 281D    	    JR Z, showDriveC
02CF: FEA6    	    CP EEDRIVE_D  ; Drive D
02D1: 281D    	    JR Z, showDriveD
02D3: FEA8    	    CP EEDRIVE_E  ; Drive E
02D5: 281D    	    JR Z, showDriveE
02D7: FEAC    	    CP EEDRIVE_F  ; Drive F
02D9: 281D    	    JR Z, showDriveF
02DB: FEAE    	    CP EEDRIVE_G  ; Drive G
02DD: 281D    	    JR Z, showDriveG
02DF: FEAA    	    CP EEDRIVE_Z  ; Drive Z
02E1: 281D    	    JR Z, showDriveZ
02E3: C9      	    RET
              	
02E4:         	showDriveA:
02E4: 3E41    	    LD A, 'A'
02E6: 181C    	    JR showCursor
02E8:         	showDriveB:
02E8: 3E42    	    LD A, 'B'
02EA: 1818    	    JR showCursor
02EC:         	showDriveC:
02EC: 3E43    	    LD A, 'C'
02EE: 1814    	    JR showCursor
02F0:         	showDriveD:
02F0: 3E44    	    LD A, 'D'
02F2: 1810    	    JR showCursor
02F4:         	showDriveE:
02F4: 3E45    	    LD A, 'E'
02F6: 180C    	    JR showCursor
02F8:         	showDriveF:
02F8: 3E46    	    LD A, 'F'
02FA: 1808    	    JR showCursor
02FC:         	showDriveG:
02FC: 3E47    	    LD A, 'G'
02FE: 1804    	    JR showCursor
0300:         	showDriveZ:
0300: 3E5A    	    LD A, 'Z'
0302: 1800    	    JR showCursor
0304:         	showCursor:
0304: CDCB07  	    CALL sendCharToLCD
0307: 3E3A    	    LD A, ':'
0309: CDCB07  	    CALL sendCharToLCD
030C: C9      	    RET
              	
              	
              	
030D:         	resetCollisionPixel:
030D: AF      	    XOR A
030E: 323CFD  	    LD (DRAW_PIXEL_COLLISION), A
0311: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
0312:         	checkCollisionPixel:
0312: 3A3CFD  	    LD A, (DRAW_PIXEL_COLLISION)
0315: B7      	    OR A
0316: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
0317: F5      	H_Delay:    PUSH AF
0318: C5      	            PUSH BC
0319: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
031A: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
031D: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
031E: 79      	            LD   A,C            ;[4]     [4]
031F: B0      	            OR   B              ;[4]     [4]
0320: C21D03  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
0323: 1B      	            DEC  DE             ;[6]     [4]
0324: 7B      	            LD   A,E            ;[4]     [4]
0325: B2      	            OR   D              ;[4]     [4]
0326: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
0328: D1      	            POP  DE
0329: C1      	            POP  BC
032A: F1      	            POP  AF
032B: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       On exit: If press A = CTRLC and NZ flagged
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
032C:         	CHKKEY:
032C: 3EFE    	    LD      A, 0xFE             ; Máscara: bit 0 baixo = col 0
032E: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0330: 00      	    NOP                         ; ~270 ns de estabilização
0331: 00      	    NOP
0332: 00      	    NOP
0333: 00      	    NOP
0334: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0336: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
0337: FE01    	    CP 1
0339: C24103  	    jp nz, GRET
033C: 3E03    		LD  A, CTRLC
033E: FE00    		CP	0
0340: C9      		RET
0341:         	GRET:
0341: 3E00    		LD  A, 0
0343: FE00    		CP 0
0345: C9      		RET
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
0346:         	CONIN:
0346: C5      	    PUSH BC
0347: D5      	    PUSH DE
0348: E5      	    PUSH HL
0349: CDCD03  	    CALL readKeyboarWaitPressA
034C: E1      	    POP HL
034D: D1      	    POP DE
034E: C1      	    POP BC
034F: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
0350:         	CONIN_NOT_LOOP:
0350: C5      	    PUSH BC
0351: D5      	    PUSH DE
0352: E5      	    PUSH HL
0353: CD5A03  	    CALL readKeyboarPressA
0356: E1      	    POP HL
0357: D1      	    POP DE
0358: C1      	    POP BC
0359: C9      	    RET
              	
              	
035A:         	readKeyboarPressA;
035A: AF      	    XOR A
035B: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
035E: CD0B04  	    CALL    SCAN_MATRIX
0361: D0      	    RET      NC
0362: CD6D03  	    CALl GetKeycode
0365: CD7303  	    CALL checkShiftKey
0368: 3AA4FB  	    LD A, (KEY_PRESS)
036B: 37      	    SCF  ; Carry = 1
036C: C9      	    RET
              	
              	
              	
              	; A = col*8 + row  (0x00 – 0x3F)
036D:         	GetKeycode:
              	    ; --- Tecla confirmada: calcula keycode ---
              	    ; col*8 + row  (0x00 – 0x3F)
036D: 78      	    LD      A, B                ; B = coluna
036E: 87      	    ADD     A, A                ; ×2
036F: 87      	    ADD     A, A                ; ×4
0370: 87      	    ADD     A, A                ; ×8
0371: 81      	    ADD     A, C                ; + linha (C) = keycode
0372: C9      	    RET
              	
              	
              	; Verifica se shift e recupera ascii
              	;   Salva tecla em KEY_PRESS
0373:         	checkShiftKey:
              	    ; Verifica Shift
0373: 5F      	    LD E, A
0374: 21B001  	    LD HL, KEYMAP_NORMAL
0377: 3AA2FB  	    LD A, (MEN_SHIFT)
037A: FE01    	    CP 1
037C: C28903  	    JP NZ, NO_SHIFT
037F: 21F001  	    LD HL, KEYMAP_SHIFT
0382: CD0604  	    CALL DO_LOOKUP
0385: 32A4FB  	    LD (KEY_PRESS), A
0388: C9      	    RET
0389:         	NO_SHIFT:
0389: CD0604  	    CALL 	DO_LOOKUP	; pega tecla
038C: 32A4FB  	    LD (KEY_PRESS), A
038F: FEFF    	    CP $FF ;capslook?
0391: CAA403  	    JP Z, CAPSLOCK
0394: 3AA3FB  	    LD A, (MEN_CAPSL)
0397: FE00    	    CP 0
0399: C0      	    RET NZ
039A: 213002  	    LD HL, KEYMAP_CAPSLOCK
039D: CD0604  	    CALL DO_LOOKUP
03A0: 32A4FB  	    LD (KEY_PRESS), A
03A3: C9      	    RET
              	
              	
              	
              	
              	
03A4:         	CAPSLOCK:
03A4: 3AA3FB  	    LD A, (MEN_CAPSL)
03A7: FE00    	    CP 0
03A9: CABA03  	    JP Z, CAPSLOCK_OFF
03AC: AF      	    XOR A
03AD: 32A3FB  	    LD (MEN_CAPSL), A
03B0: 010306  	    LD BC, $0603
03B3: ED43A5FB	    LD (MEN_CURSR), BC
03B7: C3C603  	    JP CAPSLOCK_OK
03BA:         	CAPSLOCK_OFF:
03BA: 3E01    	    LD A, 1
03BC: 32A3FB  	    LD (MEN_CAPSL), A
03BF: 010606  	    LD BC, $0606
03C2: ED43A5FB	    LD (MEN_CURSR), BC
03C6:         	CAPSLOCK_OK:
03C6: 116400  	    LD DE, $0064 ; 100ms
03C9: CD1703  	    CALL H_Delay
03CC: C9      	    RET
              	
              	
              	
              	
              	; LER TECLADO
              	; Aguarda até uma teclad for pressionada e retorna em A
03CD:         	readKeyboarWaitPressA:
03CD: CD0B04  	    CALL    SCAN_MATRIX
03D0: D2CD03  	    JP      NC, readKeyboarWaitPressA       ; Nenhuma tecla, continua
              	
              	    ; --- Primeira leitura positiva: aguarda debounce ---
03D3: CDFA03  	    CALL    DEBOUNCE
              	
              	    ; --- Confirma que a tecla ainda está pressionada ---
03D6: AF      	    XOR A
03D7: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
03DA: CD0B04  	    CALL    SCAN_MATRIX
03DD: D2CD03  	    JP      NC, readKeyboarWaitPressA       ; Foi ruído, descarta
              	
03E0: CD6D03  	    CALL GetKeycode
              	    
03E3: CD7303  	    CALL checkShiftKey
              	    
              	    ; --- Aguarda soltar + debounce de release ---
03E6:         	WAIT_RELEASE:
03E6: CD0B04  	    CALL    SCAN_MATRIX
03E9: DAE603  	    JP      C, WAIT_RELEASE     ; Ainda pressionada
03EC: CDFA03  	    CALL    DEBOUNCE            ; Debounce do soltar
03EF: CD0B04  	    CALL    SCAN_MATRIX
03F2: DAE603  	    JP      C, WAIT_RELEASE     ; Bounce no release, volta a esperar
              	
03F5: 3AA4FB  	    LD A, (KEY_PRESS)
03F8: B7      	    OR A
03F9: C9      	    RET
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  espera ~10 ms (calibrado para 7.3728 MHz)
              	;   Usa DE como contador, preserva BC
              	;   T-states totais ≈ 69.080  →  ~9.36 ms
              	; ============================================================
03FA:         	DEBOUNCE:
03FA: C5      	    PUSH    BC
03FB: 0616    	    LD      B, DB_OUTER         ; B = contador externo
03FD:         	DB_OUTER_LOOP:
03FD: 0EF0    	    LD      C, DB_INNER         ; C = contador interno
03FF:         	DB_INNER_LOOP:
03FF: 0D      	    DEC     C                   ; 4 T
0400: 20FD    	    JR      NZ, DB_INNER_LOOP   ; 12 T (não salta) / 7 T (salta)
0402: 10F9    	    DJNZ    DB_OUTER_LOOP       ; 13 T (não salta) / 8 T (salta)
0404: C1      	    POP     BC
0405: C9      	    RET
              	
              	
              	; Pega char in table
0406:         	DO_LOOKUP:
0406: 1600    	    LD      D, 0
0408: 19      	    ADD     HL, DE
0409: 7E      	    LD      A, (HL)
040A: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_MATRIX
              	;   Varre 8 colunas, uma por vez (bit baixo = ativo)
              	;   Saída: B = col (0-7), C = row (0-7), Carry=1 se tecla
              	; ============================================================
040B:         	SCAN_MATRIX:
040B: 0600    	    LD      B, 0                ; Coluna atual
040D: 16FE    	    LD      D, 0xFE             ; Máscara: bit 0 baixo = col 0
040F:         	SCAN_COL:
040F: 7A      	    LD      A, D
0410: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0412: 00      	    NOP                         ; ~270 ns de estabilização
0413: 00      	    NOP
0414: 00      	    NOP
0415: 00      	    NOP
0416: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0418: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
              	    
              	    ; SHIFT
0419: F5      	    PUSH AF
041A: 7A      	    LD A, D
041B: FEFE    	    CP $FE
041D: C23004  	    JP NZ, FIM
0420: F1      	    POP AF
0421: F5      	    PUSH AF
0422: FE08    	    CP $08
0424: C23004  	    JP NZ, FIM
0427: 3E01    	    LD A, 1
0429: 32A2FB  	    LD (MEN_SHIFT), A
042C: F1      	    POP AF
042D: 3E00    	    LD A, 0
042F: F5      	    PUSH AF
              	    
0430:         	FIM:
0430: F1      		POP AF
              	    
0431: E6FF    	    AND     0xFF
0433: 280E    	    JR      Z, NEXT_COL         ; Nenhuma linha nesta coluna
              	    
              	    ; Encontrou linha — identifica bit
0435: 0E00    	    LD      C, 0
0437:         	FIND_ROW:
0437: 1F      	    RRA
0438: 3803    	    JR      C, ROW_FOUND
043A: 0C      	    INC     C
043B: 18FA    	    JR      FIND_ROW
              	
043D:         	ROW_FOUND:
043D: 3EFF    	    LD      A, 0xFF
043F: D340    	    OUT     (KEYBOARD), A           ; Desativa colunas
0441: 37      	    SCF                         ; Carry = 1
0442: C9      	    RET
              	
0443:         	NEXT_COL:
0443: 04      	    INC     B
0444: 78      	    LD      A, B
0445: FE08    	    CP      8
0447: 2809    	    JR      Z, SCAN_NONE        ; Todas varridas, nada encontrado
              	
              	    ; Rotaciona máscara para próxima coluna
0449: 7A      	    LD      A, D
044A: 37      	    SCF
044B: CB17    	    RL      A                   ; Desloca bit baixo para esquerda
044D: F601    	    OR      0x01                ; Garante que o bit 0 volta alto (inativo)
044F: 57      	    LD      D, A
0450: 18BD    	    JR      SCAN_COL
              	
0452:         	SCAN_NONE:
0452: 3EFF    	    LD      A, 0xFF
0454: D340    	    OUT     (KEYBOARD), A
0456: B7      	    OR      A                   ; Limpa Carry
0457: C9      	    RET
              	
              	
              	    
              	    
              	    
              	#include "GLCD.asm"
              	; Graphical LCD 128 x 64 Library
              	; ------------------------------
              	; By B. Chiha May-2023
              	; Modificações para funcionar no Z80 Mini - 2026
              	;
              	; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
              	;
              	; There are a few variants of these LCD screens, but they must all must use the ST7920
              	; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
              	; ST7921 Panels (128 x 32) stacked one above the other.
              	;
              	; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can 
              	; be displayed at the same time.
              	;
              	; The Pinout for the QC12864B board is as follows:
              	;
              	; Pin	Name	Desc                    Serial  Parallel
              	; ---   ----    -------------           ------  -------------
              	; 1     VSS     Ground                  GND     GND
              	; 2     VDD     Power                   5v      5v
              	; 3     V0      Contrast                N/A     N/A
              	; 4     D/I     IR/DR (CS)              5v      A7
              	; 5     R/W     R/W (SID)               D0      RD (inverted)
              	; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
              	; 7     DB0     Data                    N/A     D0
              	; 8     DB1     Data                    N/A     D1
              	; 9     DB2     Data                    N/A     D2
              	; 10    DB3     Data                    N/A     D3
              	; 11    DB4     Data                    N/A     D4
              	; 12    DB5     Data                    N/A     D5
              	; 13    DB6     Data                    N/A     D6
              	; 14    DB7     Data                    N/A     D7
              	; 15    PSB     Serial/Para             GND     5v
              	; 16    NC
              	; 17    RST     Reset                   RST     RST
              	; 18    VEE     LCD Drive               N/A     N/A
              	; 19    A       Backlight               5v/NC   5v/NC
              	; 20    K       Backlight               GND/NC  GND/NC
              	;
              	;
              	        
              	        
              	; Modifiable values.  Thse three values can be modified to suit your own set up
              	; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
              	; V_DELAY_US is the minimum delay needed for a command to be processed by the
              	; LCD board.  If only some of the data is being sent, make this value larger
              	        
              	;Port 7 on TEC is connected to LCD Enable (Pin 6)
              	;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
0010:         	V_DELAY_US: .equ $0010   ;Delay for 76us on your system
              	
              	; Dont need to modify anything else below.
00F8:         	UP:     .equ $F8                 ; Up Arrow
00F7:         	DN:     .equ $F7                 ; Down Arrow
000C:         	FF:     .equ 0CH                 ; Form Feed
008F:         	CURSOR: .equ 8FH                 ; Cursor
              	        
              	
              	
              	
              	
              	; --- CONOUT: Envia byte em A ---
0458:         	PUTCHAR:
0458:         	CONOUT:
0458: F5      	        PUSH AF
0459: C5      	        PUSH BC
045A: D5      	        PUSH DE
045B: E5      	        PUSH HL
045C: CDCB07  	        CALL sendCharToLCD
045F: E1      	        POP HL
0460: D1      	        POP DE
0461: C1      	        POP BC
0462: F1      	        POP AF
0463: C9      	        RET
              	
              	
              	; --- PUTS: Envia string terminada em NUL apontada por HL ---
0464:         	PUTS:
0464: F5      	        PUSH AF
0465: C5      	        PUSH BC
0466: D5      	        PUSH DE
0467: E5      	        PUSH HL
0468: 545D    	        LD DE, HL
046A: 3E00    	        LD A, NUL
046C: CD3B08  	        CALL sendStringToLCD
046F: E1      	        POP HL
0470: D1      	        POP DE
0471: C1      	        POP BC
0472: F1      	        POP AF
0473: C9      	        RET
              	
              	; --- CRLF: Envia CR+LF ---
0474:         	CRLF:
0474: 3E0D    	        LD   A, CR
0476: CD5804  	        CALL PUTCHAR
0479: C9      	        RET
              	
              	
              	
              	; Initialise LCD
047A:         	initLCD:
047A: 21160A  	        LD HL, INIT_BASIC       ;POINT HL TO LCD INITIALIZE TABLE
047D: 0604    	        LD B, 04H               ;B=4 BYTES
047F:         	NEXT_CMD:
047F: 7E      	        LD A, (HL)
0480: D370    	        OUT (GLCD_INST), A
0482: CD8807  	        CALL delayUS
0485: 23      	        INC HL
0486: 10F7    	        DJNZ NEXT_CMD
0488: 114001  	        LD DE, 0140H            ;1.6 ms
048B: CD8B07  	        CALL delayMS
              	        
048E: 2184F7  	        LD HL,GBUF              ;Set viewport
0491: 2284FB  	        LD (VPORT),HL           ;to GBUF
              	
0494: CDA704  	        CALL clearGrLCD
              	        
              	; Clears the Graphics Memory Buffer
0497:         	clearGBUF:
0497: 2A84FB  	        LD HL, (VPORT)
049A: ED5B84FB	        LD DE, (VPORT)
049E: 13      	        INC DE
049F: AF      	        XOR A
04A0: 77      	        LD (HL), A
04A1: 01FF03  	        LD BC, 03FFH
04A4: EDB0    	        LDIR
04A6: C9      	        RET
              	        
              	; Clears the Graphics LCD Buffer
04A7:         	clearGrLCD:
04A7: CDE704  	        CALL setGrMode
04AA: 0E00    	        LD C, 00H
04AC:         	CLR_X:
04AC: 3E80    	        LD A, 80H
04AE: B1      	        OR C
04AF: D370    	        OUT (GLCD_INST), A
04B1: CD8807  	        CALL delayUS
04B4: 3E80    	        LD A, 80H
04B6: D370    	        OUT (GLCD_INST), A
04B8: CD8807  	        CALL delayUS
04BB: AF      	        XOR A                   ;Clear Byte
04BC: 0610    	        LD B, 10H
04BE:         	CLR_Y:
04BE: D371    	        OUT (GLCD_DATA), A
04C0: CD8807  	        CALL delayUS
04C3: D371    	        OUT (GLCD_DATA), A
04C5: CD8807  	        CALL delayUS
04C8: 10F4    	        DJNZ CLR_Y
04CA: 0C      	        INC C
04CB: 79      	        LD A, C
04CC: FE20    	        CP 20H
04CE: 20DC    	        JR NZ, CLR_X        
04D0: C9      	        RET
              	
              	; Clears the ASCII Text LCD
04D1:         	clearTxtLCD:
04D1: CDF504  	        CALL setTxtMode
04D4: 3E80    	        LD A, 80H
04D6: D370    	        OUT (GLCD_INST), A
04D8: CD8807  	        CALL delayUS
04DB: 0640    	        LD B, 40H
04DD:         	CLR_ROWS:
04DD: 3E20    	        LD A,  " "
04DF: D371    	        OUT (GLCD_DATA), A
04E1: CD8807  	        CALL delayUS
04E4: 10F7    	        DJNZ CLR_ROWS
04E6: C9      	        RET
              	        
              	; Set Graphics Mode
04E7:         	setGrMode:
04E7: 3E34    	        LD A, 34H
04E9: D370    	        OUT (GLCD_INST), A
04EB: CD8807  	        CALL delayUS
04EE: 3E36    	        LD A, 36H
04F0: D370    	        OUT (GLCD_INST), A
04F2: C38807  	        JP delayUS
              	        
              	; Set Text Mode
04F5:         	setTxtMode:
04F5: 3E30    	        LD A, 30H
04F7: D370    	        OUT (GLCD_INST), A
04F9: C38807  	        JP delayUS
              	        
              	;Draw Box
              	;Inputs: BC = X0,Y0
              	;        DE = X1,Y1
