15C8: 78      	    LD  A, B
15C9: FE01    	    CP  1
15CB: 2804    	    JR  Z, I2C_READ_LASTBYTE
15CD: 3EFF    	    LD  A, 0FFH                 ; ACK - ainda tem mais bytes
15CF: 1801    	    JR  I2C_READ_DOIT
15D1:         	I2C_READ_LASTBYTE:
15D1: AF      	    XOR A                        ; NACK - ultimo byte do bloco
15D2:         	I2C_READ_DOIT:
15D2: CDAB1A  	    CALL I2C_Read                ; A = byte lido
15D5: C5      	    PUSH BC
15D6: CD3315  	    CALL PRINT_HEX8
15D9: 3E20    	    LD  A, SPACE
15DB: CD8104  	    CALL PUTCHAR
15DE: C1      	    POP BC
15DF: 05      	    DEC B
15E0: 78      	    LD  A, B
15E1: B7      	    OR  A
15E2: 20E4    	    JR  NZ, I2C_READ_GO
15E4: C36415  	    JP  I2C_LOOP
              	
