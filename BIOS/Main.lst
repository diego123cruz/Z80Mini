11A4: 42415349	            DB   "BASIC",    NUL
11A8: 4300    	
11AA: 0060    	            DW   COLD
11AC: 57424153	            DB   "WBASIC",    NUL
11B0: 494300  	
11B3: 0360    	            DW   WARM
11B5: 413A00  	            DB   "A:",    NUL
11B8: 0112    	            DW   CHANGE_DRIVE_A
11BA: 423A00  	            DB   "B:",    NUL
11BD: 0A12    	            DW   CHANGE_DRIVE_B
