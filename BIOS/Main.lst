              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
1495:         	SKIP_COMMAND_DE:
1495: 1A      				LD A, (DE)
1496: FE20    				CP SPACE
1498: C8      				RET Z
1499: 13      				INC DE
149A: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
149C:         	SKIP_SPACES:
149C: 7E      	            LD   A, (HL)
149D: FE20    	            CP   SPACE
149F: C0      	            RET  NZ
14A0: 23      	            INC  HL
14A1: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
14A3:         	SKIP_SPACES_DE:
14A3: 1A      	            LD   A, (DE)
14A4: FE20    	            CP   SPACE
14A6: C0      	            RET  NZ
14A7: 13      	            INC  DE
14A8: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
14AA:         	SKIP_SPACES_HL:
14AA: 7E      	            LD   A, (HL)
14AB: FE20    	            CP   SPACE
14AD: C0      	            RET  NZ
14AE: 23      	            INC  HL
14AF: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
14B1:         	IS_HEX:
14B1: FE30    	            CP   '0'
14B3: 3814    	            JR   C, IS_HEX_BAD
14B5: FE3A    	            CP   '9'+1
14B7: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
14B9: E6DF    	            AND  0DFH               ; Uppercase
14BB: FE41    	            CP   'A'
14BD: 380A    	            JR   C, IS_HEX_BAD
14BF: FE47    	            CP   'F'+1
14C1: 3006    	            JR   NC, IS_HEX_BAD
14C3: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
14C5: C9      	            RET
14C6:         	IS_HEX_DIG:
14C6: D630    	            SUB  '0'
14C8: C9      	            RET
14C9:         	IS_HEX_BAD:
14C9: 37      	            SCF
14CA: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
14CB:         	PARSE_HEX8_HL:
14CB: 7E      	            LD   A, (HL)
14CC: CDB114  	            CALL IS_HEX
14CF: D8      	            RET  C
14D0: 0F      	            RRCA
14D1: 0F      	            RRCA
14D2: 0F      	            RRCA
14D3: 0F      	            RRCA
14D4: E6F0    	            AND  0F0H
14D6: 47      	            LD   B, A
14D7: 23      	            INC  HL
14D8: 7E      	            LD   A, (HL)
14D9: CDB114  	            CALL IS_HEX
14DC: 3803    	            JR   C, PHX8_ERR
14DE: B0      	            OR   B
14DF: 23      	            INC  HL
14E0: C9      	            RET
14E1:         	PHX8_ERR:
14E1: 2B      	            DEC  HL
14E2: 37      	            SCF
14E3: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
14E4:         	PARSE_HEX8_DE:
14E4: 1A      	            LD   A, (DE)
14E5: CDB114  	            CALL IS_HEX
14E8: D8      	            RET  C
14E9: 0F      	            RRCA
14EA: 0F      	            RRCA
14EB: 0F      	            RRCA
14EC: 0F      	            RRCA
14ED: E6F0    	            AND  0F0H
14EF: 47      	            LD   B, A
14F0: 13      	            INC  DE
14F1: 1A      	            LD   A, (DE)
14F2: CDB114  	            CALL IS_HEX
14F5: 3803    	            JR   C, PHX8D_ERR
14F7: B0      	            OR   B
14F8: 13      	            INC  DE
14F9: C9      	            RET
14FA:         	PHX8D_ERR:
14FA: 1B      	            DEC  DE
14FB: 37      	            SCF
14FC: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
14FD:         	PARSE_HEX16_DE:
14FD: CDE414  	            CALL PARSE_HEX8_DE
1500: D8      	            RET  C
1501: 67      	            LD   H, A
1502: CDE414  	            CALL PARSE_HEX8_DE
1505: D8      	            RET  C
1506: 6F      	            LD   L, A
1507: C9      	            RET
              	
              	; --- UPCASE_TOKEN: copia token de (HL) em maiúscula para HEXBUF; HL avança após token ---
1508:         	UPCASE_TOKEN:
1508: 11F7FB  	            LD   DE, HEXBUF
150B: 060A    	            LD   B, 10
150D:         	UPCASE_LOOP:
150D: 7E      	            LD   A, (HL)
150E: FE20    	            CP   SPACE
1510: 2817    	            JR   Z, UPCASE_DONE
1512: FE0D    	            CP   CR
1514: 2813    	            JR   Z, UPCASE_DONE
1516: FE00    	            CP   NUL
1518: 280F    	            JR   Z, UPCASE_DONE
151A: FE61    	            CP   'a'
151C: 3806    	            JR   C, UPCASE_STORE
151E: FE7B    	            CP   'z'+1
1520: 3002    	            JR   NC, UPCASE_STORE
1522: E6DF    	            AND  0DFH               ; Converte para maiúscula
1524:         	UPCASE_STORE:
1524: 12      	            LD   (DE), A
1525: 23      	            INC  HL
1526: 13      	            INC  DE
1527: 10E4    	            DJNZ UPCASE_LOOP
1529:         	UPCASE_DONE:
1529: 3E00    	            LD   A, NUL
152B: 12      	            LD   (DE), A
152C: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
152D:         	STRCMP:
152D: 7E      	            LD   A, (HL)
152E: 47      	            LD   B, A
152F: 1A      	            LD   A, (DE)
1530: B8      	            CP   B
1531: C0      	            RET  NZ
1532: FE00    	            CP   NUL
1534: C8      	            RET  Z
1535: 23      	            INC  HL
1536: 13      	            INC  DE
1537: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
1539:         	PRINT_HEX8:
1539: F5      	            PUSH AF
153A: 0F      	            RRCA
153B: 0F      	            RRCA
153C: 0F      	            RRCA
153D: 0F      	            RRCA
153E: CD4615  	            CALL PRINT_NIBBLE
1541: F1      	            POP  AF
1542: CD4615  	            CALL PRINT_NIBBLE
1545: C9      	            RET
              	
1546:         	PRINT_NIBBLE:
1546: E60F    	            AND  0FH
1548: C630    	            ADD  A, '0'
154A: FE3A    	            CP   '9'+1
154C: 3802    	            JR   C, PN_DONE
154E: C607    	            ADD  A, 07H              ; 'A'-'9'-1
1550:         	PN_DONE:
1550: CD8704  	            CALL PUTCHAR
1553: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
1554:         	PRINT_HEX16:
1554: 7C      	            LD   A, H
1555: CD3915  	            CALL PRINT_HEX8
1558: 7D      	            LD   A, L
1559: CD3915  	            CALL PRINT_HEX8
155C: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
155D:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
155D: CDE414  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
1560: DA1116  	    JP  C, I2C_BAD_SYNTAX
1563: 3242FD  	    LD  (I2C_ADDR7), A
1566: AF      	    XOR A
1567: 3243FD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
156A:         	I2C_LOOP:
156A: CDA314  	    CALL SKIP_SPACES_DE
156D: 1A      	    LD  A, (DE)
156E: FE0D    	    CP  CR
1570: CAFD15  	    JP  Z, I2C_DONE
1573: FE00    	    CP  NUL
1575: CAFD15  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
1578: 1A      	    LD  A, (DE)
1579: E6DF    	    AND 0DFH                ; forca maiuscula
157B: 13      	    INC DE
157C: FE57    	    CP  'W'
157E: 2807    	    JR  Z, I2C_DO_WRITE
1580: FE52    	    CP  'R'
1582: 2829    	    JR  Z, I2C_DO_READ
1584: C31116  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
1587:         	I2C_DO_WRITE:
1587: CDE414  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
158A: DA1116  	    JP  C, I2C_BAD_SYNTAX
158D: 4F      	    LD  C, A                ; guarda o byte
              	
158E: 3A43FD  	    LD  A, (I2C_STATE)
1591: FE01    	    CP  1
1593: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
1595: 3A42FD  	    LD  A, (I2C_ADDR7)
1598: 07      	    RLCA                     ; addr << 1
1599: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
159B: CD601A  	    CALL I2C_Open
159E: 204D    	    JR  NZ, I2C_NOACK
15A0: 3E01    	    LD  A, 1
15A2: 3243FD  	    LD  (I2C_STATE), A
              	
15A5:         	I2C_WRITE_GO:
15A5: 79      	    LD  A, C
15A6: CD741A  	    CALL I2C_Write
15A9: 2042    	    JR  NZ, I2C_NOACK
15AB: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
15AD:         	I2C_DO_READ:
15AD: CDE414  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
15B0: 385F    	    JR  C, I2C_BAD_SYNTAX
15B2: 47      	    LD  B, A
15B3: 78      	    LD  A, B
15B4: B7      	    OR  A
15B5: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
15B7: 3A43FD  	    LD  A, (I2C_STATE)
15BA: FE02    	    CP  2
15BC: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
15BE: 3A42FD  	    LD  A, (I2C_ADDR7)
15C1: 07      	    RLCA
15C2: F601    	    OR  01H                    ; bit0 = 1 (read)
15C4: CD601A  	    CALL I2C_Open
15C7: 2024    	    JR  NZ, I2C_NOACK
15C9: 3E02    	    LD  A, 2
