1238: 3204FC  	    LD (I2CA_BLOCK), A
123B: CD8F22  	    CALL CHECK_DISK_FORMAT
123E: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_E  -  Altera drive para device E - EEDRIVE_E
              	; ============================================================
