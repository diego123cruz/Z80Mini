1F74: 1E00    	    LD E, 0
1F76: 2139FC  	    LD HL, FS_TMP1
1F79: 010100  	    LD BC, 1
1F7C: CDCE1C  	    CALL I2C_MemRd
1F7F: C0      	    RET NZ
              	
              	    ; min(FS_TMPSZ, 255) bytes a ler
1F80: 2A3AFC  	    LD HL, (FS_TMPSZ)
