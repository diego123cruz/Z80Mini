              	#include "IHEX.asm"
              	
              	
1878:         	loadInit:
1878: 3EFF    	    LD A, $FF
187A: 32FFFB  	    LD (LOAD_FIRST_FLAG), A
              	
187D: 213C1A  	    LD HL, MSG_LOAD_HELP
1880: CDDD19  	    CALL SERIAL_A_PRINT_STRING
              	
1883: 113E1A  	    LD DE, MSG_LOAD_HELP_LCD
1886: CD7C08  	    CALL sendStringToLCD
              	
1889:         	loopHexLoad:
1889: CDCB10  	    CALL RXDATA
              	
188C: FE3A    	    CP   ':'	; ":"?
188E: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
1890: 3AFFFB  		LD   A, (LOAD_FIRST_FLAG)
1893: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
1895: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
1897: 3E01    		LD   A, $01
1899: 32FFFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
189C:         	monitor_do_load:
189C: CDAD18  		CALL    LOAD
189F: CDE619  		CALL SERIAL_A_TXCRLF
18A2: C38918  	    JP loopHexLoad
              	
              	
18A5:         	CALL_IHEX:
18A5: 21CE02  		LD HL, MAIN_LOOP
18A8: E5      		PUSH HL
18A9: CD7818  		CALL loadInit
18AC: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
18AD:         	LOAD:
18AD: 1E00    			LD   E,0	        ; Zera checksum
18AF: CD8B19  			CALL GET2	        ; Record Length -> D
18B2: 57      			LD   D,A
18B3: CD8B19  			CALL GET2	        ; Endereco High -> H
18B6: 67      			LD   H,A
18B7: CD8B19  			CALL GET2	        ; Endereco Low -> L
18BA: 6F      			LD   L,A
18BB: CD8B19  			CALL GET2	        ; Record Type -> A
18BE: FE01    			CP   $01	        ; EOF record?
18C0: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
18C2: CD8B19  			CALL GET2	        ; Consome checksum do EOF
18C5: 7B      			LD   A,E
18C6: A7      			AND  A
18C7: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
18C9: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
18CB:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
18CB: 3AFFFB  			LD   A, (LOAD_FIRST_FLAG)
18CE: FE01    			CP   $01                    ; e a primeira linha?
18D0: 2008    			JR   NZ, LOAD2_SKIP
18D2: 3E00    			LD   A, $00
18D4: 32FFFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
18D7: 2200FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
18DA:         	LOAD2_SKIP:
18DA: 7A      			LD   A,D	        ; Contador de bytes da linha
18DB: A7      			AND  A
18DC: 280D    			JR   Z,LOAD3
              	
18DE: CD8B19  			CALL GET2	        ; Le proximo byte
18E1: 77      			LD   (HL),A	        ; Grava na memoria
18E2: 23      			INC  HL
18E3: 3E2E    			LD   A,'.'
18E5: CD9E10  			CALL OUTCH
18E8: 15      			DEC  D
18E9: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
18EB:         	LOAD3:
18EB: 2202FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
18EE: CD8B19  			CALL GET2	                ; Consome checksum da linha
18F1: 7B      			LD   A,E
18F2: A7      			AND  A
18F3: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
18F4:         	LOADERR:
18F4: 21F119  			LD   HL,CKSUMERR
18F7: CDDD19  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
18FA: 11F119  	        LD   DE, CKSUMERR
18FD: CD7C08  	        CALL sendStringToLCD
              	
1900: E1      	        POP HL
              	
1901: C9      			RET
              	
1902:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
1902: 21021A  			LD   HL, LDETXT
1905: CDDD19  			CALL SERIAL_A_PRINT_STRING
              	
1908: 21211A  			LD   HL, msg_load_start
190B: CDDD19  			CALL SERIAL_A_PRINT_STRING
190E: 2A00FC  			LD   HL, (LOAD_START_ADDR)
1911: CDB519  			CALL SERIAL_A_PRINT_HL_HEX
1914: CDE619  			CALL SERIAL_A_TXCRLF
              	
1917: 212A1A  			LD   HL, msg_load_end
191A: CDDD19  			CALL SERIAL_A_PRINT_STRING
191D: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1920: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1921: CDB519  			CALL SERIAL_A_PRINT_HL_HEX
1924: CDE619  			CALL SERIAL_A_TXCRLF
              	
1927: 21331A  			LD   HL, msg_load_total
192A: CDDD19  			CALL SERIAL_A_PRINT_STRING
192D: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1931: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1934: B7      			OR   A                      ; limpa carry flag
1935: ED52    			SBC  HL, DE                 ; HL = total de bytes
1937: CDB519  			CALL SERIAL_A_PRINT_HL_HEX
193A: CDE619  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
193D: 111B1A  	        LD   DE, LDETXTLCD
1940: CD7C08  	        CALL sendStringToLCD
              	
1943: 11211A  	        LD   DE, msg_load_start
1946: 3E00    	        LD   A, 0
1948: CD7C08  			CALL sendStringToLCD
194B: 2A00FC  			LD   HL, (LOAD_START_ADDR)
194E: CDC008  			CALL sendHLToLCD
1951: CDB504  			CALL CRLF
              	
1954: 112A1A  			LD   DE, msg_load_end
1957: 3E00    	        LD   A, 0
1959: CD7C08  			CALL sendStringToLCD
195C: 2A02FC  			LD   HL, (LOAD_END_ADDR)
195F: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1960: CDC008  			CALL sendHLToLCD
1963: CDB504  			CALL CRLF
              	
1966: 11331A  			LD   DE, msg_load_total
1969: 3E00    	        LD   A, 0
196B: CD7C08  			CALL sendStringToLCD
196E: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1972: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1975: B7      			OR   A                      ; limpa carry flag
1976: ED52    			SBC  HL, DE                 ; HL = total de bytes
1978: CDC008  			CALL sendHLToLCD
              	
197B: CDB504  	        CALL CRLF
              	
197E: E1      	        POP HL 
197F: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
1980: CDA410  	GETCHR_S:	CALL INCH	; RX a Character
1983: FE03    			CP   $03	; <ctrl-c> User break?
1985: C8      			RET  Z			
1986: FE20    			CP   $20	; <space> or better?
1988: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
198A: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
198B: CD8019  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
198E: 47      			LD   B,A	; Load it in B
198F: CD8019  			CALL GETCHR_S	; Get us another character
1992: 4F      			LD   C,A	; load it in C
1993: CD9C19  			CALL BCTOA	; Convert ASCII to byte
1996: 4F      			LD   C,A	; Build the checksum
1997: 7B      			LD   A,E
1998: 91      			SUB  C		; The checksum should always equal zero when checked
1999: 5F      			LD   E,A	; Save the checksum back where it came from
199A: 79      			LD   A,C	; Retrieve the byte and go back
199B: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
199C: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
199D: D630    			SUB  $30	; Take it down from Ascii
199F: FE0A    			CP   $0A	; Are we in the 0-9 range here?
19A1: 3802    			JR   C,BCTOA1	; If so, get the next nybble
19A3: D607    			SUB  $07	; But if A-F, take it down some more
19A5: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
19A6: 07      			RLCA		; One bit at a time
19A7: 07      			RLCA		; Until we
19A8: 07      			RLCA		; Get there with it
19A9: 47      			LD   B,A	; Save the converted high nybble
19AA: 79      			LD   A,C	; Now get the low order byte
19AB: D630    			SUB  $30	; Convert it down from Ascii
19AD: FE0A    			CP   $0A	; 0-9 at this point?
19AF: 3802    			JR   C,BCTOA2	; Good enough then, but
19B1: D607    			SUB  $07	; Take off 7 more if it's A-F
19B3: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
19B4: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
19B5:         	SERIAL_A_PRINT_HL_HEX:
19B5: 7C      			LD   A, H
19B6: CDBE19  			CALL SERIAL_A_PRINT_A_HEX
19B9: 7D      			LD   A, L
19BA: CDBE19  			CALL SERIAL_A_PRINT_A_HEX
19BD: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
19BE:         	SERIAL_A_PRINT_A_HEX:
19BE: F5      			PUSH AF
19BF: 0F      			RRCA
19C0: 0F      			RRCA
19C1: 0F      			RRCA
19C2: 0F      			RRCA
19C3: CDCB19  			CALL SERIAL_A_PRINT_NIBBLE
19C6: F1      			POP  AF
19C7: CDCB19  			CALL SERIAL_A_PRINT_NIBBLE
19CA: C9      			RET
              	
19CB:         	SERIAL_A_PRINT_NIBBLE:
19CB: E60F    			AND  $0F
19CD: FE0A    			CP   $0A
19CF: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
19D1: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
19D3: CD9E10  			CALL OUTCH
19D6: C9      			RET
19D7:         	SERIAL_A_PRINT_NIBBLE_09:
19D7: C630    			ADD  A, $30             ; 0-9
19D9: CD9E10  			CALL OUTCH
19DC: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
19DD:         	SERIAL_A_PRINT_STRING:
19DD: 7E      	        LD   A,(HL)	; Get character
19DE: B7      			OR   A		; Is it $00 ?
19DF: C8      			RET  Z		; Then RETurn on terminator
19E0: CD9E10  			CALL OUTCH	; Print it
