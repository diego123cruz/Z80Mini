2456: E1      	    POP HL
2457: D1      	    POP DE
2458: C1      	    POP BC
2459: C9      	    RET
              	
              	; FS_FREE_CHAIN: Libera cadeia de paginas a partir da pagina A
              	;   On exit: Z=OK  NZ=erro
245A:         	FS_FREE_CHAIN:
245A: B7      	    OR A
245B: C8      	    RET Z
              	
245C:         	FS_FC_LP:
245C: 3257FC  	    LD (FS_BMPADDR), A      ; salva pagina corrente
              	
              	    ; Primeiro le o next page (antes de liberar)
245F: 57      	    LD D, A
2460: 1E00    	    LD E, 0
2462: 2150FC  	    LD HL, FS_TMP1
2465: 010100  	    LD BC, 1
2468: CD4F1D  	    CALL I2C_MemRd
246B: 201C    	    JR NZ, FS_FC_ERR
              	
              	    ; Salva next page no stack (FS_FREE_PG vai usar FS_BMPADDR/+1)
246D: 3A50FC  	    LD A, (FS_TMP1)
2470: F5      	    PUSH AF                 ; [1] next page
              	
              	    ; Pequeno delay para o barramento I2C se estabilizar entre as operacoes
              	    ; Abre e fecha a EEPROM ate receber ACK (write cycle polling)
2471:         	FS_FC_WAIT:
2471: 3EAE    	    LD A, $AE
2473: CDDB1A  	    CALL I2C_Open
2476: CDE21A  	    CALL I2C_Close
2479: 20F6    	    JR NZ, FS_FC_WAIT       ; aguarda EEPROM pronta
              	
              	    ; Libera a pagina
247B: 3A57FC  	    LD A, (FS_BMPADDR)
247E: CDFE23  	    CALL FS_FREE_PG
2481: 2010    	    JR NZ, FS_FC_ERR2
              	
2483: F1      	    POP AF                  ; [1] A = next page
2484: B7      	    OR A
2485: 20D5    	    JR NZ, FS_FC_LP         ; continua na proxima pagina
              	
2487: AF      	    XOR A
2488: C9      	    RET
              	
