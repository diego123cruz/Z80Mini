              	#include "IHEX.asm"
              	
              	
1854:         	loadInit:
1854: 3EFF    	    LD A, $FF
1856: 32FFFB  	    LD (LOAD_FIRST_FLAG), A
              	
1859: 21181A  	    LD HL, MSG_LOAD_HELP
185C: CDB919  	    CALL SERIAL_A_PRINT_STRING
              	
185F: 111A1A  	    LD DE, MSG_LOAD_HELP_LCD
1862: CD6408  	    CALL sendStringToLCD
              	
1865:         	loopHexLoad:
1865: CDB310  	    CALL RXDATA
              	
1868: FE3A    	    CP   ':'	; ":"?
186A: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
186C: 3AFFFB  		LD   A, (LOAD_FIRST_FLAG)
186F: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
1871: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
1873: 3E01    		LD   A, $01
1875: 32FFFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
1878:         	monitor_do_load:
1878: CD8918  		CALL    LOAD
187B: CDC219  		CALL SERIAL_A_TXCRLF
187E: C36518  	    JP loopHexLoad
              	
              	
1881:         	CALL_IHEX:
1881: 21C802  		LD HL, MAIN_LOOP
1884: E5      		PUSH HL
1885: CD5418  		CALL loadInit
1888: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
1889:         	LOAD:
1889: 1E00    			LD   E,0	        ; Zera checksum
188B: CD6719  			CALL GET2	        ; Record Length -> D
188E: 57      			LD   D,A
188F: CD6719  			CALL GET2	        ; Endereco High -> H
1892: 67      			LD   H,A
1893: CD6719  			CALL GET2	        ; Endereco Low -> L
1896: 6F      			LD   L,A
1897: CD6719  			CALL GET2	        ; Record Type -> A
189A: FE01    			CP   $01	        ; EOF record?
189C: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
189E: CD6719  			CALL GET2	        ; Consome checksum do EOF
18A1: 7B      			LD   A,E
18A2: A7      			AND  A
18A3: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
18A5: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
18A7:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
18A7: 3AFFFB  			LD   A, (LOAD_FIRST_FLAG)
18AA: FE01    			CP   $01                    ; e a primeira linha?
18AC: 2008    			JR   NZ, LOAD2_SKIP
18AE: 3E00    			LD   A, $00
18B0: 32FFFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
18B3: 2200FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
18B6:         	LOAD2_SKIP:
18B6: 7A      			LD   A,D	        ; Contador de bytes da linha
18B7: A7      			AND  A
18B8: 280D    			JR   Z,LOAD3
              	
18BA: CD6719  			CALL GET2	        ; Le proximo byte
18BD: 77      			LD   (HL),A	        ; Grava na memoria
18BE: 23      			INC  HL
18BF: 3E2E    			LD   A,'.'
18C1: CD8610  			CALL OUTCH
18C4: 15      			DEC  D
18C5: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
18C7:         	LOAD3:
18C7: 2202FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
18CA: CD6719  			CALL GET2	                ; Consome checksum da linha
18CD: 7B      			LD   A,E
18CE: A7      			AND  A
18CF: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
18D0:         	LOADERR:
18D0: 21CD19  			LD   HL,CKSUMERR
18D3: CDB919  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
18D6: 11CD19  	        LD   DE, CKSUMERR
18D9: CD6408  	        CALL sendStringToLCD
              	
18DC: E1      	        POP HL
              	
18DD: C9      			RET
              	
18DE:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
18DE: 21DE19  			LD   HL, LDETXT
18E1: CDB919  			CALL SERIAL_A_PRINT_STRING
              	
18E4: 21FD19  			LD   HL, msg_load_start
18E7: CDB919  			CALL SERIAL_A_PRINT_STRING
18EA: 2A00FC  			LD   HL, (LOAD_START_ADDR)
18ED: CD9119  			CALL SERIAL_A_PRINT_HL_HEX
18F0: CDC219  			CALL SERIAL_A_TXCRLF
              	
18F3: 21061A  			LD   HL, msg_load_end
18F6: CDB919  			CALL SERIAL_A_PRINT_STRING
18F9: 2A02FC  			LD   HL, (LOAD_END_ADDR)
18FC: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
18FD: CD9119  			CALL SERIAL_A_PRINT_HL_HEX
1900: CDC219  			CALL SERIAL_A_TXCRLF
              	
1903: 210F1A  			LD   HL, msg_load_total
1906: CDB919  			CALL SERIAL_A_PRINT_STRING
1909: ED5B00FC			LD   DE, (LOAD_START_ADDR)
190D: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1910: B7      			OR   A                      ; limpa carry flag
1911: ED52    			SBC  HL, DE                 ; HL = total de bytes
1913: CD9119  			CALL SERIAL_A_PRINT_HL_HEX
1916: CDC219  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
1919: 11F719  	        LD   DE, LDETXTLCD
191C: CD6408  	        CALL sendStringToLCD
              	
191F: 11FD19  	        LD   DE, msg_load_start
1922: 3E00    	        LD   A, 0
1924: CD6408  			CALL sendStringToLCD
1927: 2A00FC  			LD   HL, (LOAD_START_ADDR)
192A: CDA808  			CALL sendHLToLCD
192D: CD9D04  			CALL CRLF
              	
1930: 11061A  			LD   DE, msg_load_end
1933: 3E00    	        LD   A, 0
1935: CD6408  			CALL sendStringToLCD
1938: 2A02FC  			LD   HL, (LOAD_END_ADDR)
193B: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
193C: CDA808  			CALL sendHLToLCD
193F: CD9D04  			CALL CRLF
              	
1942: 110F1A  			LD   DE, msg_load_total
1945: 3E00    	        LD   A, 0
1947: CD6408  			CALL sendStringToLCD
194A: ED5B00FC			LD   DE, (LOAD_START_ADDR)
194E: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1951: B7      			OR   A                      ; limpa carry flag
1952: ED52    			SBC  HL, DE                 ; HL = total de bytes
1954: CDA808  			CALL sendHLToLCD
              	
1957: CD9D04  	        CALL CRLF
              	
195A: E1      	        POP HL 
195B: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
195C: CD8C10  	GETCHR_S:	CALL INCH	; RX a Character
195F: FE03    			CP   $03	; <ctrl-c> User break?
1961: C8      			RET  Z			
1962: FE20    			CP   $20	; <space> or better?
1964: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
1966: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
1967: CD5C19  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
196A: 47      			LD   B,A	; Load it in B
196B: CD5C19  			CALL GETCHR_S	; Get us another character
196E: 4F      			LD   C,A	; load it in C
196F: CD7819  			CALL BCTOA	; Convert ASCII to byte
1972: 4F      			LD   C,A	; Build the checksum
1973: 7B      			LD   A,E
1974: 91      			SUB  C		; The checksum should always equal zero when checked
1975: 5F      			LD   E,A	; Save the checksum back where it came from
1976: 79      			LD   A,C	; Retrieve the byte and go back
1977: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
1978: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
1979: D630    			SUB  $30	; Take it down from Ascii
197B: FE0A    			CP   $0A	; Are we in the 0-9 range here?
197D: 3802    			JR   C,BCTOA1	; If so, get the next nybble
197F: D607    			SUB  $07	; But if A-F, take it down some more
1981: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
1982: 07      			RLCA		; One bit at a time
1983: 07      			RLCA		; Until we
1984: 07      			RLCA		; Get there with it
1985: 47      			LD   B,A	; Save the converted high nybble
1986: 79      			LD   A,C	; Now get the low order byte
1987: D630    			SUB  $30	; Convert it down from Ascii
1989: FE0A    			CP   $0A	; 0-9 at this point?
198B: 3802    			JR   C,BCTOA2	; Good enough then, but
198D: D607    			SUB  $07	; Take off 7 more if it's A-F
198F: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
1990: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
1991:         	SERIAL_A_PRINT_HL_HEX:
1991: 7C      			LD   A, H
1992: CD9A19  			CALL SERIAL_A_PRINT_A_HEX
1995: 7D      			LD   A, L
1996: CD9A19  			CALL SERIAL_A_PRINT_A_HEX
1999: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
199A:         	SERIAL_A_PRINT_A_HEX:
199A: F5      			PUSH AF
199B: 0F      			RRCA
199C: 0F      			RRCA
199D: 0F      			RRCA
199E: 0F      			RRCA
199F: CDA719  			CALL SERIAL_A_PRINT_NIBBLE
19A2: F1      			POP  AF
19A3: CDA719  			CALL SERIAL_A_PRINT_NIBBLE
19A6: C9      			RET
              	
19A7:         	SERIAL_A_PRINT_NIBBLE:
19A7: E60F    			AND  $0F
19A9: FE0A    			CP   $0A
19AB: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
19AD: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
19AF: CD8610  			CALL OUTCH
19B2: C9      			RET
19B3:         	SERIAL_A_PRINT_NIBBLE_09:
19B3: C630    			ADD  A, $30             ; 0-9
19B5: CD8610  			CALL OUTCH
19B8: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
19B9:         	SERIAL_A_PRINT_STRING:
19B9: 7E      	        LD   A,(HL)	; Get character
19BA: B7      			OR   A		; Is it $00 ?
19BB: C8      			RET  Z		; Then RETurn on terminator
19BC: CD8610  			CALL OUTCH	; Print it
19BF: 23      			INC  HL		; Next Character
19C0: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
19C2: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
19C4: CD8610  			CALL OUTCH	; Print character 
19C7: 3E0A    			LD   A,$0A	; 
19C9: CD8610  			CALL OUTCH	; Print character
19CC: C9      			RET
              	
              	
              	
19CD:         	CKSUMERR:
19CD: 43686563			.db	"Checksum error"
19D1: 6B73756D	
19D5: 20657272	
19D9: 6F72    	
19DB: 0D0A00  			.db	CR, LF,$00
              	
19DE:         	LDETXT:
19DE: 43617272			.db	"Carregamento completo."
19E2: 6567616D	
19E6: 656E746F	
19EA: 20636F6D	
