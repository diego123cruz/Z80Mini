              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
2066: CD2017  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
2069: 47      	    LD   B,A	; Load it in B
206A: CD2017  	    CALL GETCHR_S	; Get us another character
206D: 4F      	    LD   C,A	; load it in C
206E: CD3C17  	    CALL BCTOA	; Convert ASCII to byte
2071: C9      	    RET
              	
              	;------------------------------------------------------------------------------
              	; Pegar 4 caracteres ASCII (0-9 A-F) converte em HL
              	;------------------------------------------------------------------------------
2072:         	SERIAL_GET_HEX_HL:
2072: CD6620  	    CALL SERIAL_GET_HEX_A	        ; Endereco High -> H
2075: 67      		LD   H,A
2076: CD6620  		CALL SERIAL_GET_HEX_A	        ; Endereco Low -> L
2079: 6F      		LD   L,A
207A: C9      	    RET
              	
              	
              	
