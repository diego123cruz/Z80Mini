              	    ; Imprime (20-B) x '.' (livre)
1E29: 3E13    	    LD A, 19
1E2B: 90      	    SUB B
1E2C: 2806    	    JR Z, FS_INF_NO_DOT
1E2E: 47      	    LD B, A
1E2F:         	FS_INF_DOT:
