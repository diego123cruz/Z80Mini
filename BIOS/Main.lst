1262: C9      	    RET
              	
              	
              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
1263:         	LOAD_HEX_CMD;
1263: CD7818  	    CALL loadInit
1266: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
1267:         	CALL_8000:
1267: 11CE02  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
126A: D5      	    PUSH DE
126B: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
126E:         	CLS_CMD:
126E: 3E0C    	            LD A, 0CH ; FF
1270: CD0C08  	            CALL sendCharToLCD
1273: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
1274:         	DUMP_CMD:
              	            ; DE aponta para argumentos
1274: CD1715  	            CALL PARSE_HEX16_DE      ; HL = endereço
1277: 3836    	            JR   C, DUMP_BAD_ADDR
1279: 22FDFB  	            LD   (ADDR_TMP), HL
              	
127C: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
127E:         	DUMP_LINE:
127E: C5      	            PUSH BC
              	            ; Exibe endereço
127F: 2AFDFB  	            LD   HL, (ADDR_TMP)
1282: CD6E15  	            CALL PRINT_HEX16
1285: 3E3A    	            LD   A, ':'
1287: CD9904  	            CALL PUTCHAR
128A: 3E20    	            LD   A, SPACE
128C: CD9904  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
128F: 2AFDFB  	            LD   HL, (ADDR_TMP)
1292: 0E05    	            LD   C, 5
1294:         	DUMP_HEX:
1294: 7E      	            LD   A, (HL)
1295: CD5315  	            CALL PRINT_HEX8
1298: 3E20    	            LD   A, SPACE
129A: CD9904  	            CALL PUTCHAR
129D: 23      	            INC  HL
129E: 0D      	            DEC  C
129F: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
12A1: 2AFDFB  	            LD   HL, (ADDR_TMP)
12A4: 110500  	            LD   DE, 5
12A7: 19      	            ADD  HL, DE
12A8: 22FDFB  	            LD   (ADDR_TMP), HL
12AB: C1      	            POP  BC
12AC: 10D0    	            DJNZ DUMP_LINE
12AE: C9      	            RET
              	
12AF:         	DUMP_BAD_ADDR:
12AF: 217116  	            LD   HL, MSG_BAD_ADDR
12B2: CDA504  	            CALL PUTS
12B5: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
12B6:         	LOAD_CMD:
12B6: CD1715  	            CALL PARSE_HEX16_DE
12B9: 3848    	            JR   C, LOAD_BAD
12BB: 22FDFB  	            LD   (ADDR_TMP), HL
12BE: 219B16  	            LD   HL, MSG_LOAD_HINT
12C1: CDA504  	            CALL PUTS
              	
12C4:         	LOAD_LOOP:
              	            ; Exibe endereço atual
12C4: 2AFDFB  	            LD   HL, (ADDR_TMP)
12C7: CD6E15  	            CALL PRINT_HEX16
12CA: 3E3A    	            LD   A, ':'
12CC: CD9904  	            CALL PUTCHAR
12CF: 3E20    	            LD   A, SPACE
12D1: CD9904  	            CALL PUTCHAR
              	
12D4: CD5914  	            CALL GETLINE             ; Lê linha
12D7: 21A7FB  	            LD   HL, LINEBUF
12DA: CDB614  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
12DD: 7E      	            LD   A, (HL)
12DE: FE0D    	            CP   CR
12E0: C8      	            RET  Z
12E1: FE00    	            CP   NUL
12E3: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
12E4:         	LOAD_BYTE:
12E4: CDE514  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
12E7: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
12E9: ED5BFDFB	            LD   DE, (ADDR_TMP)
12ED: 12      	            LD   (DE), A
12EE: 13      	            INC  DE
12EF: ED53FDFB	            LD   (ADDR_TMP), DE
12F3: CDC414  	            CALL SKIP_SPACES_HL
12F6: 7E      	            LD   A, (HL)
12F7: FE0D    	            CP   CR
12F9: 28C9    	            JR   Z, LOAD_LOOP
12FB: FE00    	            CP   NUL
12FD: 28C5    	            JR   Z, LOAD_LOOP
12FF: 18E3    	            JR   LOAD_BYTE
              	
1301:         	LOAD_NEXT_LINE:
