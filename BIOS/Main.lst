14A2: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
14A4:         	SKIP_SPACES_HL:
14A4: 7E      	            LD   A, (HL)
14A5: FE20    	            CP   SPACE
14A7: C0      	            RET  NZ
14A8: 23      	            INC  HL
14A9: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
14AB:         	IS_HEX:
14AB: FE30    	            CP   '0'
14AD: 3814    	            JR   C, IS_HEX_BAD
14AF: FE3A    	            CP   '9'+1
14B1: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
14B3: E6DF    	            AND  0DFH               ; Uppercase
14B5: FE41    	            CP   'A'
14B7: 380A    	            JR   C, IS_HEX_BAD
14B9: FE47    	            CP   'F'+1
14BB: 3006    	            JR   NC, IS_HEX_BAD
14BD: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
14BF: C9      	            RET
14C0:         	IS_HEX_DIG:
14C0: D630    	            SUB  '0'
14C2: C9      	            RET
14C3:         	IS_HEX_BAD:
14C3: 37      	            SCF
14C4: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
14C5:         	PARSE_HEX8_HL:
14C5: 7E      	            LD   A, (HL)
14C6: CDAB14  	            CALL IS_HEX
14C9: D8      	            RET  C
14CA: 0F      	            RRCA
14CB: 0F      	            RRCA
14CC: 0F      	            RRCA
14CD: 0F      	            RRCA
14CE: E6F0    	            AND  0F0H
14D0: 47      	            LD   B, A
14D1: 23      	            INC  HL
14D2: 7E      	            LD   A, (HL)
14D3: CDAB14  	            CALL IS_HEX
14D6: 3803    	            JR   C, PHX8_ERR
14D8: B0      	            OR   B
14D9: 23      	            INC  HL
14DA: C9      	            RET
14DB:         	PHX8_ERR:
14DB: 2B      	            DEC  HL
14DC: 37      	            SCF
14DD: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
14DE:         	PARSE_HEX8_DE:
14DE: 1A      	            LD   A, (DE)
14DF: CDAB14  	            CALL IS_HEX
14E2: D8      	            RET  C
14E3: 0F      	            RRCA
14E4: 0F      	            RRCA
14E5: 0F      	            RRCA
14E6: 0F      	            RRCA
14E7: E6F0    	            AND  0F0H
14E9: 47      	            LD   B, A
14EA: 13      	            INC  DE
14EB: 1A      	            LD   A, (DE)
14EC: CDAB14  	            CALL IS_HEX
14EF: 3803    	            JR   C, PHX8D_ERR
14F1: B0      	            OR   B
14F2: 13      	            INC  DE
14F3: C9      	            RET
14F4:         	PHX8D_ERR:
14F4: 1B      	            DEC  DE
14F5: 37      	            SCF
14F6: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
14F7:         	PARSE_HEX16_DE:
14F7: CDDE14  	            CALL PARSE_HEX8_DE
14FA: D8      	            RET  C
14FB: 67      	            LD   H, A
14FC: CDDE14  	            CALL PARSE_HEX8_DE
14FF: D8      	            RET  C
1500: 6F      	            LD   L, A
1501: C9      	            RET
              	
              	; --- UPCASE_TOKEN: copia token de (HL) em maiúscula para HEXBUF; HL avança após token ---
1502:         	UPCASE_TOKEN:
1502: 11F7FB  	            LD   DE, HEXBUF
1505: 060A    	            LD   B, 10
