177E:         	loadInit:
177E: 3EFF    	    LD A, $FF
1780: 32FFFB  	    LD (LOAD_FIRST_FLAG), A
              	
1783: 214219  	    LD HL, MSG_LOAD_HELP
1786: CDE318  	    CALL SERIAL_A_PRINT_STRING
              	
1789: 114419  	    LD DE, MSG_LOAD_HELP_LCD
178C: CD3B08  	    CALL sendStringToLCD
              	
178F:         	loopHexLoad:
178F: CD8A10  	    CALL RXDATA
              	
1792: FE3A    	    CP   ':'	; ":"?
1794: 20F9    		JR   NZ, loopHexLoad ; Aguarda :
              	
              	    ; Só inicializa o flag se for a primeira linha do carregamento
1796: 3AFFFB  		LD   A, (LOAD_FIRST_FLAG)
1799: FEFF    		CP   $FF                    ; $FF = virgem / sessão nova
179B: 2005    		JR   NZ, monitor_do_load    ; já está no meio de um carregamento
179D: 3E01    		LD   A, $01
179F: 32FFFB  		LD   (LOAD_FIRST_FLAG), A   ; sinaliza: próximo LOAD é o primeiro
              	
17A2:         	monitor_do_load:
17A2: CDB317  		CALL    LOAD
17A5: CDEC18  		CALL SERIAL_A_TXCRLF
17A8: C38F17  	    JP loopHexLoad
              	
              	
17AB:         	CALL_IHEX:
17AB: 21B402  		LD HL, MAIN_LOOP
