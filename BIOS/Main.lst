0A15: B7      	        OR A
0A16: CC1507  	        CALL Z,flipPixel    ;Flip the bit at the cursor position if not inverse
0A19: 04      	        INC B               ;move X to the right by one
0A1A: 15      	        DEC D
0A1B: 20F5    	        JR NZ,FLIP_BIT
0A1D: 1D      	        DEC E               ;move column pixel count down by one
0A1E: C8      	        RET Z               ;if its zero no more to do, just exit
0A1F: 0C      	        INC C               ;move down a row
0A20: 1606    	        LD D,6              ;reset pixel length per row
0A22: 3A96FB  	        LD A,(CURSOR_X)     ;restore original column
0A25: 47      	        LD B,A              ;reset column
0A26: 18EA    	        JR FLIP_BIT
              	
              	;Draw a blank at the current cursor position.  This is for DELETE character
0A28:         	drawBlank:
0A28: 110606  	        LD DE,0606H         ;Six pixels across, Six pixels down
0A2B: ED4B95FB	        LD BC,(CURSOR_XY)   ;Get graphics cursor position
0A2F:         	FLIP_BIT1:        
0A2F: CD0307  	        CALL clearPixel     ;clear the bit at the cursor position
0A32: 04      	        INC B               ;move X to the right by one
0A33: 15      	        DEC D
0A34: 20F9    	        JR NZ,FLIP_BIT1
0A36: 1D      	        DEC E               ;move column pixel count down by one
0A37: C8      	        RET Z               ;if its zero no more to do, just exit
0A38: 0C      	        INC C               ;move down a row
0A39: 1606    	        LD D,6              ;reset pixel length per row
0A3B: 3A96FB  	        LD A,(CURSOR_X)     ;restore original column
0A3E: 47      	        LD B,A              ;reset column
0A3F: 18EE    	        JR FLIP_BIT1
              	
