1127: 434C5300	            DB   "CLS",  NUL
112B: 4E12    	            DW   CLS_CMD
112D: 44554D50	            DB   "DUMP", NUL
1131: 00      	
1132: 5412    	            DW   DUMP_CMD
1134: 57524954	            DB   "WRITE", NUL
1138: 4500    	
113A: 9612    	            DW   LOAD_CMD
113C: 45444954	            DB   "EDIT", NUL
