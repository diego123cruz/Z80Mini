              	; --- GETLINE: Lê linha para LINEBUF; eco local ---
              	;     Termina em CR. Suporta BS/DEL para apagar.
14B6:         	GETLINE:
14B6: 21BEFB  	            LD   HL, LINEBUF
14B9: 064F    	            LD   B, 79               ; Máx 79 chars + NUL
14BB:         	GETLINE_LOOP:
14BB: CD8203  	            CALL CONIN
14BE: FE0D    	            CP   CR
14C0: 2844    	            JR   Z, GETLINE_DONE
14C2: FEF8    	            CP   $F8    ; ignora scroll up - GLCD
14C4: 28EB    	            JR   Z, LCD_SCROLL
14C6: FEF7    	            CP   $F7    ; ignora scroll down - GLCD
14C8: 28E7    	            JR   Z, LCD_SCROLL
14CA: FE0A    	            CP   LF
14CC: 28ED    	            JR   Z, GETLINE_LOOP    ; Ignora LF
14CE: FE1B    	            CP   ESC
14D0: 28E9    	            JR   Z, GETLINE_LOOP    ; Ignora
14D2: FEFF    	            CP   $FF ;capslock Ignora
14D4: CABB14  	            JP   Z, GETLINE_LOOP
14D7: FE08    	            CP   BkS
14D9: 281D    	            JR   Z, GETLINE_BS
14DB: FE7F    	            CP   DEL
14DD: 2819    	            JR   Z, GETLINE_BS
14DF: FEFA    	            CP   $FA ; AltGr
14E1: CA0219  	            JP   Z, CALL_IHEX
14E4: FEF9    	            CP   $F9 ; LUZ
14E6: CAC412  	            JP   Z, CALL_8000
14E9: 4F      	            LD   C, A
14EA: 78      	            LD   A, B
14EB: FE00    	            CP   0
14ED: 28CC    	            JR   Z, GETLINE_LOOP    ; Buffer cheio
14EF: 79      	            LD   A, C
14F0: 77      	            LD   (HL), A
14F1: 23      	            INC  HL
14F2: 05      	            DEC  B
14F3: CDF704  	            CALL PUTCHAR             ; Eco
14F6: 18C3    	            JR   GETLINE_LOOP
