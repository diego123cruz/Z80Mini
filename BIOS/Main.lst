              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
2714: CD5C19  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
2717: 47      	    LD   B,A	; Load it in B
2718: CD5C19  	    CALL GETCHR_S	; Get us another character
271B: 4F      	    LD   C,A	; load it in C
271C: CD7819  	    CALL BCTOA	; Convert ASCII to byte
271F: C9      	    RET
              	
              	;------------------------------------------------------------------------------
              	; Pegar 4 caracteres ASCII (0-9 A-F) converte em HL
              	;------------------------------------------------------------------------------
2720:         	SERIAL_GET_HEX_HL:
