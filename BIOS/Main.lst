150A: 2817    	            JR   Z, UPCASE_DONE
150C: FE0D    	            CP   CR
150E: 2813    	            JR   Z, UPCASE_DONE
1510: FE00    	            CP   NUL
1512: 280F    	            JR   Z, UPCASE_DONE
1514: FE61    	            CP   'a'
1516: 3806    	            JR   C, UPCASE_STORE
1518: FE7B    	            CP   'z'+1
151A: 3002    	            JR   NC, UPCASE_STORE
151C: E6DF    	            AND  0DFH               ; Converte para maiúscula
151E:         	UPCASE_STORE:
