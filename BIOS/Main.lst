20D2: 52524F21	
20D6: 0D0A00  	             .DB CR, LF, 0
              	
              	
              	
              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
20D9:         	FS_WRITE_PG:
20D9: C5      	    PUSH BC
20DA: D5      	    PUSH DE
20DB: E5      	    PUSH HL
20DC: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
20DD: 2A35FC  	    LD HL, (FS_TMPSZ)
20E0: 7C      	    LD A, H
20E1: B7      	    OR A
20E2: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
20E4: 7D      	    LD A, L
20E5: FEFF    	    CP FS_DATAPG            ; L < 255?
20E7: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
20E9:         	FS_WP_USE255:
20E9: 0EFF    	    LD C, FS_DATAPG         ; C = 255
20EB: 1801    	    JR FS_WP_COPY
20ED:         	FS_WP_USELT:
20ED: 4D      	    LD C, L                 ; C = L (< 255)
              	
20EE:         	FS_WP_COPY:
              	    ; C = bytes a gravar (1..255). Salva em D para nao perder.
20EE: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
20EF: 213DFC  	    LD HL, PG_BUF
20F2: 3600    	    LD (HL), $00            ; byte 0 = next = $00
20F4: 23      	    INC HL                  ; HL = PG_BUF + 1
              	
              	    ; Copia D bytes de FS_TMPRAM para PG_BUF+1
              	    ; Usa IX como ponteiro de origem (LD BC,(nn) pode nao funcionar no zasm)
20F5: DD2A37FC	    LD IX, (FS_TMPRAM)      ; IX = ponteiro RAM origem
20F9: 5A      	    LD E, D                 ; E = contador de copia
20FA:         	FS_WP_CPLOOP:
20FA: DD7E00  	    LD A, (IX+0)            ; le da RAM origem
20FD: 77      	    LD (HL), A              ; grava no PG_BUF
20FE: DD23    	    INC IX
2100: 23      	    INC HL
2101: 1D      	    DEC E
2102: 20F6    	    JR NZ, FS_WP_CPLOOP
              	
              	    ; Padding $FF ate completar 256 bytes (posicoes D+1 a 255)
              	    ; Bytes de padding = 255 - D
2104: 3EFF    	    LD A, FS_DATAPG         ; 255
2106: 92      	    SUB D                   ; A = 255 - D (bytes de padding)
2107: 2807    	    JR Z, FS_WP_NOPAD       ; sem padding (D=255, pagina cheia)
2109: 5F      	    LD E, A
210A:         	FS_WP_PADLOOP:
210A: 36FF    	    LD (HL), $FF
210C: 23      	    INC HL
210D: 1D      	    DEC E
210E: 20FA    	    JR NZ, FS_WP_PADLOOP
2110:         	FS_WP_NOPAD:
              	
              	    ; Grava PG_BUF inteiro (256 bytes) na EEPROM
              	    ; Endereco EEPROM = pagina * 256 (D = pagina, E = 0)
2110: F1      	    POP AF                  ; A = numero da pagina
2111: F5      	    PUSH AF
2112: 57      	    LD D, A
2113: 1E00    	    LD E, 0
2115: 213DFC  	    LD HL, PG_BUF
2118: 010001  	    LD BC, 256
211B: CDFA1B  	    CALL I2C_MemWr
211E: C24B21  	    JP NZ, FS_WP_ERR
              	
              	    ; Atualiza FS_TMPRAM += D_bytes_gravados
2121: F1      	    POP AF                  ; A = pagina (descarta)
2122: E1      	    POP HL                  ; restaura HL original
2123: D1      	    POP DE                  ; restaura DE original
2124: C1      	    POP BC                  ; restaura BC original
              	
              	    ; Recalcula com D = bytes gravados
              	    ; D foi preservado? Nao — foi sobrescrito por LD D, A (pagina).
              	    ; Usamos FS_TMPSZ antes e depois para calcular o que foi gravado:
              	    ; bytes_gravados = min(TMPSZ_antes, 255)
              	    ; Mais simples: relemos FS_TMPSZ e FS_TMPRAM e atualizamos
              	    ; Mas D foi sobrescrito... precisamos salvar D antes do I2C_MemWr.
              	    ; SOLUCAO: salvar D (bytes) em FS_TMP1 antes de gravar.
              	    ; Para nao refatorar todo o fluxo acima, usamos um truque:
              	    ; bytes_gravados = FS_TMPSZ se < 255, ou 255 se >= 255.
              	    ; Recalcula de FS_TMPSZ:
2125: 2A35FC  	    LD HL, (FS_TMPSZ)
2128: 7C      	    LD A, H
2129: B7      	    OR A
212A: 2005    	    JR NZ, FS_WP_UPD255
212C: 7D      	    LD A, L
212D: FEFF    	    CP FS_DATAPG
212F: 3805    	    JR C, FS_WP_UPDLT
2131:         	FS_WP_UPD255:
2131: 01FF00  	    LD BC, FS_DATAPG        ; bytes gravados = 255
2134: 1803    	    JR FS_WP_UPDATE
2136:         	FS_WP_UPDLT:
2136: 0600    	    LD B, 0
2138: 4D      	    LD C, L                 ; bytes gravados = L
              	
2139:         	FS_WP_UPDATE:
              	    ; FS_TMPRAM += BC
2139: 2A37FC  	    LD HL, (FS_TMPRAM)
213C: 09      	    ADD HL, BC
213D: 2237FC  	    LD (FS_TMPRAM), HL
              	    ; FS_TMPSZ -= BC
2140: 2A35FC  	    LD HL, (FS_TMPSZ)
2143: B7      	    OR A                    ; limpa carry
2144: ED42    	    SBC HL, BC
2146: 2235FC  	    LD (FS_TMPSZ), HL
2149: AF      	    XOR A                   ; Z = sucesso
214A: C9      	    RET
              	
214B:         	FS_WP_ERR:
214B: F1      	    POP AF
214C: E1      	    POP HL
214D: D1      	    POP DE
214E: C1      	    POP BC
214F: 3E01    	    LD A, 1
2151: B7      	    OR A
2152: C9      	    RET
              	
              	; FS_SET_NEXT: Escreve byte 0 da pagina A com valor B
              	;   On exit: Z=OK  NZ=erro
2153:         	FS_SET_NEXT:
2153: C5      	    PUSH BC
2154: D5      	    PUSH DE
2155: E5      	    PUSH HL
2156: 57      	    LD D, A
2157: 1E00    	    LD E, 0
2159: 78      	    LD A, B
215A: 3234FC  	    LD (FS_TMP1), A
215D: 2134FC  	    LD HL, FS_TMP1
2160: 010100  	    LD BC, 1
2163: CDFA1B  	    CALL I2C_MemWr
2166: E1      	    POP HL
2167: D1      	    POP DE
2168: C1      	    POP BC
2169: C9      	    RET
              	
              	
              	
              	; FS_FIND_NAME: Busca FS_NAMBUF no diretorio
              	;   On exit: Z=encontrado (FS_CUR=idx, FS_WRKBUF=entrada)
              	;            NZ=nao encontrado
216A:         	FS_FIND_NAME:
216A: AF      	    XOR A
216B: 3209FC  	    LD (FS_CUR), A
216E: 0608    	    LD B, FS_MAXFILES
2170:         	FS_FN_LP:
2170: C5      	    PUSH BC
2171: CD601F  	    CALL FS_RD_ENTRY
2174: C2A321  	    JP NZ, FS_FN_ERR
2177: 3A17FC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
217A: FE01    	    CP FS_FLAG_USED
217C: 2017    	    JR NZ, FS_FN_NXT
217E: 212AFC  	    LD HL, FS_NAMBUF
2181: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
2184: 0E08    	    LD C, FS_NAME_SZ
2186:         	FS_FN_CMP:
2186: 7E      	    LD   A, (HL)
2187: 47      	    LD   B, A
2188: 1A      	    LD   A, (DE)
2189: B8      	    CP   B
218A: C29521  	    JP  NZ, FS_FN_NXT
218D: 23      	    INC HL
218E: 13      	    INC DE
218F: 0D      	    DEC C
2190: 20F4    	    JR NZ, FS_FN_CMP
2192: C1      	    POP BC
2193: AF      	    XOR A
2194: C9      	    RET
2195:         	FS_FN_NXT:
2195: 3A09FC  	    LD A, (FS_CUR)
2198: 3C      	    INC A
2199: 3209FC  	    LD (FS_CUR), A
219C: C1      	    POP BC
219D: 10D1    	    DJNZ FS_FN_LP
219F: 3E01    	    LD A, 1
21A1: B7      	    OR A
21A2: C9      	    RET
21A3:         	FS_FN_ERR:
21A3: C1      	    POP BC
21A4: 3E03    	    LD A, ERR_TOUT
21A6: B7      	    OR A
21A7: C9      	    RET
              	
              	
