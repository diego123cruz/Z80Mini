              	; ============================================================
              	;  SUBROTINAS DE PARSE
              	; ============================================================
              	; --- SKIP_COMMAND_DE: Avança DE até o proximo espaço ---
14B4:         	SKIP_COMMAND_DE:
14B4: 1A      				LD A, (DE)
14B5: FE20    				CP SPACE
14B7: C8      				RET Z
14B8: 13      				INC DE
14B9: 18F9    				JR SKIP_COMMAND_DE
              	
              	
              	; --- SKIP_SPACES: Avança HL sobre espaços ---
14BB:         	SKIP_SPACES:
14BB: 7E      	            LD   A, (HL)
14BC: FE20    	            CP   SPACE
14BE: C0      	            RET  NZ
14BF: 23      	            INC  HL
14C0: 18F9    	            JR   SKIP_SPACES
              	
              	; --- SKIP_SPACES_DE: Avança DE sobre espaços ---
14C2:         	SKIP_SPACES_DE:
14C2: 1A      	            LD   A, (DE)
14C3: FE20    	            CP   SPACE
14C5: C0      	            RET  NZ
14C6: 13      	            INC  DE
14C7: 18F9    	            JR   SKIP_SPACES_DE
              	
              	; --- SKIP_SPACES_HL: Avança HL sobre espaços ---
14C9:         	SKIP_SPACES_HL:
14C9: 7E      	            LD   A, (HL)
14CA: FE20    	            CP   SPACE
14CC: C0      	            RET  NZ
14CD: 23      	            INC  HL
14CE: 18F9    	            JR   SKIP_SPACES_HL
              	
              	; --- IS_HEX: testa se A é dígito hex; retorna dígito em A (0-15), CY se inválido ---
14D0:         	IS_HEX:
14D0: FE30    	            CP   '0'
14D2: 3814    	            JR   C, IS_HEX_BAD
14D4: FE3A    	            CP   '9'+1
14D6: 380D    	            JR   C, IS_HEX_DIG      ; '0'-'9'
14D8: E6DF    	            AND  0DFH               ; Uppercase
14DA: FE41    	            CP   'A'
14DC: 380A    	            JR   C, IS_HEX_BAD
14DE: FE47    	            CP   'F'+1
14E0: 3006    	            JR   NC, IS_HEX_BAD
14E2: D637    	            SUB  'A'-10             ; 'A'→10 ... 'F'→15
14E4: C9      	            RET
14E5:         	IS_HEX_DIG:
14E5: D630    	            SUB  '0'
14E7: C9      	            RET
14E8:         	IS_HEX_BAD:
14E8: 37      	            SCF
14E9: C9      	            RET
              	
              	; --- PARSE_HEX8_HL: parseia 2 dígitos hex em (HL), resultado em A; HL avança 2 ---
              	;     Carry = erro
14EA:         	PARSE_HEX8_HL:
14EA: 7E      	            LD   A, (HL)
14EB: CDD014  	            CALL IS_HEX
14EE: D8      	            RET  C
14EF: 0F      	            RRCA
14F0: 0F      	            RRCA
14F1: 0F      	            RRCA
14F2: 0F      	            RRCA
14F3: E6F0    	            AND  0F0H
14F5: 47      	            LD   B, A
14F6: 23      	            INC  HL
14F7: 7E      	            LD   A, (HL)
14F8: CDD014  	            CALL IS_HEX
14FB: 3803    	            JR   C, PHX8_ERR
14FD: B0      	            OR   B
14FE: 23      	            INC  HL
14FF: C9      	            RET
1500:         	PHX8_ERR:
1500: 2B      	            DEC  HL
1501: 37      	            SCF
1502: C9      	            RET
              	
              	; --- PARSE_HEX8_DE: igual mas com DE ---
1503:         	PARSE_HEX8_DE:
1503: 1A      	            LD   A, (DE)
1504: CDD014  	            CALL IS_HEX
1507: D8      	            RET  C
1508: 0F      	            RRCA
1509: 0F      	            RRCA
150A: 0F      	            RRCA
150B: 0F      	            RRCA
150C: E6F0    	            AND  0F0H
150E: 47      	            LD   B, A
150F: 13      	            INC  DE
1510: 1A      	            LD   A, (DE)
1511: CDD014  	            CALL IS_HEX
1514: 3803    	            JR   C, PHX8D_ERR
1516: B0      	            OR   B
1517: 13      	            INC  DE
1518: C9      	            RET
1519:         	PHX8D_ERR:
1519: 1B      	            DEC  DE
151A: 37      	            SCF
151B: C9      	            RET
              	
              	; --- PARSE_HEX16_DE: parseia 4 dígitos hex em (DE), resultado em HL; DE avança 4 ---
151C:         	PARSE_HEX16_DE:
151C: CD0315  	            CALL PARSE_HEX8_DE
151F: D8      	            RET  C
1520: 67      	            LD   H, A
1521: CD0315  	            CALL PARSE_HEX8_DE
1524: D8      	            RET  C
1525: 6F      	            LD   L, A
1526: C9      	            RET
              	
              	; --- UPCASE_TOKEN: copia token de (HL) em maiúscula para HEXBUF; HL avança após token ---
1527:         	UPCASE_TOKEN:
1527: 11F5FB  	            LD   DE, HEXBUF
152A: 060A    	            LD   B, 10
152C:         	UPCASE_LOOP:
152C: 7E      	            LD   A, (HL)
152D: FE20    	            CP   SPACE
152F: 2817    	            JR   Z, UPCASE_DONE
1531: FE0D    	            CP   CR
1533: 2813    	            JR   Z, UPCASE_DONE
1535: FE00    	            CP   NUL
1537: 280F    	            JR   Z, UPCASE_DONE
1539: FE61    	            CP   'a'
153B: 3806    	            JR   C, UPCASE_STORE
153D: FE7B    	            CP   'z'+1
153F: 3002    	            JR   NC, UPCASE_STORE
1541: E6DF    	            AND  0DFH               ; Converte para maiúscula
1543:         	UPCASE_STORE:
1543: 12      	            LD   (DE), A
1544: 23      	            INC  HL
1545: 13      	            INC  DE
1546: 10E4    	            DJNZ UPCASE_LOOP
1548:         	UPCASE_DONE:
1548: 3E00    	            LD   A, NUL
154A: 12      	            LD   (DE), A
154B: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
154C:         	STRCMP:
154C: 7E      	            LD   A, (HL)
154D: 47      	            LD   B, A
154E: 1A      	            LD   A, (DE)
154F: B8      	            CP   B
1550: C0      	            RET  NZ
1551: FE00    	            CP   NUL
1553: C8      	            RET  Z
1554: 23      	            INC  HL
1555: 13      	            INC  DE
1556: 18F4    	            JR   STRCMP
              	
              	; ============================================================
              	;  SUBROTINAS DE SAÍDA HEX
              	; ============================================================
              	
              	; --- PRINT_HEX8: Imprime byte em A como 2 dígitos hex ---
1558:         	PRINT_HEX8:
1558: F5      	            PUSH AF
1559: 0F      	            RRCA
155A: 0F      	            RRCA
155B: 0F      	            RRCA
155C: 0F      	            RRCA
155D: CD6515  	            CALL PRINT_NIBBLE
1560: F1      	            POP  AF
1561: CD6515  	            CALL PRINT_NIBBLE
1564: C9      	            RET
              	
1565:         	PRINT_NIBBLE:
1565: E60F    	            AND  0FH
1567: C630    	            ADD  A, '0'
1569: FE3A    	            CP   '9'+1
156B: 3802    	            JR   C, PN_DONE
156D: C607    	            ADD  A, 07H              ; 'A'-'9'-1
156F:         	PN_DONE:
156F: CD9F04  	            CALL PUTCHAR
1572: C9      	            RET
              	
              	; --- PRINT_HEX16: Imprime HL como 4 dígitos hex ---
1573:         	PRINT_HEX16:
1573: 7C      	            LD   A, H
1574: CD5815  	            CALL PRINT_HEX8
1577: 7D      	            LD   A, L
1578: CD5815  	            CALL PRINT_HEX8
157B: C9      	            RET
              	
              	
              	
              	
              	; ============================================================
              	; I2C_CMD - Testes rapidos no barramento I2C
              	;
              	; Sintaxe: I2C aa [Wdd] [Rnn] [Wdd] [Rnn] ...
              	;   aa  = endereco do device, 7 bits, hex, SEM o bit R/W
              	;   Wdd = escreve o byte dd (hex)
              	;   Rnn = le nn bytes (hex) e imprime cada um em hex
              	;
              	; Exemplos:
              	;   I2C 20 WFF           -> PCF8574: open(write), write FF, close
              	;   I2C 50 W10 W20 R04    -> EEPROM : open(write), write 10, write 20,
              	;                             open(read, repeated start), read 4, close
              	;
              	; O comando reabre o device (I2C_Open de novo, sem fechar antes) toda
              	; vez que a direcao muda de W para R ou de R para W - isso gera um
              	; repeated start, igual o I2C_MemRd ja faz internamente.
              	;
              	; Dentro de um bloco Rnn, todo byte manda ACK pro slave, exceto o
              	; ultimo, que manda NACK (fim da leitura) - mesma logica do I2C_MemRd.
              	;
              	; No primeiro NACK (falha de escrita/open), a sequencia e abortada,
              	; o barramento e fechado (STOP) para nao ficar travado, e uma
              	; mensagem de erro e impressa.
              	;
              	; Requer de I2C.asm: I2C_Open, I2C_Write, I2C_Read, I2C_Close
              	; ============================================================
              	
157C:         	I2C_CMD:
              	    ; DE -> argumentos (endereco DEc apos "I2C ")
157C: CD0315  	    CALL PARSE_HEX8_DE     ; A = endereco do device (7 bits)
157F: DA3016  	    JP  C, I2C_BAD_SYNTAX
1582: 3240FD  	    LD  (I2C_ADDR7), A
1585: AF      	    XOR A
1586: 3241FD  	    LD  (I2C_STATE), A     ; 0 = fechado
              	
1589:         	I2C_LOOP:
1589: CDC214  	    CALL SKIP_SPACES_DE
158C: 1A      	    LD  A, (DE)
158D: FE0D    	    CP  CR
158F: CA1C16  	    JP  Z, I2C_DONE
1592: FE00    	    CP  NUL
1594: CA1C16  	    JP  Z, I2C_DONE
              	
              	    ; Le o operador (W ou R)
1597: 1A      	    LD  A, (DE)
1598: E6DF    	    AND 0DFH                ; forca maiuscula
159A: 13      	    INC DE
159B: FE57    	    CP  'W'
159D: 2807    	    JR  Z, I2C_DO_WRITE
159F: FE52    	    CP  'R'
15A1: 2829    	    JR  Z, I2C_DO_READ
15A3: C33016  	    JP  I2C_BAD_SYNTAX
              	
              	; -------- WRITE --------
15A6:         	I2C_DO_WRITE:
15A6: CD0315  	    CALL PARSE_HEX8_DE      ; A = byte a escrever
15A9: DA3016  	    JP  C, I2C_BAD_SYNTAX
15AC: 4F      	    LD  C, A                ; guarda o byte
              	
15AD: 3A41FD  	    LD  A, (I2C_STATE)
15B0: FE01    	    CP  1
15B2: 2810    	    JR  Z, I2C_WRITE_GO      ; ja aberto em modo write
              	
15B4: 3A40FD  	    LD  A, (I2C_ADDR7)
15B7: 07      	    RLCA                     ; addr << 1
15B8: E6FE    	    AND 0FEH                 ; bit0 = 0 (write)
15BA: CD831A  	    CALL I2C_Open
15BD: 204D    	    JR  NZ, I2C_NOACK
15BF: 3E01    	    LD  A, 1
15C1: 3241FD  	    LD  (I2C_STATE), A
              	
15C4:         	I2C_WRITE_GO:
15C4: 79      	    LD  A, C
15C5: CD971A  	    CALL I2C_Write
15C8: 2042    	    JR  NZ, I2C_NOACK
15CA: 18BD    	    JR  I2C_LOOP
              	
              	; -------- READ --------
15CC:         	I2C_DO_READ:
15CC: CD0315  	    CALL PARSE_HEX8_DE       ; A = quantidade de bytes a ler
15CF: 385F    	    JR  C, I2C_BAD_SYNTAX
15D1: 47      	    LD  B, A
15D2: 78      	    LD  A, B
15D3: B7      	    OR  A
15D4: 28B3    	    JR  Z, I2C_LOOP           ; R00 = nada a fazer
              	
15D6: 3A41FD  	    LD  A, (I2C_STATE)
15D9: FE02    	    CP  2
15DB: 2810    	    JR  Z, I2C_READ_GO         ; ja aberto em modo read
              	
15DD: 3A40FD  	    LD  A, (I2C_ADDR7)
15E0: 07      	    RLCA
15E1: F601    	    OR  01H                    ; bit0 = 1 (read)
15E3: CD831A  	    CALL I2C_Open
15E6: 2024    	    JR  NZ, I2C_NOACK
15E8: 3E02    	    LD  A, 2
15EA: 3241FD  	    LD  (I2C_STATE), A
              	
15ED:         	I2C_READ_GO:
15ED: 78      	    LD  A, B
15EE: FE01    	    CP  1
15F0: 2804    	    JR  Z, I2C_READ_LASTBYTE
15F2: 3EFF    	    LD  A, 0FFH                 ; ACK - ainda tem mais bytes
15F4: 1801    	    JR  I2C_READ_DOIT
15F6:         	I2C_READ_LASTBYTE:
15F6: AF      	    XOR A                        ; NACK - ultimo byte do bloco
15F7:         	I2C_READ_DOIT:
15F7: CDD41A  	    CALL I2C_Read                ; A = byte lido
15FA: C5      	    PUSH BC
15FB: CD5815  	    CALL PRINT_HEX8
15FE: 3E20    	    LD  A, SPACE
1600: CD9F04  	    CALL PUTCHAR
1603: C1      	    POP BC
1604: 05      	    DEC B
1605: 78      	    LD  A, B
1606: B7      	    OR  A
1607: 20E4    	    JR  NZ, I2C_READ_GO
1609: C38915  	    JP  I2C_LOOP
              	
              	; -------- Erro / fim --------
160C:         	I2C_NOACK:
160C: F5      	    PUSH AF
160D: CD8A1A  	    CALL I2C_Close               ; garante que o barramento nao trava
1610: AF      	    XOR A
1611: 3241FD  	    LD  (I2C_STATE), A
1614: F1      	    POP AF
1615: 213716  	    LD  HL, MSG_I2C_NOACK
1618: CDAB04  	    CALL PUTS
161B: C9      	    RET
              	
161C:         	I2C_DONE:
161C: 3A41FD  	    LD  A, (I2C_STATE)
161F: B7      	    OR  A
1620: 2807    	    JR  Z, I2C_OK
1622: CD8A1A  	    CALL I2C_Close
1625: AF      	    XOR A
1626: 3241FD  	    LD  (I2C_STATE), A
1629:         	I2C_OK:
1629: 219C16  	    LD  HL, MSG_OK
162C: CDAB04  	    CALL PUTS
162F: C9      	    RET
              	
1630:         	I2C_BAD_SYNTAX:
1630: 218A16  	    LD  HL, MSG_SYNTAX
1633: CDAB04  	    CALL PUTS
1636: C9      	    RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
