24F0: CD9D22  	    CALL FS_RD_ENTRY
24F3: C22225  	    JP NZ, FS_FFN_ERR
24F6: 3A1FFC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
24F9: FE02    	    CP FS_FLAG_USED_FOLDER
24FB: 2017    	    JR NZ, FS_FFN_NXT
24FD: 212AFC  	    LD HL, FS_NAMBUF
2500: 110AFC  	    LD DE, FS_WRKBUF + FS_O_NAME
2503: 0E10    	    LD C, FS_NAME_SZ
2505:         	FS_FFN_CMP:
2505: 7E      	    LD   A, (HL)
2506: 47      	    LD   B, A
2507: 1A      	    LD   A, (DE)
2508: B8      	    CP   B
2509: C21425  	    JP  NZ, FS_FFN_NXT
250C: 23      	    INC HL
250D: 13      	    INC DE
250E: 0D      	    DEC C
250F: 20F4    	    JR NZ, FS_FFN_CMP
2511: C1      	    POP BC
2512: AF      	    XOR A
2513: C9      	    RET
2514:         	FS_FFN_NXT:
2514: 3A09FC  	    LD A, (FS_CUR)
2517: 3C      	    INC A
2518: 3209FC  	    LD (FS_CUR), A
251B: C1      	    POP BC
251C: 10D1    	    DJNZ FS_FFN_LP
251E: 3E01    	    LD A, 1
2520: B7      	    OR A
2521: C9      	    RET
2522:         	FS_FFN_ERR:
2522: C1      	    POP BC
2523: 3E03    	    LD A, ERR_TOUT
2525: B7      	    OR A
2526: C9      	    RET
              	
              	
              	
              	
              	
