              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
274B: CD8519  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
274E: 47      	    LD   B,A	; Load it in B
274F: CD8519  	    CALL GETCHR_S	; Get us another character
2752: 4F      	    LD   C,A	; load it in C
2753: CDA119  	    CALL BCTOA	; Convert ASCII to byte
2756: C9      	    RET
              	
              	;------------------------------------------------------------------------------
              	; Pegar 4 caracteres ASCII (0-9 A-F) converte em HL
              	;------------------------------------------------------------------------------
