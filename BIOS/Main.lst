200B: 3A3CFC  	    LD A, (FS_BMPADDR+1)
200E: 4F      	    LD C, A
200F: 3E01    	    LD A, 1
2011:         	FS_AP_MKSHL:
2011: 0D      	    DEC C
2012: FA1820  	    JP M, FS_AP_MKINV
2015: 07      	    RLCA
2016: 18F9    	    JR FS_AP_MKSHL
2018:         	FS_AP_MKINV:
