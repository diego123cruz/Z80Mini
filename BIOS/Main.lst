17AF: CD7E17  		CALL loadInit
17B2: C9      		RET
              	
              	;------------------------------------------------------------------------------
              	; LOAD Intel Hex format file from the console.
              	; [Intel Hex Format is:
              	; 1) Colon (Frame 0)
              	; 2) Record Length Field (Frames 1 and 2)
              	; 3) Load Address Field (Frames 3,4,5,6)
              	; 4) Record Type Field (Frames 7 and 8)
              	; 5) Data Field (Frames 9 to 9+2*(Record Length)-1
              	; 6) Checksum Field - Sum of all byte values from Record Length to and 
              	;   including Checksum Field = 0 ]
              	;------------------------------------------------------------------------------	
17B3:         	LOAD:
17B3: 1E00    			LD   E,0	        ; Zera checksum
17B5: CD9118  			CALL GET2	        ; Record Length -> D
17B8: 57      			LD   D,A
17B9: CD9118  			CALL GET2	        ; Endereco High -> H
17BC: 67      			LD   H,A
17BD: CD9118  			CALL GET2	        ; Endereco Low -> L
17C0: 6F      			LD   L,A
17C1: CD9118  			CALL GET2	        ; Record Type -> A
17C4: FE01    			CP   $01	        ; EOF record?
17C6: 2009    			JR   NZ,LOAD2	    ; Nao: processa dados
              	
              			; --- Record tipo 01: EOF ---
17C8: CD9118  			CALL GET2	        ; Consome checksum do EOF
17CB: 7B      			LD   A,E
17CC: A7      			AND  A
17CD: 2839    			JR   Z,LOAD00       ; Checksum OK: imprime resumo
17CF: 1829    			JR   LOADERR        ; Checksum falhou
              	
              			; --- Record tipo 00: Dados ---
17D1:         	LOAD2:
              			; Salva endereco inicial apenas na primeira linha
17D1: 3AFFFB  			LD   A, (LOAD_FIRST_FLAG)
17D4: FE01    			CP   $01                    ; e a primeira linha?
17D6: 2008    			JR   NZ, LOAD2_SKIP
17D8: 3E00    			LD   A, $00
17DA: 32FFFB  			LD   (LOAD_FIRST_FLAG), A   ; limpa flag
17DD: 2200FC  			LD   (LOAD_START_ADDR), HL  ; salva endereco inicial
              	
17E0:         	LOAD2_SKIP:
17E0: 7A      			LD   A,D	        ; Contador de bytes da linha
17E1: A7      			AND  A
17E2: 280D    			JR   Z,LOAD3
              	
17E4: CD9118  			CALL GET2	        ; Le proximo byte
17E7: 77      			LD   (HL),A	        ; Grava na memoria
17E8: 23      			INC  HL
17E9: 3E2E    			LD   A,'.'
17EB: CD5D10  			CALL OUTCH
17EE: 15      			DEC  D
17EF: 18EF    			JR   LOAD2_SKIP     ; (continua pelo loop sem re-checar o flag)
              	
17F1:         	LOAD3:
17F1: 2202FC  			LD   (LOAD_END_ADDR), HL    ; Atualiza endereco final (apos ultimo byte)
17F4: CD9118  			CALL GET2	                ; Consome checksum da linha
17F7: 7B      			LD   A,E
17F8: A7      			AND  A
17F9: C8      			RET  Z                      ; Checksum OK: volta pro monitor
              	
17FA:         	LOADERR:
17FA: 21F718  			LD   HL,CKSUMERR
17FD: CDE318  			CALL SERIAL_A_PRINT_STRING
              	
              	        ;LCD
1800: 11F718  	        LD   DE, CKSUMERR
1803: CD3B08  	        CALL sendStringToLCD
              	
1806: E1      	        POP HL
              	
1807: C9      			RET
              	
1808:         	LOAD00:
              			; --- Imprime resumo do carregamento ---
1808: 210819  			LD   HL, LDETXT
180B: CDE318  			CALL SERIAL_A_PRINT_STRING
              	
180E: 212719  			LD   HL, msg_load_start
1811: CDE318  			CALL SERIAL_A_PRINT_STRING
1814: 2A00FC  			LD   HL, (LOAD_START_ADDR)
1817: CDBB18  			CALL SERIAL_A_PRINT_HL_HEX
181A: CDEC18  			CALL SERIAL_A_TXCRLF
              	
181D: 213019  			LD   HL, msg_load_end
1820: CDE318  			CALL SERIAL_A_PRINT_STRING
1823: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1826: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1827: CDBB18  			CALL SERIAL_A_PRINT_HL_HEX
182A: CDEC18  			CALL SERIAL_A_TXCRLF
              	
182D: 213919  			LD   HL, msg_load_total
1830: CDE318  			CALL SERIAL_A_PRINT_STRING
1833: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1837: 2A02FC  			LD   HL, (LOAD_END_ADDR)
183A: B7      			OR   A                      ; limpa carry flag
183B: ED52    			SBC  HL, DE                 ; HL = total de bytes
183D: CDBB18  			CALL SERIAL_A_PRINT_HL_HEX
1840: CDEC18  			CALL SERIAL_A_TXCRLF
              	
              	        ; Mostra status no lcd
1843: 112119  	        LD   DE, LDETXTLCD
1846: CD3B08  	        CALL sendStringToLCD
              	
1849: 112719  	        LD   DE, msg_load_start
184C: 3E00    	        LD   A, 0
184E: CD3B08  			CALL sendStringToLCD
1851: 2A00FC  			LD   HL, (LOAD_START_ADDR)
1854: CD7F08  			CALL sendHLToLCD
1857: CD7404  			CALL CRLF
              	
185A: 113019  			LD   DE, msg_load_end
185D: 3E00    	        LD   A, 0
185F: CD3B08  			CALL sendStringToLCD
1862: 2A02FC  			LD   HL, (LOAD_END_ADDR)
1865: 2B      			DEC  HL                     ; aponta para o ultimo byte gravado
1866: CD7F08  			CALL sendHLToLCD
1869: CD7404  			CALL CRLF
              	
186C: 113919  			LD   DE, msg_load_total
186F: 3E00    	        LD   A, 0
1871: CD3B08  			CALL sendStringToLCD
1874: ED5B00FC			LD   DE, (LOAD_START_ADDR)
1878: 2A02FC  			LD   HL, (LOAD_END_ADDR)
187B: B7      			OR   A                      ; limpa carry flag
187C: ED52    			SBC  HL, DE                 ; HL = total de bytes
187E: CD7F08  			CALL sendHLToLCD
              	
1881: CD7404  	        CALL CRLF
              	
1884: E1      	        POP HL 
1885: C9      			RET
              	
              	
              	
              	
              	;------------------------------------------------------------------------------
              	; Get a character from the console, must be $20-$7F to be valid (no control characters)
              	; <Ctrl-c> and <SPACE> breaks with the Zero Flag set
              	;------------------------------------------------------------------------------	
1886: CD6310  	GETCHR_S:	CALL INCH	; RX a Character
1889: FE03    			CP   $03	; <ctrl-c> User break?
188B: C8      			RET  Z			
188C: FE20    			CP   $20	; <space> or better?
188E: 38F6    			JR   C,GETCHR_S	; Do it again until we get something usable
1890: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Gets two ASCII characters from the console (assuming them to be HEX 0-9 A-F)
              	; Moves them into B and C, converts them into a byte value in A and updates a
              	; Checksum value in E
              	;------------------------------------------------------------------------------
1891: CD8618  	GET2:   CALL GETCHR_S	; Get us a valid character to work with
1894: 47      			LD   B,A	; Load it in B
1895: CD8618  			CALL GETCHR_S	; Get us another character
1898: 4F      			LD   C,A	; load it in C
1899: CDA218  			CALL BCTOA	; Convert ASCII to byte
189C: 4F      			LD   C,A	; Build the checksum
189D: 7B      			LD   A,E
189E: 91      			SUB  C		; The checksum should always equal zero when checked
189F: 5F      			LD   E,A	; Save the checksum back where it came from
18A0: 79      			LD   A,C	; Retrieve the byte and go back
18A1: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Convert ASCII characters in B C registers to a byte value in A
              	;------------------------------------------------------------------------------
18A2: 78      	BCTOA		LD   A,B	; Move the hi order byte to A
18A3: D630    			SUB  $30	; Take it down from Ascii
18A5: FE0A    			CP   $0A	; Are we in the 0-9 range here?
18A7: 3802    			JR   C,BCTOA1	; If so, get the next nybble
18A9: D607    			SUB  $07	; But if A-F, take it down some more
18AB: 07      	BCTOA1		RLCA		; Rotate the nybble from low to high
18AC: 07      			RLCA		; One bit at a time
18AD: 07      			RLCA		; Until we
18AE: 07      			RLCA		; Get there with it
18AF: 47      			LD   B,A	; Save the converted high nybble
18B0: 79      			LD   A,C	; Now get the low order byte
18B1: D630    			SUB  $30	; Convert it down from Ascii
18B3: FE0A    			CP   $0A	; 0-9 at this point?
18B5: 3802    			JR   C,BCTOA2	; Good enough then, but
18B7: D607    			SUB  $07	; Take off 7 more if it's A-F
18B9: 80      	BCTOA2		ADD  A,B	; Add in the high order nybble
18BA: C9      			RET
              	
              	;------------------------------------------------------------------------------
              	; Imprime HL como 4 digitos hexadecimais
              	; Ex: HL=$80FF -> imprime "80FF"
              	;------------------------------------------------------------------------------
18BB:         	SERIAL_A_PRINT_HL_HEX:
18BB: 7C      			LD   A, H
18BC: CDC418  			CALL SERIAL_A_PRINT_A_HEX
18BF: 7D      			LD   A, L
18C0: CDC418  			CALL SERIAL_A_PRINT_A_HEX
18C3: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Imprime byte em A como 2 digitos hexadecimais
              	;------------------------------------------------------------------------------
18C4:         	SERIAL_A_PRINT_A_HEX:
18C4: F5      			PUSH AF
18C5: 0F      			RRCA
18C6: 0F      			RRCA
18C7: 0F      			RRCA
18C8: 0F      			RRCA
18C9: CDD118  			CALL SERIAL_A_PRINT_NIBBLE
18CC: F1      			POP  AF
18CD: CDD118  			CALL SERIAL_A_PRINT_NIBBLE
18D0: C9      			RET
              	
18D1:         	SERIAL_A_PRINT_NIBBLE:
18D1: E60F    			AND  $0F
18D3: FE0A    			CP   $0A
18D5: 3806    			JR   C, SERIAL_A_PRINT_NIBBLE_09
18D7: C637    			ADD  A, $37             ; A-F  ('A'=41h, 41h-0Ah=37h)
18D9: CD5D10  			CALL OUTCH
18DC: C9      			RET
18DD:         	SERIAL_A_PRINT_NIBBLE_09:
18DD: C630    			ADD  A, $30             ; 0-9
18DF: CD5D10  			CALL OUTCH
18E2: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
18E3:         	SERIAL_A_PRINT_STRING:
18E3: 7E      	        LD   A,(HL)	; Get character
18E4: B7      			OR   A		; Is it $00 ?
18E5: C8      			RET  Z		; Then RETurn on terminator
18E6: CD5D10  			CALL OUTCH	; Print it
18E9: 23      			INC  HL		; Next Character
18EA: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
18EC: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
18EE: CD5D10  			CALL OUTCH	; Print character 
18F1: 3E0A    			LD   A,$0A	; 
18F3: CD5D10  			CALL OUTCH	; Print character
18F6: C9      			RET
              	
              	
              	
