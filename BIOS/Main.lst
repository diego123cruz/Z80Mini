0A04: 15      	        DEC D
0A05: 20F9    	        JR NZ,FLIP_BIT1
0A07: 1D      	        DEC E               ;move column pixel count down by one
0A08: C8      	        RET Z               ;if its zero no more to do, just exit
0A09: 0C      	        INC C               ;move down a row
0A0A: 1606    	        LD D,6              ;reset pixel length per row
0A0C: 3A96FB  	        LD A,(CURSOR_X)     ;restore original column
0A0F: 47      	        LD B,A              ;reset column
