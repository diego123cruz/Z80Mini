0A4D: 1D      	        DEC E               ;move column pixel count down by one
0A4E: C8      	        RET Z               ;if its zero no more to do, just exit
0A4F: 0C      	        INC C               ;move down a row
0A50: 1606    	        LD D,6              ;reset pixel length per row
0A52: 3A96FB  	        LD A,(CURSOR_X)     ;restore original column
0A55: 47      	        LD B,A              ;reset column
0A56: 18EE    	        JR FLIP_BIT1
              	
