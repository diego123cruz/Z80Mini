              	;------------------------------------------------------------------------------
              	; Print string of characters to Serial A until byte=$00, WITH CR, LF
              	;------------------------------------------------------------------------------
19E2:         	SERIAL_A_PRINT_STRING:
19E2: 7E      	        LD   A,(HL)	; Get character
19E3: B7      			OR   A		; Is it $00 ?
19E4: C8      			RET  Z		; Then RETurn on terminator
19E5: CDA310  			CALL OUTCH	; Print it
19E8: 23      			INC  HL		; Next Character
19E9: 18F7    			JR   SERIAL_A_PRINT_STRING	; Continue until $00
              	
19EB: 3E0D    	SERIAL_A_TXCRLF:	LD   A,$0D	; 
19ED: CDA310  			CALL OUTCH	; Print character 
19F0: 3E0A    			LD   A,$0A	; 
19F2: CDA310  			CALL OUTCH	; Print character
19F5: C9      			RET
              	
              	
              	
