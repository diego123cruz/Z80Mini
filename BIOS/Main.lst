1FA9: 2A3CFC  	    LD HL, (FS_TMPRAM)
1FAC: 09      	    ADD HL, BC
1FAD: 223CFC  	    LD (FS_TMPRAM), HL
1FB0: 2A3AFC  	    LD HL, (FS_TMPSZ)
1FB3: B7      	    OR A                    ; limpa carry
1FB4: ED42    	    SBC HL, BC
1FB6: 223AFC  	    LD (FS_TMPSZ), HL
              	
