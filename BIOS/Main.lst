20C5: 3220FC  	    LD (FS_CUR), A
20C8: CD4923  	    CALL FS_WR_ENTRY
20CB: C2B625  	    JP NZ, FS_ERR_I2C
20CE: 211627  	    LD HL, str_created_folder
20D1: CD0305  	    CALL PUTS
20D4: C9      	    RET
              	
              	
              	; **********************************************************************
              	; FS_RMDIR
              	; 
              	; rmdir name 
              	;   OBS: Só deixa remover diretorio vazio
              	; **********************************************************************
20D5:         	FS_RMDIR:
20D5: CD1023  	    CALL FS_COPY_NAME_FROM_BUFFER
20D8: DAD325  	    JP C, FS_ABORT
20DB: CD1305  	    CALL CRLF
20DE: CD7825  	    CALL FS_FIND_FOLDER_NAME
20E1: CAEB20  	    JP Z, FS_DO_RMDIR
20E4: 213C26  	    LD HL, str_notfound
20E7: CD0305  	    CALL PUTS
20EA: C9      	    RET
              	
              	; (FS_CUR=idx, FS_WRKBUF=entrada)
20EB:         	FS_DO_RMDIR:
              	    ; pega a pagina da pasta
20EB: 3A31FC  	    LD A, (FS_WRKBUF + FS_O_FSTPG)
              	
              	    ; le a pasta (256 bytes) para o buffer 
20EE: 57      	    LD D, A     ; from i2c addrr
20EF: 1E00    	    LD E, $00
20F1: 2159FC  	    LD HL, PG_BUF ; to buffer
20F4: 01FF00  	    LD BC, $ff ; size
20F7: CD4F1D  	    CALL I2C_MemRd
20FA: C2B625  	    JP NZ, FS_ERR_I2C
              	
              	    ; le entradas e verifica vazias
20FD: AF      	    XOR A
20FE: 3220FC  	    LD (FS_CUR), A
2101: 0608    	    LD B, FS_MAXFILES
2103: DD2159FC	    LD IX, PG_BUF 
2107: 110000  	    LD DE, $0000
210A:         	FS_RMDIR_LP:
210A: 3A20FC  	    LD A, (FS_CUR)
210D: 07      	    RLCA
210E: 07      	    RLCA
210F: 07      	    RLCA
2110: 07      	    RLCA
2111: 07      	    RLCA
              	
2112: DD2159FC	    LD IX, PG_BUF
              	
2116: 5F      	    LD E, A
2117: DD19    	    ADD IX, DE
              	
2119: DD7E15  	    LD A, (IX + FS_O_FLAGS)
              	
211C: FEFF    	    CP FS_FLAG_FREE
211E: C23021  	    JP NZ, NOT_EMPTY
              	    
2121: 3A20FC  	    LD A, (FS_CUR)
