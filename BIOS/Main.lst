0FEC: 01      	        .db 00000001b   ;      #
              	#include "SERIAL.asm"
              	; Inicializa SIO/2 Serial 115200
0FED:         	initSerial:
0FED: 214A10  	    LD    HL,TXDATA
0FF0: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
0FF3: 215D10  	    LD    HL,RXDATA
0FF6: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
              	
              	
              	    ;	Initialise SIO/2 A - Onboard USB
0FF9: 3E04    		LD	A,$04
0FFB: D302    		OUT	(SIOA_C),A
0FFD: 3EC4    		LD	A,$C4
0FFF: D302    		OUT	(SIOA_C),A
              	
1001: 3E03    		LD	A,$03
1003: D302    		OUT	(SIOA_C),A
1005: 3EE1    		LD	A,$E1
1007: D302    		OUT	(SIOA_C),A
              	
1009: 3E05    		LD	A,$05
100B: D302    		OUT	(SIOA_C),A
100D: 3E68    		LD	A, $68
100F: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
1011: 3E04    		LD	A,$04
1013: D303    		OUT	(SIOB_C),A
1015: 3EC4    		LD	A,$C4
1017: D303    		OUT	(SIOB_C),A
              	
1019: 3E03    		LD	A,$03
101B: D303    		OUT	(SIOB_C),A
101D: 3EE1    		LD	A,$E1
101F: D303    		OUT	(SIOB_C),A
              	
1021: 3E05    		LD	A,$05
1023: D303    		OUT	(SIOB_C),A
1025: 3E68    		LD	A, $68
1027: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
1029: 217B20  	    LD HL, WELLCOME
102C: CD3C10  	    CALL SNDSTR
              	
102F: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
1030: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
1034: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
1036: DD2AA0FB	INCH:  LD   IX,(GETCH)
103A: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
103C: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
103E: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
103F: FE00    	       CP    00H          ;ZERO TERMINATOR?
1041: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
1043: CD3010  	       CALL  OUTCH         ;TRANSMIT THE CHAR
1046: 23      	       INC   HL
1047: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
1049: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
104A:         	TXDATA:		
104A: F5      			PUSH	AF		; Store character
104B: CD5410  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
104E: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
1050: F1      			POP	AF		; RETrieve character
1051: D300    			OUT	(SIOA_D),A	; OUTput the character
1053: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
1054:         	CKSIOA
1054: 97      			SUB	A
1055: D302    			OUT 	(SIOA_C),A
1057: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1059: 0F      			RRCA			; Rotates RX status into Carry Flag,	
105A: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
105C: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
105D:         	RXDATA:	
105D:         	waitForChar:
              	        ; Check if there is a char in channel A
105D: 97      			SUB	A
105E: D302    			OUT 	(SIOA_C),A
1060: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1062: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1063: 30F8    			JR	NC, waitForChar
1065: DB00    			IN	A,(SIOA_D)
1067: B7      			OR A ; clear carry
1068: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
1069:         	TXDATA_B:		
1069: F5      			PUSH	AF		; Store character
106A: CD7310  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
106D: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
106F: F1      			POP	AF		; RETrieve character
1070: D301    			OUT	(SIOB_D),A	; OUTput the character
1072: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
1073:         	CKSIOB
1073: 97      			SUB	A
1074: D303    			OUT 	(SIOB_C),A
1076: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1078: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1079: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
107B: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
107C:         	RXDATA_B:	
107C:         	waitForCharB:
              	        ; Check if there is a char in channel A
107C: 97      			SUB	A
107D: D303    			OUT 	(SIOB_C),A
107F: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1081: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1082: 30F8    			JR	NC, waitForCharB
1084: DB01    			IN	A,(SIOB_D)
1086: B7      			OR A ; clear carry
1087: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
1088:         	PARSE_CMD:
1088: 21A7FB  	            LD   HL, LINEBUF
108B: CD9D13  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
108E: 7E      	            LD   A, (HL)
108F: FE0D    	            CP   CR
1091: C8      	            RET  Z
1092: FE00    	            CP   NUL
1094: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
1095: CD0914  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
1098: 21D110  	            LD   HL, CMD_TABLE
109B:         	CMD_SCAN:
109B: 7E      	            LD   A, (HL)
109C: FE00    	            CP   NUL
109E: CACA10  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
10A1: E5      	            PUSH HL
10A2: 11F7FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
10A5: CD2E14  	            CALL STRCMP
10A8: E1      	            POP  HL
10A9: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
10AB:         	SKIP_ENTRY:
10AB: 7E      	            LD   A, (HL)
10AC: 23      	            INC  HL
10AD: FE00    	            CP   NUL
10AF: 20FA    	            JR   NZ, SKIP_ENTRY
10B1: 23      	            INC  HL                  ; pula high byte do endereço
10B2: 23      	            INC  HL                  ; pula low  byte do endereço
10B3: C39B10  	            JP   CMD_SCAN
              	
10B6:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
10B6: 7E      	            LD   A, (HL)
10B7: 23      	            INC  HL
10B8: FE00    	            CP   NUL
10BA: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
10BC: 7E      	            LD   A, (HL)
10BD: 23      	            INC  HL
10BE: 66      	            LD   H, (HL)
10BF: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
10C0: 11A7FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
10C3: CD9613  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
10C6: CDA413  	            CALL SKIP_SPACES_DE      ; DE aponta para args
10C9: E9      	            JP   (HL)                ; chama handler
              	
10CA:         	CMD_UNKNOWN:
10CA: 216314  	            LD   HL, MSG_UNKNOWN
10CD: CD3704  	            CALL PUTS
10D0: C9      	            RET
              	
              	; -------- Tabela de comandos --------
10D1:         	CMD_TABLE:
10D1: 434C5300	            DB   "CLS",  NUL
10D5: 7B11    	            DW   CLS_CMD
10D7: 44554D50	            DB   "DUMP", NUL
10DB: 00      	
10DC: 8111    	            DW   DUMP_CMD
10DE: 57524954	            DB   "WRITE", NUL
10E2: 4500    	
10E4: C311    	            DW   LOAD_CMD
10E6: 45444954	            DB   "EDIT", NUL
10EA: 00      	
10EB: 1712    	            DW   EDIT_CMD
10ED: 4F555400	            DB   "OUT",  NUL
10F1: 6C12    	            DW   OUT_CMD
10F3: 494E00  	            DB   "IN",   NUL
10F6: 8A12    	            DW   IN_CMD
10F8: 4A554D50	            DB   "JUMP",    NUL
10FC: 00      	
10FD: A012    	            DW   GO_CMD
10FF: 43414C4C	            DB   "CALL",    NUL
1103: 00      	
1104: AD12    	            DW   CALL_CMD
1106: 4800    	            DB   "H",    NUL
1108: BE12    	            DW   HELP_CMD
110A: 3F00    	            DB   "?",    NUL
110C: BE12    	            DW   HELP_CMD
110E: 49484558	            DB   "IHEX",    NUL
1112: 00      	
1113: 7011    	            DW   LOAD_HEX_CMD
1115: 4932434C	            DB   "I2CLIST",    NUL
1119: 49535400	
111D: F418    	            DW   I2CLIST
111F: 44495200	            DB   "DIR",    NUL
1123: AA19    	            DW   FS_DIR
1125: 52554E00	            DB   "RUN",    NUL
1129: 901B    	            DW   FS_EXEC
112B: 53415645	            DB   "SAVE",    NUL
112F: 00      	
1130: CA1A    	            DW   FS_SAVE
1132: 44454C00	            DB   "DEL",    NUL
1136: C11B    	            DW   FS_ERASE
1138: 464F524D	            DB   "FORMAT",    NUL
113C: 415400  	
113F: 201C    	            DW   FS_FORMAT
1141: 4C4F4144	            DB   "LOAD",    NUL
1145: 00      	
1146: 291A    	            DW   FS_LOAD_CMD
1148: 42415349	            DB   "BASIC",    NUL
114C: 4300    	
114E: 0060    	            DW   COLD
1150: 57424153	            DB   "WBASIC",    NUL
1154: 494300  	
1157: 0360    	            DW   WARM
1159: 413A00  	            DB   "A:",    NUL
115C: 6411    	            DW   CHANGE_DRIVE_A
115E: 423A00  	            DB   "B:",    NUL
1161: 6A11    	            DW   CHANGE_DRIVE_B
              	
1163: 00      	            DB   NUL                 ; fim da tabela
              	
              	
              	; ============================================================
              	;  CHANGE_DRIVE_A  -  Altera drive para device A - EEDRIVE_A
              	; ============================================================
1164:         	CHANGE_DRIVE_A:
1164: 3EA0    	    LD A, EEDRIVE_A
1166: 3204FC  	    LD (I2CA_BLOCK), A
1169: C9      	    RET
              	
              	; ============================================================
              	;  CHANGE_DRIVE_B  -  Altera drive para device B - EEDRIVE_B
              	; ============================================================
116A:         	CHANGE_DRIVE_B:
116A: 3EAE    	    LD A, EEDRIVE_B
116C: 3204FC  	    LD (I2CA_BLOCK), A
116F: C9      	    RET
              	
              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
1170:         	LOAD_HEX_CMD;
1170: CD1816  	    CALL loadInit
1173: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
1174:         	CALL_8000:
1174: 11B402  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
1177: D5      	    PUSH DE
1178: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
117B:         	CLS_CMD:
117B: 3E0C    	            LD A, 0CH ; FF
117D: CD9E07  	            CALL sendCharToLCD
1180: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
1181:         	DUMP_CMD:
              	            ; DE aponta para argumentos
1181: CDFE13  	            CALL PARSE_HEX16_DE      ; HL = endereço
1184: 3836    	            JR   C, DUMP_BAD_ADDR
1186: 22FDFB  	            LD   (ADDR_TMP), HL
              	
1189: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
118B:         	DUMP_LINE:
118B: C5      	            PUSH BC
              	            ; Exibe endereço
118C: 2AFDFB  	            LD   HL, (ADDR_TMP)
118F: CD5514  	            CALL PRINT_HEX16
1192: 3E3A    	            LD   A, ':'
1194: CD2B04  	            CALL PUTCHAR
1197: 3E20    	            LD   A, SPACE
1199: CD2B04  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
119C: 2AFDFB  	            LD   HL, (ADDR_TMP)
119F: 0E05    	            LD   C, 5
11A1:         	DUMP_HEX:
11A1: 7E      	            LD   A, (HL)
11A2: CD3A14  	            CALL PRINT_HEX8
11A5: 3E20    	            LD   A, SPACE
11A7: CD2B04  	            CALL PUTCHAR
11AA: 23      	            INC  HL
11AB: 0D      	            DEC  C
11AC: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
11AE: 2AFDFB  	            LD   HL, (ADDR_TMP)
11B1: 110500  	            LD   DE, 5
11B4: 19      	            ADD  HL, DE
11B5: 22FDFB  	            LD   (ADDR_TMP), HL
11B8: C1      	            POP  BC
11B9: 10D0    	            DJNZ DUMP_LINE
11BB: C9      	            RET
              	
11BC:         	DUMP_BAD_ADDR:
11BC: 218414  	            LD   HL, MSG_BAD_ADDR
11BF: CD3704  	            CALL PUTS
11C2: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
11C3:         	LOAD_CMD:
11C3: CDFE13  	            CALL PARSE_HEX16_DE
11C6: 3848    	            JR   C, LOAD_BAD
11C8: 22FDFB  	            LD   (ADDR_TMP), HL
11CB: 21AE14  	            LD   HL, MSG_LOAD_HINT
11CE: CD3704  	            CALL PUTS
              	
11D1:         	LOAD_LOOP:
              	            ; Exibe endereço atual
11D1: 2AFDFB  	            LD   HL, (ADDR_TMP)
11D4: CD5514  	            CALL PRINT_HEX16
11D7: 3E3A    	            LD   A, ':'
11D9: CD2B04  	            CALL PUTCHAR
11DC: 3E20    	            LD   A, SPACE
11DE: CD2B04  	            CALL PUTCHAR
              	
11E1: CD3613  	            CALL GETLINE             ; Lê linha
11E4: 21A7FB  	            LD   HL, LINEBUF
11E7: CD9D13  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
11EA: 7E      	            LD   A, (HL)
11EB: FE0D    	            CP   CR
11ED: C8      	            RET  Z
11EE: FE00    	            CP   NUL
11F0: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
11F1:         	LOAD_BYTE:
11F1: CDCC13  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
11F4: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
11F6: ED5BFDFB	            LD   DE, (ADDR_TMP)
11FA: 12      	            LD   (DE), A
11FB: 13      	            INC  DE
11FC: ED53FDFB	            LD   (ADDR_TMP), DE
1200: CDAB13  	            CALL SKIP_SPACES_HL
1203: 7E      	            LD   A, (HL)
1204: FE0D    	            CP   CR
1206: 28C9    	            JR   Z, LOAD_LOOP
1208: FE00    	            CP   NUL
120A: 28C5    	            JR   Z, LOAD_LOOP
120C: 18E3    	            JR   LOAD_BYTE
              	
120E:         	LOAD_NEXT_LINE:
120E: 18C1    	            JR   LOAD_LOOP
              	
1210:         	LOAD_BAD:
1210: 218414  	            LD   HL, MSG_BAD_ADDR
1213: CD3704  	            CALL PUTS
1216: C9      	            RET
              	
              	; ============================================================
              	;  EDIT_CMD  -  Edita memória byte a byte
              	;  Sintaxe: EDIT xxxx
              	;  Exibe: XXXX: AA  _  (digitar novo valor ou Enter p/ manter)
              	;  '.' encerra
              	; ============================================================
1217:         	EDIT_CMD:
1217: CDFE13  	            CALL PARSE_HEX16_DE
121A: 3849    	            JR   C, EDIT_BAD
121C: 22FDFB  	            LD   (ADDR_TMP), HL
              	
121F:         	EDIT_LOOP:
121F: 2AFDFB  	            LD   HL, (ADDR_TMP)
1222: CD5514  	            CALL PRINT_HEX16
1225: 3E3A    	            LD   A, ':'
1227: CD2B04  	            CALL PUTCHAR
122A: 3E20    	            LD   A, SPACE
122C: CD2B04  	            CALL PUTCHAR
122F: 7E      	            LD   A, (HL)             ; Valor atual
1230: CD3A14  	            CALL PRINT_HEX8
1233: 3E20    	            LD   A, SPACE
1235: CD2B04  	            CALL PUTCHAR
1238: 3E20    	            LD   A, SPACE
123A: CD2B04  	            CALL PUTCHAR
              	
              	            ; Lê até 3 chars (2 hex + CR)
123D: CD3613  	            CALL GETLINE
1240: 21A7FB  	            LD   HL, LINEBUF
1243: CD9D13  	            CALL SKIP_SPACES
              	
1246: 7E      	            LD   A, (HL)
1247: FE2E    	            CP   '.'                 ; '.' = sair
1249: C8      	            RET  Z
124A: FE0D    	            CP   CR
124C: 280E    	            JR   Z, EDIT_KEEP       ; Enter = mantém byte
124E: FE00    	            CP   NUL
1250: 280A    	            JR   Z, EDIT_KEEP
              	
              	            ; Tenta parsear novo byte
1252: CDCC13  	            CALL PARSE_HEX8_HL
1255: 38C8    	            JR   C, EDIT_LOOP       ; Hex inválido: repete
              	
              	            ; Grava novo byte
1257: ED5BFDFB	            LD   DE, (ADDR_TMP)
125B: 12      	            LD   (DE), A
              	
125C:         	EDIT_KEEP:
125C: 2AFDFB  	            LD   HL, (ADDR_TMP)
125F: 23      	            INC  HL
1260: 22FDFB  	            LD   (ADDR_TMP), HL
1263: 18BA    	            JR   EDIT_LOOP
              	
1265:         	EDIT_BAD:
1265: 218414  	            LD   HL, MSG_BAD_ADDR
1268: CD3704  	            CALL PUTS
126B: C9      	            RET
              	
              	; ============================================================
              	;  OUT_CMD  -  Escreve byte em porta de I/O
              	;  Sintaxe: OUT pp dd   (porta pp, dado dd, ambos em hex)
              	; ============================================================
126C:         	OUT_CMD:
              	            ; DE → argumentos
126C: CDE513  	            CALL PARSE_HEX8_DE       ; A = número da porta
126F: 3812    	            JR   C, OUT_BAD
1271: 4F      	            LD   C, A                ; C = porta
              	
1272: CDA413  	            CALL SKIP_SPACES_DE
1275: CDE513  	            CALL PARSE_HEX8_DE       ; A = dado
1278: 3809    	            JR   C, OUT_BAD
              	
              	            ; OUT (C), A
127A: ED79    	            OUT  (C), A
127C: 21AA14  	            LD   HL, MSG_OK
127F: CD3704  	            CALL PUTS
1282: C9      	            RET
              	
1283:         	OUT_BAD:
1283: 219814  	            LD   HL, MSG_SYNTAX
1286: CD3704  	            CALL PUTS
1289: C9      	            RET
              	
              	; ============================================================
              	;  IN_CMD  -  Lê byte de porta de I/O
              	;  Sintaxe: IN pp
              	; ============================================================
128A:         	IN_CMD:
128A: CDE513  	            CALL PARSE_HEX8_DE
128D: 380A    	            JR   C, IN_BAD
128F: 4F      	            LD   C, A
1290: ED78    	            IN   A, (C)
1292: CD3A14  	            CALL PRINT_HEX8
1295: CD4704  	            CALL CRLF
1298: C9      	            RET
              	
1299:         	IN_BAD:
1299: 219814  	            LD   HL, MSG_SYNTAX
129C: CD3704  	            CALL PUTS
129F: C9      	            RET
              	
              	; ============================================================
              	;  GO_CMD  -  Executa código a partir de endereço
              	;  Sintaxe: G xxxx
              	; ============================================================
12A0:         	GO_CMD:
12A0: CDFE13  	            CALL PARSE_HEX16_DE
12A3: 3801    	            JR   C, GO_BAD
12A5: E9      	            JP   (HL)                ; Salta para endereço
              	
12A6:         	GO_BAD:
12A6: 218414  	            LD   HL, MSG_BAD_ADDR
12A9: CD3704  	            CALL PUTS
12AC: C9      	            RET
              	
              	
              	; ============================================================
              	;  CALL_CMD  -  Executa código a partir de endereço
              	;  Sintaxe: CALL xxxx
              	; ============================================================
12AD:         	CALL_CMD:
12AD: CDFE13  	            CALL PARSE_HEX16_DE
12B0: 3805    	            JR   C, CALL_BAD
12B2: 11B402  	            LD DE, MAIN_LOOP ; endereço de retorno do CALL
12B5: D5      	            PUSH DE
12B6: E9      	            JP   (HL)                ; Salta para endereço
              	
12B7:         	CALL_BAD:
12B7: 218414  	            LD   HL, MSG_BAD_ADDR
12BA: CD3704  	            CALL PUTS
12BD: C9      	            RET
              	
              	
              	; ============================================================
              	;  HELP_CMD  -  Exibe ajuda
              	; ============================================================
12BE:         	HELP_CMD:
12BE: 11E614  	            LD   DE, MSG_HELP_L0
12C1: CD0E08  	            CALL sendStringToLCD
              	
12C4: 11F014  	            LD   DE, MSG_HELP_L1
12C7: CD0E08  	            CALL sendStringToLCD
              	
12CA: 11F714  	            LD   DE, MSG_HELP_L2
12CD: CD0E08  	            CALL sendStringToLCD
              	
12D0: 11FC14  	            LD   DE, MSG_HELP_L3
12D3: CD0E08  	            CALL sendStringToLCD
              	
12D6: 110715  	            LD   DE, MSG_HELP_L4
12D9: CD0E08  	            CALL sendStringToLCD
              	
12DC: 111315  	            LD   DE, MSG_HELP_L5
12DF: CD0E08  	            CALL sendStringToLCD
              	
12E2: 111E15  	            LD   DE, MSG_HELP_L6
12E5: CD0E08  	            CALL sendStringToLCD
              	
12E8: 112915  	            LD   DE, MSG_HELP_L7
12EB: CD0E08  	            CALL sendStringToLCD
              	
12EE: 113115  	            LD   DE, MSG_HELP_L8
12F1: CD0E08  	            CALL sendStringToLCD
              	
12F4: 113C15  	            LD   DE, MSG_HELP_L9
12F7: CD0E08  	            CALL sendStringToLCD
              	
12FA: 114715  	            LD   DE, MSG_HELP_L10
12FD: CD0E08  	            CALL sendStringToLCD
              	
1300: 115415  	            LD   DE, MSG_HELP_L11
1303: CD0E08  	            CALL sendStringToLCD
              	
1306: 116815  	            LD   DE, MSG_HELP_L12
1309: CD0E08  	            CALL sendStringToLCD
              	
