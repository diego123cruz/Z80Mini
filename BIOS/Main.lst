1A9F: 7264616E	
1AA3: 646F2065	
1AA7: 6E76696F	
1AAB: 2E2E2E0D	
1AAF: 0A      	
1AB0: 3A6E6E6E			                .db	":nnnnnn...  - Load Intel-Hex file record", CR, LF, $00
1AB4: 6E6E6E2E	
