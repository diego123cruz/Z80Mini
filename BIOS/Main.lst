              	;------------------------------------------------------------------------------
              	; Pegar 2 caracteres ASCII (0-9 A-F) converte em um byte em A
              	;------------------------------------------------------------------------------
27A3: CDDD19  	SERIAL_GET_HEX_A:   CALL GETCHR_S	; Get us a valid character to work with
27A6: 47      	    LD   B,A	; Load it in B
27A7: CDDD19  	    CALL GETCHR_S	; Get us another character
27AA: 4F      	    LD   C,A	; load it in C
27AB: CDF919  	    CALL BCTOA	; Convert ASCII to byte
27AE: C9      	    RET
              	
              	;------------------------------------------------------------------------------
              	; Pegar 4 caracteres ASCII (0-9 A-F) converte em HL
              	;------------------------------------------------------------------------------
27AF:         	SERIAL_GET_HEX_HL:
27AF: CDA327  	    CALL SERIAL_GET_HEX_A	        ; Endereco High -> H
27B2: 67      		LD   H,A
27B3: CDA327  		CALL SERIAL_GET_HEX_A	        ; Endereco Low -> L
27B6: 6F      		LD   L,A
27B7: C9      	    RET
              	
              	
              	
