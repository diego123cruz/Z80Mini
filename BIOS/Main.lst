2413: 52524F21	
2417: 0D0A00  	             .DB CR, LF, 0
              	
              	
              	
              	; FS_WRITE_PG: Grava pagina A com dados de FS_TMPRAM
              	;   Grava min(FS_TMPSZ, 255) bytes. Atualiza FS_TMPRAM e FS_TMPSZ.
              	;   byte 0 da pagina = $00 (next=fim; FS_SET_NEXT corrige se necessario)
              	;   On exit: Z=OK  NZ=erro
              	;   Preserva: BC DE HL
241A:         	FS_WRITE_PG:
241A: C5      	    PUSH BC
241B: D5      	    PUSH DE
241C: E5      	    PUSH HL
241D: F5      	    PUSH AF                 ; A = numero da pagina
              	
              	    ; Calcula quantos bytes gravar: min(FS_TMPSZ, 255)
241E: 2A3AFC  	    LD HL, (FS_TMPSZ)
2421: 7C      	    LD A, H
2422: B7      	    OR A
2423: 2005    	    JR NZ, FS_WP_USE255     ; HL >= 256: usa 255
2425: 7D      	    LD A, L
2426: FEFF    	    CP FS_DATAPG            ; L < 255?
2428: 3804    	    JR C, FS_WP_USELT       ; sim: usa L
242A:         	FS_WP_USE255:
242A: 0EFF    	    LD C, FS_DATAPG         ; C = 255
242C: 1801    	    JR FS_WP_COPY
242E:         	FS_WP_USELT:
242E: 4D      	    LD C, L                 ; C = L (< 255)
              	
242F:         	FS_WP_COPY:
              	    ; C = bytes a gravar (1..255). Salva em D para nao perder.
242F: 51      	    LD D, C                 ; D = bytes a gravar
              	
              	    ; Monta PG_BUF[0..$FF]:
              	    ;   [0]    = $00 (next page, sera corrigido por FS_SET_NEXT)
              	    ;   [1..C] = dados da RAM
              	    ;   [C+1..$FF] = $FF (padding)
