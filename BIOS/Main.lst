1413: FE0D    	            CP   CR
1415: 2813    	            JR   Z, UPCASE_DONE
1417: FE00    	            CP   NUL
1419: 280F    	            JR   Z, UPCASE_DONE
141B: FE61    	            CP   'a'
141D: 3806    	            JR   C, UPCASE_STORE
141F: FE7B    	            CP   'z'+1
1421: 3002    	            JR   NC, UPCASE_STORE
1423: E6DF    	            AND  0DFH               ; Converte para maiúscula
1425:         	UPCASE_STORE:
1425: 12      	            LD   (DE), A
1426: 23      	            INC  HL
1427: 13      	            INC  DE
1428: 10E4    	            DJNZ UPCASE_LOOP
142A:         	UPCASE_DONE:
142A: 3E00    	            LD   A, NUL
142C: 12      	            LD   (DE), A
142D: C9      	            RET
              	
              	; --- STRCMP: compara (HL) com (DE), Z=1 se iguais ---
