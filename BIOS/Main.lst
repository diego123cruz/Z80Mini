              	#include "SERIAL.asm"
              	; Inicializa SIO/2 Serial 115200
10B8:         	initSerial:
10B8: 211511  	    LD    HL,TXDATA
10BB: 229EFB  	    LD    (PUTCH),HL ;USE THE BITBANG SERIAL TRANSMIT
10BE: 212811  	    LD    HL,RXDATA
10C1: 22A0FB  	    LD    (GETCH),HL  ;USE THE BITBANG SERIAL RECEIVE
              	
              	
              	    ;	Initialise SIO/2 A - Onboard USB
10C4: 3E04    		LD	A,$04
10C6: D302    		OUT	(SIOA_C),A
10C8: 3EC4    		LD	A,$C4
10CA: D302    		OUT	(SIOA_C),A
              	
10CC: 3E03    		LD	A,$03
10CE: D302    		OUT	(SIOA_C),A
10D0: 3EE1    		LD	A,$E1
10D2: D302    		OUT	(SIOA_C),A
              	
10D4: 3E05    		LD	A,$05
10D6: D302    		OUT	(SIOA_C),A
10D8: 3E68    		LD	A, $68
10DA: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
10DC: 3E04    		LD	A,$04
10DE: D303    		OUT	(SIOB_C),A
10E0: 3EC4    		LD	A,$C4
10E2: D303    		OUT	(SIOB_C),A
              	
10E4: 3E03    		LD	A,$03
10E6: D303    		OUT	(SIOB_C),A
10E8: 3EE1    		LD	A,$E1
10EA: D303    		OUT	(SIOB_C),A
              	
10EC: 3E05    		LD	A,$05
10EE: D303    		OUT	(SIOB_C),A
10F0: 3E68    		LD	A, $68
10F2: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
10F4: 21B827  	    LD HL, WELLCOME
10F7: CD0711  	    CALL SNDSTR
              	
10FA: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
10FB: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
10FF: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
1101: DD2AA0FB	INCH:  LD   IX,(GETCH)
1105: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
1107: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
1109: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
110A: FE00    	       CP    00H          ;ZERO TERMINATOR?
110C: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
110E: CDFB10  	       CALL  OUTCH         ;TRANSMIT THE CHAR
1111: 23      	       INC   HL
1112: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
1114: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
1115:         	TXDATA:		
1115: F5      			PUSH	AF		; Store character
1116: CD1F11  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
1119: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
111B: F1      			POP	AF		; RETrieve character
111C: D300    			OUT	(SIOA_D),A	; OUTput the character
111E: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
111F:         	CKSIOA
111F: 97      			SUB	A
1120: D302    			OUT 	(SIOA_C),A
1122: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1124: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1125: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
1127: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
1128:         	RXDATA:	
1128:         	waitForChar:
              	        ; Check if there is a char in channel A
1128: 97      			SUB	A
1129: D302    			OUT 	(SIOA_C),A
112B: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
112D: 0F      			RRCA			; Rotates RX status into Carry Flag,	
112E: 30F8    			JR	NC, waitForChar
1130: DB00    			IN	A,(SIOA_D)
1132: B7      			OR A ; clear carry
1133: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
1134:         	TXDATA_B:		
1134: F5      			PUSH	AF		; Store character
1135: CD3E11  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
1138: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
113A: F1      			POP	AF		; RETrieve character
113B: D301    			OUT	(SIOB_D),A	; OUTput the character
113D: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
113E:         	CKSIOB
113E: 97      			SUB	A
113F: D303    			OUT 	(SIOB_C),A
1141: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
1143: 0F      			RRCA			; Rotates RX status into Carry Flag,	
1144: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
1146: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
1147:         	RXDATA_B:	
1147:         	waitForCharB:
              	        ; Check if there is a char in channel A
1147: 97      			SUB	A
1148: D303    			OUT 	(SIOB_C),A
114A: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
114C: 0F      			RRCA			; Rotates RX status into Carry Flag,	
114D: 30F8    			JR	NC, waitForCharB
114F: DB01    			IN	A,(SIOB_D)
1151: B7      			OR A ; clear carry
1152: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
1153:         	PARSE_CMD:
1153: 21BEFB  	            LD   HL, LINEBUF
1156: CD1315  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
1159: 7E      	            LD   A, (HL)
115A: FE0D    	            CP   CR
115C: C8      	            RET  Z
115D: FE00    	            CP   NUL
115F: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
1160: CD7F15  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
1163: 219C11  	            LD   HL, CMD_TABLE
1166:         	CMD_SCAN:
1166: 7E      	            LD   A, (HL)
1167: FE00    	            CP   NUL
1169: CA9511  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
116C: E5      	            PUSH HL
116D: 110EFC  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
1170: CDA415  	            CALL STRCMP
1173: E1      	            POP  HL
1174: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
1176:         	SKIP_ENTRY:
1176: 7E      	            LD   A, (HL)
1177: 23      	            INC  HL
1178: FE00    	            CP   NUL
117A: 20FA    	            JR   NZ, SKIP_ENTRY
117C: 23      	            INC  HL                  ; pula high byte do endereço
117D: 23      	            INC  HL                  ; pula low  byte do endereço
117E: C36611  	            JP   CMD_SCAN
              	
1181:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
1181: 7E      	            LD   A, (HL)
1182: 23      	            INC  HL
1183: FE00    	            CP   NUL
1185: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
1187: 7E      	            LD   A, (HL)
1188: 23      	            INC  HL
1189: 66      	            LD   H, (HL)
118A: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
118B: 11BEFB  	            LD   DE, LINEBUF		 ; Inicio o buffer
118E: CD0C15  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
1191: CD1A15  	            CALL SKIP_SPACES_DE      ; DE aponta para args
1194: E9      	            JP   (HL)                ; chama handler
              	
1195:         	CMD_UNKNOWN:
1195: 21AD16  	            LD   HL, MSG_UNKNOWN
1198: CD0305  	            CALL PUTS
119B: C9      	            RET
              	
