              	; FS_ALLOC_PG: Aloca primeira pagina livre (>=2) no bitmap
              	;   Registradores: B=pagina, C=bit_index, D=byte_bitmap, E=byte_index, HL=ptr
              	;   On exit: A=pagina (NZ=ok)   A=0 (Z=sem espaco)
2391:         	FS_ALLOC_PG:
              	    ; Le os 16 bytes do bitmap para PG_BUF
2391: 110100  	    LD DE, $0001
2394: 2159FC  	    LD HL, PG_BUF
2397: 011000  	    LD BC, 16
239A: CD4F1D  	    CALL I2C_MemRd
239D: C0      	    RET NZ
              	
239E: 0602    	    LD B, 2                 ; B = pagina corrente
              	
23A0:         	FS_AP_LOOP:
23A0: 78      	    LD A, B
23A1: E607    	    AND $07
23A3: 4F      	    LD C, A                 ; C = bit_index
              	
23A4: 78      	    LD A, B
23A5: CB3F    	    SRL A
23A7: CB3F    	    SRL A
23A9: CB3F    	    SRL A
23AB: 5F      	    LD E, A                 ; E = byte_index
              	
23AC: 2159FC  	    LD HL, PG_BUF
23AF: 1600    	    LD D, 0
23B1: 19      	    ADD HL, DE
23B2: 56      	    LD D, (HL)              ; D = byte do bitmap
              	
23B3: 3E01    	    LD A, 1
23B5:         	FS_AP_TBIT:
23B5: 0D      	    DEC C
23B6: FABC23  	    JP M, FS_AP_TBIT_DONE
23B9: 07      	    RLCA
23BA: 18F9    	    JR FS_AP_TBIT
23BC:         	FS_AP_TBIT_DONE:
23BC: A2      	    AND D                   ; 0=ocupado, !=0=livre
23BD: 2008    	    JR NZ, FS_AP_FOUND
              	
23BF: 04      	    INC B
23C0: 78      	    LD A, B
23C1: FE80    	    CP 128
23C3: 38DB    	    JR C, FS_AP_LOOP
23C5: AF      	    XOR A                   ; Z = sem espaco
23C6: C9      	    RET
              	
23C7:         	FS_AP_FOUND:
              	    ; B = pagina livre. Salva bit_index e byte_index.
23C7: 78      	    LD A, B
23C8: E607    	    AND $07
23CA: 3258FC  	    LD (FS_BMPADDR+1), A    ; bit_index
              	
23CD: 78      	    LD A, B
23CE: CB3F    	    SRL A
23D0: CB3F    	    SRL A
23D2: CB3F    	    SRL A
23D4: 5F      	    LD E, A                 ; E = byte_index
              	
              	    ; HL = PG_BUF + byte_index
23D5: 2159FC  	    LD HL, PG_BUF
23D8: 1600    	    LD D, 0
23DA: 19      	    ADD HL, DE
              	
              	    ; Mascara = ~(1 << bit_index) para zerar o bit
23DB: 3A58FC  	    LD A, (FS_BMPADDR+1)
23DE: 4F      	    LD C, A
23DF: 3E01    	    LD A, 1
23E1:         	FS_AP_MKSHL:
23E1: 0D      	    DEC C
23E2: FAE823  	    JP M, FS_AP_MKINV
23E5: 07      	    RLCA
23E6: 18F9    	    JR FS_AP_MKSHL
23E8:         	FS_AP_MKINV:
23E8: 2F      	    CPL                     ; ~mascara
              	
23E9: A6      	    AND (HL)
23EA: 77      	    LD (HL), A              ; atualiza PG_BUF
              	
              	    ; Salva numero da pagina antes do LD BC,1 destruir B
23EB: 78      	    LD A, B
23EC: 3257FC  	    LD (FS_BMPADDR), A
              	
              	    ; Grava byte atualizado na EEPROM: addr = byte_index + 1
23EF: 1600    	    LD D, 0
23F1: 1C      	    INC E                   ; E = byte_index + 1
23F2: 010100  	    LD BC, 1
23F5: CD871D  	    CALL I2C_MemWr
23F8: C0      	    RET NZ
              	
23F9: 3A57FC  	    LD A, (FS_BMPADDR)      ; A = pagina alocada
23FC: B7      	    OR A                    ; NZ = sucesso
23FD: C9      	    RET
              	
              	; FS_FREE_PG: Libera pagina A no bitmap (seta bit = 1)
              	;   On exit: Z=OK  NZ=erro I2C
23FE:         	FS_FREE_PG:
23FE: C5      	    PUSH BC
23FF: D5      	    PUSH DE
2400: E5      	    PUSH HL
2401: F5      	    PUSH AF                 ; salva numero da pagina
              	
              	    ; bit_index = pagina mod 8
2402: E607    	    AND $07
2404: 4F      	    LD C, A                 ; C = bit_index
              	
              	    ; byte_index = pagina / 8 → endereco EEPROM = byte_index + 1
2405: F1      	    POP AF
2406: F5      	    PUSH AF
2407: CB3F    	    SRL A
2409: CB3F    	    SRL A
240B: CB3F    	    SRL A                   ; A = byte_index
240D: 3C      	    INC A                   ; A = endereco EEPROM (1..16)
240E: 3257FC  	    LD (FS_BMPADDR), A      ; salva endereco
              	
              	    ; Le byte atual do bitmap
              	    ; ATENCAO: LD BC,1 vai sobrescrever C (bit_index)!
              	    ; Salva C na RAM antes.
2411: 79      	    LD A, C
2412: 3258FC  	    LD (FS_BMPADDR+1), A    ; salva bit_index em FS_BMPADDR+1
              	
2415: 3A57FC  	    LD A, (FS_BMPADDR)
2418: 5F      	    LD E, A
2419: 1600    	    LD D, 0
241B: 2150FC  	    LD HL, FS_TMP1
241E: 010100  	    LD BC, 1
2421: CD4F1D  	    CALL I2C_MemRd
2424: C24D24  	    JP NZ, FS_FP_ERR
              	
              	    ; Recupera bit_index
2427: 3A58FC  	    LD A, (FS_BMPADDR+1)
242A: 4F      	    LD C, A                 ; C = bit_index restaurado
              	
              	    ; Constroi mascara = 1 << bit_index
242B: 3E01    	    LD A, 1
242D:         	FS_FP_SHL:
242D: 0D      	    DEC C
242E: FA3424  	    JP M, FS_FP_OR
2431: 07      	    RLCA
2432: 18F9    	    JR FS_FP_SHL
              	
