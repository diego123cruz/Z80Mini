1051: D302    		OUT	(SIOA_C),A
1053: 3EC4    		LD	A,$C4
1055: D302    		OUT	(SIOA_C),A
              	
1057: 3E03    		LD	A,$03
1059: D302    		OUT	(SIOA_C),A
105B: 3EE1    		LD	A,$E1
105D: D302    		OUT	(SIOA_C),A
              	
105F: 3E05    		LD	A,$05
1061: D302    		OUT	(SIOA_C),A
1063: 3E68    		LD	A, $68
1065: D302    		OUT	(SIOA_C),A
              	
              	    ; Initialise SIO/2 B - Printer (P2 conector)
1067: 3E04    		LD	A,$04
1069: D303    		OUT	(SIOB_C),A
106B: 3EC4    		LD	A,$C4
106D: D303    		OUT	(SIOB_C),A
              	
106F: 3E03    		LD	A,$03
1071: D303    		OUT	(SIOB_C),A
1073: 3EE1    		LD	A,$E1
1075: D303    		OUT	(SIOB_C),A
              	
1077: 3E05    		LD	A,$05
1079: D303    		OUT	(SIOB_C),A
107B: 3E68    		LD	A, $68
107D: D303    		OUT	(SIOB_C),A
              	
              	
              	    ; Print wellcome serial
107F: 212927  	    LD HL, WELLCOME
1082: CD9210  	    CALL SNDSTR
              	
1085: C9      		RET
              	
              	
              	
              	;-----------------------------------
              	; OUTPUT A CHARACTER TO THE TERMINAL
              	;-----------------------------------       
1086: DD2A9EFB	OUTCH:  LD   IX,(PUTCH)
108A: DDE9    	       JP   (IX)
              	;------------------------------------
              	; INPUT A CHARACTER FROM THE TERMINAL
              	;------------------------------------
108C: DD2AA0FB	INCH:  LD   IX,(GETCH)
1090: DDE9    	      JP   (IX)
              	
              	
              		
              	
              	;-----------------------------------------
              	; SEND AN ASCII STRING OUT THE SERIAL PORT
              	;-----------------------------------------
              	; 
              	; SENDS A ZERO TERMINATED STRING OR 
              	; 128 CHARACTERS MAX. OUT THE SERIAL PORT
              	;
              	;      ENTRY : HL = POINTER TO 00H TERMINATED STRING
              	;      EXIT  : NONE
              	;
              	;       MODIFIES : A,B,C
              	;          
1092: 0680    	SNDSTR: LD    B,128         ;128 CHARS MAX
1094: 7E      	SDMSG1: LD    A,(HL)        ;GET THE CHAR
1095: FE00    	       CP    00H          ;ZERO TERMINATOR?
1097: 2806    	       JR    Z,SDMSG2      ;FOUND A ZERO TERMINATOR, EXIT  
1099: CD8610  	       CALL  OUTCH         ;TRANSMIT THE CHAR
109C: 23      	       INC   HL
109D: 10F5    	       DJNZ  SDMSG1        ;128 CHARS MAX!    
109F: C9      	SDMSG2: RET
              	
              	
              	;------------------------
              	; SERIAL A TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10A0:         	TXDATA:		
10A0: F5      			PUSH	AF		; Store character
10A1: CDAA10  	conoutA1:	CALL	CKSIOA		; See if SIO channel A is finished transmitting
10A4: 28FB    			JR	Z,conoutA1	; Loop until SIO flag signals ready
10A6: F1      			POP	AF		; RETrieve character
10A7: D300    			OUT	(SIOA_D),A	; OUTput the character
10A9: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10AA:         	CKSIOA
10AA: 97      			SUB	A
10AB: D302    			OUT 	(SIOA_C),A
10AD: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10AF: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10B0: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10B2: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL A RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10B3:         	RXDATA:	
10B3:         	waitForChar:
              	        ; Check if there is a char in channel A
10B3: 97      			SUB	A
10B4: D302    			OUT 	(SIOA_C),A
10B6: DB02    			IN   	A,(SIOA_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10B8: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10B9: 30F8    			JR	NC, waitForChar
10BB: DB00    			IN	A,(SIOA_D)
10BD: B7      			OR A ; clear carry
10BE: C9      			RET
              	
              	
              	
              	;======================= Serial B ========================
              	;------------------------
              	; SERIAL B TRANSMIT ROUTINE
              	;------------------------
              	;TRANSMIT BYTE SERIALLY ON DOUT
              	;
              	; ENTRY : A = BYTE TO TRANSMIT
              	;  EXIT : NO REGISTERS MODIFIED
              	;
10BF:         	TXDATA_B:		
10BF: F5      			PUSH	AF		; Store character
10C0: CDC910  	conoutB1:	CALL	CKSIOB		; See if SIO channel A is finished transmitting
10C3: 28FB    			JR	Z,conoutB1	; Loop until SIO flag signals ready
10C5: F1      			POP	AF		; RETrieve character
10C6: D301    			OUT	(SIOB_D),A	; OUTput the character
10C8: C9      			RET
              	
              	
              	;------------------------------------------------------------------------------
              	; I/O status check routine
              	; Use the "primaryIO" flag to determine which port to check.
              	;------------------------------------------------------------------------------
10C9:         	CKSIOB
10C9: 97      			SUB	A
10CA: D303    			OUT 	(SIOB_C),A
10CC: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10CE: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10CF: CB4F    			BIT  	1,A		; Set Zero flag if still transmitting character	
10D1: C9      	        RET
              	
              	    
              	;-----------------------
              	; SERIAL B RECEIVE ROUTINE
              	;-----------------------
              	;RECEIVE SERIAL BYTE FROM DIN
              	;
              	; ENTRY : NONE
              	;  EXIT : A= RECEIVED BYTE IF CARRY CLEAR
              	;
              	; REGISTERS MODIFIED A AND F
              	;
10D2:         	RXDATA_B:	
10D2:         	waitForCharB:
              	        ; Check if there is a char in channel A
10D2: 97      			SUB	A
10D3: D303    			OUT 	(SIOB_C),A
10D5: DB03    			IN   	A,(SIOB_C)	; Status byte D2=TX Buff Empty, D0=RX char ready	
10D7: 0F      			RRCA			; Rotates RX status into Carry Flag,	
10D8: 30F8    			JR	NC, waitForCharB
10DA: DB01    			IN	A,(SIOB_D)
10DC: B7      			OR A ; clear carry
10DD: C9      			RET
              	
              	#include "COMANDOS.asm"
              	
              	; -------- Constantes gerais --------
000D:         	CR          EQU  0DH
000A:         	LF          EQU  0AH
0008:         	BkS          EQU  08H
007F:         	DEL         EQU  7FH
001B:         	ESC         EQU  1BH
0020:         	SPACE       EQU  20H
0000:         	NUL         EQU  00H
              	
              	
              	
              	; ============================================================
              	;  PARSE_CMD  -  Analisa LINEBUF e despacha comando
              	; ============================================================
10DE:         	PARSE_CMD:
10DE: 21A7FB  	            LD   HL, LINEBUF
10E1: CD9614  	            CALL SKIP_SPACES
              	            ; Verifica linha vazia
10E4: 7E      	            LD   A, (HL)
10E5: FE0D    	            CP   CR
10E7: C8      	            RET  Z
10E8: FE00    	            CP   NUL
10EA: C8      	            RET  Z
              	
              	            ; Copia token do comando para comparação (uppercase)
10EB: CD0215  	            CALL UPCASE_TOKEN        ; HL aponta após token, DE=token
              	
              	            ; Compara com cada comando conhecido
10EE: 212711  	            LD   HL, CMD_TABLE
10F1:         	CMD_SCAN:
10F1: 7E      	            LD   A, (HL)
10F2: FE00    	            CP   NUL
10F4: CA2011  	            JP   Z, CMD_UNKNOWN
              	            ; Compara string
10F7: E5      	            PUSH HL
10F8: 11F7FB  	            LD   DE, HEXBUF          ; token gravado aqui por UPCASE_TOKEN
10FB: CD2715  	            CALL STRCMP
10FE: E1      	            POP  HL
10FF: 280B    	            JR   Z, CMD_DISPATCH
              	            ; Avança para próxima entrada da tabela
              	            ; Formato: [str NUL] [addr 2 bytes]
1101:         	SKIP_ENTRY:
1101: 7E      	            LD   A, (HL)
1102: 23      	            INC  HL
1103: FE00    	            CP   NUL
1105: 20FA    	            JR   NZ, SKIP_ENTRY
1107: 23      	            INC  HL                  ; pula high byte do endereço
1108: 23      	            INC  HL                  ; pula low  byte do endereço
1109: C3F110  	            JP   CMD_SCAN
              	
110C:         	CMD_DISPATCH:
              	            ; Pula string do nome para chegar ao endereço
110C: 7E      	            LD   A, (HL)
110D: 23      	            INC  HL
110E: FE00    	            CP   NUL
1110: 20FA    	            JR   NZ, CMD_DISPATCH
              	            ; (HL) = low byte do handler, (HL+1) = high byte
1112: 7E      	            LD   A, (HL)
1113: 23      	            INC  HL
1114: 66      	            LD   H, (HL)
1115: 6F      	            LD   L, A
              	            ; HL = endereço do handler; HL aponta para resto da linha
              	            ; Precisamos salvar o ponteiro de argumento
              	            ; Reposiciona ponteiro de argumento
1116: 11A7FB  	            LD   DE, LINEBUF		 ; Inicio o buffer
1119: CD8F14  	            CALL SKIP_COMMAND_DE	 ; pula comando e DE aponta para o primeiro espaço
111C: CD9D14  	            CALL SKIP_SPACES_DE      ; DE aponta para args
111F: E9      	            JP   (HL)                ; chama handler
              	
1120:         	CMD_UNKNOWN:
1120: 213016  	            LD   HL, MSG_UNKNOWN
1123: CD8D04  	            CALL PUTS
1126: C9      	            RET
              	
              	; -------- Tabela de comandos --------
