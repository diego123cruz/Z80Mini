              	; ============================================================
              	;  LOAD_HEX_CMD  -  Carrega intel hex pela porta serial
              	; ============================================================
1243:         	LOAD_HEX_CMD;
1243: CD5418  	    CALL loadInit
1246: C9      	    RET
              	
              	; ============================================================
              	;  CALL_8000  - Atalho - Call 8000H
              	; ============================================================
1247:         	CALL_8000:
1247: 11C802  	    LD DE, MAIN_LOOP ; endereço de retorno do CALL
124A: D5      	    PUSH DE
124B: C30080  	    JP  $8000
              	
              	
              	; ============================================================
              	;  CLS_CMD  -  Limpa tela via sequência ANSI
              	; ============================================================
124E:         	CLS_CMD:
124E: 3E0C    	            LD A, 0CH ; FF
1250: CDF407  	            CALL sendCharToLCD
1253: C9      	            RET
              	
              	; ============================================================
              	;  DUMP_CMD  -  Dump hex+ASCII
              	;  Sintaxe: DUMP xxxx
              	; ============================================================
1254:         	DUMP_CMD:
              	            ; DE aponta para argumentos
1254: CDF714  	            CALL PARSE_HEX16_DE      ; HL = endereço
1257: 3836    	            JR   C, DUMP_BAD_ADDR
1259: 22FDFB  	            LD   (ADDR_TMP), HL
              	
125C: 0608    	            LD   B, 8               ; 8 linhas de 5 bytes
              	
125E:         	DUMP_LINE:
125E: C5      	            PUSH BC
              	            ; Exibe endereço
125F: 2AFDFB  	            LD   HL, (ADDR_TMP)
1262: CD4E15  	            CALL PRINT_HEX16
1265: 3E3A    	            LD   A, ':'
1267: CD8104  	            CALL PUTCHAR
126A: 3E20    	            LD   A, SPACE
126C: CD8104  	            CALL PUTCHAR
              	
              	            ; Exibe 16 bytes hex
126F: 2AFDFB  	            LD   HL, (ADDR_TMP)
1272: 0E05    	            LD   C, 5
1274:         	DUMP_HEX:
1274: 7E      	            LD   A, (HL)
1275: CD3315  	            CALL PRINT_HEX8
1278: 3E20    	            LD   A, SPACE
127A: CD8104  	            CALL PUTCHAR
127D: 23      	            INC  HL
127E: 0D      	            DEC  C
127F: 20F3    	            JR   NZ, DUMP_HEX
              	
              	            ;CALL CRLF
              	            ; Avança endereço base
1281: 2AFDFB  	            LD   HL, (ADDR_TMP)
1284: 110500  	            LD   DE, 5
1287: 19      	            ADD  HL, DE
1288: 22FDFB  	            LD   (ADDR_TMP), HL
128B: C1      	            POP  BC
128C: 10D0    	            DJNZ DUMP_LINE
128E: C9      	            RET
              	
128F:         	DUMP_BAD_ADDR:
128F: 215116  	            LD   HL, MSG_BAD_ADDR
1292: CD8D04  	            CALL PUTS
1295: C9      	            RET
              	
              	; ============================================================
              	;  LOAD_CMD  -  Carrega bytes hex em endereço
              	;  Sintaxe: LOAD xxxx
              	;  Digitar pares hex separados por espaço; linha vazia encerra
              	; ============================================================
1296:         	LOAD_CMD:
1296: CDF714  	            CALL PARSE_HEX16_DE
1299: 3848    	            JR   C, LOAD_BAD
129B: 22FDFB  	            LD   (ADDR_TMP), HL
129E: 217B16  	            LD   HL, MSG_LOAD_HINT
12A1: CD8D04  	            CALL PUTS
              	
12A4:         	LOAD_LOOP:
              	            ; Exibe endereço atual
12A4: 2AFDFB  	            LD   HL, (ADDR_TMP)
12A7: CD4E15  	            CALL PRINT_HEX16
12AA: 3E3A    	            LD   A, ':'
12AC: CD8104  	            CALL PUTCHAR
12AF: 3E20    	            LD   A, SPACE
12B1: CD8104  	            CALL PUTCHAR
              	
12B4: CD3914  	            CALL GETLINE             ; Lê linha
12B7: 21A7FB  	            LD   HL, LINEBUF
12BA: CD9614  	            CALL SKIP_SPACES
              	
              	            ; Linha vazia = fim
12BD: 7E      	            LD   A, (HL)
12BE: FE0D    	            CP   CR
12C0: C8      	            RET  Z
12C1: FE00    	            CP   NUL
12C3: C8      	            RET  Z
              	
              	            ; Processa pares hex na linha
12C4:         	LOAD_BYTE:
12C4: CDC514  	            CALL PARSE_HEX8_HL       ; A = byte, HL avança
12C7: 3818    	            JR   C, LOAD_NEXT_LINE
              	            ; Grava byte
12C9: ED5BFDFB	            LD   DE, (ADDR_TMP)
12CD: 12      	            LD   (DE), A
12CE: 13      	            INC  DE
12CF: ED53FDFB	            LD   (ADDR_TMP), DE
12D3: CDA414  	            CALL SKIP_SPACES_HL
12D6: 7E      	            LD   A, (HL)
12D7: FE0D    	            CP   CR
12D9: 28C9    	            JR   Z, LOAD_LOOP
12DB: FE00    	            CP   NUL
12DD: 28C5    	            JR   Z, LOAD_LOOP
12DF: 18E3    	            JR   LOAD_BYTE
              	
12E1:         	LOAD_NEXT_LINE:
12E1: 18C1    	            JR   LOAD_LOOP
              	
12E3:         	LOAD_BAD:
12E3: 215116  	            LD   HL, MSG_BAD_ADDR
12E6: CD8D04  	            CALL PUTS
12E9: C9      	            RET
              	
              	; ============================================================
              	;  EDIT_CMD  -  Edita memória byte a byte
              	;  Sintaxe: EDIT xxxx
              	;  Exibe: XXXX: AA  _  (digitar novo valor ou Enter p/ manter)
              	;  '.' encerra
              	; ============================================================
12EA:         	EDIT_CMD:
12EA: CDF714  	            CALL PARSE_HEX16_DE
12ED: 3849    	            JR   C, EDIT_BAD
12EF: 22FDFB  	            LD   (ADDR_TMP), HL
              	
12F2:         	EDIT_LOOP:
12F2: 2AFDFB  	            LD   HL, (ADDR_TMP)
