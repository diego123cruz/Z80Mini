0270:         	INICIO:
0270: 21AD01  	    LD HL, INT_DEFAULT
0273: 2200F0  	    LD (RST38), HL
0276: 2202F0  	    LD (RST66), HL
              	
              	    ; Set defult I2C device addess: 24LC256 (Copy from/to Mem)
0279: 3EA0    	    LD A, EEDRIVE_A
027B: 3204FC  	    LD (I2CA_BLOCK), A     
              	
027E: 3E01    	    LD A, 1 ;capslock OFF
0280: 32A3FB  	    LD (MEN_CAPSL), A
0283: 010606  	    LD BC, $0606
0286: ED43A5FB	    LD (MEN_CURSR), BC   
              	
              	    ;CALL FS_CHK_SIG
              	    ;JP Z, INICIO1
              	    ;LD HL, str_notfmt
              	    ;CALL PUTS
028A:         	INICIO1:
              	
028A: 31F0FF  	    LD SP, SYSTEM_SP
              	
028D: 116400  	    LD DE, $0064 ; 100ms
0290: CDEA02  	    CALL H_Delay
              	
              	    ;Init Serial
0293: CDED0F  	    CALL initSerial
              	
              	    ;Init Teclado
0296: 3EFF    	    LD      A, 0xFF
0298: D340    	    OUT     (KEYBOARD), A           ; Todas as colunas desativadas
              	
              	    ; Init LCD
029A: CD7107  	    CALL initTerminal
029D: CDBA04  	    CALL setGrMode
02A0: CD6C07  	    CALL setBufNoClear
              	
              	
              	    ; Show init string
02A3: 010000  	    LD BC, $0000
02A6: CD5E08  	    CALL setCursor
02A9: 119120  	    LD DE, WELLCOME_LCD
              	    ; set cursor ON
02AC: 3E00    	    LD A, 0
02AE: 3298FB  	    LD (CURSOR_ON), A
              	    ; send cursor
02B1: CD0E08  	    CALL sendStringToLCD
              	
              	
02B4:         	MAIN_LOOP:
02B4: CDC002  	    CALL showCurrentDriver
              	
02B7: CD3613  	    CALL GETLINE             ; Lê linha em LINEBUF
02BA: CD8810  	    CALL PARSE_CMD           ; Interpreta e executa
              	
02BD: C3B402  	    JP      MAIN_LOOP
              	
              	
02C0:         	showCurrentDriver:
02C0: 3A04FC  	    LD A, (I2CA_BLOCK)
02C3: FEA0    	    CP EEDRIVE_A  ; Drive A
02C5: 2805    	    JR Z, showDriveA
02C7: FEAE    	    CP EEDRIVE_B  ; Drive B
02C9: 2808    	    JR Z, showDriveB
02CB: C9      	    RET
02CC:         	showDriveA:
02CC: 3E41    	    LD A, 'A'
02CE: CD9E07  	    CALL sendCharToLCD
02D1: 1807    	    JR showCursor
02D3:         	showDriveB:
02D3: 3E42    	    LD A, 'B'
02D5: CD9E07  	    CALL sendCharToLCD
02D8: 1800    	    JR showCursor
02DA:         	showCursor:
02DA: 3E3A    	    LD A, ':'
02DC: CD9E07  	    CALL sendCharToLCD
02DF: C9      	    RET
              	
              	
              	
02E0:         	resetCollisionPixel:
02E0: AF      	    XOR A
02E1: 323CFD  	    LD (DRAW_PIXEL_COLLISION), A
02E4: C9      	    RET
              	
              	; FLAG ZERO, 
              	; JP Z, SEM_COLISAO. 
              	; JP NZ, COLISAO.
02E5:         	checkCollisionPixel:
02E5: 3A3CFD  	    LD A, (DRAW_PIXEL_COLLISION)
02E8: B7      	    OR A
02E9: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; Delay by DE milliseconds
              	;   On entry: DE = Delay time in milliseconds
              	;   On exit:  AF BC DE HL IX IY I AF' BC' DE' HL' preserved
02EA: F5      	H_Delay:    PUSH AF
02EB: C5      	            PUSH BC
02EC: D5      	            PUSH DE
              	; 1 ms loop, DE times...        ;[=36]   [=29]    Overhead for each 1ms
02ED: 011A01  	LoopDE:    LD   BC, kDelayCnt   ;[10]    [9]
              	; Inner loop, BC times...       ;[=26]   [=20]    Loop time in Tcycles
02F0: 0B      	LoopBC:    DEC  BC             ;[6]     [4]
02F1: 79      	            LD   A,C            ;[4]     [4]
02F2: B0      	            OR   B              ;[4]     [4]
02F3: C2F002  	            JP   NZ,LoopBC     ;[12/7]  [8/6] 
              	; Have we looped once for each millisecond requested?
02F6: 1B      	            DEC  DE             ;[6]     [4]
02F7: 7B      	            LD   A,E            ;[4]     [4]
02F8: B2      	            OR   D              ;[4]     [4]
02F9: 20F2    	            JR   NZ, LoopDE     ;[12/7]  [8/6]
02FB: D1      	            POP  DE
02FC: C1      	            POP  BC
02FD: F1      	            POP  AF
02FE: C9      	            RET
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	
              	#include "TECLADO.asm"
0016:         	DB_OUTER    EQU     22          ; iterações externas
00F0:         	DB_INNER    EQU     240         ; iterações DJNZ internas
              	
              	
              	; -----------------------------------------------------------------------------
              	;   Check break key (Basic)
              	;       On exit: If press A = CTRLC and NZ flagged
              	;       BC DE HL preserved
              	; -----------------------------------------------------------------------------
02FF:         	CHKKEY:
02FF: 3EFE    	    LD      A, 0xFE             ; Máscara: bit 0 baixo = col 0
0301: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
0303: 00      	    NOP                         ; ~270 ns de estabilização
0304: 00      	    NOP
0305: 00      	    NOP
0306: 00      	    NOP
0307: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
0309: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
030A: FE01    	    CP 1
030C: C21403  	    jp nz, GRET
030F: 3E03    		LD  A, CTRLC
0311: FE00    		CP	0
0313: C9      		RET
0314:         	GRET:
0314: 3E00    		LD  A, 0
0316: FE00    		CP 0
0318: C9      		RET
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       loop until key is pressed 
0319:         	CONIN:
0319: C5      	    PUSH BC
031A: D5      	    PUSH DE
031B: E5      	    PUSH HL
031C: CDA003  	    CALL readKeyboarWaitPressA
031F: E1      	    POP HL
0320: D1      	    POP DE
0321: C1      	    POP BC
0322: C9      	    RET
              	
              	
              	
              	;   CONIN: Lê um teclado → A
              	;       On exit: A = KEY
              	;       BC DE HL preserved
              	;       sem loop, Carry=1 se tecla
0323:         	CONIN_NOT_LOOP:
0323: C5      	    PUSH BC
0324: D5      	    PUSH DE
0325: E5      	    PUSH HL
0326: CD2D03  	    CALL readKeyboarPressA
0329: E1      	    POP HL
032A: D1      	    POP DE
032B: C1      	    POP BC
032C: C9      	    RET
              	
              	
032D:         	readKeyboarPressA;
032D: AF      	    XOR A
032E: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
0331: CDDE03  	    CALL    SCAN_MATRIX
0334: D0      	    RET      NC
0335: CD4003  	    CALl GetKeycode
0338: CD4603  	    CALL checkShiftKey
033B: 3AA4FB  	    LD A, (KEY_PRESS)
033E: 37      	    SCF  ; Carry = 1
033F: C9      	    RET
              	
              	
              	
              	; A = col*8 + row  (0x00 – 0x3F)
0340:         	GetKeycode:
              	    ; --- Tecla confirmada: calcula keycode ---
              	    ; col*8 + row  (0x00 – 0x3F)
0340: 78      	    LD      A, B                ; B = coluna
0341: 87      	    ADD     A, A                ; ×2
0342: 87      	    ADD     A, A                ; ×4
0343: 87      	    ADD     A, A                ; ×8
0344: 81      	    ADD     A, C                ; + linha (C) = keycode
0345: C9      	    RET
              	
              	
              	; Verifica se shift e recupera ascii
              	;   Salva tecla em KEY_PRESS
0346:         	checkShiftKey:
              	    ; Verifica Shift
0346: 5F      	    LD E, A
0347: 21B001  	    LD HL, KEYMAP_NORMAL
034A: 3AA2FB  	    LD A, (MEN_SHIFT)
034D: FE01    	    CP 1
034F: C25C03  	    JP NZ, NO_SHIFT
0352: 21F001  	    LD HL, KEYMAP_SHIFT
0355: CDD903  	    CALL DO_LOOKUP
0358: 32A4FB  	    LD (KEY_PRESS), A
035B: C9      	    RET
035C:         	NO_SHIFT:
035C: CDD903  	    CALL 	DO_LOOKUP	; pega tecla
035F: 32A4FB  	    LD (KEY_PRESS), A
0362: FEFF    	    CP $FF ;capslook?
0364: CA7703  	    JP Z, CAPSLOCK
0367: 3AA3FB  	    LD A, (MEN_CAPSL)
036A: FE00    	    CP 0
036C: C0      	    RET NZ
036D: 213002  	    LD HL, KEYMAP_CAPSLOCK
0370: CDD903  	    CALL DO_LOOKUP
0373: 32A4FB  	    LD (KEY_PRESS), A
0376: C9      	    RET
              	
              	
              	
              	
              	
0377:         	CAPSLOCK:
0377: 3AA3FB  	    LD A, (MEN_CAPSL)
037A: FE00    	    CP 0
037C: CA8D03  	    JP Z, CAPSLOCK_OFF
037F: AF      	    XOR A
0380: 32A3FB  	    LD (MEN_CAPSL), A
0383: 010306  	    LD BC, $0603
0386: ED43A5FB	    LD (MEN_CURSR), BC
038A: C39903  	    JP CAPSLOCK_OK
038D:         	CAPSLOCK_OFF:
038D: 3E01    	    LD A, 1
038F: 32A3FB  	    LD (MEN_CAPSL), A
0392: 010606  	    LD BC, $0606
0395: ED43A5FB	    LD (MEN_CURSR), BC
0399:         	CAPSLOCK_OK:
0399: 116400  	    LD DE, $0064 ; 100ms
039C: CDEA02  	    CALL H_Delay
039F: C9      	    RET
              	
              	
              	
              	
              	; LER TECLADO
              	; Aguarda até uma teclad for pressionada e retorna em A
03A0:         	readKeyboarWaitPressA:
03A0: CDDE03  	    CALL    SCAN_MATRIX
03A3: D2A003  	    JP      NC, readKeyboarWaitPressA       ; Nenhuma tecla, continua
              	
              	    ; --- Primeira leitura positiva: aguarda debounce ---
03A6: CDCD03  	    CALL    DEBOUNCE
              	
              	    ; --- Confirma que a tecla ainda está pressionada ---
03A9: AF      	    XOR A
03AA: 32A2FB  	    LD (MEN_SHIFT), A ; reset shift
03AD: CDDE03  	    CALL    SCAN_MATRIX
03B0: D2A003  	    JP      NC, readKeyboarWaitPressA       ; Foi ruído, descarta
              	
03B3: CD4003  	    CALL GetKeycode
              	    
03B6: CD4603  	    CALL checkShiftKey
              	    
              	    ; --- Aguarda soltar + debounce de release ---
03B9:         	WAIT_RELEASE:
03B9: CDDE03  	    CALL    SCAN_MATRIX
03BC: DAB903  	    JP      C, WAIT_RELEASE     ; Ainda pressionada
03BF: CDCD03  	    CALL    DEBOUNCE            ; Debounce do soltar
03C2: CDDE03  	    CALL    SCAN_MATRIX
03C5: DAB903  	    JP      C, WAIT_RELEASE     ; Bounce no release, volta a esperar
              	
03C8: 3AA4FB  	    LD A, (KEY_PRESS)
03CB: B7      	    OR A
03CC: C9      	    RET
              	
              	
              	
              	
              	
              	
              	; ============================================================
              	; DEBOUNCE  –  espera ~10 ms (calibrado para 7.3728 MHz)
              	;   Usa DE como contador, preserva BC
              	;   T-states totais ≈ 69.080  →  ~9.36 ms
              	; ============================================================
03CD:         	DEBOUNCE:
03CD: C5      	    PUSH    BC
03CE: 0616    	    LD      B, DB_OUTER         ; B = contador externo
03D0:         	DB_OUTER_LOOP:
03D0: 0EF0    	    LD      C, DB_INNER         ; C = contador interno
03D2:         	DB_INNER_LOOP:
03D2: 0D      	    DEC     C                   ; 4 T
03D3: 20FD    	    JR      NZ, DB_INNER_LOOP   ; 12 T (não salta) / 7 T (salta)
03D5: 10F9    	    DJNZ    DB_OUTER_LOOP       ; 13 T (não salta) / 8 T (salta)
03D7: C1      	    POP     BC
03D8: C9      	    RET
              	
              	
              	; Pega char in table
03D9:         	DO_LOOKUP:
03D9: 1600    	    LD      D, 0
03DB: 19      	    ADD     HL, DE
03DC: 7E      	    LD      A, (HL)
03DD: C9      	    RET
              	
              	
              	; ============================================================
              	; SCAN_MATRIX
              	;   Varre 8 colunas, uma por vez (bit baixo = ativo)
              	;   Saída: B = col (0-7), C = row (0-7), Carry=1 se tecla
              	; ============================================================
03DE:         	SCAN_MATRIX:
03DE: 0600    	    LD      B, 0                ; Coluna atual
03E0: 16FE    	    LD      D, 0xFE             ; Máscara: bit 0 baixo = col 0
03E2:         	SCAN_COL:
03E2: 7A      	    LD      A, D
03E3: D340    	    OUT     (KEYBOARD), A       ; Ativa coluna B
03E5: 00      	    NOP                         ; ~270 ns de estabilização
03E6: 00      	    NOP
03E7: 00      	    NOP
03E8: 00      	    NOP
03E9: DB40    	    IN      A, (KEYBOARD)       ; Lê linhas
03EB: 2F      	    CPL                         ; Pull-up: inverte (pressionado = 1)
              	    
              	    ; SHIFT
03EC: F5      	    PUSH AF
03ED: 7A      	    LD A, D
03EE: FEFE    	    CP $FE
03F0: C20304  	    JP NZ, FIM
03F3: F1      	    POP AF
03F4: F5      	    PUSH AF
03F5: FE08    	    CP $08
03F7: C20304  	    JP NZ, FIM
03FA: 3E01    	    LD A, 1
03FC: 32A2FB  	    LD (MEN_SHIFT), A
03FF: F1      	    POP AF
0400: 3E00    	    LD A, 0
0402: F5      	    PUSH AF
              	    
0403:         	FIM:
0403: F1      		POP AF
              	    
0404: E6FF    	    AND     0xFF
0406: 280E    	    JR      Z, NEXT_COL         ; Nenhuma linha nesta coluna
              	    
              	    ; Encontrou linha — identifica bit
0408: 0E00    	    LD      C, 0
040A:         	FIND_ROW:
040A: 1F      	    RRA
040B: 3803    	    JR      C, ROW_FOUND
040D: 0C      	    INC     C
040E: 18FA    	    JR      FIND_ROW
              	
0410:         	ROW_FOUND:
0410: 3EFF    	    LD      A, 0xFF
0412: D340    	    OUT     (KEYBOARD), A           ; Desativa colunas
0414: 37      	    SCF                         ; Carry = 1
0415: C9      	    RET
              	
0416:         	NEXT_COL:
0416: 04      	    INC     B
0417: 78      	    LD      A, B
0418: FE08    	    CP      8
041A: 2809    	    JR      Z, SCAN_NONE        ; Todas varridas, nada encontrado
              	
              	    ; Rotaciona máscara para próxima coluna
041C: 7A      	    LD      A, D
041D: 37      	    SCF
041E: CB17    	    RL      A                   ; Desloca bit baixo para esquerda
0420: F601    	    OR      0x01                ; Garante que o bit 0 volta alto (inativo)
0422: 57      	    LD      D, A
0423: 18BD    	    JR      SCAN_COL
              	
0425:         	SCAN_NONE:
0425: 3EFF    	    LD      A, 0xFF
0427: D340    	    OUT     (KEYBOARD), A
0429: B7      	    OR      A                   ; Limpa Carry
042A: C9      	    RET
              	
              	
              	    
              	    
              	    
              	#include "GLCD.asm"
              	; Graphical LCD 128 x 64 Library
              	; ------------------------------
              	; By B. Chiha May-2023
              	; Modificações para funcionar no Z80 Mini - 2026
              	;
              	; This is a native Z80 Graphics library to be used with 128x64 Graphical LCD Screens
              	;
              	; There are a few variants of these LCD screens, but they must all must use the ST7920
              	; LCD Controller.  The LCD Screen that I used is the QC12864B.  This screen has two
              	; ST7921 Panels (128 x 32) stacked one above the other.
              	;
              	; These screens have DDRAM (Graphics) and CGRAM (Text) areas.  Both RAM areas can 
              	; be displayed at the same time.
              	;
              	; The Pinout for the QC12864B board is as follows:
              	;
              	; Pin	Name	Desc                    Serial  Parallel
              	; ---   ----    -------------           ------  -------------
              	; 1     VSS     Ground                  GND     GND
              	; 2     VDD     Power                   5v      5v
              	; 3     V0      Contrast                N/A     N/A
              	; 4     D/I     IR/DR (CS)              5v      A7
              	; 5     R/W     R/W (SID)               D0      RD (inverted)
              	; 6     E       Enable (SCLK)           D1      Port 7 (inverted)
              	; 7     DB0     Data                    N/A     D0
              	; 8     DB1     Data                    N/A     D1
              	; 9     DB2     Data                    N/A     D2
              	; 10    DB3     Data                    N/A     D3
              	; 11    DB4     Data                    N/A     D4
              	; 12    DB5     Data                    N/A     D5
              	; 13    DB6     Data                    N/A     D6
              	; 14    DB7     Data                    N/A     D7
              	; 15    PSB     Serial/Para             GND     5v
              	; 16    NC
              	; 17    RST     Reset                   RST     RST
              	; 18    VEE     LCD Drive               N/A     N/A
              	; 19    A       Backlight               5v/NC   5v/NC
              	; 20    K       Backlight               GND/NC  GND/NC
              	;
              	;
              	        
              	        
              	; Modifiable values.  Thse three values can be modified to suit your own set up
              	; GLCD_INST and GLCD_DATA are the output ports to send an Instruction or Data value.
              	; V_DELAY_US is the minimum delay needed for a command to be processed by the
              	; LCD board.  If only some of the data is being sent, make this value larger
              	        
              	;Port 7 on TEC is connected to LCD Enable (Pin 6)
              	;A7 is connected to Register select (Pin 4).  (A7=0 for Instruction, A7=1 for Data)
0010:         	V_DELAY_US: .equ $0010   ;Delay for 76us on your system
              	
              	; Dont need to modify anything else below.
00F8:         	UP:     .equ $F8                 ; Up Arrow
00F7:         	DN:     .equ $F7                 ; Down Arrow
000C:         	FF:     .equ 0CH                 ; Form Feed
008F:         	CURSOR: .equ 8FH                 ; Cursor
              	        
              	
              	
              	
              	
              	; --- CONOUT: Envia byte em A ---
042B:         	PUTCHAR:
042B:         	CONOUT:
042B: F5      	        PUSH AF
042C: C5      	        PUSH BC
042D: D5      	        PUSH DE
042E: E5      	        PUSH HL
042F: CD9E07  	        CALL sendCharToLCD
0432: E1      	        POP HL
0433: D1      	        POP DE
0434: C1      	        POP BC
0435: F1      	        POP AF
0436: C9      	        RET
              	
              	
              	; --- PUTS: Envia string terminada em NUL apontada por HL ---
0437:         	PUTS:
0437: F5      	        PUSH AF
0438: C5      	        PUSH BC
0439: D5      	        PUSH DE
043A: E5      	        PUSH HL
043B: 545D    	        LD DE, HL
043D: 3E00    	        LD A, NUL
043F: CD0E08  	        CALL sendStringToLCD
0442: E1      	        POP HL
0443: D1      	        POP DE
0444: C1      	        POP BC
0445: F1      	        POP AF
0446: C9      	        RET
              	
              	; --- CRLF: Envia CR+LF ---
0447:         	CRLF:
0447: 3E0D    	        LD   A, CR
0449: CD2B04  	        CALL PUTCHAR
044C: C9      	        RET
              	
              	
              	
              	; Initialise LCD
044D:         	initLCD:
044D: 21E909  	        LD HL, INIT_BASIC       ;POINT HL TO LCD INITIALIZE TABLE
0450: 0604    	        LD B, 04H               ;B=4 BYTES
0452:         	NEXT_CMD:
0452: 7E      	        LD A, (HL)
0453: D370    	        OUT (GLCD_INST), A
0455: CD5B07  	        CALL delayUS
0458: 23      	        INC HL
0459: 10F7    	        DJNZ NEXT_CMD
045B: 114001  	        LD DE, 0140H            ;1.6 ms
045E: CD5E07  	        CALL delayMS
              	        
0461: 2184F7  	        LD HL,GBUF              ;Set viewport
0464: 2284FB  	        LD (VPORT),HL           ;to GBUF
              	
0467: CD7A04  	        CALL clearGrLCD
              	        
              	; Clears the Graphics Memory Buffer
046A:         	clearGBUF:
046A: 2A84FB  	        LD HL, (VPORT)
046D: ED5B84FB	        LD DE, (VPORT)
0471: 13      	        INC DE
0472: AF      	        XOR A
0473: 77      	        LD (HL), A
0474: 01FF03  	        LD BC, 03FFH
0477: EDB0    	        LDIR
0479: C9      	        RET
              	        
              	; Clears the Graphics LCD Buffer
047A:         	clearGrLCD:
047A: CDBA04  	        CALL setGrMode
047D: 0E00    	        LD C, 00H
047F:         	CLR_X:
047F: 3E80    	        LD A, 80H
0481: B1      	        OR C
0482: D370    	        OUT (GLCD_INST), A
0484: CD5B07  	        CALL delayUS
0487: 3E80    	        LD A, 80H
0489: D370    	        OUT (GLCD_INST), A
048B: CD5B07  	        CALL delayUS
048E: AF      	        XOR A                   ;Clear Byte
048F: 0610    	        LD B, 10H
0491:         	CLR_Y:
0491: D371    	        OUT (GLCD_DATA), A
0493: CD5B07  	        CALL delayUS
0496: D371    	        OUT (GLCD_DATA), A
0498: CD5B07  	        CALL delayUS
049B: 10F4    	        DJNZ CLR_Y
049D: 0C      	        INC C
049E: 79      	        LD A, C
049F: FE20    	        CP 20H
04A1: 20DC    	        JR NZ, CLR_X        
04A3: C9      	        RET
              	
              	; Clears the ASCII Text LCD
04A4:         	clearTxtLCD:
04A4: CDC804  	        CALL setTxtMode
04A7: 3E80    	        LD A, 80H
04A9: D370    	        OUT (GLCD_INST), A
04AB: CD5B07  	        CALL delayUS
04AE: 0640    	        LD B, 40H
04B0:         	CLR_ROWS:
04B0: 3E20    	        LD A,  " "
04B2: D371    	        OUT (GLCD_DATA), A
04B4: CD5B07  	        CALL delayUS
04B7: 10F7    	        DJNZ CLR_ROWS
04B9: C9      	        RET
              	        
              	; Set Graphics Mode
04BA:         	setGrMode:
04BA: 3E34    	        LD A, 34H
04BC: D370    	        OUT (GLCD_INST), A
04BE: CD5B07  	        CALL delayUS
04C1: 3E36    	        LD A, 36H
04C3: D370    	        OUT (GLCD_INST), A
04C5: C35B07  	        JP delayUS
              	        
              	; Set Text Mode
04C8:         	setTxtMode:
04C8: 3E30    	        LD A, 30H
04CA: D370    	        OUT (GLCD_INST), A
04CC: C35B07  	        JP delayUS
              	        
              	;Draw Box
              	;Inputs: BC = X0,Y0
              	;        DE = X1,Y1
              	;Destroys: HL
04CF:         	drawBox:
04CF: C5      	        PUSH BC
04D0:         	TOP:
04D0: CD8A06  	        CALL drawPixel
04D3: 7A      	        LD A, D
04D4: 04      	        INC B
04D5: B8      	        CP B
04D6: 30F8    	        JR NC, TOP
04D8: C1      	        POP BC
              	        
04D9: C5      	        PUSH BC
04DA: 4B      	        LD C, E
04DB:         	BOTTOM:
04DB: CD8A06  	        CALL drawPixel
04DE: 7A      	        LD A, D
04DF: 04      	        INC B
04E0: B8      	        CP B
04E1: 30F8    	        JR NC, BOTTOM
04E3: C1      	        POP BC
              	        
04E4: C5      	        PUSH BC
04E5:         	B_LEFT:
04E5: CD8A06  	        CALL drawPixel
04E8: 7B      	        LD A, E
04E9: 0C      	        INC C
04EA: B9      	        CP C
04EB: 30F8    	        JR NC, B_LEFT
04ED: C1      	        POP BC
              	        
04EE: C5      	        PUSH BC
04EF: 42      	        LD B, D
04F0:         	B_RIGHT:
04F0: CD8A06  	        CALL drawPixel
04F3: 7B      	        LD A, E
04F4: 0C      	        INC C
04F5: B9      	        CP C
04F6: 30F8    	        JR NC, B_RIGHT
04F8: C1      	        POP BC
04F9: C9      	        RET
              	        
              	;Fill Box
              	;Draws vertical lines from X0,Y0 to X0,Y1 and increase X0 to X1 until X0=X1
              	;Inputs: BC = X0,Y0
              	;        DE = X1,Y1
              	;Destroys: HL
04FA:         	fillBox:
04FA: C5      	        PUSH BC
04FB:         	NEXT_PIXEL:
04FB: CD8A06  	        CALL drawPixel
04FE: 7B      	        LD A, E
04FF: 0C      	        INC C
0500: B9      	        CP C
0501: 30F8    	        JR NC, NEXT_PIXEL
0503: C1      	        POP BC
0504: 7A      	        LD A, D
0505: 04      	        INC B
