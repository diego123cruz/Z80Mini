1E36: CF      	    RST $08
1E37: 3E20    	    LD A, ' '
1E39: CF      	    RST $08
              	
              	    ; Imprime "UUh/7Eh pags"
1E3A: 7B      	    LD A, E                 ; A = usadas
1E3B: CDBE1D  	    CALL HexOut
1E3E: 3E68    	    LD A, 'h'
1E40: CF      	    RST $08
1E41: 3E2F    	    LD A, '/'
1E43: CF      	    RST $08
1E44: 3E7E    	    LD A, $7E               ; 126
1E46: CDBE1D  	    CALL HexOut
1E49: 3E68    	    LD A, 'h'
1E4B: CF      	    RST $08
1E4C: 215227  	    LD HL, str_inf_pags
1E4F: CD0305  	    CALL PUTS
              	
              	    ; === Linha 2: Usadas ===
1E52: 215A27  	    LD HL, str_inf_used
1E55: CD0305  	    CALL PUTS
1E58: 7B      	    LD A, E
1E59: CDBE1D  	    CALL HexOut
1E5C: 3E68    	    LD A, 'h'
1E5E: CF      	    RST $08
1E5F: 216A27  	    LD HL, str_inf_pags_nl
1E62: CD0305  	    CALL PUTS
1E65: CD1305  	    CALL CRLF
1E68: 3E20    	    LD A, ' '
1E6A: CF      	    RST $08
              	
              	    ; Bytes usados aprox: E * 255  (E = paginas usadas)
              	    ; Salva C (paginas livres) em RAM antes do loop destruir C
1E6B: 79      	    LD A, C
1E6C: 3258FC  	    LD (FS_INFOTMP), A      ; salva pags livres
              	
1E6F: 210000  	    LD HL, 0
1E72: 7B      	    LD A, E
1E73: B7      	    OR A
1E74: 2807    	    JR Z, FS_INF_BYTES_DONE_U
1E76:         	FS_INF_BYTES_USED:
1E76: 01FF00  	    LD BC, FS_DATAPG        ; C destruido aqui - mas ja salvamos
1E79: 09      	    ADD HL, BC
1E7A: 1D      	    DEC E
1E7B: 20F9    	    JR NZ, FS_INF_BYTES_USED
1E7D:         	FS_INF_BYTES_DONE_U:
1E7D: 7C      	    LD A, H
1E7E: CDBE1D  	    CALL HexOut
1E81: 7D      	    LD A, L
1E82: CDBE1D  	    CALL HexOut
1E85: 3E68    	    LD A, 'h'
1E87: CF      	    RST $08
1E88: 217127  	    LD HL, str_inf_bytes_nl
1E8B: CD0305  	    CALL PUTS
              	
              	    ; Recupera paginas livres
1E8E: 3A58FC  	    LD A, (FS_INFOTMP)
1E91: 4F      	    LD C, A                 ; C = paginas livres restaurado
              	
              	    ; === Linha 3: Livres ===
1E92: 216227  	    LD HL, str_inf_free
1E95: CD0305  	    CALL PUTS
1E98: 79      	    LD A, C
1E99: CDBE1D  	    CALL HexOut
1E9C: 3E68    	    LD A, 'h'
1E9E: CF      	    RST $08
1E9F: 216A27  	    LD HL, str_inf_pags_nl
1EA2: CD0305  	    CALL PUTS
1EA5: CD1305  	    CALL CRLF
1EA8: 3E20    	    LD A, ' '
1EAA: CF      	    RST $08
              	
              	    ; Bytes livres aprox: C * 255
1EAB: 210000  	    LD HL, 0
1EAE: 79      	    LD A, C
1EAF: B7      	    OR A
1EB0: 2808    	    JR Z, FS_INF_BYTES_DONE_F
1EB2: 59      	    LD E, C
1EB3:         	FS_INF_BYTES_FREE:
