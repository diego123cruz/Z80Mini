              	; Fill a block I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             L = BYTE to Fill
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; pages.
1C98: C5      	I2C_MemFill:  PUSH BC
1C99: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1C9C:         	I2C_MemFillRepeat:    
1C9C: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1C9F: CD5A1A  	            CALL I2C_Open       ;Open for write
1CA2: 280A    	            JR   Z,I2C_MemFillReady       ;If open okay then skip on
1CA4: 0B      	            DEC  BC
1CA5: 78      	            LD   A,B
1CA6: B1      	            OR   C              ;Timeout?
1CA7: 20F3    	            JR   NZ,I2C_MemFillRepeat     ;No, so go try again
1CA9: C1      	            POP  BC
1CAA: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CAC: B7      	            OR   A              ;Error, so NZ flagged
1CAD: C9      	            RET                 ;Return with error
              	; Device opened okay
1CAE: C1      	I2C_MemFillReady:     POP  BC             ;Restore byte counter
1CAF: 7A      	I2C_MemFillBlock:     LD   A,D            ;Address (hi) in I2C memory
1CB0: CD6E1A  	            CALL I2C_Write      ;Write address
1CB3: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CB4: CD6E1A  	            CALL I2C_Write      ;Write address
1CB7: 7D      	I2C_MemFillWrite:     LD   A, L         ;Get data byte to fill
1CB8: CD6E1A  	            CALL I2C_Write      ;Read byte from I2C memory
1CBB: 13      	            INC  DE             ;Increment I2C memory pointer
1CBC: 0B      	            DEC  BC             ;Decrement byte counter
1CBD: 78      	            LD   A,B
1CBE: B1      	            OR   C              ;Finished?
1CBF: 2805    	            JR   Z,I2C_MemFillStore       ;Yes, so go store this page
1CC1: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1CC2: E63F    	            AND  63             ;64 byte page boundary?
1CC4: 20F1    	            JR   NZ,I2C_MemFillWrite      ;No, so go write another byte
1CC6: CDE31A  	I2C_MemFillStore:     CALL I2C_Stop       ;Generate I2C stop
1CC9: 78      	            LD   A,B
1CCA: B1      	            OR   C              ;Finished?
1CCB: 20CB    	            JR   NZ,I2C_MemFill   ;No, so go write some more
1CCD: C9      	            RET  
              	
              	
              	
              	; Copy a block from I2C memory to CPU memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
1CCE: C5      	I2C_MemRd:  PUSH BC
1CCF: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1CD2:         	I2C_MemRdRepeat:    
1CD2: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1CD5: CD5A1A  	            CALL I2C_Open       ;Open for write
1CD8: 280A    	            JR   Z,I2C_MemRdReady       ;If open okay then skip on
1CDA: 0B      	            DEC  BC
1CDB: 78      	            LD   A,B
1CDC: B1      	            OR   C              ;Timeout?
1CDD: 20F3    	            JR   NZ,I2C_MemRdRepeat     ;No, so go try again
1CDF: C1      	            POP  BC
1CE0: 3E03    	            LD   A,ERR_TOUT     ;Error code
1CE2: B7      	            OR   A              ;Error, so NZ flagged
1CE3: C9      	            RET                 ;Return with error
              	; Device opened okay
1CE4: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1CE5: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1CE6: CD6E1A  	            CALL I2C_Write      ;Write address
1CE9: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1CEA: CD6E1A  	            CALL I2C_Write      ;Write address
1CED: 3A04FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1CF0: 3C      	            INC  A              ; Device read equal DeviceId+1
1CF1: CD5A1A  	            CALL I2C_Open       ;Open for read
1CF4: C0      	            RET  NZ             ;Abort if error
1CF5: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1CF6: 78      	            LD   A,B
1CF7: B1      	            OR   C              ;Last byte to be read?
1CF8: CDAB1A  	            CALL I2C_Read       ;Read byte with no ack on last byte
1CFB: 77      	            LD   (HL),A         ;Write byte in CPU memory
1CFC: 23      	            INC  HL             ;Increment CPU memory pointer
1CFD: 78      	            LD   A,B
1CFE: B1      	            OR   C              ;Finished?
1CFF: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1D01: CDE31A  	            CALL I2C_Stop       ;Generate I2C stop
1D04: AF      	            XOR  A              ;Return with success (Z flagged)
1D05: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1D06: C5      	I2C_MemWr:  PUSH BC
1D07: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1D0A:         	I2C_MemWrRepeat:    
1D0A: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1D0D: CD5A1A  	            CALL I2C_Open       ;Open for write
1D10: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1D12: 0B      	            DEC  BC
1D13: 78      	            LD   A,B
1D14: B1      	            OR   C              ;Timeout?
1D15: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1D17: C1      	            POP  BC
1D18: 3E03    	            LD   A,ERR_TOUT     ;Error code
1D1A: B7      	            OR   A              ;Error, so NZ flagged
1D1B: C9      	            RET                 ;Return with error
              	; Device opened okay
1D1C: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1D1D: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1D1E: CD6E1A  	            CALL I2C_Write      ;Write address
1D21: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1D22: CD6E1A  	            CALL I2C_Write      ;Write address
1D25: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1D26: CD6E1A  	            CALL I2C_Write      ;Read byte from I2C memory
1D29: 23      	            INC  HL             ;Increment CPU memory pointer
1D2A: 13      	            INC  DE             ;Increment I2C memory pointer
1D2B: 0B      	            DEC  BC             ;Decrement byte counter
1D2C: 78      	            LD   A,B
1D2D: B1      	            OR   C              ;Finished?
1D2E: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1D30: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1D31: E63F    	            AND  63             ;64 byte page boundary?
1D33: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1D35: CDE31A  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1D38: 78      	            LD   A,B
1D39: B1      	            OR   C              ;Finished?
1D3A: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1D3C: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1D3D: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1D3E: 1F      	            RRA                 ;Shift top nibble to
1D3F: 1F      	            RRA                 ;  botom four bits..
1D40: 1F      	            RRA
1D41: 1F      	            RRA
1D42: E60F    	            AND  $0F           ;Mask off unwanted bits
1D44: CD4A1D  	            CALL HexOutHex           ;Output hi nibble
1D47: F1      	            POP  AF             ;Restore byte to be output
1D48: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1D4A: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1D4C: 3802    	            JR   C,HexOutSkip        ;No, so skip
1D4E: C607    	            ADD  A,7            ;Yes, so add 7
1D50: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1D52: CD8104  	            CALL CONOUT       ;Write character
1D55: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5        ; Assinatura da EEPROM formatada
0000:         	FS_PG_BMP:  .EQU $00        ; Número da página do bitmap
0001:         	FS_PG_DIR:  .EQU $01        ; Número da página do diretório
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8          ; Máximo de arquivos
0020:         	FS_ENTRY_SZ:.EQU 32         ; Bytes por entrada do diretório
0010:         	FS_NAME_SZ: .EQU 16         ; Bytes do nome
00FF:         	FS_DATAPG:  .EQU 255        ; Bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF      ; Slot do diretório livre
0001:         	FS_FLAG_USED: .EQU $01      ; Slot do diretório usado - File
0002:         	FS_FLAG_USED_FOLDER: .EQU $02      ; Slot do diretório usado - Folder
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0          ; Nome (16 bytes)
0010:         	FS_O_FSTPG: .EQU 16         ; Primeira página de dados
0011:         	FS_O_SIZEH: .EQU 17         ; Tamanho hi
0012:         	FS_O_SIZEL: .EQU 18         ; Tamanho lo
0013:         	FS_O_RADRH: .EQU 19         ; Load RAM hi
0014:         	FS_O_RADRL: .EQU 20         ; Load RAM lo
0015:         	FS_O_FLAGS: .EQU 21         ; Flags ($FF=livre, $01=usado por arquivo, $02=usado por pasta)
              	
              	
              	
              	
              	
              	
              	; **********************************************************************
              	; **********************************************************************
              	; FS_INFO - Espaco usado/livre da EEPROM
              	;   Le bitmap, conta paginas, imprime barra e valores
              	; **********************************************************************
1D56:         	FS_INFO:
1D56: CD9D04  	    CALL CRLF
1D59: 21AC26  	    LD HL, str_info_hdr
1D5C: CD8D04  	    CALL PUTS
              	
              	    ; Le 16 bytes do bitmap (bytes 1..16 da pagina 0)
1D5F: 110100  	    LD DE, $0001
1D62: 2142FC  	    LD HL, PG_BUF
1D65: 011000  	    LD BC, 16
1D68: CDCE1C  	    CALL I2C_MemRd
1D6B: C22725  	    JP NZ, FS_ERR_I2C
              	
              	    ; Conta paginas livres (bits=1) → C
1D6E: 2142FC  	    LD HL, PG_BUF
1D71: 0610    	    LD B, 16
1D73: 0E00    	    LD C, 0
1D75:         	FS_INF_CNT:
1D75: 7E      	    LD A, (HL)
1D76: 23      	    INC HL
1D77: 1608    	    LD D, 8
1D79:         	FS_INF_BIT:
1D79: 0F      	    RRCA
1D7A: 3001    	    JR NC, FS_INF_NB
1D7C: 0C      	    INC C
1D7D:         	FS_INF_NB:
1D7D: 15      	    DEC D
1D7E: 20F9    	    JR NZ, FS_INF_BIT
1D80: 10F3    	    DJNZ FS_INF_CNT
              	
              	    ; C = pags livres (0..126)
              	    ; paginas usadas = 126 - C → salva em E
1D82: 3E7E    	    LD A, 126
1D84: 91      	    SUB C
1D85: 5F      	    LD E, A                 ; E = paginas usadas
              	
              	    ; === Linha 1: barra visual ===
              	    ; Formato: "[##########..........] UUh/7Eh pags"
              	    ; Barra de 19 chars: cada char = ~6.6 pags
              	    ; chars_usados = E * 19 / 126
              	    ;   = E / 6  (aproximacao boa o suficiente para barra)
1D86: 7B      	    LD A, E
1D87: 0600    	    LD B, 0                 ; B = chars usados
1D89:         	FS_INF_DIV6:
1D89: FE06    	    CP 6
1D8B: 3805    	    JR C, FS_INF_DIV6_DONE
1D8D: D606    	    SUB 6
1D8F: 04      	    INC B
1D90: 18F7    	    JR FS_INF_DIV6
1D92:         	FS_INF_DIV6_DONE:
              	    ; B = chars usados (0..21, clamp a 20)
1D92: 78      	    LD A, B
1D93: FE15    	    CP 21
1D95: 3802    	    JR C, FS_INF_CLAMP
1D97: 0613    	    LD B, 19
1D99:         	FS_INF_CLAMP:
              	
1D99: 3E5B    	    LD A, '['
1D9B: CF      	    RST $08
              	
              	    ; Imprime B x '#' (usado)
1D9C: 78      	    LD A, B
1D9D: B7      	    OR A
1D9E: 2808    	    JR Z, FS_INF_NO_HASH
1DA0: C5      	    PUSH BC
1DA1: 47      	    LD B, A
1DA2:         	FS_INF_HASH:
1DA2: 3E23    	    LD A, '#'
1DA4: CF      	    RST $08
1DA5: 10FB    	    DJNZ FS_INF_HASH
1DA7: C1      	    POP BC
              	
1DA8:         	FS_INF_NO_HASH:
              	    ; Imprime (20-B) x '.' (livre)
1DA8: 3E13    	    LD A, 19
1DAA: 90      	    SUB B
1DAB: 2806    	    JR Z, FS_INF_NO_DOT
1DAD: 47      	    LD B, A
1DAE:         	FS_INF_DOT:
1DAE: 3E2E    	    LD A, '.'
1DB0: CF      	    RST $08
1DB1: 10FB    	    DJNZ FS_INF_DOT
1DB3:         	FS_INF_NO_DOT:
              	
1DB3: 3E5D    	    LD A, ']'
1DB5: CF      	    RST $08
1DB6: 3E20    	    LD A, ' '
1DB8: CF      	    RST $08
              	
              	    ; Imprime "UUh/7Eh pags"
1DB9: 7B      	    LD A, E                 ; A = usadas
1DBA: CD3D1D  	    CALL HexOut
1DBD: 3E68    	    LD A, 'h'
1DBF: CF      	    RST $08
1DC0: 3E2F    	    LD A, '/'
1DC2: CF      	    RST $08
1DC3: 3E7E    	    LD A, $7E               ; 126
1DC5: CD3D1D  	    CALL HexOut
1DC8: 3E68    	    LD A, 'h'
1DCA: CF      	    RST $08
1DCB: 21C326  	    LD HL, str_inf_pags
1DCE: CD8D04  	    CALL PUTS
              	
              	    ; === Linha 2: Usadas ===
1DD1: 21CB26  	    LD HL, str_inf_used
1DD4: CD8D04  	    CALL PUTS
1DD7: 7B      	    LD A, E
1DD8: CD3D1D  	    CALL HexOut
1DDB: 3E68    	    LD A, 'h'
1DDD: CF      	    RST $08
1DDE: 21DB26  	    LD HL, str_inf_pags_nl
1DE1: CD8D04  	    CALL PUTS
1DE4: CD9D04  	    CALL CRLF
1DE7: 3E20    	    LD A, ' '
1DE9: CF      	    RST $08
              	
              	    ; Bytes usados aprox: E * 255  (E = paginas usadas)
              	    ; Salva C (paginas livres) em RAM antes do loop destruir C
1DEA: 79      	    LD A, C
1DEB: 3241FC  	    LD (FS_INFOTMP), A      ; salva pags livres
              	
1DEE: 210000  	    LD HL, 0
1DF1: 7B      	    LD A, E
1DF2: B7      	    OR A
1DF3: 2807    	    JR Z, FS_INF_BYTES_DONE_U
1DF5:         	FS_INF_BYTES_USED:
1DF5: 01FF00  	    LD BC, FS_DATAPG        ; C destruido aqui - mas ja salvamos
1DF8: 09      	    ADD HL, BC
1DF9: 1D      	    DEC E
1DFA: 20F9    	    JR NZ, FS_INF_BYTES_USED
1DFC:         	FS_INF_BYTES_DONE_U:
1DFC: 7C      	    LD A, H
1DFD: CD3D1D  	    CALL HexOut
1E00: 7D      	    LD A, L
1E01: CD3D1D  	    CALL HexOut
1E04: 3E68    	    LD A, 'h'
1E06: CF      	    RST $08
1E07: 21E226  	    LD HL, str_inf_bytes_nl
1E0A: CD8D04  	    CALL PUTS
              	
              	    ; Recupera paginas livres
1E0D: 3A41FC  	    LD A, (FS_INFOTMP)
1E10: 4F      	    LD C, A                 ; C = paginas livres restaurado
              	
              	    ; === Linha 3: Livres ===
1E11: 21D326  	    LD HL, str_inf_free
1E14: CD8D04  	    CALL PUTS
1E17: 79      	    LD A, C
1E18: CD3D1D  	    CALL HexOut
1E1B: 3E68    	    LD A, 'h'
1E1D: CF      	    RST $08
1E1E: 21DB26  	    LD HL, str_inf_pags_nl
1E21: CD8D04  	    CALL PUTS
1E24: CD9D04  	    CALL CRLF
1E27: 3E20    	    LD A, ' '
1E29: CF      	    RST $08
              	
              	    ; Bytes livres aprox: C * 255
1E2A: 210000  	    LD HL, 0
1E2D: 79      	    LD A, C
1E2E: B7      	    OR A
1E2F: 2808    	    JR Z, FS_INF_BYTES_DONE_F
1E31: 59      	    LD E, C
1E32:         	FS_INF_BYTES_FREE:
1E32: 01FF00  	    LD BC, FS_DATAPG
1E35: 09      	    ADD HL, BC
1E36: 1D      	    DEC E
1E37: 20F9    	    JR NZ, FS_INF_BYTES_FREE
1E39:         	FS_INF_BYTES_DONE_F:
1E39: 7C      	    LD A, H
1E3A: CD3D1D  	    CALL HexOut
1E3D: 7D      	    LD A, L
1E3E: CD3D1D  	    CALL HexOut
1E41: 3E68    	    LD A, 'h'
1E43: CF      	    RST $08
1E44: 21E226  	    LD HL, str_inf_bytes_nl
1E47: CD8D04  	    CALL PUTS
1E4A: C9      	    RET
              	
              	
              	
              	; **********************************************************************
              	; FS_DIR
              	; **********************************************************************
1E4B:         	FS_DIR:
1E4B: CD9D04  	    CALL CRLF
1E4E: 3E5B    	    LD A, '['
1E50: CF      	    RST $08
1E51: 0611    	    LD B, FS_NAME_SZ + 1
1E53: 2145FD  	    LD HL, FS_DIR_NAME
1E56:         	FS_S_DIR:
1E56: 7E      	    LD A, (HL)
1E57: FE00    	    CP 0
1E59: CA601E  	    JP Z, FS_S_DIR_F
1E5C: 23      	    INC HL
1E5D: CF      	    RST $08
1E5E: 10F6    	    djnz FS_S_DIR
1E60:         	FS_S_DIR_F:
1E60: 3E5D    	    LD A, ']'
1E62: CF      	    RST $08
              	
1E63: 3E01    	    LD A, 1
1E65: CD8D09  	    CALL plotAlways
              	
1E68: CD9D04  	    CALL CRLF
              	    ;LD HL, str_dir_hdr
              	    ;CALL PUTS
1E6B: AF      	    XOR A
1E6C: 3209FC  	    LD (FS_CUR), A
1E6F: 0608    	    LD B, FS_MAXFILES
1E71: 0E00    	    LD C, 0
1E73:         	FS_DIR_LOOP:
1E73: C5      	    PUSH BC
1E74: CD9D22  	    CALL FS_RD_ENTRY
1E77: C22E25  	    JP NZ, FS_ERR_I2C_POP
