1BD8: C1      	I2C_MemRdReady:     POP  BC             ;Restore byte counter
1BD9: 7A      	            LD   A,D            ;Address (hi) in I2C memory
1BDA: CD9819  	            CALL I2C_Write      ;Write address
1BDD: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1BDE: CD9819  	            CALL I2C_Write      ;Write address
1BE1: 3A04FC  	            LD   A, (I2CA_BLOCK) ;I2C device to be read from
1BE4: 3C      	            INC  A              ; Device read equal DeviceId+1
1BE5: CD8419  	            CALL I2C_Open       ;Open for read
1BE8: C0      	            RET  NZ             ;Abort if error
1BE9: 0B      	I2C_MemRdRead:      DEC  BC             ;Decrement byte counter
1BEA: 78      	            LD   A,B
1BEB: B1      	            OR   C              ;Last byte to be read?
1BEC: CDD519  	            CALL I2C_Read       ;Read byte with no ack on last byte
1BEF: 77      	            LD   (HL),A         ;Write byte in CPU memory
1BF0: 23      	            INC  HL             ;Increment CPU memory pointer
1BF1: 78      	            LD   A,B
1BF2: B1      	            OR   C              ;Finished?
1BF3: 20F4    	            JR   NZ,I2C_MemRdRead       ;No, so go read next byte
1BF5: CD0D1A  	            CALL I2C_Stop       ;Generate I2C stop
1BF8: AF      	            XOR  A              ;Return with success (Z flagged)
1BF9: C9      	            RET
              	
              	
              	; Copy a block from CPU memory to I2C memory
              	;   On entry: DE = First address in I2C memory
              	;             HL = First address in CPU memory
              	;             BC = Number of bytes to be copied
              	;             SCL = unknown, SDA = unknown
              	;   On exit:  If successfully A = 0 and Z flagged
              	;             If unsuccessfully A = Error and NZ flagged
              	;             IX IY preserved
              	; The 24LC64 requires blocks of data to be written in 64 byte (or less)
              	; pages.
1BFA: C5      	I2C_MemWr:  PUSH BC
1BFB: 011027  	            LD   BC,TIMEOUT     ;Timeout loop counter
1BFE:         	I2C_MemWrRepeat:    
1BFE: 3A04FC  	            LD   A, (I2CA_BLOCK)   ;I2C address to write to
1C01: CD8419  	            CALL I2C_Open       ;Open for write
1C04: 280A    	            JR   Z,I2C_MemWrReady       ;If open okay then skip on
1C06: 0B      	            DEC  BC
1C07: 78      	            LD   A,B
1C08: B1      	            OR   C              ;Timeout?
1C09: 20F3    	            JR   NZ,I2C_MemWrRepeat     ;No, so go try again
1C0B: C1      	            POP  BC
1C0C: 3E03    	            LD   A,ERR_TOUT     ;Error code
1C0E: B7      	            OR   A              ;Error, so NZ flagged
1C0F: C9      	            RET                 ;Return with error
              	; Device opened okay
1C10: C1      	I2C_MemWrReady:     POP  BC             ;Restore byte counter
1C11: 7A      	I2C_MemWrBlock:     LD   A,D            ;Address (hi) in I2C memory
1C12: CD9819  	            CALL I2C_Write      ;Write address
1C15: 7B      	            LD   A,E            ;Address (lo) in I2C memory
1C16: CD9819  	            CALL I2C_Write      ;Write address
1C19: 7E      	I2C_MemWrWrite:     LD   A,(HL)         ;Get data byte from CPU memory
1C1A: CD9819  	            CALL I2C_Write      ;Read byte from I2C memory
1C1D: 23      	            INC  HL             ;Increment CPU memory pointer
1C1E: 13      	            INC  DE             ;Increment I2C memory pointer
1C1F: 0B      	            DEC  BC             ;Decrement byte counter
1C20: 78      	            LD   A,B
1C21: B1      	            OR   C              ;Finished?
1C22: 2805    	            JR   Z,I2C_MemWrStore       ;Yes, so go store this page
1C24: 7B      	            LD   A,E            ;Get address in I2C memory (lo byte)
1C25: E63F    	            AND  63             ;64 byte page boundary?
1C27: 20F0    	            JR   NZ,I2C_MemWrWrite      ;No, so go write another byte
1C29: CD0D1A  	I2C_MemWrStore:     CALL I2C_Stop       ;Generate I2C stop
1C2C: 78      	            LD   A,B
1C2D: B1      	            OR   C              ;Finished?
1C2E: 20CA    	            JR   NZ,I2C_MemWr   ;No, so go write some more
1C30: C9      	            RET   
              	
              	
              	; Hex byte output to console
              	;   On entry: A = Byte to be output in hex
              	;   On exit:  BC DE HL IX IY preserved
1C31: F5      	HexOut:     PUSH AF             ;Preserve byte to be output
1C32: 1F      	            RRA                 ;Shift top nibble to
1C33: 1F      	            RRA                 ;  botom four bits..
1C34: 1F      	            RRA
1C35: 1F      	            RRA
1C36: E60F    	            AND  $0F           ;Mask off unwanted bits
1C38: CD3E1C  	            CALL HexOutHex           ;Output hi nibble
1C3B: F1      	            POP  AF             ;Restore byte to be output
1C3C: E60F    	            AND  $0F           ;Mask off unwanted bits
              	; Output nibble as ascii character
1C3E: FE0A    	HexOutHex:       CP   $0A           ;Nibble > 10 ?
1C40: 3802    	            JR   C,HexOutSkip        ;No, so skip
1C42: C607    	            ADD  A,7            ;Yes, so add 7
1C44: C630    	HexOutSkip:      ADD  A,$30         ;Add ASCII '0'
1C46: CD5804  	            CALL CONOUT       ;Write character
1C49: C9      	            RET
              	#include "FS.asm"
              	
              	; --- Constantes ---
00A5:         	FS_SIG:     .EQU $A5
0000:         	FS_PG_BMP:  .EQU $00
0001:         	FS_PG_DIR:  .EQU $01
0002:         	FS_PG_DATA: .EQU $02        ; primeira pagina de dados
0008:         	FS_MAXFILES:.EQU 8
0020:         	FS_ENTRY_SZ:.EQU 32
0008:         	FS_NAME_SZ: .EQU 8
00FF:         	FS_DATAPG:  .EQU 255        ; bytes uteis por pagina
              	
00FF:         	FS_FLAG_FREE: .EQU $FF
0001:         	FS_FLAG_USED: .EQU $01
              	
              	; Offsets na entrada
0000:         	FS_O_NAME:  .EQU 0
0008:         	FS_O_FSTPG: .EQU 8
0009:         	FS_O_SIZEH: .EQU 9
000A:         	FS_O_SIZEL: .EQU 10
000B:         	FS_O_RADRH: .EQU 11
000C:         	FS_O_RADRL: .EQU 12
000D:         	FS_O_FLAGS: .EQU 13
              	
              	
              	
              	; **********************************************************************
              	; FS_DIR
              	; **********************************************************************
1C4A:         	FS_DIR:
1C4A: 3E01    	    LD A, 1
1C4C: CD6409  	    CALL plotAlways
              	
1C4F: CD7404  	    CALL CRLF
1C52: 21DC22  	    LD HL, str_dir_hdr
1C55: CD6404  	    CALL PUTS
1C58: AF      	    XOR A
1C59: 3209FC  	    LD (FS_CUR), A
1C5C: 0608    	    LD B, FS_MAXFILES
1C5E: 0E00    	    LD C, 0
1C60:         	FS_DIR_LOOP:
1C60: C5      	    PUSH BC
1C61: CD601F  	    CALL FS_RD_ENTRY
1C64: C2AF21  	    JP NZ, FS_ERR_I2C_POP
1C67: 3A17FC  	    LD A, (FS_WRKBUF + FS_O_FLAGS)
1C6A: FE01    	    CP FS_FLAG_USED
1C6C: 2041    	    JR NZ, FS_DIR_SKIP
1C6E: 210AFC  	    LD HL, FS_WRKBUF + FS_O_NAME
1C71: 0608    	    LD B, FS_NAME_SZ
1C73:         	FS_DIR_NM:
1C73: 7E      	    LD A, (HL)
1C74: B7      	    OR A
1C75: 2806    	    JR Z, FS_DIR_PAD
1C77: CF      	    RST $08
1C78: 23      	    INC HL
1C79: 10F8    	    DJNZ FS_DIR_NM
1C7B: 1806    	    JR FS_DIR_AFT
1C7D:         	FS_DIR_PAD:
1C7D: 3E20    	    LD A, ' '
1C7F: CF      	    RST $08
1C80: 23      	    INC HL
1C81: 10FA    	    DJNZ FS_DIR_PAD
1C83:         	FS_DIR_AFT:
1C83: 3E20    	    LD A, ' '
1C85: CF      	    RST $08
1C86: 3A13FC  	    LD A, (FS_WRKBUF + FS_O_SIZEH)
1C89: CD311C  	    CALL HexOut
1C8C: 3A14FC  	    LD A, (FS_WRKBUF + FS_O_SIZEL)
1C8F: CD311C  	    CALL HexOut
1C92: 3E20    	    LD A, ' '
1C94: CF      	    RST $08
1C95: 3A15FC  	    LD A, (FS_WRKBUF + FS_O_RADRH)
1C98: CD311C  	    CALL HexOut
1C9B: 3A16FC  	    LD A, (FS_WRKBUF + FS_O_RADRL)
1C9E: CD311C  	    CALL HexOut
1CA1: 3E20    	    LD A, ' '
1CA3: CF      	    RST $08
1CA4: 3A12FC  	    LD A, (FS_WRKBUF + FS_O_FSTPG)
1CA7: CD311C  	    CALL HexOut
1CAA: C1      	    POP BC
1CAB: 0C      	    INC C
1CAC: C3B01C  	    JP FS_DIR_INC
